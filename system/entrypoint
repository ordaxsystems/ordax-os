#!/bin/sh
set -eu

SYSTEM_ROOT=${0%/*}
SYSTEM_ENTRYPOINT=$SYSTEM_ROOT/entrypoint
SUPERVISOR=$SYSTEM_ROOT/supervisor
RECOVERY_ENTRYPOINT=/ordax/bootstrap/recovery/entrypoint
UPDATE_RUN_DIR=${ORDAX_UPDATE_RUN_DIR:-/run/ordax-update}
UPDATE_STATE=$UPDATE_RUN_DIR/state.json
SUPERVISOR_HEARTBEAT_FILE=$UPDATE_RUN_DIR/supervisor-heartbeat
WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
GIT_BIN=${ORDAX_GIT_BIN:-/usr/bin/git}
DISTRIBUTION_PROFILE=${ORDAX_DISTRIBUTION_PROFILE:-owner-development}
PRODUCT_MODE=${ORDAX_PRODUCT_MODE:-}
SOURCE_SHA_HINT=${ORDAX_SOURCE_SHA:-}
STABLE_ROOT=${ORDAX_STABLE_ROOT:-/ordax}
STABLE_LAYOUT=${ORDAX_STABLE_LAYOUT:-legacy-tree}
BASE_UPDATE_STATE_DIR=${ORDAX_BASE_UPDATE_STATE_DIR:-/state/ordax/base-update}
BASE_HEARTBEAT_FILE=$BASE_UPDATE_STATE_DIR/base-heartbeat.json
BASE_BOOT_ID_FILE=$UPDATE_RUN_DIR/base-boot-id
CMDLINE_FILE=/proc/cmdline
GUARDIAN_PID_FILE=$UPDATE_RUN_DIR/guardian.pid
SUPERVISOR_PID_FILE=$UPDATE_RUN_DIR/supervisor.pid
SUPERVISOR_POWER_QUIESCED_FILE=$UPDATE_RUN_DIR/supervisor-power-quiesced
GUARDIAN_LOG=$UPDATE_RUN_DIR/guardian.log
HOST_POWER_REQUEST=$UPDATE_RUN_DIR/host-power-request
ACPI_ACTION_SOURCE=$SYSTEM_ROOT/services/power/acpi-button-action.sh
ACPI_DIR=$UPDATE_RUN_DIR/acpi
ACPI_BUTTON_PID=""
POWER_STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}/power
POWER_LAST_REQUEST=$POWER_STATE_DIR/last-request
POWER_LAST_STAGE=$POWER_STATE_DIR/last-stage
POWER_LAST_FAILURE=$POWER_STATE_DIR/last-failure
BASE_TELEMETRY_PID_FILE=${ORDAX_STATE_DIR:-/state/ordax}/telemetry/agent.pid
BASE_TELEMETRY_AGENT=${ORDAX_STATE_DIR:-/state/ordax}/telemetry/agent.sh
RESCUE_PID_FILE=${ORDAX_STATE_DIR:-/state/ordax}/rescue/agent.pid
RESCUE_AGENT=${ORDAX_STATE_DIR:-/state/ordax}/rescue/agent.sh
BASE_UPDATE_PID_FILE=${ORDAX_STATE_DIR:-/state/ordax}/base-update/agent.pid
BASE_UPDATE_AGENT=${ORDAX_STATE_DIR:-/state/ordax}/base-update/agent.sh
CHECK_INTERVAL=${ORDAX_GUARDIAN_CHECK_SECONDS:-10}
STALE_SECONDS=${ORDAX_SUPERVISOR_STALE_SECONDS:-120}
CRASH_LIMIT=${ORDAX_SUPERVISOR_CRASH_LIMIT:-3}
STABLE_SECONDS=${ORDAX_SUPERVISOR_STABLE_SECONDS:-60}
SUPERVISOR_PID=""
STOPPING=0
HOST_POWER_ACTION=""

mkdir -p "$UPDATE_RUN_DIR" "$POWER_STATE_DIR"
chmod 700 "$UPDATE_RUN_DIR" "$POWER_STATE_DIR"

log() {
    printf '%s ordax-guardian: %s\n' "$(/bin/busybox date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown)" "$*" >>"$GUARDIAN_LOG"
}

normalize_number() {
    value=$1
    fallback=$2
    minimum=$3
    case "$value" in
        ''|*[!0-9]*) value=$fallback ;;
    esac
    [ "$value" -ge "$minimum" ] 2>/dev/null || value=$fallback
    printf '%s' "$value"
}

CHECK_INTERVAL=$(normalize_number "$CHECK_INTERVAL" 10 5)
STALE_SECONDS=$(normalize_number "$STALE_SECONDS" 120 60)
CRASH_LIMIT=$(normalize_number "$CRASH_LIMIT" 3 2)
STABLE_SECONDS=$(normalize_number "$STABLE_SECONDS" 60 30)

epoch_now() {
    /bin/busybox date +%s 2>/dev/null || printf '0\n'
}

state_epoch() {
    # Prefer the current child's independent liveness marker. A completed
    # update transition does not imply that a provisioning worker has stalled.
    if [ -f "$SUPERVISOR_HEARTBEAT_FILE" ] && [ ! -L "$SUPERVISOR_HEARTBEAT_FILE" ]; then
        beat_owner=$(/bin/busybox cat "$SUPERVISOR_HEARTBEAT_FILE" 2>/dev/null || true)
        [ "$beat_owner" = "$SUPERVISOR_PID" ] || {
            printf '1\n'
            return 0
        }
        /bin/busybox stat -c %Y "$SUPERVISOR_HEARTBEAT_FILE" 2>/dev/null || printf '1\n'
        return 0
    fi
    # Compatibility during the first start, before the child has sent a beat.
    [ -f "$UPDATE_STATE" ] || {
        printf '0\n'
        return 0
    }
    /bin/busybox stat -c %Y "$UPDATE_STATE" 2>/dev/null || printf '0\n'
}

is_pid() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 1 ] 2>/dev/null
}

write_pid() {
    destination=$1
    value=$2
    temporary=$destination.tmp.$$
    printf '%s\n' "$value" >"$temporary"
    /bin/busybox mv -f "$temporary" "$destination"
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

stable_current_release_sha() {
    current=$STABLE_ROOT/current
    [ -L "$current" ] || return 1
    target=$(/bin/busybox readlink "$current" 2>/dev/null || true)
    case "$target" in
        releases/*) value=${target#releases/} ;;
        *) return 1 ;;
    esac
    case "$value" in
        */*) return 1 ;;
    esac
    is_sha "$value" || return 1
    [ -d "$STABLE_ROOT/releases/$value" ] || return 1
    [ -x "$STABLE_ROOT/releases/$value/system/entrypoint" ] || return 1
    printf '%s' "$value"
}

portable_stable_source_sha() {
    [ "$PRODUCT_MODE" = "usb" ] || return 1
    is_sha "$SOURCE_SHA_HINT" || return 1
    [ -x "$SYSTEM_ENTRYPOINT" ] || return 1
    [ -f "$SUPERVISOR" ] || return 1
    printf '%s' "$SOURCE_SHA_HINT"
}

stable_release_identity_sha() {
    case "$STABLE_LAYOUT" in
        legacy-tree)
            stable_current_release_sha
            ;;
        portable-v2)
            portable_stable_source_sha
            ;;
        *)
            return 1
            ;;
    esac
}

runtime_source_sha() {
    case "$DISTRIBUTION_PROFILE" in
        stable-mvp)
            stable_release_identity_sha
            ;;
        owner-development)
            value=$("$GIT_BIN" -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
            is_sha "$value" || return 1
            printf '%s' "$value"
            ;;
        *)
            return 1
            ;;
    esac
}

ensure_base_boot_id() {
    current=""
    if [ -r "$BASE_BOOT_ID_FILE" ]; then
        current=$(/bin/busybox cat "$BASE_BOOT_ID_FILE" 2>/dev/null || true)
    fi
    if [ "${#current}" -eq 32 ]; then
        case "$current" in *[!0-9a-f]*) current="" ;; esac
    else
        current=""
    fi
    [ -n "$current" ] && return 0

    generated=$(/bin/busybox od -An -N16 -tx1 /dev/urandom 2>/dev/null | /bin/busybox tr -d ' \n' || true)
    [ "${#generated}" -eq 32 ] || return 1
    case "$generated" in *[!0-9a-f]*) return 1 ;; esac

    temporary=$BASE_BOOT_ID_FILE.tmp.$$
    printf '%s\n' "$generated" >"$temporary"
    chmod 600 "$temporary"
    /bin/busybox mv -f "$temporary" "$BASE_BOOT_ID_FILE"
}

cmdline_value() {
    key=$1
    [ -r "$CMDLINE_FILE" ] || return 1
    found=""
    for token in $(/bin/busybox cat "$CMDLINE_FILE"); do
        case "$token" in
            "$key="*)
                value=${token#*=}
                [ -z "$found" ] || return 1
                found=$value
                ;;
        esac
    done
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

write_base_update_heartbeat() {
    candidate=$(cmdline_value ordax.base_candidate 2>/dev/null || true)
    slot=$(cmdline_value ordax.base_slot 2>/dev/null || true)

    if [ -z "$candidate" ] && [ -z "$slot" ]; then
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    fi

    is_sha "$candidate" || {
        log "candidate base heartbeat rejected invalid release identity"
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    }
    case "$slot" in a|b) ;; *)
        log "candidate base heartbeat rejected invalid slot"
        rm -f "$BASE_HEARTBEAT_FILE" >/dev/null 2>&1 || true
        return 0
    esac

    source_sha=$(runtime_source_sha 2>/dev/null || true)
    is_sha "$source_sha" || {
        log "candidate base heartbeat could not resolve current release"
        return 0
    }
    boot_id=$(/bin/busybox cat "$BASE_BOOT_ID_FILE" 2>/dev/null || true)
    [ "${#boot_id}" -eq 32 ] || {
        log "candidate base heartbeat could not resolve boot session id"
        return 0
    }
    case "$boot_id" in
        *[!0-9a-f]*) log "candidate base heartbeat rejected invalid boot session id"; return 0 ;;
    esac

    /bin/busybox mkdir -p "$BASE_UPDATE_STATE_DIR"
    chmod 700 "$BASE_UPDATE_STATE_DIR"
    temporary=$BASE_HEARTBEAT_FILE.tmp.$$
    printf '{"$schema":"prototype-ordax.base-heartbeat/1","candidateSha":"%s","sourceSha":"%s","slot":"%s","bootId":"%s"}\n' \
        "$candidate" "$source_sha" "$slot" "$boot_id" >"$temporary"
    chmod 600 "$temporary"
    /bin/busybox mv -f "$temporary" "$BASE_HEARTBEAT_FILE"
}

terminate_supervisor() {
    pid=${SUPERVISOR_PID:-}
    is_pid "$pid" || return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 0

    kill "$pid" >/dev/null 2>&1 || true
    remaining=5
    while kill -0 "$pid" >/dev/null 2>&1 && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
        log "forcing stalled supervisor pid $pid"
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
}

# kill -0 also succeeds for zombie processes. A Supervisor may have
# published its final quiesce receipt and exited, but not yet been reaped by
# the Guardian parent. Treat that state as exited; the receipt still must
# match the exact supervised PID before any power transition is allowed.
supervisor_process_active() {
    pid=$1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    process_state=$(/bin/busybox awk '$1 == "State:" { print $2; exit }' "/proc/$pid/status" 2>/dev/null || true)
    [ "$process_state" != Z ]
}

quiesce_supervisor_for_power_transition() {
    pid=${SUPERVISOR_PID:-}
    is_pid "$pid" || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1

    rm -f "$SUPERVISOR_POWER_QUIESCED_FILE" >/dev/null 2>&1 || true
    kill "$pid" >/dev/null 2>&1 || return 1

    # Surface stop is bounded to 5s and its Native authority proof to another
    # 4s. Give that existing owner enough time to prove a clean handoff rather
    # than racing it with the guardian's generic 5s termination budget.
    # Supervisor permits 14s for Surface cleanup and up to 5s to prove
    # the native-host lock has been released. Its parent must outlive both
    # gates, including scheduling/receipt overhead, without a premature KILL.
    remaining=24
    while supervisor_process_active "$pid" && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if supervisor_process_active "$pid"; then
        log "supervisor did not produce a bounded power-quiesce handoff; forcing pid $pid"
        kill -KILL "$pid" >/dev/null 2>&1 || true
        wait "$pid" 2>/dev/null || true
        SUPERVISOR_PID=""
        return 1
    fi

    wait "$pid" 2>/dev/null || true
    SUPERVISOR_PID=""
    proof=""
    if [ -s "$SUPERVISOR_POWER_QUIESCED_FILE" ] && [ ! -L "$SUPERVISOR_POWER_QUIESCED_FILE" ]; then
        IFS= read -r proof <"$SUPERVISOR_POWER_QUIESCED_FILE" || true
    fi
    [ "$proof" = "$pid" ] || {
        log "supervisor exited without proving Surface/Native quiescence for host power transition"
        return 1
    }
    rm -f "$SUPERVISOR_POWER_QUIESCED_FILE" >/dev/null 2>&1 || true
    return 0
}

pid_matches_path() {
    pid=${1:-}
    expected_path=${2:-}
    is_pid "$pid" || return 1
    [ -n "$expected_path" ] || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(/bin/busybox tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in
        *"$expected_path"*) return 0 ;;
    esac
    return 1
}

terminate_persistent_agent() {
    pid_file=$1
    expected_path=$2
    label=$3
    pid=""
    [ -s "$pid_file" ] && [ ! -L "$pid_file" ] || return 0
    IFS= read -r pid <"$pid_file" || true
    if ! pid_matches_path "$pid" "$expected_path"; then
        rm -f "$pid_file" >/dev/null 2>&1 || true
        return 0
    fi

    kill "$pid" >/dev/null 2>&1 || true
    remaining=2
    while supervisor_process_active "$pid" && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if supervisor_process_active "$pid"; then
        log "forcing persistent $label pid $pid for host power transition"
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    remaining=2
    while supervisor_process_active "$pid" && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    supervisor_process_active "$pid" && return 1
    rm -f "$pid_file" >/dev/null 2>&1 || true
    return 0
}

terminate_persistent_host_agents() {
    terminate_persistent_agent "$BASE_TELEMETRY_PID_FILE" "$BASE_TELEMETRY_AGENT" "telemetry agent" || return 1
    terminate_persistent_agent "$RESCUE_PID_FILE" "$RESCUE_AGENT" "rescue agent" || return 1
    terminate_persistent_agent "$BASE_UPDATE_PID_FILE" "$BASE_UPDATE_AGENT" "base update agent" || return 1
    return 0
}

root_filesystem_is_read_only() {
    root_options=$(/bin/busybox awk '$2 == "/" { print $4; exit }' /proc/mounts 2>/dev/null || true)
    case ",$root_options," in
        *,ro,*) return 0 ;;
    esac
    return 1
}

# The Dev root is a bind-mounted ext4 directory, not an /etc/fstab
# filesystem entry. BusyBox mount with a single operand may attempt to
# resolve metadata after switch_root/pivot_root. Pass source AND target
# explicitly to remount precisely the active root mount, not the backing
# ext4 superblock or one of the other writable binds. Preserve the ro proof.
# Stable/MVP retains its separately defined ordinary-root transition.
remount_root_read_only_for_power() {
    case "$DISTRIBUTION_PROFILE" in
        owner-development)
            /bin/busybox mount -o remount,bind,ro / / >>"$GUARDIAN_LOG" 2>&1
            ;;
        stable-mvp)
            /bin/busybox mount -o remount,ro / >>"$GUARDIAN_LOG" 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

# The abort path must undo only the same bind mount flags. In particular,
# do not attempt a superblock-wide remount which could leave unrelated
# writable state inaccessible after a rejected shutdown.
remount_root_read_write_after_power_abort() {
    case "$DISTRIBUTION_PROFILE" in
        owner-development)
            /bin/busybox mount -o remount,bind,rw / / >>"$GUARDIAN_LOG" 2>&1
            ;;
        stable-mvp)
            /bin/busybox mount -o remount,rw / >>"$GUARDIAN_LOG" 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

# Owner USB Dev uses one ext4 superblock through multiple bind mounts after
# switch_root/pivot_root. Sealing only the / bind VFS flag does not seal the
# ext4 journal. Resolve the *physical block source* of / and require ORDAX
# identity through sysfs and mountinfo before touching flags. The fixed
# initramfs already verified the ORDAX labels on the same removable USB.
OWNER_USB_ROOT_SOURCE=""

owner_usb_root_source() {
    device=$(/bin/busybox awk '$2 == "/" && $3 == "ext4" { print $1; exit }' /proc/mounts 2>/dev/null || true)
    case "$device" in /dev/*) ;; *) return 1 ;; esac
    [ -b "$device" ] || return 1
    name=${device##*/}
    sys=/sys/class/block/$name
    [ -f "$sys/partition" ] && [ -f "$sys/dev" ] || return 1
    partition=$(/bin/busybox cat "$sys/partition" 2>/dev/null || true)
    removable=$(/bin/busybox cat "$sys/../removable" 2>/dev/null || true)
    [ "$partition" = 2 ] && [ "$removable" = 1 ] || return 1
    root_id=$(/bin/busybox awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo 2>/dev/null || true)
    device_id=$(/bin/busybox cat "$sys/dev" 2>/dev/null || true)
    [ -n "$root_id" ] && [ "$root_id" = "$device_id" ] || return 1
    printf '%s\n' "$device"
}

owner_usb_all_root_mounts_read_only() {
    # The major:minor identifies *all* aliases of the mounted superblock.
    # Reading only /proc/mounts at / would miss rw bind mounts elsewhere.
    mount_id=$(/bin/busybox awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo 2>/dev/null || true)
    case "$mount_id" in *:*) ;; *) return 1 ;; esac
    /bin/busybox awk -v root_id="$mount_id" '
        $3 == root_id {
            seen = 1
            if ($6 !~ /(^|,)ro(,|$)/) bad = 1
            ext4 = 0
            for (i=1; i<=NF; i++) {
                if ($i == "-") {
                    if ($(i+1) == "ext4" && $(i+3) ~ /(^|,)ro(,|$)/) ext4 = 1
                    break
                }
            }
            if (!ext4) bad = 1
        }
        END { exit (!seen || bad) }
    ' /proc/self/mountinfo
}

owner_usb_foreign_persistent_mounts_quiesced() {
    # ESP/DATA are partitions 1/3 of the verified removable USB root 2.
    # Identify siblings directly; the minimal Owner Base has no blkid applet.
    root_device=$(owner_usb_root_source) || return 1
    disk_prefix=${root_device%2}
    [ "$disk_prefix" != "$root_device" ] || return 1
    sources=$(/bin/busybox awk '
        ($3 == "vfat" || $3 == "exfat") && $4 ~ /(^|,)rw(,|$)/ { print $1 }
    ' /proc/mounts) || return 1
    for device in $sources; do
        case "$device" in
            "$disk_prefix"1|"$disk_prefix"3) return 1 ;;
            /dev/*) ;;
            *) return 1 ;;
        esac
    done
    return 0
}

owner_usb_seal_root_for_power() {
    OWNER_USB_ROOT_SOURCE=""
    owner_usb_foreign_persistent_mounts_quiesced || return 1
    device=$(owner_usb_root_source) || return 1
    OWNER_USB_ROOT_SOURCE=$device
    # Superblock-wide remount, not remount,bind,ro. The latter leaves the
    # journal writable through other aliases. No filesystem log FD is kept
    # open across the transition.
    /bin/busybox mount -o remount,ro "$device" / >/dev/null 2>&1 || return 1
    owner_usb_all_root_mounts_read_only
}

owner_usb_restore_root_after_abort() {
    [ -n "$OWNER_USB_ROOT_SOURCE" ] || return 0
    /bin/busybox mount -o remount,rw "$OWNER_USB_ROOT_SOURCE" / >/dev/null 2>&1 || return 1
    root_filesystem_is_read_only && return 1
    OWNER_USB_ROOT_SOURCE=""
    return 0
}

mark_power_request_failed() {
    expected_action=$1
    [ -s "$POWER_LAST_REQUEST" ] && [ ! -L "$POWER_LAST_REQUEST" ] || return 0
    action=""
    request_boot_id=""
    request_epoch=""
    status=""
    IFS='|' read -r action request_boot_id request_epoch status <"$POWER_LAST_REQUEST" || return 0
    [ "$action" = "$expected_action" ] && [ "$status" = "pending" ] || return 0
    temporary=$POWER_LAST_REQUEST.tmp.$$
    printf '%s|%s|%s|failed\n' "$action" "$request_boot_id" "$request_epoch" >"$temporary" || return 1
    chmod 600 "$temporary" || return 1
    /bin/busybox mv -f "$temporary" "$POWER_LAST_REQUEST" || return 1
    return 0
}

# Durable, privacy-safe stage receipts: identify which owner could not
# complete shutdown. Preserve the last stage and a separate failure reason so
# the UI cannot confuse a Surface recovery with a real host poweroff.
record_host_power_stage() {
    stage=$1
    case "$stage" in
        accepted|supervisor-quiesce|host-agents|filesystem-sync|root-readonly) ;;
        *) return 1 ;;
    esac
    temporary=$POWER_LAST_STAGE.tmp.$$
    printf '%s\n' "$stage" >"$temporary" || return 1
    chmod 600 "$temporary" || return 1
    /bin/busybox mv -f "$temporary" "$POWER_LAST_STAGE" || return 1
}

record_host_power_failure() {
    failure=$1
    case "$failure" in
        supervisor-quiesce-failed|host-agents-failed|sync-failed|remount-failed|root-still-writable|kernel-transition-returned) ;;
        *) return 1 ;;
    esac
    temporary=$POWER_LAST_FAILURE.tmp.$$
    printf '%s\n' "$failure" >"$temporary" || return 1
    chmod 600 "$temporary" || return 1
    /bin/busybox mv -f "$temporary" "$POWER_LAST_FAILURE" || return 1
}

prepare_host_power_channel() {
    rm -f "$HOST_POWER_REQUEST" >/dev/null 2>&1 || true
    /bin/busybox mkfifo "$HOST_POWER_REQUEST" || return 1
    chmod 600 "$HOST_POWER_REQUEST" || return 1
    exec 8<>"$HOST_POWER_REQUEST" || return 1
    return 0
}

start_acpi_button_listener() {
    [ "$DISTRIBUTION_PROFILE" = "owner-development" ] || return 0
    if [ -n "$ACPI_BUTTON_PID" ] && kill -0 "$ACPI_BUTTON_PID" >/dev/null 2>&1; then
        return 0
    fi
    ACPI_BUTTON_PID=""
    [ -f "$ACPI_ACTION_SOURCE" ] && [ ! -L "$ACPI_ACTION_SOURCE" ] || return 1
    /bin/busybox acpid --help >/dev/null 2>&1 || return 1
    mkdir -p "$ACPI_DIR" || return 1
    chmod 700 "$ACPI_DIR" || return 1
    /bin/busybox cp "$ACPI_ACTION_SOURCE" "$ACPI_DIR/shutdown" || return 1
    chmod 700 "$ACPI_DIR/shutdown" || return 1
    # Linux evdev power key press only (value 1); no lid, sleep or release event.
    printf '%s\n' 'EV_KEY 0x01 KEY_POWER 116 1 "button/power PWRF 00000080"' >"$ACPI_DIR/acpi.map" || return 1
    printf '%s\n' 'PWRF shutdown' >"$ACPI_DIR/acpid.conf" || return 1
    chmod 600 "$ACPI_DIR/acpi.map" "$ACPI_DIR/acpid.conf" || return 1
    ORDAX_HOST_POWER_REQUEST="$HOST_POWER_REQUEST" \
        /bin/busybox acpid -f -c "$ACPI_DIR" -a "$ACPI_DIR/acpid.conf" -M "$ACPI_DIR/acpi.map" \
            >>"$GUARDIAN_LOG" 2>&1 &
    ACPI_BUTTON_PID=$!
    /bin/busybox sleep 1
    if ! kill -0 "$ACPI_BUTTON_PID" >/dev/null 2>&1; then
        wait "$ACPI_BUTTON_PID" 2>/dev/null || true
        ACPI_BUTTON_PID=""
        return 1
    fi
    log "physical ACPI power button now routes to Guardian shutdown authority"
}

stop_acpi_button_listener() {
    [ -n "$ACPI_BUTTON_PID" ] || return 0
    kill "$ACPI_BUTTON_PID" >/dev/null 2>&1 || true
    wait "$ACPI_BUTTON_PID" 2>/dev/null || true
    ACPI_BUTTON_PID=""
}

close_host_power_channel() {
    exec 8>&- 2>/dev/null || true
    rm -f "$HOST_POWER_REQUEST" >/dev/null 2>&1 || true
}

restore_runtime_after_power_failure() {
    action=$1
    reason=$2
    failure_code=$3
    mark_power_request_failed "$action" || true
    record_host_power_failure "$failure_code" || true
    STOPPING=0
    log "$reason; restoring supervised runtime"
    if ! start_supervisor; then
        fail_closed "host power transition failed and supervisor could not be restored"
    fi
    start_acpi_button_listener || log "physical ACPI button listener could not be restored"
    return 1
}

perform_host_power_transition() {
    action=$1
    case "$action" in restart|shutdown) ;; *) return 1 ;; esac

    STOPPING=1
    rm -f "$POWER_LAST_FAILURE" >/dev/null 2>&1 || true
    record_host_power_stage accepted || true
    log "host power owner accepted $action; stopping supervised runtime"
    record_host_power_stage supervisor-quiesce || true
    if ! quiesce_supervisor_for_power_transition; then
        restore_runtime_after_power_failure "$action" "supervisor could not prove Surface/Native quiescence for $action" supervisor-quiesce-failed
        return 1
    fi

    stop_acpi_button_listener
    record_host_power_stage host-agents || true
    if ! terminate_persistent_host_agents; then
        restore_runtime_after_power_failure "$action" "persistent host agent did not quiesce for $action" host-agents-failed
        return 1
    fi
    record_host_power_stage filesystem-sync || true
    if ! /bin/busybox sync >>"$GUARDIAN_LOG" 2>&1; then
        restore_runtime_after_power_failure "$action" "filesystem sync failed before $action" sync-failed
        return 1
    fi
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] && [ "$PRODUCT_MODE" = "usb" ]; then
        record_host_power_stage root-readonly || true
        if ! owner_usb_seal_root_for_power; then
            if ! owner_usb_restore_root_after_abort; then
                fail_closed "Owner USB ext4 seal failed and rw recovery could not be proven"
            fi
            restore_runtime_after_power_failure "$action" "Owner USB ext4 superblock could not be sealed" remount-failed
            return 1
        fi
        if ! /bin/busybox sync >/dev/null 2>&1; then
            if ! owner_usb_restore_root_after_abort; then
                fail_closed "Owner USB final sync failed and writable root could not be restored"
            fi
            restore_runtime_after_power_failure "$action" "Owner USB final sync failed after filesystem seal" sync-failed
            return 1
        fi
        # No further persistent writes before the kernel transition.
    else
        # Stable/MVP owns a distinct rootfs and retains its verified
        # read-only barrier. Future non-USB Dev modes keep this conservative
        # route until their filesystem topology is explicitly supported.
        record_host_power_stage root-readonly || true
        if ! remount_root_read_only_for_power; then
            restore_runtime_after_power_failure "$action" "root filesystem could not be remounted read-only for $action" remount-failed
            return 1
        fi
        if ! root_filesystem_is_read_only; then
            remount_root_read_write_after_power_abort || true
            restore_runtime_after_power_failure "$action" "root filesystem remained writable after $action quiesce" root-still-writable
            return 1
        fi
        # Persistence is sealed on this profile. No writes to regular files
        # unless the kernel transition returns and root is restored writable.
        /bin/busybox sync >/dev/null 2>&1 || true
    fi
    # A sysrq b/o fallback bypasses filesystem shutdown and can corrupt ext4.
    # Only the canonical kernel transition is allowed after the sync barrier.
    # If the call returns, record failure and restore the supervised runtime;
    # never issue an emergency reset as a routine power fallback.
    case "$action" in
        restart)
            /bin/busybox reboot -f >/dev/null 2>&1 || true
            ;;
        shutdown)
            /bin/busybox poweroff -f >/dev/null 2>&1 || true
            ;;
    esac

    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] && [ "$PRODUCT_MODE" = "usb" ]; then
        if ! owner_usb_restore_root_after_abort; then
            fail_closed "Owner USB kernel transition returned and writable root could not be restored"
        fi
        restore_runtime_after_power_failure "$action" "kernel $action transition returned without crossing a boot boundary" kernel-transition-returned
        return 1
    fi
    if remount_root_read_write_after_power_abort; then
        restore_runtime_after_power_failure "$action" "kernel $action transition returned without crossing a boot boundary" kernel-transition-returned
        return 1
    fi

    # Stable/root-sealed path: do not restart on an unverified writable root.
    while :; do /bin/busybox sleep 3600; done
}

wait_guardian_interval() {
    HOST_POWER_ACTION=""
    if IFS= read -r -t "$CHECK_INTERVAL" HOST_POWER_ACTION <&8; then
        case "$HOST_POWER_ACTION" in
            restart|shutdown) return 0 ;;
            *)
                log "rejected unknown host power action: $HOST_POWER_ACTION"
                HOST_POWER_ACTION=""
                ;;
        esac
    fi
    return 1
}

cleanup() {
    STOPPING=1
    stop_acpi_button_listener
    terminate_supervisor
    close_host_power_channel
    rm -f "$SUPERVISOR_PID_FILE" "$GUARDIAN_PID_FILE" >/dev/null 2>&1 || true
}

terminate() {
    trap - EXIT HUP INT TERM
    cleanup
    exit 0
}

fail_closed() {
    reason=$1
    log "$reason"
    terminate_supervisor
    stop_acpi_button_listener
    rm -f "$SUPERVISOR_PID_FILE" "$GUARDIAN_PID_FILE" >/dev/null 2>&1 || true
    close_host_power_channel
    if [ -x "$RECOVERY_ENTRYPOINT" ]; then
        trap - EXIT HUP INT TERM
        exec "$RECOVERY_ENTRYPOINT"
    fi
    exit 1
}

start_supervisor() {
    [ -f "$SUPERVISOR" ] || return 1
    /bin/sh -n "$SUPERVISOR" >>"$GUARDIAN_LOG" 2>&1 || return 1
    rm -f "$SUPERVISOR_HEARTBEAT_FILE"
    /bin/sh "$SUPERVISOR" >>"$GUARDIAN_LOG" 2>&1 &
    SUPERVISOR_PID=$!
    write_pid "$SUPERVISOR_PID_FILE" "$SUPERVISOR_PID"
    log "started supervisor pid $SUPERVISOR_PID"
    return 0
}

case "$PRODUCT_MODE" in
    usb|native-disk)
        ;;
    *)
        fail_closed "OrdaX product mode identity is missing or invalid"
        ;;
esac
ORDAX_PRODUCT_MODE=$PRODUCT_MODE
export ORDAX_PRODUCT_MODE

case "$DISTRIBUTION_PROFILE" in
    owner-development)
        ;;
    stable-mvp)
        case "$STABLE_LAYOUT" in
            legacy-tree)
                SOURCE_SHA_HINT=$(stable_current_release_sha) || fail_closed "Stable/MVP current release identity is missing or invalid"
                SYSTEM_ROOT=$STABLE_ROOT/current/system
                SYSTEM_ENTRYPOINT=$SYSTEM_ROOT/entrypoint
                SUPERVISOR=$SYSTEM_ROOT/supervisor
                ;;
            portable-v2)
                [ "$PRODUCT_MODE" = "usb" ] || fail_closed "portable-v2 Stable layout is USB-only"
                SOURCE_SHA_HINT=$(portable_stable_source_sha) || fail_closed "portable-v2 verified source identity or mounted system tree is invalid"
                ;;
            *)
                fail_closed "unknown Stable/MVP runtime layout"
                ;;
        esac
        ;;
    *)
        fail_closed "unknown OrdaX distribution profile"
        ;;
esac
ORDAX_DISTRIBUTION_PROFILE=$DISTRIBUTION_PROFILE
export ORDAX_DISTRIBUTION_PROFILE
ORDAX_STABLE_LAYOUT=$STABLE_LAYOUT
export ORDAX_STABLE_LAYOUT
if [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
    # Owner/Development runs from a USB worktree and can legitimately need most
    # of the existing 90-second Surface liveness window to render on cold or
    # guardian-refresh starts. Keep both health gates aligned unless explicitly
    # overridden by a bounded diagnostic/test environment.
    if [ -z "${ORDAX_SURFACE_HEALTH_TIMEOUT_SECONDS+x}" ]; then
        ORDAX_SURFACE_HEALTH_TIMEOUT_SECONDS=90
        export ORDAX_SURFACE_HEALTH_TIMEOUT_SECONDS
    fi
    if [ -z "${ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS+x}" ]; then
        ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS=90
        export ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS
    fi
fi

if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
    if [ -z "${ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS+x}" ]; then
        ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS=60
        export ORDAX_INITIAL_SURFACE_HEALTH_TIMEOUT_SECONDS
    fi
    ORDAX_SOURCE_SHA=$SOURCE_SHA_HINT
    export ORDAX_SOURCE_SHA
fi

trap cleanup EXIT
trap terminate HUP INT TERM

prepare_host_power_channel || fail_closed "host power request channel could not be initialized"
start_acpi_button_listener || log "physical ACPI button listener unavailable; checking base ACPI driver/applet"
write_pid "$GUARDIAN_PID_FILE" "$$"
log "guardian started pid=$$"
ensure_base_boot_id || fail_closed "boot session id could not be initialized"
write_base_update_heartbeat

consecutive_failures=0

while :; do
    start_supervisor || fail_closed "supervisor script is missing or invalid"

    started_at=$(epoch_now)
    stale_restart=0

    while is_pid "$SUPERVISOR_PID" && kill -0 "$SUPERVISOR_PID" >/dev/null 2>&1; do
        if wait_guardian_interval; then
            perform_host_power_transition "$HOST_POWER_ACTION" || true
            continue
        fi
        [ "$STOPPING" -eq 0 ] || exit 0

        now=$(epoch_now)
        heartbeat=$(state_epoch)
        case "$now:$heartbeat" in
            *[!0-9:]*|'0:'*|*:0) continue ;;
        esac

        age=$((now - heartbeat))
        if [ "$age" -gt "$STALE_SECONDS" ] 2>/dev/null; then
            log "supervisor heartbeat stale for ${age}s; restarting child"
            stale_restart=1
            terminate_supervisor
            break
        fi
    done

    supervisor_rc=0
    if [ "$stale_restart" -eq 0 ]; then
        wait "$SUPERVISOR_PID" 2>/dev/null || supervisor_rc=$?
    else
        supervisor_rc=124
    fi
    rm -f "$SUPERVISOR_PID_FILE" >/dev/null 2>&1 || true
    SUPERVISOR_PID=""

    if [ "$supervisor_rc" -eq 75 ]; then
        log "supervisor requested guardian refresh"
        if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
            case "$STABLE_LAYOUT" in
                legacy-tree)
                    SOURCE_SHA_HINT=$(stable_current_release_sha) || fail_closed "Stable/MVP current release identity could not be refreshed"
                    ORDAX_SOURCE_SHA=$SOURCE_SHA_HINT
                    export ORDAX_SOURCE_SHA
                    SYSTEM_ROOT=$STABLE_ROOT/current/system
                    SYSTEM_ENTRYPOINT=$SYSTEM_ROOT/entrypoint
                    SUPERVISOR=$SYSTEM_ROOT/supervisor
                    ;;
                portable-v2)
                    fail_closed "portable-v2 guardian refresh is blocked until transactional EROFS activation is connected"
                    ;;
                *)
                    fail_closed "unknown Stable/MVP runtime layout during guardian refresh"
                    ;;
            esac
        fi
        trap - EXIT HUP INT TERM
        exec "$SYSTEM_ENTRYPOINT"
    fi

    ended_at=$(epoch_now)
    runtime=0
    case "$started_at:$ended_at" in
        *[!0-9:]*|'0:'*|*:0) runtime=0 ;;
        *) runtime=$((ended_at - started_at)) ;;
    esac

    if [ "$runtime" -ge "$STABLE_SECONDS" ] 2>/dev/null; then
        consecutive_failures=0
    else
        consecutive_failures=$((consecutive_failures + 1))
    fi

    log "supervisor exited rc=$supervisor_rc runtime=${runtime}s failures=$consecutive_failures"

    if [ "$consecutive_failures" -ge "$CRASH_LIMIT" ] 2>/dev/null; then
        fail_closed "supervisor exceeded crash budget"
    fi

    /bin/busybox sleep 2
done