record_owner_poll_boot_stage() {
    [ "$DISTRIBUTION_PROFILE" = owner-development ] || return 0
    [ "$OWNER_POLL_BOOT_FINISHED" -eq 0 ] || return 0
    stage=$1
    case "$stage" in
        initialized|poll-loop-entered|first-run-pending|first-run-verified|git-remote-started|git-remote-failed|git-remote-completed) ;;
        *) return 0 ;;
    esac
    [ "$stage" != "$OWNER_POLL_BOOT_STAGE" ] || return 0
    witness_dir=${OWNER_POLL_BOOT_FILE%/*}
    [ -d "$witness_dir" ] && [ ! -L "$witness_dir" ] || return 0
    [ ! -L "$OWNER_POLL_BOOT_FILE" ] || return 0
    # Unique temporary per Supervisor process; different boot instances must
    # never write to the same diagnostic staging file.
    witness_tmp=$OWNER_POLL_BOOT_FILE.tmp.$$
    stamp=$(utc_now)
    if printf '{"schema":"ordax.owner-supervisor-first-poll/1","stage":"%s","observedAt":"%s"}\n' "$stage" "$stamp" >"$witness_tmp" &&
       /bin/busybox chmod 600 "$witness_tmp" &&
       /bin/busybox mv -f "$witness_tmp" "$OWNER_POLL_BOOT_FILE"
    then
        OWNER_POLL_BOOT_STAGE=$stage
        case "$stage" in git-remote-failed|git-remote-completed) OWNER_POLL_BOOT_FINISHED=1 ;; esac
    else
        /bin/busybox rm -f "$witness_tmp" >/dev/null 2>&1 || true
    fi
    return 0
}

