candidate_file_to_temp() {
    candidate_sha=$1
    candidate_path=$2
    destination=$3

    rm -f "$destination"
    if ! run_bounded_git "$FETCH_TIMEOUT" -C "$WORKTREE" show "$candidate_sha:$candidate_path" >"$destination" 2>>"$UPDATE_LOG"; then
        rm -f "$destination"
        return 1
    fi
    [ -s "$destination" ] || {
        rm -f "$destination"
        return 1
    }
    return 0
}

candidate_shell_is_valid() {
    candidate_sha=$1
    candidate_path=$2
    temporary=$UPDATE_RUN_DIR/candidate-shell.tmp

    candidate_file_to_temp "$candidate_sha" "$candidate_path" "$temporary" || return 1
    /bin/sh -n "$temporary" >>"$UPDATE_LOG" 2>&1 || {
        rm -f "$temporary"
        return 1
    }
    rm -f "$temporary"
    return 0
}

candidate_path_exists() {
    candidate_sha=$1
    candidate_path=$2
    run_bounded_git "$FETCH_TIMEOUT" -C "$WORKTREE" cat-file -e "$candidate_sha:$candidate_path" >>"$UPDATE_LOG" 2>&1
}

candidate_path_is_executable() {
    candidate_sha=$1
    candidate_path=$2
    tree_line=$(run_bounded_git "$FETCH_TIMEOUT" -C "$WORKTREE" ls-tree "$candidate_sha" -- "$candidate_path" 2>>"$UPDATE_LOG" || true)
    set -- $tree_line
    [ "${1:-}" = "100755" ]
}

validate_candidate_tree() {
    candidate_sha=$1
    candidate_mode=${2:-surface-restart}

    case "$candidate_mode" in
        none)
            return 0
            ;;
        reload)
            candidate_path_exists "$candidate_sha" system/composition/native/main.mjs || {
                log "candidate preflight missing system/composition/native/main.mjs"
                return 1
            }
            return 0
            ;;
        surface-restart|supervisor-restart)
            for path in \
                system/entrypoint \
                system/surface/entrypoint \
                system/surface/bin/ordax-surface
            do
                candidate_path_exists "$candidate_sha" "$path" || {
                    log "candidate preflight missing required path: $path"
                    return 1
                }
                candidate_path_is_executable "$candidate_sha" "$path" || {
                    log "candidate preflight requires executable mode: $path"
                    return 1
                }
                candidate_shell_is_valid "$candidate_sha" "$path" || {
                    log "candidate preflight shell syntax failed: $path"
                    return 1
                }
            done

            for path in \
                system/composition/native/main.mjs \
                system/surface/runtime/native_host_server.py
            do
                candidate_path_exists "$candidate_sha" "$path" || {
                    log "candidate preflight missing required path: $path"
                    return 1
                }
            done

            if [ "$candidate_mode" = supervisor-restart ]; then
                candidate_path_exists "$candidate_sha" system/supervisor || {
                    log "candidate preflight missing system/supervisor"
                    return 1
                }
                candidate_shell_is_valid "$candidate_sha" system/supervisor || {
                    log "candidate preflight shell syntax failed: system/supervisor"
                    return 1
                }
            fi
            return 0
            ;;
        *)
            log "candidate preflight received unknown apply mode: $candidate_mode"
            return 1
            ;;
    esac
}

staged_release_tree_is_valid() {
    staged_system=$1
    staged_mode=$2

    case "$staged_mode" in
        none)
            return 0
            ;;
        reload)
            [ -f "$staged_system/composition/native/main.mjs" ]
            ;;
        surface-restart)
            [ -x "$staged_system/entrypoint" ] || return 1
            [ -x "$staged_system/surface/entrypoint" ] || return 1
            [ -x "$staged_system/surface/bin/ordax-surface" ] || return 1
            [ -f "$staged_system/composition/native/main.mjs" ] || return 1
            [ -f "$staged_system/surface/runtime/native_host_server.py" ] || return 1
            /bin/sh -n "$staged_system/entrypoint" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$staged_system/surface/entrypoint" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$staged_system/surface/bin/ordax-surface" >>"$UPDATE_LOG" 2>&1
            ;;
        supervisor-restart)
            [ -x "$staged_system/entrypoint" ] || return 1
            [ -f "$staged_system/supervisor" ] || return 1
            [ -x "$staged_system/surface/entrypoint" ] || return 1
            [ -x "$staged_system/surface/bin/ordax-surface" ] || return 1
            [ -f "$staged_system/composition/native/main.mjs" ] || return 1
            [ -f "$staged_system/surface/runtime/native_host_server.py" ] || return 1
            /bin/sh -n "$staged_system/entrypoint" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$staged_system/supervisor" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$staged_system/surface/entrypoint" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$staged_system/surface/bin/ordax-surface" >>"$UPDATE_LOG" 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

stage_candidate_release() {
    candidate_sha=$1
    candidate_mode=$2

    if [ "$candidate_mode" = none ]; then
        write_state_value "$LAST_STAGE_DURATION_FILE" "0"
        return 0
    fi

    if [ "$candidate_mode" = reload ]; then
        write_state_value "$STAGED_RELEASE_FILE" "$candidate_sha"
        write_state_value "$LAST_STAGE_DURATION_FILE" "0"
        log "live-safe candidate staged in fetched Git objects: $candidate_sha"
        return 0
    fi

    stage_started=$(epoch_now)
    release_slot=$RELEASES_DIR/$candidate_sha
    if [ -f "$release_slot/.ready" ] && [ -d "$release_slot/system" ]; then
        write_state_value "$STAGED_RELEASE_FILE" "$candidate_sha"
        write_state_value "$LAST_STAGE_DURATION_FILE" "0"
        return 0
    fi

    stage_dir=$RELEASES_DIR/.staging-$candidate_sha-$(epoch_now)
    stage_archive=$UPDATE_RUN_DIR/release-$candidate_sha.tar
    rm -rf "$stage_dir"
    rm -f "$stage_archive"
    mkdir -p "$stage_dir"

    if ! run_bounded_git "$STAGE_TIMEOUT" -C "$WORKTREE" archive --format=tar "$candidate_sha" system >"$stage_archive" 2>>"$UPDATE_LOG"; then
        log "candidate release archive failed for $candidate_sha"
        rm -rf "$stage_dir"
        rm -f "$stage_archive"
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        return 1
    fi

    if ! /bin/busybox timeout -k 2 "$STAGE_TIMEOUT" /bin/busybox tar -xf "$stage_archive" -C "$stage_dir" >>"$UPDATE_LOG" 2>&1; then
        log "candidate release extraction failed for $candidate_sha"
        rm -rf "$stage_dir"
        rm -f "$stage_archive"
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        return 1
    fi
    rm -f "$stage_archive"

    if ! staged_release_tree_is_valid "$stage_dir/system" "$candidate_mode"; then
        log "staged candidate release validation failed for $candidate_sha"
        rm -rf "$stage_dir"
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        return 1
    fi

    printf '%s\n' "$candidate_sha" >"$stage_dir/.sha"
    printf 'ready\n' >"$stage_dir/.ready"
    rm -rf "$release_slot"
    if ! /bin/busybox mv "$stage_dir" "$release_slot"; then
        rm -rf "$stage_dir"
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        return 1
    fi
    write_state_value "$STAGED_RELEASE_FILE" "$candidate_sha"
    record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
    log "candidate release staged outside live checkout: $candidate_sha"
    return 0
}

refresh_dev_helpers() {
    source_sha=$1
    case "$source_sha" in
        ''|*[!0-9a-f]*) return 0 ;;
    esac
    [ "${#source_sha}" -eq 40 ] || return 0

    current_helper_sha=$(read_state_value "$DEV_HELPERS_SHA_FILE")
    [ "$current_helper_sha" = "$source_sha" ] && return 0

    helper=$WORKTREE/system/services/base-update/dev-helpers.sh
    source_probe=$WORKTREE/bootstrap/dev-base/ordax-pull
    if [ ! -f "$source_probe" ]; then
        if [ ! -x "$PULL_BIN" ] || ! ORDAX_EXPECTED_SHA="$source_sha" \
                ORDAX_REPO_URL="$REPO_URL" \
                ORDAX_REPO_BRANCH="$BRANCH" \
                ORDAX_WORKTREE="$WORKTREE" \
                ORDAX_STATE_DIR="$STATE_DIR" \
                "$PULL_BIN" >>"$UPDATE_LOG" 2>&1; then
            log "atomic checkout owner could not restore Git-owned development Base helper sources; will retry"
            return 0
        fi
    fi
    [ -f "$helper" ] || {
        log "development Base helper refresh owner is unavailable; will retry"
        return 0
    }

    if ORDAX_SOURCE_SHA="$source_sha" \
            ORDAX_WORKTREE="$WORKTREE" \
            ORDAX_STATE_DIR="$STATE_DIR" \
            /bin/sh "$helper" >>"$UPDATE_LOG" 2>&1; then
        log "development Base helper scripts refreshed from Git at $source_sha"
    else
        log "development Base helper refresh failed for $source_sha; running system remains unchanged"
    fi
    return 0
}

apply_remote_checkout() {
    checkout_previous_sha=$1
    checkout_target_sha=$2
    CHECKOUT_ERROR=""

    if [ ! -x "$PULL_BIN" ]; then
        CHECKOUT_ERROR=atomic-checkout-owner-unavailable
        log "atomic checkout owner is unavailable: $PULL_BIN"
        return 1
    fi

    fetch_started=$(epoch_now)
    # Capture stderr only in /run. Raw Git diagnostics can include URLs or
    # credentials: they must never be copied to persistent state.
    rm -f "$FETCH_ERROR_FILE"
    if run_bounded_git "$FETCH_TIMEOUT" -C "$WORKTREE" fetch --no-tags origin \
        "refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" >>"$UPDATE_LOG" 2>"$FETCH_ERROR_FILE"; then
        rm -f "$FETCH_ERROR_FILE" "$FETCH_RETRY_FILE"
    else
        fetch_rc=$?
        fetch_reason=$(classify_fetch_error "$FETCH_ERROR_FILE" "$fetch_rc")
        rm -f "$FETCH_ERROR_FILE"
        record_fetch_failure "$checkout_target_sha" "$fetch_started" "$fetch_rc" "$fetch_reason"
        CHECKOUT_ERROR=fetch-$fetch_reason-failed
        log "Git fetch failed or timed out after ${FETCH_TIMEOUT}s (category=$fetch_reason, exit=$fetch_rc); retry deferred"
        return 1
    fi

    checkout_fetched_sha=$("$GIT_BIN" -C "$WORKTREE" rev-parse "refs/remotes/origin/$BRANCH" 2>>"$UPDATE_LOG" || true)
    [ "$checkout_fetched_sha" = "$checkout_target_sha" ] || {
        CHECKOUT_ERROR=fetched-sha-mismatch
        log "fetched SHA mismatch: expected $checkout_target_sha, got ${checkout_fetched_sha:-unknown}"
        return 1
    }

    "$GIT_BIN" -C "$WORKTREE" merge-base --is-ancestor "$checkout_previous_sha" "$checkout_target_sha" >>"$UPDATE_LOG" 2>&1 || {
        CHECKOUT_ERROR=non-fast-forward
        record_non_ff_target "$checkout_previous_sha" "$checkout_target_sha"
        log "remote update is not a fast-forward from $checkout_previous_sha"
        return 1
    }

    classify_changes "$checkout_previous_sha" "$checkout_target_sha"
    set_update_context validating "$checkout_target_sha" "$UPDATE_ATTEMPT_ID" ""
    write_update_state "$checkout_previous_sha" updating "$APPLY_MODE"
    if ! validate_candidate_tree "$checkout_target_sha" "$APPLY_MODE"; then
        CHECKOUT_ERROR=candidate-preflight-failed
        log "candidate preflight failed before atomic checkout switch"
        return 1
    fi
    if ! stage_candidate_release "$checkout_target_sha" "$APPLY_MODE"; then
        CHECKOUT_ERROR=candidate-stage-failed
        log "candidate could not be staged outside the live checkout"
        return 1
    fi

    # Preserve the exact verified fetch identity across diagnostics/staging.
    # POSIX shell function variables are global; do not reuse generic SHA
    # parameter names as transaction ownership, or a nested state writer can
    # silently replace the target with the old checkout.
    if [ "$checkout_target_sha" != "$checkout_fetched_sha" ]; then
        CHECKOUT_ERROR=handoff-target-mutation
        log "Supervisor candidate identity changed before Pull handoff; checkout preserved"
        return 1
    fi

    # Invalidate the previous attempt token before invoking the single
    # canonical Pull owner. Without this the Supervisor can misattribute
    # stale error details after a killed or unavailable updater.
    rm -f "$PULL_RESULT_FILE"
    if ! ORDAX_EXPECTED_SHA="$checkout_target_sha" \
            ORDAX_REPO_URL="$REPO_URL" \
            ORDAX_REPO_BRANCH="$BRANCH" \
            ORDAX_WORKTREE="$WORKTREE" \
            ORDAX_STATE_DIR="$STATE_DIR" \
            "$PULL_BIN" >>"$UPDATE_LOG" 2>&1; then
        checkout_pull_phase=$(read_state_value "$PULL_RESULT_FILE")
        case "$checkout_pull_phase" in
            preflight|remote-discovery|handoff-validation|handoff-metadata-gitdir|handoff-metadata-head|handoff-metadata-origin|handoff-metadata-branch|handoff-metadata-entrypoint|handoff-metadata-unknown|handoff-ref-mismatch|handoff-commit-unavailable|remote-fetch|candidate-objects|isolated-checkout|remote-clone|atomic-switch|candidate-validation|state-commit|helper-refresh)
                CHECKOUT_ERROR="pull-$checkout_pull_phase-failed"
                ;;
            *)
                CHECKOUT_ERROR=atomic-checkout-failed
                ;;
        esac
        log "atomic checkout owner failed ($CHECKOUT_ERROR) for exact candidate $checkout_target_sha"
        return 1
    fi
    checkout_pull_result=$(read_state_value "$PULL_RESULT_FILE")
    if [ "$checkout_pull_result" = helpers-pending ]; then
        log "Git candidate activated, but Dev helpers still require canonical retry"
    fi

    checkout_activated_sha=$("$GIT_BIN" -C "$WORKTREE" rev-parse HEAD 2>>"$UPDATE_LOG" || true)
    [ "$checkout_activated_sha" = "$checkout_target_sha" ] || {
        CHECKOUT_ERROR=atomic-checkout-sha-mismatch
        log "atomic checkout activated unexpected SHA: expected $checkout_target_sha, got ${checkout_activated_sha:-unknown}"
        return 1
    }
    # The canonical ordax-pull installed helpers and wrote its receipt.
    # A second refresh in the Supervisor duplicates installation authority.
    return 0
}

/bin/busybox mkdir -p "$UPDATE_RUN_DIR" "$STATE_DIR" "$RELEASES_DIR" "$STATE_DIR/native-state"
chmod 700 "$UPDATE_RUN_DIR" "$RELEASES_DIR" "$STATE_DIR/native-state"
rm -f "$SUPERVISOR_POWER_QUIESCED_FILE" >/dev/null 2>&1 || true
: >"$UPDATE_LOG"

utc_now() {
    /bin/busybox date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown\n'
}

epoch_now() {
    /bin/busybox date +%s 2>/dev/null || printf '0\n'
}

read_state_value() {
    file=$1
    value=""
    if [ -s "$file" ]; then
        IFS= read -r value <"$file" || true
    fi
    printf '%s' "$value"
}

record_elapsed_seconds() {
    started_epoch=$1
    destination=$2
    ended_epoch=$(epoch_now)
    elapsed=0
    case "$started_epoch:$ended_epoch" in
        *[!0-9:]*|'0:'*|*:0) elapsed=0 ;;
        *)
            if [ "$ended_epoch" -ge "$started_epoch" ] 2>/dev/null; then
                elapsed=$((ended_epoch - started_epoch))
            fi
            ;;
    esac
    write_state_value "$destination" "$elapsed"
}

stable_current_release_sha() {
    current=$STABLE_ROOT/current
    [ -L "$current" ] || return 1
    target=$(/bin/busybox readlink "$current" 2>/dev/null || true)
    case "$target" in
        releases/*) value=${target#releases/} ;;
        *) return 1 ;;
    esac
    case "$value" in
        */*) return 1 ;;
    esac
    is_sha "$value" || return 1
    [ -d "$STABLE_ROOT/releases/$value" ] || return 1
    [ -x "$STABLE_ROOT/releases/$value/system/entrypoint" ] || return 1
    printf '%s\n' "$value"
}

portable_stable_source_sha() {
    [ "$PRODUCT_MODE" = "usb" ] || return 1
    is_sha "$SOURCE_SHA_HINT" || return 1
    [ -x "$SYSTEM_ENTRYPOINT" ] || return 1
    [ -f "$SUPERVISOR_SCRIPT" ] || return 1
    printf '%s\n' "$SOURCE_SHA_HINT"
}

stable_release_identity_sha() {
    case "$STABLE_LAYOUT" in
        legacy-tree)
            stable_current_release_sha
            ;;
        portable-v2)
            portable_stable_source_sha
            ;;
        *)
            return 1
            ;;
    esac
}

current_sha() {
    case "$DISTRIBUTION_PROFILE" in
        stable-mvp)
            stable_release_identity_sha 2>/dev/null || printf 'unknown\n'
            ;;
        owner-development)
            "$GIT_BIN" -C "$WORKTREE" rev-parse HEAD 2>/dev/null || printf 'unknown\n'
            ;;
        *)
            printf 'unknown\n'
            ;;
    esac
}

delivery_number_for_sha() {
    source_sha=$1

    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        printf '0'
        return 0
    fi

    if "$GIT_BIN" -C "$WORKTREE" merge-base --is-ancestor "$DELIVERY_EPOCH_SHA" "$source_sha" >/dev/null 2>&1; then
        delta=$("$GIT_BIN" -C "$WORKTREE" rev-list --first-parent --count "$DELIVERY_EPOCH_SHA..$source_sha" -- \
            system boot bootstrap \
            ':(exclude,glob)system/**/*.md' \
            ':(exclude,glob)boot/**/*.md' \
            ':(exclude,glob)bootstrap/**/*.md' \
            ':(exclude,glob)boot/**/prove_*' \
            ':(exclude,glob)bootstrap/**/prove_*' 2>/dev/null || true)
        case "$delta" in
            ''|*[!0-9]*) printf '0' ;;
            *) printf '%s' $((DELIVERY_EPOCH_NUMBER + delta)) ;;
        esac
        return 0
    fi

    # Historical fallback keeps delivery numbers that were already shown before
    # the device-impact scope was tightened at Entrega 220.
    value=$("$GIT_BIN" -C "$WORKTREE" rev-list --first-parent --count "$source_sha" -- \
        system boot bootstrap ':(exclude)system/*.md' 2>/dev/null || true)
    case "$value" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "$value" ;;
    esac
}

release_title_for_sha() {
    source_sha=$1
    title=$("$GIT_BIN" -C "$WORKTREE" show -s --format=%B "$source_sha" 2>/dev/null |
        /bin/busybox sed -n '3p' |
        /bin/busybox tr '\t\r\n' '   ' |
        /bin/busybox cut -c 1-160 || true)
    [ -n "$title" ] || title="Atualização OrdaX"
    printf '%s' "$title"
}

refresh_release_history() {
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        return 0
    fi
    temporary=$RELEASE_HISTORY_FILE.tmp.$$
    : >"$temporary"
    for release_sha in $("$GIT_BIN" -C "$WORKTREE" rev-list --first-parent --max-count="$RELEASE_HISTORY_MAX_ENTRIES" HEAD -- \
        system boot bootstrap \
        ':(exclude,glob)system/**/*.md' \
        ':(exclude,glob)boot/**/*.md' \
        ':(exclude,glob)bootstrap/**/*.md' \
        ':(exclude,glob)boot/**/prove_*' \
        ':(exclude,glob)bootstrap/**/prove_*' 2>/dev/null || true); do
        release_delivery=$(delivery_number_for_sha "$release_sha")
        [ "$release_delivery" -gt 0 ] 2>/dev/null || continue
        released_at=$("$GIT_BIN" -C "$WORKTREE" show -s --format=%cI "$release_sha" 2>/dev/null || true)
        [ -n "$released_at" ] || released_at=unknown
        release_title=$(release_title_for_sha "$release_sha")
        printf '%s\t%s\t%s\t%s\n' "$release_delivery" "$released_at" "$release_sha" "$release_title" >>"$temporary"
    done
    /bin/busybox mv -f "$temporary" "$RELEASE_HISTORY_FILE"
}

append_application_history() {
    source_sha=$1
    apply_mode=$2
    result=$3
    applied_at=$4
    delivery_number=$(delivery_number_for_sha "$source_sha")
    [ "$delivery_number" -gt 0 ] 2>/dev/null || return 0

    apply_duration=$(read_state_value "$LAST_APPLY_DURATION_FILE")
    stage_duration=$(read_state_value "$LAST_STAGE_DURATION_FILE")
    case "$apply_duration" in ''|*[!0-9]*) apply_duration=0 ;; esac
    case "$stage_duration" in ''|*[!0-9]*) stage_duration=0 ;; esac
    [ "$apply_duration" -le 3600 ] 2>/dev/null || apply_duration=0
    [ "$stage_duration" -le 3600 ] 2>/dev/null || stage_duration=0

    temporary=$UPDATE_HISTORY_FILE.tmp.$$
    if [ -f "$UPDATE_HISTORY_FILE" ]; then
        /bin/busybox cat "$UPDATE_HISTORY_FILE" >"$temporary"
    else
        : >"$temporary"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$delivery_number" "$applied_at" "$source_sha" "$apply_mode" "$result" "$apply_duration" "$stage_duration" >>"$temporary"
    /bin/busybox tail -n "$UPDATE_HISTORY_MAX_ENTRIES" "$temporary" >"$temporary.trimmed"
    /bin/busybox mv -f "$temporary.trimmed" "$UPDATE_HISTORY_FILE"
    rm -f "$temporary"
}

set_update_context() {
    UPDATE_PHASE=$1
    UPDATE_TARGET_SHA=${2:-}
    UPDATE_ATTEMPT_ID=${3:-}
    UPDATE_ERROR=${4:-}
}

clear_update_context() {
    UPDATE_PHASE=idle
    UPDATE_TARGET_SHA=""
    UPDATE_ATTEMPT_ID=""
    UPDATE_ERROR=""
}

derive_base_update_progress() {
    base_progress_target_sha=$1
    BASE_UPDATE_PHASE=none
    BASE_UPDATE_SHA=""

    [ -s "$BOOT_REFRESH_FILE" ] || return 0
    base_progress_pending_sha=$(read_state_value "$BOOT_REFRESH_FILE")
    [ -n "$base_progress_pending_sha" ] || return 0
    BASE_UPDATE_SHA=$base_progress_pending_sha

    if [ "$base_progress_pending_sha" != "$base_progress_target_sha" ]; then
        BASE_UPDATE_PHASE=waiting-candidate
        return 0
    fi

    base_progress_readiness_sha=$(read_state_value "$DEV_BASE_ACTIVATION_READINESS_SHA_FILE")
    if [ "$base_progress_readiness_sha" = "$base_progress_target_sha" ] && [ -s "$DEV_BASE_ACTIVATION_READINESS_FILE" ]; then
        BASE_UPDATE_PHASE=activation-ready
        return 0
    fi

    base_progress_staged_sha=$(read_state_value "$DEV_BASE_STAGED_FILE")
    if [ "$base_progress_staged_sha" = "$base_progress_target_sha" ] && [ -s "$DEV_BASE_STAGE_RESULT_FILE" ]; then
        BASE_UPDATE_PHASE=staged
        return 0
    fi

    base_progress_ready_sha=$(read_state_value "$DEV_BASE_READY_FILE")
    if [ "$base_progress_ready_sha" = "$base_progress_target_sha" ]; then
        BASE_UPDATE_PHASE=candidate-ready
        return 0
    fi

    base_progress_fetching_sha=$(read_state_value "$DEV_BASE_FETCHING_FILE")
    if [ "$base_progress_fetching_sha" = "$base_progress_target_sha" ]; then
        BASE_UPDATE_PHASE=candidate-fetching
        return 0
    fi

    base_progress_requested_sha=$(read_state_value "$DEV_BASE_REQUEST_FILE")
    if [ "$base_progress_requested_sha" = "$base_progress_target_sha" ]; then
        BASE_UPDATE_PHASE=candidate-requested
        return 0
    fi

    BASE_UPDATE_PHASE=waiting-candidate
}

write_update_state() {
    source_sha=$1
    status=$2
    apply_mode=$3
    boot_refresh=false
    [ -f "$BOOT_REFRESH_FILE" ] && boot_refresh=true
    checked_at=$(utc_now)
    last_applied_sha=$(read_state_value "$LAST_APPLIED_SHA_FILE")
    last_applied_at=$(read_state_value "$LAST_APPLIED_AT_FILE")
    runtime_surface_sha=$(read_state_value "$RUNTIME_SURFACE_SHA_FILE")
    rejected_sha=$(read_state_value "$REJECTED_FILE")
    staged_release_sha=$(read_state_value "$STAGED_RELEASE_FILE")
    last_apply_duration=$(read_state_value "$LAST_APPLY_DURATION_FILE")
    last_stage_duration=$(read_state_value "$LAST_STAGE_DURATION_FILE")
    derive_base_update_progress "$source_sha"
    [ -n "$last_applied_at" ] || last_applied_at=unknown
    [ -n "$runtime_surface_sha" ] || runtime_surface_sha=$source_sha
    case "$last_apply_duration" in ''|*[!0-9]*) last_apply_duration=0 ;; esac
    case "$last_stage_duration" in ''|*[!0-9]*) last_stage_duration=0 ;; esac
    delivery_number=$(delivery_number_for_sha "$source_sha")
    temporary=$UPDATE_STATE.tmp.$$
    printf '{"sourceSha":"%s","deliveryNumber":%s,"versionNumber":%s,"runtimeSurfaceSha":"%s","targetSha":"%s","status":"%s","phase":"%s","applyMode":"%s","attemptId":"%s","bootRefreshRequired":%s,"baseUpdatePhase":"%s","baseUpdateSha":"%s","checkedAt":"%s","lastAppliedSha":"%s","lastAppliedAt":"%s","stagedReleaseSha":"%s","lastApplyDurationSeconds":%s,"lastStageDurationSeconds":%s,"rejectedSha":"%s","lastError":"%s"}\n' \
        "$source_sha" "$delivery_number" "$delivery_number" "$runtime_surface_sha" "$UPDATE_TARGET_SHA" "$status" "$UPDATE_PHASE" "$apply_mode" "$UPDATE_ATTEMPT_ID" \
        "$boot_refresh" "$BASE_UPDATE_PHASE" "$BASE_UPDATE_SHA" "$checked_at" "$last_applied_sha" "$last_applied_at" "$staged_release_sha" "$last_apply_duration" "$last_stage_duration" "$rejected_sha" "$UPDATE_ERROR" >"$temporary"
    /bin/busybox mv -f "$temporary" "$UPDATE_STATE"
}

record_applied() {
    source_sha=$1
    apply_mode=$2
    attempt_started=$(read_state_value "$ATTEMPT_STARTED_EPOCH_FILE")
    if [ -n "$attempt_started" ]; then
        record_elapsed_seconds "$attempt_started" "$LAST_APPLY_DURATION_FILE"
        rm -f "$ATTEMPT_STARTED_EPOCH_FILE"
    fi
    temporary=$LAST_APPLIED_SHA_FILE.tmp.$$
    printf '%s\n' "$source_sha" >"$temporary"
    /bin/busybox mv -f "$temporary" "$LAST_APPLIED_SHA_FILE"
    temporary=$LAST_APPLIED_AT_FILE.tmp.$$
    utc_now >"$temporary"
    /bin/busybox mv -f "$temporary" "$LAST_APPLIED_AT_FILE"
    applied_at=$(read_state_value "$LAST_APPLIED_AT_FILE")
    refresh_release_history
    append_application_history "$source_sha" "$apply_mode" applied "$applied_at"
}

record_runtime_surface_sha() {
    source_sha=$1
    write_state_value "$RUNTIME_SURFACE_SHA_FILE" "$source_sha"
}

mark_boot_refresh_required() {
    source_sha=$1
    temporary=$BOOT_REFRESH_FILE.tmp.$$
    printf '%s\n' "$source_sha" >"$temporary"
    /bin/busybox mv -f "$temporary" "$BOOT_REFRESH_FILE"
}


dev_base_candidate_ready_for() {
    source_sha=$1
    [ -s "$DEV_BASE_READY_FILE" ] || return 1
    ready_sha=$(read_state_value "$DEV_BASE_READY_FILE")
    [ "$ready_sha" = "$source_sha" ]
}

request_dev_base_candidate() {
    source_sha=$1
    case "$source_sha" in
        ''|*[!0-9a-f]*) return 0 ;;
    esac
    [ "${#source_sha}" -eq 40 ] || return 0
    [ -f "$BOOT_REFRESH_FILE" ] || return 0
    dev_base_candidate_ready_for "$source_sha" && {
        [ ! -s "$DEV_BASE_REQUEST_FILE" ] || rm -f "$DEV_BASE_REQUEST_FILE"
        return 0
    }

    requested_sha=$(read_state_value "$DEV_BASE_REQUEST_FILE")
    [ "$requested_sha" = "$source_sha" ] && return 0

    write_state_value "$DEV_BASE_REQUEST_FILE" "$source_sha"
    log "development Base candidate requested from base-update owner: $source_sha"
}

start_surface_from_system() {
    surface_system_root=$1
    surface_source_sha=$2
    surface_entrypoint=$surface_system_root/surface/entrypoint

    is_sha "$surface_source_sha" || return 1
    [ -x "$surface_entrypoint" ] || return 1
    # Gate every start, including automatic recovery after an unexpected
    # launcher crash. A prior HTTP child may still own Native App Data.
    if ! native_host_quiesced; then
        log "refusing to start Surface while a previous Native host owns App Data"
        return 1
    fi

    ORDAX_SYSTEM_ROOT="$surface_system_root" \
    ORDAX_DISTRIBUTION_PROFILE="$DISTRIBUTION_PROFILE" \
    ORDAX_PRODUCT_MODE="$PRODUCT_MODE" \
    ORDAX_SOURCE_SHA="$surface_source_sha" \
        "$surface_entrypoint" &
    SURFACE_PID=$!
    SURFACE_STARTED_AT=$(epoch_now)
    log "Surface $surface_source_sha started as pid $SURFACE_PID"
}

start_surface() {
    start_surface_from_system "$SYSTEM_ROOT" "$(current_sha)"
}

# Surface owns the Native HTTP process until the Supervisor/mount cutover.
# After a launcher crash or SIGKILL, its child may survive as an orphan.
# Check the SAME kernel lock used by native_app_data_runtime.py: a dead
# launcher PID is not evidence that the Native capability issuer has stopped.
# This is only a host-liveness fence; it is NOT per-app quiescence or a
# stateful activation/rollback authorization.
native_host_quiesced() {
    native_lock=/run/ordax-surface/native-host-instance.lock
    [ ! -L "$native_lock" ] || return 1
    [ -e "$native_lock" ] || return 0
    [ -f "$native_lock" ] || return 1

    attempts=5
    while [ "$attempts" -gt 0 ]; do
        # BusyBox flock is part of the verified portable Base. Contention,
        # absence of the applet, or a lock error all fail closed.
        if /bin/busybox flock -n "$native_lock" /bin/true >/dev/null 2>&1; then
            return 0
        fi
        attempts=$((attempts - 1))
        [ "$attempts" -eq 0 ] || /bin/busybox sleep 1
    done
    return 1
}

stop_surface() {
    if [ -n "$SURFACE_PID" ]; then
        if kill -0 "$SURFACE_PID" >/dev/null 2>&1; then
            kill "$SURFACE_PID" >/dev/null 2>&1 || true
            # Surface stops its brokers together under 4s, then proves no
            # native-root process remains (up to 5s) before mount teardown.
            # Give the owner enough time for that bounded sequence.
            remaining=14
            while kill -0 "$SURFACE_PID" >/dev/null 2>&1 && [ "$remaining" -gt 0 ]; do
                /bin/busybox sleep 1
                remaining=$((remaining - 1))
            done
            if kill -0 "$SURFACE_PID" >/dev/null 2>&1; then
                log "Surface did not stop gracefully; forcing pid $SURFACE_PID"
                kill -KILL "$SURFACE_PID" >/dev/null 2>&1 || true
            fi
        fi
        wait "$SURFACE_PID" 2>/dev/null || true
        SURFACE_PID=""
    fi
    # Do not apply another release, probe health, or restart graphics while
    # an orphaned Native host can still issue App Data capabilities.
    if ! native_host_quiesced; then
        log "Native host still owns the live App Data authority after Surface stop; refusing transition"
        trap - EXIT HUP INT TERM
        exit 1
    fi
}

surface_stays_running() {
    seconds=${1:-4}
    while [ "$seconds" -gt 0 ]; do
        supervisor_heartbeat || return 1
        [ -n "$SURFACE_PID" ] && kill -0 "$SURFACE_PID" >/dev/null 2>&1 || return 1
        /bin/busybox sleep 1
        seconds=$((seconds - 1))
    done
    return 0
}

surface_heartbeat_sha() {
    [ -s "$SURFACE_HEARTBEAT_FILE" ] || return 0
    /bin/busybox sed -n 's/.*"sourceSha":"\([0-9a-f]*\)".*/\1/p' "$SURFACE_HEARTBEAT_FILE" 2>/dev/null | /bin/busybox head -n 1
}

surface_heartbeat_epoch() {
    [ -f "$SURFACE_HEARTBEAT_FILE" ] || {
        printf '0\n'
        return 0
    }
    /bin/busybox stat -c %Y "$SURFACE_HEARTBEAT_FILE" 2>/dev/null || printf '0\n'
}

surface_heartbeat_is_fresh() {
    expected_sha=$(read_state_value "$RUNTIME_SURFACE_SHA_FILE")
    [ -n "$expected_sha" ] || expected_sha=$(current_sha)
    rendered_sha=$(surface_heartbeat_sha)
    [ "$rendered_sha" = "$expected_sha" ] || return 1

    now=$(epoch_now)
    heartbeat=$(surface_heartbeat_epoch)
    case "$now:$heartbeat" in
        *[!0-9:]*|'0:'*|*:0) return 1 ;;
    esac
    age=$((now - heartbeat))
    [ "$age" -ge 0 ] 2>/dev/null || return 1
    [ "$age" -le "$SURFACE_STALE_SECONDS" ] 2>/dev/null
}

surface_start_grace_active() {
    now=$(epoch_now)
    case "$now:$SURFACE_STARTED_AT" in
        *[!0-9:]*|'0:'*|*:0) return 1 ;;
    esac
    age=$((now - SURFACE_STARTED_AT))
    [ "$age" -ge 0 ] 2>/dev/null || return 1
    [ "$age" -le "$SURFACE_STALE_SECONDS" ] 2>/dev/null
}

recover_stale_surface_if_needed() {
    [ -n "$SURFACE_PID" ] && kill -0 "$SURFACE_PID" >/dev/null 2>&1 || return 0

    if surface_heartbeat_is_fresh; then
        SURFACE_STALE_RECOVERY_ARMED=1
        return 0
    fi

    surface_start_grace_active && return 0
    [ "$SURFACE_STALE_RECOVERY_ARMED" -eq 1 ] || return 0

    SURFACE_STALE_RECOVERY_ARMED=0
    expected_sha=$(read_state_value "$RUNTIME_SURFACE_SHA_FILE")
    [ -n "$expected_sha" ] || expected_sha=$(current_sha)
    log "Surface heartbeat stale or mismatched for runtime $expected_sha; restarting Surface once"
    clear_surface_health
    stop_surface
    start_surface || fail_closed "Surface heartbeat recovery restart failed"
    if ! surface_stays_running 4 || ! wait_for_surface_health "$expected_sha" "$SURFACE_HEALTH_TIMEOUT"; then
        fail_closed "Surface heartbeat recovery restart did not acknowledge healthy state"
    fi
    SURFACE_STALE_RECOVERY_ARMED=1
    log "Surface heartbeat recovery restart acknowledged healthy state"
}

clear_surface_health() {
    rm -f "$HEALTH_FILE" "$SURFACE_HEARTBEAT_FILE"
}

write_surface_health_state() {
    state=$1
    expected_sha=$2
    case "$state" in starting|provisioning|waiting-health|healthy|failed) ;; *) return 1 ;; esac
    temporary=$SURFACE_HEALTH_STATE_FILE.tmp.$$
    printf '%s|%s\n' "$state" "$expected_sha" >"$temporary" || return 1
    /bin/busybox mv -f "$temporary" "$SURFACE_HEALTH_STATE_FILE"
}

surface_health_matches() {
    expected_sha=$1
    healthy_sha=$(read_state_value "$HEALTH_FILE")
    rendered_sha=$(surface_heartbeat_sha)
    [ "$healthy_sha" = "$expected_sha" ] && [ "$rendered_sha" = "$expected_sha" ]
}

wait_for_surface_health() {
    expected_sha=$1
    seconds=${2:-12}
    while [ "$seconds" -gt 0 ]; do
        supervisor_heartbeat || return 1
        if [ -n "$SURFACE_PID" ] && ! kill -0 "$SURFACE_PID" >/dev/null 2>&1; then
            return 1
        fi
        if surface_health_matches "$expected_sha"; then
            return 0
        fi
        /bin/busybox sleep 1
        seconds=$((seconds - 1))
    done
    surface_health_matches "$expected_sha"
}

owner_monotonic_seconds() {
    [ -r /proc/uptime ] || return 1
    IFS= read -r owner_uptime </proc/uptime || return 1
    owner_seconds=${owner_uptime%%.*}
    case "$owner_seconds" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$owner_seconds"
}

begin_owner_initial_surface_health() {
    owner_now=$(owner_monotonic_seconds) || fail_closed "monotonic first-boot clock unavailable"
    OWNER_INITIAL_NORMAL_SINCE=$owner_now
    OWNER_INITIAL_PROVISION_SINCE=0
    OWNER_INITIAL_PROVISION_PHASE=0
    OWNER_INITIAL_HEALTH_STATE=starting
    OWNER_INITIAL_HEALTH_PENDING=1
    write_surface_health_state starting "$initial_sha" || true
}

owner_initial_surface_health_failed() {
    write_surface_health_state failed "$initial_sha" || true
    if rollback_boot_candidate "$boot_runtime_sha" "$initial_sha" "cold-boot Surface did not become healthy"; then
        exit 75
    fi
    if [ "$OWNER_INITIAL_HEALTH_RETRIES" -ge 1 ]; then
        fail_closed "cold-boot Surface failed health after one retry"
    fi
    OWNER_INITIAL_HEALTH_RETRIES=1
    log "cold-boot Surface did not become healthy; retrying current checkout once"
    clear_surface_health
    stop_surface
    start_surface || fail_closed "cold-boot Surface retry could not be started"
    begin_owner_initial_surface_health
}

check_owner_initial_surface_health() {
    [ "$OWNER_INITIAL_HEALTH_PENDING" -eq 1 ] || return 0
    supervisor_heartbeat || fail_closed "supervisor liveness checkpoint could not be published"
    [ -n "$SURFACE_PID" ] && kill -0 "$SURFACE_PID" >/dev/null 2>&1 || {
        owner_initial_surface_health_failed
        return 0
    }
    if surface_health_matches "$initial_sha"; then
        write_surface_health_state healthy "$initial_sha" || true
        OWNER_INITIAL_HEALTH_PENDING=0
        record_runtime_surface_sha "$initial_sha"
        clear_update_context
        write_update_state "$initial_sha" running initial
        log "cold-boot Surface acknowledged healthy state; automatic Git activation unblocked"
        return 0
    fi
    owner_now=$(owner_monotonic_seconds) || fail_closed "monotonic first-boot clock unavailable"
    marker_source=""
    if [ -r "$SURFACE_RUNTIME_PROVISION_MARKER" ]; then
        IFS= read -r marker_source <"$SURFACE_RUNTIME_PROVISION_MARKER" || true
    fi
    if [ "$marker_source" = "$initial_sha" ]; then
        if [ "$OWNER_INITIAL_PROVISION_PHASE" -eq 0 ]; then
            OWNER_INITIAL_PROVISION_PHASE=1
            OWNER_INITIAL_PROVISION_SINCE=$owner_now
        fi
        if [ "$OWNER_INITIAL_HEALTH_STATE" != provisioning ]; then
            OWNER_INITIAL_HEALTH_STATE=provisioning
            write_surface_health_state provisioning "$initial_sha" || true
            log "Surface health state=provisioning for $initial_sha (budget ${OWNER_PROVISION_TIMEOUT}s)"
        fi
        if [ $((owner_now - OWNER_INITIAL_PROVISION_SINCE)) -gt "$OWNER_PROVISION_TIMEOUT" ]; then
            log "first-boot runtime provisioning exceeded bounded budget"
            owner_initial_surface_health_failed
        fi
    else
        if [ "$OWNER_INITIAL_PROVISION_PHASE" -eq 1 ]; then
            OWNER_INITIAL_PROVISION_PHASE=2
            OWNER_INITIAL_NORMAL_SINCE=$owner_now
        fi
        if [ "$OWNER_INITIAL_HEALTH_STATE" != waiting-health ]; then
            OWNER_INITIAL_HEALTH_STATE=waiting-health
            write_surface_health_state waiting-health "$initial_sha" || true
            log "Surface health state=waiting-health for $initial_sha (budget ${INITIAL_SURFACE_HEALTH_TIMEOUT}s)"
        fi
        if [ $((owner_now - OWNER_INITIAL_NORMAL_SINCE)) -gt "$INITIAL_SURFACE_HEALTH_TIMEOUT" ]; then
            owner_initial_surface_health_failed
        fi
    fi
    return 0
}

recover_reload_with_surface_restart() {
    expected_sha=$1
    log "live reload health acknowledgement timed out; restarting Surface once on $expected_sha"
    clear_surface_health
    stop_surface
    start_surface || return 1
    wait_for_surface_health "$expected_sha" "$RELOAD_FALLBACK_HEALTH_TIMEOUT"
}

terminate() {
    trap - EXIT HUP INT TERM
    cancel_active_git
    stop_surface
    temporary=$SUPERVISOR_POWER_QUIESCED_FILE.tmp.$
    printf '%s\n' "$$" >"$temporary" || exit 1
    chmod 600 "$temporary" || exit 1
    /bin/busybox mv -f "$temporary" "$SUPERVISOR_POWER_QUIESCED_FILE" || exit 1
    exit 0
}

fail_closed() {
    log "$*"
    stop_surface
    if [ -x "$RECOVERY_ENTRYPOINT" ]; then
        trap - EXIT HUP INT TERM
        exec "$RECOVERY_ENTRYPOINT"
    fi
    log "recovery entrypoint unavailable"
    exit 1
}

validate_updated_tree() {
    validation_mode=${1:-surface-restart}

    case "$validation_mode" in
        none)
            return 0
            ;;
        reload)
            [ -f "$SYSTEM_ROOT/composition/native/main.mjs" ] || return 1
            return 0
            ;;
        surface-restart)
            [ -x "$SYSTEM_ENTRYPOINT" ] || return 1
            [ -x "$SURFACE_ENTRYPOINT" ] || return 1
            [ -x "$SYSTEM_ROOT/surface/bin/ordax-surface" ] || return 1
            [ -f "$SYSTEM_ROOT/composition/native/main.mjs" ] || return 1
            [ -f "$SYSTEM_ROOT/surface/runtime/native_host_server.py" ] || return 1
            /bin/sh -n "$SYSTEM_ENTRYPOINT" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$SURFACE_ENTRYPOINT" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$SYSTEM_ROOT/surface/bin/ordax-surface" >>"$UPDATE_LOG" 2>&1 || return 1
            return 0
            ;;
        supervisor-restart)
            [ -x "$SYSTEM_ENTRYPOINT" ] || return 1
            [ -f "$SUPERVISOR_SCRIPT" ] || return 1
            [ -x "$SURFACE_ENTRYPOINT" ] || return 1
            [ -x "$SYSTEM_ROOT/surface/bin/ordax-surface" ] || return 1
            [ -f "$SYSTEM_ROOT/composition/native/main.mjs" ] || return 1
            [ -f "$SYSTEM_ROOT/surface/runtime/native_host_server.py" ] || return 1
            /bin/sh -n "$SYSTEM_ENTRYPOINT" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$SUPERVISOR_SCRIPT" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$SURFACE_ENTRYPOINT" >>"$UPDATE_LOG" 2>&1 || return 1
            /bin/sh -n "$SYSTEM_ROOT/surface/bin/ordax-surface" >>"$UPDATE_LOG" 2>&1 || return 1
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

rollback_boot_candidate() {
    previous_sha=$1
    failed_sha=$2
    reason=$3

    [ "$DISTRIBUTION_PROFILE" = "owner-development" ] || return 1

    [ "${#previous_sha}" -eq 40 ] 2>/dev/null || return 1
    [ "${#failed_sha}" -eq 40 ] 2>/dev/null || return 1
    case "$previous_sha$failed_sha" in
        *[!0-9a-f]*) return 1 ;;
    esac
    [ "$previous_sha" != "$failed_sha" ] || return 1
    validate_candidate_tree "$previous_sha" supervisor-restart || {
        log "last runtime Surface SHA $previous_sha is not a valid rollback tree"
        return 1
    }

    set_update_context rollback "$failed_sha" "" "$reason"
    write_update_state "$failed_sha" applied supervisor-restart
    append_application_history "$failed_sha" supervisor-restart rolled-back "$(utc_now)"
    log "cold-boot Surface candidate $failed_sha failed health; rolling back to last rendered runtime $previous_sha"

    temporary=$REJECTED_FILE.tmp.$$
    printf '%s\n' "$failed_sha" >"$temporary"
    /bin/busybox mv -f "$temporary" "$REJECTED_FILE"
    clear_surface_health
    stop_surface

    if ! "$GIT_BIN" -C "$WORKTREE" reset --hard "$previous_sha" >>"$UPDATE_LOG" 2>&1; then
        log "cold-boot rollback reset to $previous_sha failed"
        return 1
    fi

    record_runtime_surface_sha "$previous_sha"
    write_update_state "$previous_sha" rolled-back supervisor-restart
    log "cold-boot rollback restored $previous_sha; guardian refresh required"
    return 0
}

rollback_update() {
    previous_sha=$1
    failed_sha=$2
    failed_mode=$3
    reason=$4
    set_update_context rollback "$failed_sha" "$UPDATE_ATTEMPT_ID" "$reason"
    write_update_state "$failed_sha" applied "$failed_mode"
    attempt_started=$(read_state_value "$ATTEMPT_STARTED_EPOCH_FILE")
    if [ -n "$attempt_started" ]; then
        record_elapsed_seconds "$attempt_started" "$LAST_APPLY_DURATION_FILE"
        rm -f "$ATTEMPT_STARTED_EPOCH_FILE"
    fi
    append_application_history "$failed_sha" "$failed_mode" rolled-back "$(utc_now)"
    log "rejecting update $failed_sha: $reason; rolling back to $previous_sha"
    temporary=$REJECTED_FILE.tmp.$$
    printf '%s\n' "$failed_sha" >"$temporary"
    /bin/busybox mv -f "$temporary" "$REJECTED_FILE"
    clear_surface_health
    stop_surface
    if ! "$GIT_BIN" -C "$WORKTREE" reset --hard "$previous_sha" >>"$UPDATE_LOG" 2>&1; then
        fail_closed "automatic rollback to $previous_sha failed"
    fi
    start_surface || fail_closed "rolled-back Surface could not be started"
    surface_stays_running 4 || fail_closed "rolled-back Surface did not stay running"
    record_runtime_surface_sha "$previous_sha"
    write_update_state "$previous_sha" rolled-back "$failed_mode"
}

classify_changes() {
    old_sha=$1
    new_sha=$2
    APPLY_MODE=none
    LOW_LEVEL_CHANGED=0
    DEV_HELPERS_CHANGED=0
    supervisor_changed=0
    surface_host_changed=0
    live_surface_changed=0

    if ! changed_paths=$("$GIT_BIN" -C "$WORKTREE" diff --name-only "$old_sha" "$new_sha" 2>>"$UPDATE_LOG"); then
        APPLY_MODE=surface-restart
        return 0
    fi

    helper_manifest=$UPDATE_RUN_DIR/dev-helper-classification.$$.tsv
    helper_manifest_ready=0
    if "$GIT_BIN" -C "$WORKTREE" show "$new_sha:system/services/base-update/dev-helper-manifest.tsv" >"$helper_manifest" 2>>"$UPDATE_LOG"; then
        helper_manifest_ready=1
    else
        rm -f "$helper_manifest"
    fi

    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if [ "$path" = "system/services/base-update/dev-helper-manifest.tsv" ] || \
           [ "$path" = "system/services/base-update/dev-helpers.sh" ]; then
            DEV_HELPERS_CHANGED=1
            continue
        fi
        if [ "$helper_manifest_ready" -eq 1 ] && \
           /bin/busybox awk -F "$(printf '\t')" -v candidate="$path" '
               $1 == candidate { found = 1 }
               END { exit(found ? 0 : 1) }
           ' "$helper_manifest"; then
            DEV_HELPERS_CHANGED=1
            continue
        fi
        case "$path" in
            system/*.md|boot/*.md|bootstrap/*.md|boot/*/prove_*|bootstrap/*/prove_*)
                ;;
            boot/*|bootstrap/*)
                LOW_LEVEL_CHANGED=1
                ;;
            system/entrypoint|system/supervisor)
                supervisor_changed=1
                ;;
            system/surface/bin/*|system/surface/runtime/*|system/surface/entrypoint|system/services/telemetry/base-agent.sh|system/services/telemetry/relay.json|system/services/base-update/agent.sh)
                surface_host_changed=1
                ;;
            system/apps/*|system/adapters/*|system/contracts/*|system/services/*|system/composition/*|system/surface/ui/*)
                live_surface_changed=1
                ;;
            system/*)
                surface_host_changed=1
                ;;
        esac
    done <<EOF
$changed_paths
EOF
    rm -f "$helper_manifest"

    if [ "$supervisor_changed" -eq 1 ]; then
        APPLY_MODE=supervisor-restart
    elif [ "$surface_host_changed" -eq 1 ]; then
        APPLY_MODE=surface-restart
    elif [ "$live_surface_changed" -eq 1 ]; then
        APPLY_MODE=reload
    fi
}

stable_channel_url() {
    [ -f "$STABLE_CHANNEL_FILE" ] || return 1
    [ ! -L "$STABLE_CHANNEL_FILE" ] || return 1

    line_count=$(/bin/busybox awk 'END { print NR }' "$STABLE_CHANNEL_FILE" 2>/dev/null || true)
    [ "$line_count" = "1" ] || return 1

    url=""
    IFS= read -r url <"$STABLE_CHANNEL_FILE" || [ -n "$url" ] || return 1
    case "$url" in
        https://*) ;;
        *) return 1 ;;
    esac
    case "$url" in
        *[[:space:]]*) return 1 ;;
    esac
    printf '%s' "$url"
}

stable_receipt_string() {
    receipt=$1
    key=$2
    /bin/busybox awk -F'"' -v key="$key" '
        $2 == key {
            value = $4
            count += 1
        }
        END {
            if (count != 1 || value == "") {
                exit 1
            }
            print value
        }
    ' "$receipt" 2>/dev/null
}

stable_release_tree_is_valid() {
    source_sha=$1
    is_sha "$source_sha" || return 1
    system_root=$STABLE_ROOT/releases/$source_sha/system
    [ -d "$system_root" ] || return 1
    staged_release_tree_is_valid "$system_root" supervisor-restart
}

write_stable_activation_guard() {
    previous_sha=$1
    candidate_sha=$2
    attempt_id=$3
    is_sha "$previous_sha" || return 1
    is_sha "$candidate_sha" || return 1
    [ "$previous_sha" != "$candidate_sha" ] || return 1
    [ -n "$attempt_id" ] || return 1

    temporary=$STABLE_ACTIVATION_GUARD_FILE.tmp.$$
    printf '%s %s %s\n' "$previous_sha" "$candidate_sha" "$attempt_id" >"$temporary"
    chmod 600 "$temporary"
    /bin/busybox mv -f "$temporary" "$STABLE_ACTIVATION_GUARD_FILE"
    /bin/busybox sync
}

stable_activate_exact_to() {
    expected_sha=$1
    receipt=$2

    is_sha "$expected_sha" || return 1
    rm -f "$receipt"
    /bin/busybox timeout -k 5 "$STABLE_ACTIVATION_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" activate-exact \
        --trust "$STABLE_TRUST_FILE" \
        --root "$STABLE_ROOT" \
        --repository ordaxsystems/ordax-os \
        --expected-commit "$expected_sha" \
        >"$receipt" 2>>"$UPDATE_LOG"
}

activate_health_ready_stable_release() {
    previous_sha=$1
    candidate_sha=$2

    is_sha "$previous_sha" || return 1
    is_sha "$candidate_sha" || return 1
    [ "$previous_sha" != "$candidate_sha" ] || return 1

    staged_sha=$(read_state_value "$STAGED_RELEASE_FILE")
    ready_sha=$(read_state_value "$STABLE_HEALTH_READY_FILE")
    rejected_sha=$(read_state_value "$STABLE_HEALTH_REJECTED_FILE")
    [ "$staged_sha" = "$candidate_sha" ] || return 1
    [ "$ready_sha" = "$candidate_sha" ] || return 1
    [ "$rejected_sha" != "$candidate_sha" ] || return 1
    stable_release_tree_is_valid "$candidate_sha" || return 1
    [ "$(stable_current_release_sha 2>/dev/null || true)" = "$previous_sha" ] || return 1

    attempt_id=$(utc_now)
    write_stable_activation_guard "$previous_sha" "$candidate_sha" "$attempt_id" || {
        set_update_context error "$candidate_sha" "$attempt_id" "stable-release-activation-guard-failed"
        write_update_state "$previous_sha" activation-error signed-release
        return 1
    }

    set_update_context activating "$candidate_sha" "$attempt_id" ""
    write_update_state "$previous_sha" activating signed-release
    log "activating exact health-ready Stable/MVP release: $previous_sha -> $candidate_sha"

    activation_ok=0
    if stable_activate_exact_to "$candidate_sha" "$STABLE_ACTIVATION_RECEIPT"; then
        activation_ok=1
    fi

    active_sha=$(stable_current_release_sha 2>/dev/null || true)
    if [ "$active_sha" = "$previous_sha" ]; then
        rm -f "$STABLE_ACTIVATION_RECEIPT" "$STABLE_ACTIVATION_GUARD_FILE"
        /bin/busybox sync
        set_update_context error "$candidate_sha" "$attempt_id" "stable-release-activation-failed-before-swap"
        write_update_state "$previous_sha" activation-error signed-release
        log "exact Stable activation failed before current changed; known-good remains active"
        return 1
    fi

    if [ "$active_sha" != "$candidate_sha" ]; then
        fail_closed "Stable activation left current in an unexpected state"
    fi

    if [ "$activation_ok" -eq 1 ]; then
        activation_status=$(stable_receipt_string "$STABLE_ACTIVATION_RECEIPT" status || true)
        activation_sha=$(stable_receipt_string "$STABLE_ACTIVATION_RECEIPT" source_commit || true)
        activation_previous=$(stable_receipt_string "$STABLE_ACTIVATION_RECEIPT" previous_commit || true)
        if [ "$activation_status" != "activated-exact" ] ||
           [ "$activation_sha" != "$candidate_sha" ] ||
           [ "$activation_previous" != "$previous_sha" ]
        then
            log "Stable activation receipt was inconsistent after exact current swap; transaction guard will arbitrate cold health"
        fi
    else
        log "Stable activation command ended ambiguously after current swap; transaction guard will arbitrate cold health"
    fi
    rm -f "$STABLE_ACTIVATION_RECEIPT"

    set_update_context restart-required "$candidate_sha" "$attempt_id" ""
    write_update_state "$candidate_sha" activated signed-release
    clear_surface_health
    stop_surface
    record_runtime_surface_sha "$candidate_sha"
    log "Stable current now points to $candidate_sha; requesting guardian refresh for cold health"
    trap - EXIT HUP INT TERM
    exit 75
}

rollback_stable_activation() {
    previous_sha=$1
    failed_sha=$2
    attempt_id=$3

    is_sha "$previous_sha" || return 1
    is_sha "$failed_sha" || return 1
    [ "$previous_sha" != "$failed_sha" ] || return 1
    [ "$(stable_current_release_sha 2>/dev/null || true)" = "$failed_sha" ] || return 1

    set_update_context rollback "$failed_sha" "$attempt_id" "stable-release-cold-health-failed"
    write_update_state "$failed_sha" rolling-back signed-release
    rm -f "$STABLE_ROLLBACK_RECEIPT"

    if ! stable_activate_exact_to "$previous_sha" "$STABLE_ROLLBACK_RECEIPT"; then
        fail_closed "Stable rollback could not restore the previous signed release"
    fi

    rollback_status=$(stable_receipt_string "$STABLE_ROLLBACK_RECEIPT" status || true)
    rollback_sha=$(stable_receipt_string "$STABLE_ROLLBACK_RECEIPT" source_commit || true)
    rollback_previous=$(stable_receipt_string "$STABLE_ROLLBACK_RECEIPT" previous_commit || true)
    rm -f "$STABLE_ROLLBACK_RECEIPT"
    if [ "$rollback_status" != "activated-exact" ] ||
       [ "$rollback_sha" != "$previous_sha" ] ||
       [ "$rollback_previous" != "$failed_sha" ] ||
       [ "$(stable_current_release_sha 2>/dev/null || true)" != "$previous_sha" ]
    then
        fail_closed "Stable rollback receipt or current pointer is inconsistent"
    fi

    write_state_value "$STABLE_HEALTH_REJECTED_FILE" "$failed_sha"
    rm -f "$STABLE_HEALTH_READY_FILE" "$STABLE_ACTIVATION_GUARD_FILE"
    /bin/busybox sync
    write_update_state "$previous_sha" rolled-back signed-release
    log "Stable/MVP cold health failed for $failed_sha; exact known-good $previous_sha restored"
    trap - EXIT HUP INT TERM
    exit 75
}

handle_stable_activation_guard() {
    initial_sha_value=$1
    [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] || return 1
    [ -s "$STABLE_ACTIVATION_GUARD_FILE" ] || return 1
    is_sha "$initial_sha_value" || fail_closed "Stable activation guard saw invalid current release identity"

    guard_line=$(read_state_value "$STABLE_ACTIVATION_GUARD_FILE")
    set -- $guard_line
    guard_previous=${1:-}
    guard_candidate=${2:-}
    guard_attempt=${3:-}
    guard_extra=${4:-}
    if ! is_sha "$guard_previous" ||
       ! is_sha "$guard_candidate" ||
       [ "$guard_previous" = "$guard_candidate" ] ||
       [ -z "$guard_attempt" ] ||
       [ -n "$guard_extra" ]
    then
        fail_closed "Stable activation guard is malformed"
    fi

    if [ "$initial_sha_value" = "$guard_previous" ]; then
        set_update_context health-wait "$guard_previous" "$guard_attempt" "activation-interrupted-before-swap"
        write_update_state "$guard_previous" validating signed-release
        if ! surface_stays_running 4 || ! wait_for_surface_health "$guard_previous" "$SURFACE_HEALTH_TIMEOUT"; then
            fail_closed "Stable known-good did not recover after interrupted activation"
        fi
        rm -f "$STABLE_ACTIVATION_GUARD_FILE"
        /bin/busybox sync
        record_runtime_surface_sha "$guard_previous"
        clear_update_context
        write_update_state "$guard_previous" running signed-release
        log "Stable activation was interrupted before current changed; known-good remains active"
        return 0
    fi

    [ "$initial_sha_value" = "$guard_candidate" ] ||
        fail_closed "Stable activation guard does not match current release"

    set_update_context health-wait "$guard_candidate" "$guard_attempt" ""
    write_update_state "$guard_candidate" validating signed-release
    log "validating cold health for exact activated Stable/MVP release $guard_candidate"

    if surface_stays_running 4 && wait_for_surface_health "$guard_candidate" "$SURFACE_HEALTH_TIMEOUT"; then
        record_applied "$guard_candidate" signed-release
        record_runtime_surface_sha "$guard_candidate"
        rm -f \
            "$STABLE_ACTIVATION_GUARD_FILE" \
            "$STAGED_RELEASE_FILE" \
            "$STABLE_HEALTH_READY_FILE" \
            "$STABLE_HEALTH_REJECTED_FILE"
        /bin/busybox sync
        clear_update_context
        write_update_state "$guard_candidate" running signed-release
        log "Stable/MVP exact release committed after cold health: $guard_candidate"
        return 0
    fi

    clear_surface_health
    stop_surface
    rollback_stable_activation "$guard_previous" "$guard_candidate" "$guard_attempt"
    fail_closed "Stable rollback returned unexpectedly"
}

restore_current_surface_after_probe() {
    current_sha_value=$1
    candidate_sha=$2

    is_sha "$current_sha_value" || return 1
    is_sha "$candidate_sha" || return 1

    set_update_context health-wait "$candidate_sha" "$(utc_now)" ""
    write_update_state "$current_sha_value" restoring signed-release
    clear_surface_health
    stop_surface
    if ! start_surface || ! surface_stays_running 4 || ! wait_for_surface_health "$current_sha_value" "$SURFACE_HEALTH_TIMEOUT"; then
        fail_closed "Stable/MVP known-good Surface could not be restored after candidate health probe"
    fi
    record_runtime_surface_sha "$current_sha_value"
    return 0
}

probe_staged_stable_release_health() {
    current_sha_value=$1
    candidate_sha=$2

    is_sha "$current_sha_value" || return 1
    is_sha "$candidate_sha" || return 1
    [ "$candidate_sha" != "$current_sha_value" ] || return 1
    stable_release_tree_is_valid "$candidate_sha" || return 1

    ready_sha=$(read_state_value "$STABLE_HEALTH_READY_FILE")
    if [ "$ready_sha" = "$candidate_sha" ]; then
        set_update_context health-ready "$candidate_sha" "" ""
        write_update_state "$current_sha_value" health-ready signed-release
        return 0
    fi

    rejected_sha=$(read_state_value "$STABLE_HEALTH_REJECTED_FILE")
    if [ "$rejected_sha" = "$candidate_sha" ]; then
        set_update_context blocked "$candidate_sha" "" "stable-release-health-rejected"
        write_update_state "$current_sha_value" rejected signed-release
        return 1
    fi

    rm -f "$STABLE_HEALTH_READY_FILE"
    set_update_context health-wait "$candidate_sha" "$(utc_now)" ""
    write_update_state "$candidate_sha" testing signed-release
    log "probing staged Stable/MVP Surface health without changing current: $candidate_sha"

    clear_surface_health
    stop_surface

    candidate_healthy=0
    candidate_system=$STABLE_ROOT/releases/$candidate_sha/system
    if start_surface_from_system "$candidate_system" "$candidate_sha"; then
        if surface_stays_running 4 && wait_for_surface_health "$candidate_sha" "$SURFACE_HEALTH_TIMEOUT"; then
            candidate_healthy=1
        fi
    fi

    stop_surface
    restore_current_surface_after_probe "$current_sha_value" "$candidate_sha"

    if [ "$candidate_healthy" -eq 1 ]; then
        write_state_value "$STABLE_HEALTH_READY_FILE" "$candidate_sha"
        rm -f "$STABLE_HEALTH_REJECTED_FILE"
        set_update_context health-ready "$candidate_sha" "" ""
        write_update_state "$current_sha_value" health-ready signed-release
        log "staged Stable/MVP release passed Surface health and remains inactive: $candidate_sha"
        return 0
    fi

    write_state_value "$STABLE_HEALTH_REJECTED_FILE" "$candidate_sha"
    set_update_context blocked "$candidate_sha" "" "stable-release-health-failed"
    write_update_state "$current_sha_value" rejected signed-release
    log "staged Stable/MVP release failed Surface health; known-good restored: $candidate_sha"
    return 1
}

check_stable_signed_update() {
    current=$1

    if [ ! -x "$STABLE_RELEASE_AGENT" ] || [ -L "$STABLE_RELEASE_AGENT" ]; then
        set_update_context blocked "" "" "stable-release-agent-unavailable"
        write_update_state "$current" disabled none
        return 0
    fi
    if [ ! -f "$STABLE_TRUST_FILE" ] || [ -L "$STABLE_TRUST_FILE" ]; then
        set_update_context blocked "" "" "stable-release-trust-unavailable"
        write_update_state "$current" disabled none
        return 0
    fi
    if ! channel_url=$(stable_channel_url); then
        set_update_context blocked "" "" "stable-release-channel-invalid"
        write_update_state "$current" disabled none
        return 0
    fi

    rm -f "$STABLE_INSPECT_RECEIPT"
    if ! /bin/busybox timeout -k 5 "$STABLE_INSPECT_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" inspect \
        --envelope-url "$channel_url" \
        --trust "$STABLE_TRUST_FILE" \
        --repository ordaxsystems/ordax-os \
        >"$STABLE_INSPECT_RECEIPT" 2>>"$UPDATE_LOG"
    then
        rm -f "$STABLE_INSPECT_RECEIPT"
        set_update_context error "" "" "stable-release-inspect-failed"
        write_update_state "$current" network-error none
        return 0
    fi

    inspect_status=$(stable_receipt_string "$STABLE_INSPECT_RECEIPT" status || true)
    remote_sha=$(stable_receipt_string "$STABLE_INSPECT_RECEIPT" source_commit || true)
    if [ "$inspect_status" != "verified" ] || ! is_sha "$remote_sha"; then
        rm -f "$STABLE_INSPECT_RECEIPT"
        set_update_context error "" "" "stable-release-inspect-invalid"
        write_update_state "$current" remote-error none
        return 0
    fi
    rm -f "$STABLE_INSPECT_RECEIPT"

    if [ "$remote_sha" = "$current" ]; then
        staged_sha=$(read_state_value "$STAGED_RELEASE_FILE")
        [ "$staged_sha" != "$current" ] || rm -f "$STAGED_RELEASE_FILE"
        ready_sha=$(read_state_value "$STABLE_HEALTH_READY_FILE")
        [ "$ready_sha" != "$current" ] || rm -f "$STABLE_HEALTH_READY_FILE"
        rejected_sha=$(read_state_value "$STABLE_HEALTH_REJECTED_FILE")
        [ "$rejected_sha" != "$current" ] || rm -f "$STABLE_HEALTH_REJECTED_FILE"
        clear_update_context
        write_update_state "$current" running none
        return 0
    fi

    staged_sha=$(read_state_value "$STAGED_RELEASE_FILE")
    if [ "$staged_sha" = "$remote_sha" ] && stable_release_tree_is_valid "$remote_sha"; then
        ready_sha=$(read_state_value "$STABLE_HEALTH_READY_FILE")
        if [ "$ready_sha" = "$remote_sha" ]; then
            activate_health_ready_stable_release "$current" "$remote_sha" || true
            return 0
        fi
        if probe_staged_stable_release_health "$current" "$remote_sha"; then
            activate_health_ready_stable_release "$current" "$remote_sha" || true
        fi
        return 0
    fi

    ready_sha=$(read_state_value "$STABLE_HEALTH_READY_FILE")
    [ "$ready_sha" = "$remote_sha" ] || rm -f "$STABLE_HEALTH_READY_FILE"
    rejected_sha=$(read_state_value "$STABLE_HEALTH_REJECTED_FILE")
    [ "$rejected_sha" = "$remote_sha" ] || rm -f "$STABLE_HEALTH_REJECTED_FILE"

    attempt_id=$(utc_now)
    stage_started=$(epoch_now)
    set_update_context materializing "$remote_sha" "$attempt_id" ""
    write_update_state "$current" updating signed-release
    rm -f "$STABLE_MATERIALIZE_RECEIPT"

    if ! /bin/busybox timeout -k 5 "$STABLE_MATERIALIZE_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" materialize \
        --envelope-url "$channel_url" \
        --trust "$STABLE_TRUST_FILE" \
        --root "$STABLE_ROOT" \
        --repository ordaxsystems/ordax-os \
        --expected-commit "$remote_sha" \
        >"$STABLE_MATERIALIZE_RECEIPT" 2>>"$UPDATE_LOG"
    then
        rm -f "$STABLE_MATERIALIZE_RECEIPT"
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        set_update_context error "$remote_sha" "$attempt_id" "stable-release-materialize-failed"
        write_update_state "$current" stage-error signed-release
        return 0
    fi

    materialize_status=$(stable_receipt_string "$STABLE_MATERIALIZE_RECEIPT" status || true)
    materialized_sha=$(stable_receipt_string "$STABLE_MATERIALIZE_RECEIPT" source_commit || true)
    rm -f "$STABLE_MATERIALIZE_RECEIPT"
    if [ "$materialize_status" != "materialized" ] || [ "$materialized_sha" != "$remote_sha" ]; then
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        set_update_context error "$remote_sha" "$attempt_id" "stable-release-materialize-invalid"
        write_update_state "$current" stage-error signed-release
        return 0
    fi

    if ! stable_release_tree_is_valid "$remote_sha"; then
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        set_update_context error "$remote_sha" "$attempt_id" "stable-release-tree-invalid"
        write_update_state "$current" stage-error signed-release
        return 0
    fi

    write_state_value "$STAGED_RELEASE_FILE" "$remote_sha"
    record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
    set_update_context staged "$remote_sha" "$attempt_id" ""
    write_update_state "$current" staged signed-release
    log "Stable/MVP signed release staged without activation: $remote_sha"
    if probe_staged_stable_release_health "$current" "$remote_sha"; then
        activate_health_ready_stable_release "$current" "$remote_sha" || true
    fi
    return 0
}

portable_state_helper_ready() {
    [ "$PRODUCT_MODE" = "usb" ] || return 1
    [ "$STABLE_LAYOUT" = "portable-v2" ] || return 1
    [ -x "$PORTABLE_STATE_HELPER" ] || return 1
    [ ! -L "$PORTABLE_STATE_HELPER" ] || return 1
    [ -d "$PORTABLE_ROOT/releases" ] || return 1
    [ -d "$PORTABLE_STATE_ROOT/ordax/portable-release" ] || return 1
}

portable_rejected_sha() {
    portable_state_helper_ready || return 1
    "$PORTABLE_STATE_HELPER" "$PORTABLE_STATE_ROOT" rejected 2>/dev/null
}

portable_release_schema_supported() {
    case "${1:-}" in
        prototype-ordax.release-manifest/3|prototype-ordax.release-manifest/4)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

portable_release_is_verified() {
    expected_sha=$1
    manifest_schema=$2
    is_sha "$expected_sha" || return 1

    case "$manifest_schema" in
        prototype-ordax.release-manifest/3)
            portable_verify_subcommand=verify-portable-v3-exact
            ;;
        prototype-ordax.release-manifest/4)
            portable_verify_subcommand=verify-portable-v4-exact
            ;;
        *)
            return 1
            ;;
    esac

    rm -f "$PORTABLE_VERIFY_RECEIPT"
    if ! /bin/busybox timeout -k 5 "$STABLE_ACTIVATION_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" "$portable_verify_subcommand" \
        --trust "$STABLE_TRUST_FILE" \
        --root "$PORTABLE_ROOT" \
        --repository ordaxsystems/ordax-os \
        --expected-commit "$expected_sha" \
        >"$PORTABLE_VERIFY_RECEIPT" 2>>"$UPDATE_LOG"
    then
        rm -f "$PORTABLE_VERIFY_RECEIPT"
        return 1
    fi
    verify_status=$(stable_receipt_string "$PORTABLE_VERIFY_RECEIPT" status || true)
    verify_sha=$(stable_receipt_string "$PORTABLE_VERIFY_RECEIPT" source_commit || true)
    rm -f "$PORTABLE_VERIFY_RECEIPT"
    [ "$verify_status" = "verified" ] && [ "$verify_sha" = "$expected_sha" ]
}

portable_materialize_release() {
    expected_sha=$1
    manifest_schema=$2
    channel_url=$3
    is_sha "$expected_sha" || return 1

    case "$manifest_schema" in
        prototype-ordax.release-manifest/3)
            portable_materialize_subcommand=materialize-portable-v3
            portable_materialize_status=materialized-portable-v3
            ;;
        prototype-ordax.release-manifest/4)
            portable_materialize_subcommand=materialize-portable-v4
            portable_materialize_status=materialized-portable-v4
            ;;
        *)
            return 1
            ;;
    esac

    rm -f "$PORTABLE_MATERIALIZE_RECEIPT"
    if ! /bin/busybox timeout -k 5 "$STABLE_MATERIALIZE_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" "$portable_materialize_subcommand" \
        --envelope-url "$channel_url" \
        --trust "$STABLE_TRUST_FILE" \
        --root "$PORTABLE_ROOT" \
        --repository ordaxsystems/ordax-os \
        --expected-commit "$expected_sha" \
        >"$PORTABLE_MATERIALIZE_RECEIPT" 2>>"$UPDATE_LOG"
    then
        rm -f "$PORTABLE_MATERIALIZE_RECEIPT"
        return 1
    fi

    materialize_status=$(stable_receipt_string "$PORTABLE_MATERIALIZE_RECEIPT" status || true)
    materialized_sha=$(stable_receipt_string "$PORTABLE_MATERIALIZE_RECEIPT" source_commit || true)
    rm -f "$PORTABLE_MATERIALIZE_RECEIPT"
    [ "$materialize_status" = "$portable_materialize_status" ] &&
        [ "$materialized_sha" = "$expected_sha" ] &&
        portable_release_is_verified "$expected_sha" "$manifest_schema"
}

portable_prepare_candidate() {
    candidate_sha=$1
    portable_state_helper_ready || return 1
    is_sha "$candidate_sha" || return 1
    prepared=$("$PORTABLE_STATE_HELPER" prepare \
        "$PORTABLE_STATE_ROOT" "$PORTABLE_ROOT" "$candidate_sha" 2>>"$UPDATE_LOG" || true)
    [ "$prepared" = "$candidate_sha" ]
}

portable_commit_candidate() {
    candidate_sha=$1
    portable_state_helper_ready || return 1
    committed=$("$PORTABLE_STATE_HELPER" commit \
        "$PORTABLE_STATE_ROOT" "$PORTABLE_ROOT" "$candidate_sha" 2>>"$UPDATE_LOG" || true)
    [ "$committed" = "$candidate_sha" ]
}

portable_rollback_candidate() {
    candidate_sha=$1
    portable_state_helper_ready || return 1
    rolled_back=$("$PORTABLE_STATE_HELPER" rollback \
        "$PORTABLE_STATE_ROOT" "$PORTABLE_ROOT" "$candidate_sha" 2>>"$UPDATE_LOG" || true)
    is_sha "$rolled_back" || return 1
    [ "$rolled_back" != "$candidate_sha" ] || return 1
    printf '%s\n' "$rolled_back"
}

portable_reboot_now() {
    reason=$1
    log "$reason"
    /bin/busybox sync >/dev/null 2>&1 || true
    stop_surface
    trap - EXIT HUP INT TERM
    /bin/busybox reboot -f >/dev/null 2>&1 ||
        fail_closed "Portable Stable/MVP reboot request failed"
    fail_closed "Portable Stable/MVP reboot returned unexpectedly"
}

check_stable_portable_update() {
    current=$1
    is_sha "$current" || return 1

    if [ ! -x "$STABLE_RELEASE_AGENT" ] || [ -L "$STABLE_RELEASE_AGENT" ]; then
        set_update_context blocked "" "" "stable-release-agent-unavailable"
        write_update_state "$current" disabled signed-release
        return 0
    fi
    if [ ! -f "$STABLE_TRUST_FILE" ] || [ -L "$STABLE_TRUST_FILE" ]; then
        set_update_context blocked "" "" "stable-release-trust-unavailable"
        write_update_state "$current" disabled signed-release
        return 0
    fi
    if ! portable_state_helper_ready; then
        set_update_context blocked "" "" "portable-activation-state-helper-unavailable"
        write_update_state "$current" disabled signed-release
        return 0
    fi
    if ! channel_url=$(stable_channel_url); then
        set_update_context blocked "" "" "stable-release-channel-invalid"
        write_update_state "$current" disabled signed-release
        return 0
    fi

    rm -f "$STABLE_INSPECT_RECEIPT"
    if ! /bin/busybox timeout -k 5 "$STABLE_INSPECT_TIMEOUT" \
        "$STABLE_RELEASE_AGENT" inspect \
        --envelope-url "$channel_url" \
        --trust "$STABLE_TRUST_FILE" \
        --repository ordaxsystems/ordax-os \
        >"$STABLE_INSPECT_RECEIPT" 2>>"$UPDATE_LOG"
    then
        rm -f "$STABLE_INSPECT_RECEIPT"
        set_update_context error "" "" "stable-release-inspect-failed"
        write_update_state "$current" network-error signed-release
        return 0
    fi

    inspect_status=$(stable_receipt_string "$STABLE_INSPECT_RECEIPT" status || true)
    remote_sha=$(stable_receipt_string "$STABLE_INSPECT_RECEIPT" source_commit || true)
    remote_manifest_schema=$(stable_receipt_string "$STABLE_INSPECT_RECEIPT" manifest_schema || true)
    rm -f "$STABLE_INSPECT_RECEIPT"
    if [ "$inspect_status" != "verified" ] ||
       ! is_sha "$remote_sha" ||
       ! portable_release_schema_supported "$remote_manifest_schema"
    then
        set_update_context error "" "" "stable-release-inspect-invalid"
        write_update_state "$current" remote-error signed-release
        return 0
    fi

    if [ "$PORTABLE_RELEASE_MANIFEST_SCHEMA" = "4" ] &&
       [ "$remote_manifest_schema" != "prototype-ordax.release-manifest/4" ]
    then
        set_update_context blocked "$remote_sha" "" "portable-release-schema-downgrade-blocked"
        write_update_state "$current" blocked signed-release
        return 0
    fi

    if [ "$remote_sha" = "$current" ]; then
        rm -f "$STAGED_RELEASE_FILE" "$STABLE_HEALTH_READY_FILE"
        clear_update_context
        write_update_state "$current" running signed-release
        return 0
    fi

    rejected_sha=$(portable_rejected_sha || true)
    if [ "$remote_sha" = "$rejected_sha" ]; then
        write_state_value "$STABLE_HEALTH_REJECTED_FILE" "$rejected_sha"
        set_update_context blocked "$remote_sha" "" "stable-release-health-rejected"
        write_update_state "$current" rejected signed-release
        return 0
    fi
    if [ -n "$rejected_sha" ] && [ "$remote_sha" != "$rejected_sha" ]; then
        rm -f "$STABLE_HEALTH_REJECTED_FILE"
    fi

    attempt_id=$(utc_now)
    stage_started=$(epoch_now)
    set_update_context materializing "$remote_sha" "$attempt_id" ""
    write_update_state "$current" updating signed-release

    if ! portable_release_is_verified "$remote_sha" "$remote_manifest_schema"; then
        if ! portable_materialize_release "$remote_sha" "$remote_manifest_schema" "$channel_url"; then
            record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
            set_update_context error "$remote_sha" "$attempt_id" "portable-release-materialize-failed"
            write_update_state "$current" stage-error signed-release
            return 0
        fi
    fi

    if ! portable_prepare_candidate "$remote_sha"; then
        record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
        set_update_context error "$remote_sha" "$attempt_id" "portable-activation-prepare-failed"
        write_update_state "$current" activation-error signed-release
        return 0
    fi

    write_state_value "$STAGED_RELEASE_FILE" "$remote_sha"
    record_elapsed_seconds "$stage_started" "$LAST_STAGE_DURATION_FILE"
    set_update_context restart-required "$remote_sha" "$attempt_id" ""
    write_update_state "$current" candidate-armed signed-release
    portable_reboot_now "Portable Stable/MVP candidate armed for one-shot boot: $current -> $remote_sha"
}

handle_portable_candidate_boot() {
    candidate_sha=$1
    [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] || return 1
    [ "$STABLE_LAYOUT" = "portable-v2" ] || return 1
    [ "$PORTABLE_BOOT_SLOT" = "candidate" ] || return 1
    is_sha "$candidate_sha" || fail_closed "Portable candidate boot has invalid source identity"

    attempt_id=$(utc_now)
    set_update_context health-wait "$candidate_sha" "$attempt_id" ""
    write_update_state "$candidate_sha" validating signed-release
    log "validating cold health for one-shot Portable Stable/MVP candidate $candidate_sha"

    if surface_stays_running 4 && wait_for_surface_health "$candidate_sha" "$INITIAL_SURFACE_HEALTH_TIMEOUT"; then
        if ! portable_commit_candidate "$candidate_sha"; then
            set_update_context error "$candidate_sha" "$attempt_id" "portable-activation-commit-ambiguous"
            write_update_state "$candidate_sha" activation-error signed-release
            portable_reboot_now "Portable candidate health passed but activation commit was ambiguous; rebooting for transaction recovery"
        fi
        record_applied "$candidate_sha" signed-release
        record_runtime_surface_sha "$candidate_sha"
        rm -f "$STAGED_RELEASE_FILE" "$STABLE_HEALTH_READY_FILE" "$STABLE_HEALTH_REJECTED_FILE"
        /bin/busybox sync >/dev/null 2>&1 || true
        clear_update_context
        write_update_state "$candidate_sha" running signed-release
        log "Portable Stable/MVP candidate committed after cold health: $candidate_sha"
        printf 'ORDAX_PORTABLE_COLD_HEALTH_COMMIT=%s\n' "$candidate_sha" >/dev/console 2>/dev/null || true
        return 0
    fi

    clear_surface_health
    stop_surface
    if ! previous_sha=$(portable_rollback_candidate "$candidate_sha"); then
        fail_closed "Portable candidate health failed and rollback state could not be committed"
    fi
    write_state_value "$STABLE_HEALTH_REJECTED_FILE" "$candidate_sha"
    rm -f "$STAGED_RELEASE_FILE" "$STABLE_HEALTH_READY_FILE"
    set_update_context rollback "$candidate_sha" "$attempt_id" "portable-cold-health-failed"
    write_update_state "$previous_sha" rolled-back signed-release
    portable_reboot_now "Portable candidate failed cold health; rebooting exact previous release $previous_sha"
}
check_for_update() {
    current=$(current_sha)

    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        case "$STABLE_LAYOUT" in
            legacy-tree)
                check_stable_signed_update "$current"
                ;;
            portable-v2)
                check_stable_portable_update "$current"
                ;;
            *)
                fail_closed "unknown Stable/MVP runtime layout during update check"
                ;;
        esac
        return 0
    fi

    boot_rejected_sha=""

    if [ -s "$PINNED_FILE" ]; then
        boot_rejected_sha=$(read_state_value "$BOOT_REJECTED_FILE")
        case "$boot_rejected_sha" in
            [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
                [ "${#boot_rejected_sha}" -eq 40 ] || boot_rejected_sha=""
                ;;
            *) boot_rejected_sha="" ;;
        esac
        if [ -z "$boot_rejected_sha" ]; then
            set_update_context blocked "" "" "pinned"
            write_update_state "$current" pinned none
            return 0
        fi
    fi
    if [ ! -x "$GIT_BIN" ] || [ ! -d "$WORKTREE/.git" ]; then
        set_update_context blocked "" "" "git-unavailable"
        write_update_state "$current" disabled none
        return 0
    fi

    # The welcome flow must not be interrupted by a Git hot update.
    # This is the same persistent state bound to /var/lib/ordax in Cage.
    first_run_receipt=$STATE_DIR/native-state/first-run.json
    if [ ! -f "$first_run_receipt" ] || [ -L "$first_run_receipt" ] ||
       ! /bin/busybox grep -q '"completed"[[:space:]]*:[[:space:]]*true' "$first_run_receipt"; then
        record_owner_poll_boot_stage first-run-pending
        return 0
    fi
    record_owner_poll_boot_stage first-run-verified
    record_owner_poll_boot_stage git-remote-started

    # Do not enter a command substitution around a blocking Git operation:
    # the parent shell must handle TERM immediately during an active fetch.
    remote_output_file=$UPDATE_RUN_DIR/remote-head.$
    rm -f "$remote_output_file"
    if ! run_bounded_git "$REMOTE_TIMEOUT" -C "$WORKTREE" ls-remote --heads origin "refs/heads/$BRANCH" >"$remote_output_file" 2>>"$UPDATE_LOG"; then
        rm -f "$remote_output_file"
        record_owner_poll_boot_stage git-remote-failed
        log "remote check failed or timed out after ${REMOTE_TIMEOUT}s; keeping running Surface"
        set_update_context error "" "" "remote-check-failed"
        write_update_state "$current" network-error none
        return 0
    fi
    record_owner_poll_boot_stage git-remote-completed
    remote_output=$(/bin/busybox cat "$remote_output_file" 2>/dev/null || true)
    rm -f "$remote_output_file"
    set -- $remote_output
    remote_sha=${1:-}
    case "$remote_sha" in
        ''|*[!0-9a-f]*)
            set_update_context error "" "" "invalid-remote-sha"
            write_update_state "$current" remote-error none
            return 0
            ;;
    esac

    # Poll main promptly after First Run, but never replace an unverified UI.
    if [ "$OWNER_INITIAL_HEALTH_PENDING" -eq 1 ]; then
        set_update_context health-wait "$remote_sha" "" ""
        write_update_state "$current" applied initial
        return 0
    fi

    if [ -s "$PINNED_FILE" ]; then
        if [ "$remote_sha" = "$boot_rejected_sha" ]; then
            set_update_context blocked "$remote_sha" "" "boot-rollback-pinned"
            write_update_state "$current" pinned none
            return 0
        fi
        rm -f "$PINNED_FILE" "$BOOT_REJECTED_FILE"
        log "remote main advanced beyond boot-rejected $boot_rejected_sha; releasing automatic rollback pin"
    fi

    rejected_sha=$(read_state_value "$REJECTED_FILE")

    if [ "$remote_sha" = "$current" ]; then
        refresh_dev_helpers "$current"
        # A post-swap helper failure must not be silently promoted to
        # "running" on the next poll. The canonical helper receipt is the
        # only proof that the binaries correspond to the current Git SHA.
        if [ -f "$WORKTREE/system/services/base-update/dev-helpers.sh" ]; then
            helper_sha=$(read_state_value "$DEV_HELPERS_SHA_FILE")
            if [ "$helper_sha" != "$current" ]; then
                set_update_context error "$current" "" "helper-refresh-failed"
                write_update_state "$current" pull-error none
                log "Git checkout $current is active; helper installation is pending canonical retry"
                return 0
            fi
        fi
        if [ -f "$BOOT_REFRESH_FILE" ]; then
            pending_boot_sha=$(read_state_value "$BOOT_REFRESH_FILE")
            [ -n "$pending_boot_sha" ] && request_dev_base_candidate "$pending_boot_sha"
        fi
        healthy_sha=$(read_state_value "$HEALTH_FILE")
        if [ -n "$rejected_sha" ] && [ "$rejected_sha" = "$current" ] && [ "$healthy_sha" = "$current" ]; then
            rm -f "$REJECTED_FILE"
            rejected_sha=""
            log "cleared stale rejected state for healthy current checkout $current"
        fi
        if [ -n "$rejected_sha" ] && [ "$rejected_sha" = "$current" ]; then
            set_update_context blocked "$current" "" "rejected-commit"
            write_update_state "$current" rejected none
        else
            clear_update_context
            write_update_state "$current" running none
        fi
        return 0
    fi

    if [ -n "$rejected_sha" ] && [ "$remote_sha" = "$rejected_sha" ]; then
        set_update_context blocked "$remote_sha" "" "rejected-commit"
        write_update_state "$current" rejected none
        return 0
    fi
    if [ -n "$rejected_sha" ] && [ "$remote_sha" != "$rejected_sha" ]; then
        rm -f "$REJECTED_FILE"
    fi

    if non_ff_target_blocked "$current" "$remote_sha"; then
        set_update_context blocked "$remote_sha" "" "non-fast-forward"
        write_update_state "$current" pull-error none
        return 0
    fi
    if fetch_retry_pending "$remote_sha"; then
        set_update_context error "$remote_sha" "" "fetch-retry-wait"
        write_update_state "$current" network-error none
        return 0
    fi

    old_sha=$current
    attempt_id=$(utc_now)
    write_state_value "$ATTEMPT_STARTED_EPOCH_FILE" "$(epoch_now)"
    set_update_context fetching "$remote_sha" "$attempt_id" ""
    write_update_state "$old_sha" updating none
    log "update available: $old_sha -> $remote_sha"

    if ! apply_remote_checkout "$old_sha" "$remote_sha"; then
        reason=${CHECKOUT_ERROR:-checkout-failed}
        log "automatic supervisor-owned Git update failed ($reason); keeping running Surface"
        set_update_context error "$remote_sha" "$attempt_id" "$reason"
        # A helper failure occurs AFTER the atomic Git checkout was committed.
        # Do not lie about sourceSha: show the verified active SHA and require
        # the independent dev-helpers-sha receipt on subsequent retries.
        active_after_failure=$(current_sha)
        if [ "$reason" = "pull-helper-refresh-failed" ] &&
           [ "$active_after_failure" = "$remote_sha" ]; then
            write_update_state "$active_after_failure" pull-error none
        else
            write_update_state "$old_sha" pull-error none
        fi
        return 0
    fi

    new_sha=$(current_sha)
    if [ "$new_sha" = "$old_sha" ] || [ "$new_sha" = unknown ]; then
        set_update_context error "$remote_sha" "$attempt_id" "checkout-sha-invalid"
        write_update_state "$old_sha" pull-error none
        return 0
    fi

    set_update_context validating "$new_sha" "$attempt_id" ""
    write_update_state "$new_sha" updating none
    if ! validate_updated_tree "$APPLY_MODE"; then
        rollback_update "$old_sha" "$new_sha" "$APPLY_MODE" "updated system tree failed preflight validation"
        return 0
    fi

    if [ "$LOW_LEVEL_CHANGED" -eq 1 ]; then
        mark_boot_refresh_required "$new_sha"
        request_dev_base_candidate "$new_sha"
        log "boot/bootstrap changes detected; current session remains running and Base candidate acquisition is delegated to the replaceable base-update owner"
    fi

    case "$APPLY_MODE" in
        reload)
            clear_surface_health
            set_update_context health-wait "$new_sha" "$attempt_id" ""
            write_update_state "$new_sha" applied reload
            log "live-safe system update applied; waiting for Surface health acknowledgement"
            reload_healthy=0
            if wait_for_surface_health "$new_sha" "$RELOAD_HEALTH_TIMEOUT"; then
                reload_healthy=1
            else
                set_update_context activating "$new_sha" "$attempt_id" "reload-health-timeout"
                write_update_state "$new_sha" applied reload
                if recover_reload_with_surface_restart "$new_sha"; then
                    reload_healthy=1
                    log "Surface restart fallback acknowledged healthy state"
                fi
            fi

            if [ "$reload_healthy" -ne 1 ] && surface_health_matches "$new_sha"; then
                reload_healthy=1
                log "late Surface health acknowledgement arrived before rollback commit"
            fi

            if [ "$reload_healthy" -eq 1 ]; then
                record_applied "$new_sha" "$APPLY_MODE"
                record_runtime_surface_sha "$new_sha"
                clear_update_context
                write_update_state "$new_sha" running reload
                log "updated Surface acknowledged healthy state"
            else
                rollback_update "$old_sha" "$new_sha" reload "Surface did not acknowledge healthy state after reload and one Surface restart"
            fi
            ;;
        surface-restart)
            clear_surface_health
            set_update_context activating "$new_sha" "$attempt_id" ""
            write_update_state "$new_sha" applied surface-restart
            log "native host update applied; restarting Surface only"
            stop_surface
            if ! start_surface || ! surface_stays_running 4 || ! wait_for_surface_health "$new_sha" "$SURFACE_HEALTH_TIMEOUT"; then
                rollback_update "$old_sha" "$new_sha" surface-restart "updated native Surface host did not render and acknowledge healthy state"
                return 0
            fi
            record_applied "$new_sha" "$APPLY_MODE"
            record_runtime_surface_sha "$new_sha"
            clear_update_context
            write_update_state "$new_sha" running surface-restart
            ;;
        supervisor-restart)
            clear_surface_health
            set_update_context activating "$new_sha" "$attempt_id" ""
            temporary=$SUPERVISOR_GUARD_FILE.tmp.$$
            printf '%s %s %s\n' "$old_sha" "$new_sha" "$attempt_id" >"$temporary"
            /bin/busybox mv -f "$temporary" "$SUPERVISOR_GUARD_FILE"
            write_update_state "$new_sha" applied supervisor-restart
            log "supervisor update applied; asking guardian to restart supervisor without reboot"
            stop_surface
            trap - EXIT HUP INT TERM
            exit 75
            ;;
        none)
            rm -f "$ATTEMPT_STARTED_EPOCH_FILE"
            write_state_value "$LAST_APPLY_DURATION_FILE" "0"
            write_state_value "$LAST_STAGE_DURATION_FILE" "0"
            refresh_release_history
            clear_update_context
            write_update_state "$new_sha" running none
            if [ "$LOW_LEVEL_CHANGED" -eq 1 ]; then
                log "low-level delivery observed; application remains pending boot refresh"
            else
                log "repository update has no device delivery effect"
            fi
            ;;
    esac
}

trap stop_surface EXIT
trap terminate HUP INT TERM

case "$PRODUCT_MODE" in
    usb|native-disk)
        ;;
    *)
        fail_closed "OrdaX product mode identity is missing or invalid"
        ;;
esac

case "$DISTRIBUTION_PROFILE" in
    owner-development)
        ;;
    stable-mvp)
        is_sha "$SOURCE_SHA_HINT" || fail_closed "Stable/MVP runtime source SHA is missing or invalid"
        case "$STABLE_LAYOUT" in
            legacy-tree)
                ;;
            portable-v2)
                [ "$PRODUCT_MODE" = "usb" ] || fail_closed "portable-v2 Stable layout is USB-only"
                portable_stable_source_sha >/dev/null || fail_closed "portable-v2 mounted system tree does not match verified source identity"
                ;;
            *)
                fail_closed "unknown Stable/MVP runtime layout"
                ;;
        esac
        ;;
    *)
        fail_closed "unknown OrdaX distribution profile"
        ;;
esac

[ -x "$SURFACE_ENTRYPOINT" ] || fail_closed "surface entrypoint is missing"
supervisor_heartbeat || fail_closed "supervisor liveness checkpoint could not be published"

initial_sha=$(current_sha)
boot_runtime_sha=$(read_state_value "$RUNTIME_SURFACE_SHA_FILE")
if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
    rm -f "$SUPERVISOR_GUARD_FILE" >/dev/null 2>&1 || true
fi
refresh_release_history
clear_update_context
write_update_state "$initial_sha" running initial
record_owner_poll_boot_stage initialized
clear_surface_health
if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
    log "starting shared OrdaX Surface with Stable/MVP signed-release profile"
else
    log "starting shared OrdaX Surface with Owner/Development Git hot-update supervisor"
fi
start_surface || fail_closed "surface entrypoint could not be started"

if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] &&
   [ "$STABLE_LAYOUT" = "portable-v2" ] &&
   [ "$PORTABLE_BOOT_SLOT" = "candidate" ]; then
    handle_portable_candidate_boot "$initial_sha"
elif [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] && [ -s "$STABLE_ACTIVATION_GUARD_FILE" ]; then
    handle_stable_activation_guard "$initial_sha"
elif [ -s "$SUPERVISOR_GUARD_FILE" ]; then
    guard_line=$(read_state_value "$SUPERVISOR_GUARD_FILE")
    set -- $guard_line
    guard_previous=${1:-}
    guard_current=${2:-}
    guard_attempt=${3:-}
    if [ -n "$guard_previous" ] && [ "$guard_current" = "$initial_sha" ]; then
        set_update_context health-wait "$guard_current" "$guard_attempt" ""
        write_update_state "$guard_current" applied supervisor-restart
        log "validating restarted supervisor and Surface for $guard_current"
        if surface_stays_running 4 && wait_for_surface_health "$guard_current" "$SURFACE_HEALTH_TIMEOUT"; then
            record_applied "$guard_current" supervisor-restart
            record_runtime_surface_sha "$guard_current"
            rm -f "$SUPERVISOR_GUARD_FILE"
            clear_update_context
            write_update_state "$guard_current" running supervisor-restart
            log "restarted supervisor and Surface acknowledged healthy state"
        else
            rm -f "$SUPERVISOR_GUARD_FILE"
            rollback_update "$guard_previous" "$guard_current" supervisor-restart "restarted supervisor/Surface did not become healthy"
        fi
    else
        rm -f "$SUPERVISOR_GUARD_FILE"
    fi
elif [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
    set_update_context health-wait "$initial_sha" "" ""
    write_update_state "$initial_sha" applied initial
    log "validating initial Surface health in the Supervisor polling loop"
    begin_owner_initial_surface_health
else
    set_update_context health-wait "$initial_sha" "" ""
    write_update_state "$initial_sha" applied initial
    log "validating cold-boot Surface health for $initial_sha"

    if surface_stays_running 4 && wait_for_surface_health "$initial_sha" "$INITIAL_SURFACE_HEALTH_TIMEOUT"; then
        record_runtime_surface_sha "$initial_sha"
        clear_update_context
        write_update_state "$initial_sha" running initial
        log "cold-boot Surface acknowledged healthy state"
    else
        if rollback_boot_candidate "$boot_runtime_sha" "$initial_sha" "cold-boot Surface did not become healthy"; then
            exit 75
        fi

        log "cold-boot Surface did not become healthy; retrying current checkout once"
        clear_surface_health
        stop_surface
        start_surface || fail_closed "cold-boot Surface retry could not be started"
        if ! surface_stays_running 4 || ! wait_for_surface_health "$initial_sha" "$INITIAL_SURFACE_HEALTH_TIMEOUT"; then
            fail_closed "cold-boot Surface failed health after one retry"
        fi
        record_runtime_surface_sha "$initial_sha"
        clear_update_context
        write_update_state "$initial_sha" running initial
        log "cold-boot Surface retry acknowledged healthy state"
    fi
fi

record_owner_poll_boot_stage poll-loop-entered
while :; do
    supervisor_heartbeat || fail_closed "supervisor liveness checkpoint could not be published"
    # Owner/Dev button wakes the existing Supervisor promptly. No second
    # process, Git owner or automatic-update toggle is introduced.
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
        poll_waited=0
        while [ "$poll_waited" -lt "$UPDATE_INTERVAL" ]; do
            [ -f "$OWNER_MANUAL_CHECK_REQUEST" ] && break
            /bin/busybox sleep 1
            poll_waited=$((poll_waited + 1))
        done
    else
        /bin/busybox sleep "$UPDATE_INTERVAL"
    fi
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] &&
       [ -f "$OWNER_MANUAL_CHECK_REQUEST" ]; then
        if [ ! -L "$OWNER_MANUAL_CHECK_REQUEST" ] &&
           [ "$(/bin/busybox cat "$OWNER_MANUAL_CHECK_REQUEST" 2>/dev/null || true)" = "check-main" ]; then
            /bin/busybox rm -f "$OWNER_MANUAL_CHECK_REQUEST"
            log "Owner/Development manual main check requested; using canonical Supervisor"
        else
            log "ignoring invalid owner manual update request"
            /bin/busybox rm -f "$OWNER_MANUAL_CHECK_REQUEST"
        fi
    fi

    if [ "$OWNER_INITIAL_HEALTH_PENDING" -eq 0 ] &&
       [ -n "$SURFACE_PID" ] && ! kill -0 "$SURFACE_PID" >/dev/null 2>&1; then
        surface_rc=0
        wait "$SURFACE_PID" 2>/dev/null || surface_rc=$?
        SURFACE_PID=""
        log "Surface exited with status $surface_rc; restarting without reboot"
        start_surface || fail_closed "Surface restart failed"
        record_runtime_surface_sha "$(current_sha)"
    fi

    if [ "$OWNER_INITIAL_HEALTH_PENDING" -eq 1 ]; then
        check_owner_initial_surface_health
    else
        recover_stale_surface_if_needed
    fi
    check_for_update
 done
