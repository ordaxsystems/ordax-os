# Each Git command owns a distinct session/process group. The shell waits for
# that group as a background job so TERM interrupts wait immediately, rather
# than deferring Guardian power-quiesce until a 45-second network timeout.
run_bounded_git() {
    timeout_seconds=$1
    shift
    /bin/busybox setsid /bin/busybox timeout -k 5 "$timeout_seconds" \
        "$GIT_BIN" -c http.lowSpeedLimit=1 \
        -c "http.lowSpeedTime=$GIT_LOW_SPEED_TIME" "$@" &
    GIT_JOB_PID=$!
    git_job_rc=0
    wait "$GIT_JOB_PID" || git_job_rc=$?
    GIT_JOB_PID=""
    return "$git_job_rc"
}

cancel_active_git() {
    active_git_pid=${GIT_JOB_PID:-}
    case "$active_git_pid" in ''|*[!0-9]*) return 0 ;; esac
    # Process-group signalling also reaches children of the timeout wrapper.
    # This group was created by setsid, never by the Guardian or the Surface.
    kill -TERM -- "-$active_git_pid" 2>/dev/null || true
    /bin/busybox sleep 1
    kill -KILL -- "-$active_git_pid" 2>/dev/null || true
    wait "$active_git_pid" 2>/dev/null || true
    GIT_JOB_PID=""
}

# Only typed, allowlisted diagnostics cross the volatile /run boundary.
classify_fetch_error() {
    diagnostic=$1
    result_code=$2
    case "$result_code" in 124|137) printf 'timeout'; return 0 ;; esac
    if /bin/busybox grep -Eqi 'could not resolve host|could not resolve proxy|temporary failure in name resolution|name or service not known' "$diagnostic"; then
        printf 'dns'
    elif /bin/busybox grep -Eqi 'SSL certificate problem|certificate verify failed|certificate has expired|unable to get local issuer certificate' "$diagnostic"; then
        printf 'tls'
    elif /bin/busybox grep -Eqi 'authentication failed|http 401|http 403|requested URL returned error: (401|403)' "$diagnostic"; then
        printf 'auth'
    elif /bin/busybox grep -Eqi 'timed out|timeout|operation too slow' "$diagnostic"; then
        printf 'timeout'
    elif /bin/busybox grep -Eqi 'network is unreachable|no route to host|failed to connect|connection refused|connection reset' "$diagnostic"; then
        printf 'connectivity'
    else
        printf 'unknown'
    fi
}

record_fetch_failure() {
    fetch_target=$1
    fetch_started=$2
    fetch_rc=$3
    fetch_reason=$4
    fetch_previous_count=0
    if [ -f "$FETCH_RETRY_FILE" ] && [ ! -L "$FETCH_RETRY_FILE" ]; then
        read -r last_target last_count last_retry <"$FETCH_RETRY_FILE" || true
        if [ "${last_target:-}" = "$fetch_target" ]; then
            case "${last_count:-}" in ''|*[!0-9]*) ;; *) fetch_previous_count=$last_count ;; esac
        fi
    fi
    [ "$fetch_previous_count" -lt 8 ] 2>/dev/null || fetch_previous_count=8
    fetch_count=$((fetch_previous_count + 1))
    # 15, 30, 60, 120, 240, then max 300s. Persist across restarts.
    fetch_delay=15
    fetch_index=1
    while [ "$fetch_index" -lt "$fetch_count" ]; do
        fetch_delay=$((fetch_delay * 2))
        [ "$fetch_delay" -le 300 ] || { fetch_delay=300; break; }
        fetch_index=$((fetch_index + 1))
    done
    fetch_now=$(epoch_now)
    fetch_next=$((fetch_now + fetch_delay))
    fetch_elapsed=0
    if [ "$fetch_now" -ge "$fetch_started" ] 2>/dev/null; then
        fetch_elapsed=$((fetch_now - fetch_started))
    fi
    retry_tmp=$FETCH_RETRY_FILE.tmp.$
    printf '%s %s %s\n' "$fetch_target" "$fetch_count" "$fetch_next" >"$retry_tmp"
    chmod 600 "$retry_tmp"
    /bin/busybox mv -f "$retry_tmp" "$FETCH_RETRY_FILE"
    receipt_tmp=$FETCH_FAILURE_RECEIPT.tmp.$
    printf 'ordax.git-fetch-failure/1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$fetch_target" "$fetch_started" "$fetch_elapsed" "$fetch_rc" \
        "$fetch_reason" "$fetch_count" "$fetch_next" >"$receipt_tmp"
    chmod 600 "$receipt_tmp"
    /bin/busybox mv -f "$receipt_tmp" "$FETCH_FAILURE_RECEIPT"
}

fetch_retry_pending() {
    retry_target=$1
    [ -f "$FETCH_RETRY_FILE" ] && [ ! -L "$FETCH_RETRY_FILE" ] || return 1
    read -r pending_sha pending_count pending_epoch <"$FETCH_RETRY_FILE" || return 1
    [ "$pending_sha" = "$retry_target" ] || return 1
    case "$pending_count:$pending_epoch" in *[!0-9:]*|:*) return 1 ;; esac
    [ "$(epoch_now)" -lt "$pending_epoch" ] 2>/dev/null
}

non_ff_target_blocked() {
    blocked_old=$1
    blocked_target=$2
    [ -f "$NON_FF_BLOCKED_FILE" ] && [ ! -L "$NON_FF_BLOCKED_FILE" ] || return 1
    read -r blocked_old_sha blocked_target_sha <"$NON_FF_BLOCKED_FILE" || return 1
    [ "$blocked_old_sha" = "$blocked_old" ] && [ "$blocked_target_sha" = "$blocked_target" ]
}

record_non_ff_target() {
    blocked_temp=$NON_FF_BLOCKED_FILE.tmp.$
    printf '%s %s\n' "$1" "$2" >"$blocked_temp"
    chmod 600 "$blocked_temp"
    /bin/busybox mv -f "$blocked_temp" "$NON_FF_BLOCKED_FILE"
}

