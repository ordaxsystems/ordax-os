{
  "$schema": "prototype-ordax.studio-runtime-source-lock/1",
  "source": {
    "repository": "https://github.com/ordaxsystems/ordax-runtime",
    "commit": "9734893697dae7dbb3cef5ca060a531e5fb0cd66",
    "compatibility_contract": {
      "path": "docs/contracts/ordax-os-runtime-compatibility.json",
      "schema": "ordax.studio-runtime-compatibility/1",
      "sha256": "34d889808e9f79412580422a5d7fa7c182f5d50e9dba07eb07934af5aff790f8",
      "product_version": "0.4.7"
    }
  },
  "runtime": {
    "profile": "headless",
    "python": ">=3.11",
    "entrypoints": [
      "ordax-dev-agent",
      "ordax-device-agent"
    ],
    "device_agent_schema": "ordax.device-agent/1",
    "capability_reader_schema": "ordax.device-agent-capability-reader/1",
    "product_transport_owner": "ordax_dev_agent.product_device_control_plane.ProductDeviceControlPlane",
    "product_transport_path": "/v3/device/transport",
    "product_transport_operations": [
      "heartbeat",
      "claim",
      "start",
      "lease",
      "progress",
      "report",
      "recover-report"
    ],
    "central_attestation_owner": "ordax_dev_agent.product_central_session.ProductCentralSessionClient",
    "native_device_identity_provider": "ProductDeviceIdentityStore.read_enrolled_credential",
    "native_identity_provider_supported": true,
    "device_id_match_required": true,
    "duplicate_persisted_token_forbidden": true,
    "runtime_kind_authority": "upstream-compatibility-contract:ordax_os.native_runtime_kind",
    "native_composition_entrypoint": "ordax_dev_agent.main.run",
    "native_composition_explicit_config_required": true,
    "native_composition_main_thread_required": true,
    "native_composition_uses_canonical_dispatch_loop": true
  },
  "distribution": {
    "runtime_packaged_in_stable": false,
    "runtime_network_download_allowed": false,
    "runtime_artifact_claimed": false,
    "source_binding_only": true,
    "signed_runtime_slot_available": false,
    "activation_channel": "ordax-runtime-component-channel"
  },
  "authority": {
    "identity_owner": "ordax-os",
    "spaces_owner": "ordax-os",
    "permissions_owner": "ordax-os",
    "intelligence_owner": "ordax-os",
    "memory_owner": "ordax-os",
    "model_router_owner": "ordax-os",
    "same_action_gateway_required": true,
    "surface_raw_execute_forbidden": true,
    "parallel_runtime_forbidden": true
  },
  "activation": {
    "capability_discovery_contract_pinned": true,
    "dispatch_enabled": false,
    "action_gateway_activation_required": true,
    "boot_critical": false,
    "attestation_enabled": false,
    "requires_signed_runtime_slot": true,
    "requires_runtime_health_proof": true,
    "requires_product_oauth_client_consent": true,
    "requires_device_scoped_grants": true,
    "requires_native_policy": true,
    "intelligence_grants_do_not_authorize_remote_actions": true,
    "single_device_heartbeat_owner_required": true,
    "verified_os_runtime_provenance_required": true
  }
}
