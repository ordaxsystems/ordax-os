#!/bin/sh
set -eu

SYSTEM_ROOT=${ORDAX_SYSTEM_ROOT:-}
DISTRIBUTION_PROFILE=${ORDAX_DISTRIBUTION_PROFILE:-owner-development}
PRODUCT_MODE=${ORDAX_PRODUCT_MODE:-}
NATIVE_INSTALL_CAPABILITY=${ORDAX_NATIVE_INSTALL_CAPABILITY:-disabled}
ACCOUNT_GATEWAY_ORIGIN=${ORDAX_ACCOUNT_GATEWAY_ORIGIN:-}
ACCOUNT_GATEWAY_CONFIG=$SYSTEM_ROOT/services/account/gateway-base-url
SOURCE_SHA_HINT=${ORDAX_SOURCE_SHA:-}
SOURCE_SHA=unknown
STATE_ROOT=${ORDAX_STATE_DIR:-/state/ordax}
PERSISTENT_NATIVE_STATE=$STATE_ROOT/native-state
KEYBOARD_LAYOUT_STATE=$PERSISTENT_NATIVE_STATE/keyboard-layout
PERSISTENT_USER_HOME=${ORDAX_USER_HOME:-$STATE_ROOT/home}
RESCUE_SOURCE=$SYSTEM_ROOT/rescue/agent.sh
RESCUE_DIR=$STATE_ROOT/rescue
RESCUE_AGENT=$RESCUE_DIR/agent.sh
RESCUE_LOG=$RESCUE_DIR/launcher.log
RESCUE_PID_FILE=$RESCUE_DIR/agent.pid
BASE_TELEMETRY_SOURCE=$SYSTEM_ROOT/services/telemetry/base-agent.sh
BASE_TELEMETRY_CONFIG_SOURCE=$SYSTEM_ROOT/services/telemetry/relay.json
BASE_TELEMETRY_DIR=$STATE_ROOT/telemetry
BASE_TELEMETRY_AGENT=$BASE_TELEMETRY_DIR/agent.sh
BASE_TELEMETRY_CONFIG=$BASE_TELEMETRY_DIR/relay.json
BASE_TELEMETRY_LOG=$BASE_TELEMETRY_DIR/launcher.log
BASE_TELEMETRY_PID_FILE=$BASE_TELEMETRY_DIR/agent.pid
BASE_UPDATE_SOURCE=$SYSTEM_ROOT/services/base-update/agent.sh
BASE_UPDATE_DIR=$STATE_ROOT/base-update
BASE_UPDATE_AGENT=$BASE_UPDATE_DIR/agent.sh
BASE_UPDATE_LOG=$BASE_UPDATE_DIR/agent.log
BASE_UPDATE_PID_FILE=$BASE_UPDATE_DIR/agent.pid
SESSION_DIR=/run/ordax-surface
RUNTIME_PROVISIONING_FILE=$SESSION_DIR/runtime-provisioning-source-sha
RUNTIME_PROOF_CONTEXT=$SESSION_DIR/runtime-proof-context
HTTP_LOG=$SESSION_DIR/http.log
HOST_LOG=$SESSION_DIR/host.log
TIME_SYNC_LOG=$SESSION_DIR/time-sync.log
NETWORK_LOG=$SESSION_DIR/network-broker.log
NETWORK_CONTROL=$SESSION_DIR/network-control
NETWORK_REQUEST=$SESSION_DIR/network-request
NETWORK_RESPONSE=$SESSION_DIR/network-response
NETWORK_SCAN_RAW=$SESSION_DIR/network-scan.raw
NETWORK_LINK_RAW=$SESSION_DIR/network-link.raw
NETWORK_SAVED_SSID=$SESSION_DIR/network-saved-ssid
NETWORK_BROKER_SOURCE=$SYSTEM_ROOT/surface/runtime/network_broker.sh
NATIVE_INSTALL_BROKER_SOURCE=$SYSTEM_ROOT/surface/runtime/native_install_broker.sh
NATIVE_INSTALL_HELPER=$SYSTEM_ROOT/bin/ordax-native-install-targets
NATIVE_INSTALL_LOG=$SESSION_DIR/native-install-broker.log
NATIVE_INSTALL_CONTROL=$SESSION_DIR/native-install-control
NATIVE_INSTALL_REQUEST=$SESSION_DIR/native-install-request
NATIVE_INSTALL_RESPONSE=$SESSION_DIR/native-install-response
NATIVE_INSTALL_SNAPSHOT=$SESSION_DIR/native-install-targets.json
POWER_REQUEST=$SESSION_DIR/power-request
HOST_POWER_REQUEST=${ORDAX_HOST_POWER_REQUEST:-/run/ordax-update/host-power-request}
KEYBOARD_SESSION_RESTART_REQUEST=$SESSION_DIR/keyboard-session-restart-request
SURFACE_PID=$$
POWER_STATE_DIR=$STATE_ROOT/power
POWER_RECEIPTS_MOUNT_RELATIVE=/srv/ordax-power-receipts
POWER_LAST_REQUEST=$POWER_STATE_DIR/last-request
POWER_PENDING_STALE_SECONDS=120
POWER_TERM_GRACE_SECONDS=2
POWER_KILL_SETTLE_SECONDS=1
POWER_SYNC_TIMEOUT_SECONDS=12
POWER_REMOUNT_TIMEOUT_SECONDS=5
POWER_KERNEL_ACTION_TIMEOUT_SECONDS=5
SEATD_SOCKET=/run/seatd.sock
RUNTIME_STATE=$STATE_ROOT/runtime/native-surface
RUNTIME_ID=alpine-v3.22-cage-webkitgtk-v1
DYNAMIC_RUNTIME_ROOT=$RUNTIME_STATE/$RUNTIME_ID/rootfs
DYNAMIC_RUNTIME_READY=$RUNTIME_STATE/$RUNTIME_ID/ready
VERIFIED_RUNTIME_MODE=${ORDAX_SURFACE_RUNTIME_MODE:-}
VERIFIED_RUNTIME_ROOT=${ORDAX_SURFACE_RUNTIME_ROOT:-}
VERIFIED_RUNTIME_SHA256=${ORDAX_SURFACE_RUNTIME_SHA256:-}
RUNTIME_ROOT=$DYNAMIC_RUNTIME_ROOT
RUNTIME_READY=$DYNAMIC_RUNTIME_READY
LEGACY_RUNTIME_ID=alpine-v3.22-cage-barkery-v1
LEGACY_RUNTIME_ROOT=$RUNTIME_STATE/$LEGACY_RUNTIME_ID/rootfs
LEGACY_RUNTIME_READY=$RUNTIME_STATE/$LEGACY_RUNTIME_ID/ready
RUNTIME_INSTALL_TIMEOUT=${ORDAX_RUNTIME_INSTALL_TIMEOUT_SECONDS:-600}
RUNTIME_UPGRADE_TIMEOUT=${ORDAX_RUNTIME_UPGRADE_TIMEOUT_SECONDS:-120}
HTTP_PID=""
GRAPHICS_PID=""
POWER_BROKER_PID=""
KEYBOARD_SESSION_RESTART_BROKER_PID=""
NETWORK_BROKER_PID=""
NATIVE_INSTALL_BROKER_PID=""
TIME_SYNC_PID=""
STAGING_DIR=""
DEV_BOUND=0
PROC_BOUND=0
SYS_BOUND=0
RUN_BOUND=0
SYSTEM_BOUND=0
REPO_BOUND=0
ORDAX_BOUND=0
STATE_BOUND=0
USER_HOME_BOUND=0
POWER_RECEIPTS_BOUND=0
UDEV_ACTIVE=0

mkdir -p "$SESSION_DIR" "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" "$RESCUE_DIR" "$BASE_TELEMETRY_DIR" "$BASE_UPDATE_DIR" "$POWER_STATE_DIR"
chmod 700 "$SESSION_DIR" "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" "$RESCUE_DIR" "$BASE_TELEMETRY_DIR" "$BASE_UPDATE_DIR" "$POWER_STATE_DIR"
: > "$HTTP_LOG"
: > "$HOST_LOG"
: > "$TIME_SYNC_LOG"
: > "$NETWORK_LOG"
: > "$NATIVE_INSTALL_LOG"
rm -f "$RUNTIME_PROOF_CONTEXT" >/dev/null 2>&1 || true

valid_account_gateway_base_url() {
    value=${1:-}
    case "$value" in
        https://*) ;;
        *) return 1 ;;
    esac
    remainder=${value#https://}
    [ -n "$remainder" ] || return 1
    case "$remainder" in
        *\?*|*\#*|*@*|*[!A-Za-z0-9._:/-]*|*/) return 1 ;;
    esac
    authority=${remainder%%/*}
    [ -n "$authority" ] || return 1
    return 0
}

resolve_account_gateway_base_url() {
    if [ -n "$ACCOUNT_GATEWAY_ORIGIN" ]; then
        valid_account_gateway_base_url "$ACCOUNT_GATEWAY_ORIGIN" || {
            echo "ordax-surface: configured account gateway URL is invalid; disabling online account" >>"$HOST_LOG"
            ACCOUNT_GATEWAY_ORIGIN=
        }
        return 0
    fi
    [ -f "$ACCOUNT_GATEWAY_CONFIG" ] && [ ! -L "$ACCOUNT_GATEWAY_CONFIG" ] || return 0
    configured=$(/bin/busybox cat "$ACCOUNT_GATEWAY_CONFIG" 2>/dev/null || true)
    if valid_account_gateway_base_url "$configured"; then
        ACCOUNT_GATEWAY_ORIGIN=$configured
    else
        echo "ordax-surface: signed account gateway config is invalid; disabling online account" >>"$HOST_LOG"
    fi
}

case "$PRODUCT_MODE" in
    usb|native-disk) ;;
    *) echo "ordax-surface: product mode identity is missing or invalid" >&2; exit 1 ;;
esac

case "$NATIVE_INSTALL_CAPABILITY" in
    disabled|post-mvp-preview) ;;
    *) NATIVE_INSTALL_CAPABILITY=disabled ;;
esac

# Stable/MVP is USB-only. Native installation remains compiled/testable
# foundation, but the public profile cannot activate its broker or token.
[ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] && NATIVE_INSTALL_CAPABILITY=disabled

if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] || [ -n "$VERIFIED_RUNTIME_MODE" ]; then
    case "$VERIFIED_RUNTIME_MODE" in
        verified-erofs-overlay)
            [ "$VERIFIED_RUNTIME_ROOT" = "/run/ordax/runtime/native-surface/rootfs" ] || {
                echo "ordax-surface: verified runtime root is invalid" >&2
                exit 1
            }
            [ "${#VERIFIED_RUNTIME_SHA256}" -eq 64 ] || {
                echo "ordax-surface: verified runtime digest is invalid" >&2
                exit 1
            }
            case "$VERIFIED_RUNTIME_SHA256" in
                *[!0-9a-f]*)
                    echo "ordax-surface: verified runtime digest is invalid" >&2
                    exit 1
                    ;;
            esac
            RUNTIME_ROOT=$VERIFIED_RUNTIME_ROOT
            RUNTIME_READY=
            ;;
        "")
            # Portable v2 remains a compatibility boot shape, but Stable/MVP
            # must never provision its graphical runtime from the network.
            ;;
        *)
            echo "ordax-surface: unsupported verified runtime mode" >&2
            exit 1
            ;;
    esac
fi

case "$RUNTIME_INSTALL_TIMEOUT" in
    ''|*[!0-9]*) RUNTIME_INSTALL_TIMEOUT=180 ;;
esac
[ "$RUNTIME_INSTALL_TIMEOUT" -ge 60 ] 2>/dev/null || RUNTIME_INSTALL_TIMEOUT=180

case "$RUNTIME_UPGRADE_TIMEOUT" in
    ''|*[!0-9]*) RUNTIME_UPGRADE_TIMEOUT=120 ;;
esac
[ "$RUNTIME_UPGRADE_TIMEOUT" -ge 45 ] 2>/dev/null || RUNTIME_UPGRADE_TIMEOUT=120

run_bounded_apk() {
    timeout_seconds=$1
    shift
    /bin/busybox timeout -k 10 "$timeout_seconds" /sbin/apk "$@"
}

persistent_agent_pid_matches() {
    pid=${1:-}
    expected_path=${2:-}
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    [ -n "$expected_path" ] || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(/bin/busybox tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in
        *"$expected_path"*) return 0 ;;
    esac
    return 1
}

base_telemetry_agent_running() {
    pid=""
    [ -s "$BASE_TELEMETRY_PID_FILE" ] && IFS= read -r pid <"$BASE_TELEMETRY_PID_FILE" || true
    persistent_agent_pid_matches "$pid" "$BASE_TELEMETRY_AGENT"
}

ensure_base_telemetry_agent() {
    [ -f "$BASE_TELEMETRY_SOURCE" ] || {
        echo "ordax-surface: base telemetry source unavailable: $BASE_TELEMETRY_SOURCE" >>"$BASE_TELEMETRY_LOG"
        return 0
    }
    [ -f "$BASE_TELEMETRY_CONFIG_SOURCE" ] || {
        echo "ordax-surface: base telemetry config unavailable: $BASE_TELEMETRY_CONFIG_SOURCE" >>"$BASE_TELEMETRY_LOG"
        return 0
    }

    base_agent_changed=1
    if [ -f "$BASE_TELEMETRY_AGENT" ] && /bin/busybox cmp "$BASE_TELEMETRY_SOURCE" "$BASE_TELEMETRY_AGENT" >/dev/null 2>&1; then
        base_agent_changed=0
    fi

    temporary=$BASE_TELEMETRY_AGENT.tmp.$$
    cp "$BASE_TELEMETRY_SOURCE" "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    chmod 700 "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1

    temporary=$BASE_TELEMETRY_CONFIG.tmp
    cp "$BASE_TELEMETRY_CONFIG_SOURCE" "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    chmod 600 "$temporary" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$BASE_TELEMETRY_CONFIG" >>"$BASE_TELEMETRY_LOG" 2>&1 || return 1

    if [ "$base_agent_changed" -eq 1 ] && base_telemetry_agent_running; then
        pid=""
        IFS= read -r pid <"$BASE_TELEMETRY_PID_FILE" || true
        terminate_child "$pid" "base telemetry agent"
        rm -f "$BASE_TELEMETRY_PID_FILE"
        echo "ordax-surface: refreshed persistent base telemetry agent" >>"$BASE_TELEMETRY_LOG"
    fi

    base_telemetry_agent_running && return 0

    if [ -x /bin/setsid ]; then
        ORDAX_DISTRIBUTION_PROFILE="$DISTRIBUTION_PROFILE" \
        ORDAX_SOURCE_SHA="$SOURCE_SHA" \
            /bin/setsid "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 </dev/null &
    else
        ORDAX_DISTRIBUTION_PROFILE="$DISTRIBUTION_PROFILE" \
        ORDAX_SOURCE_SHA="$SOURCE_SHA" \
            "$BASE_TELEMETRY_AGENT" >>"$BASE_TELEMETRY_LOG" 2>&1 </dev/null &
    fi
    /bin/busybox sleep 1
    base_telemetry_agent_running || {
        echo "ordax-surface: base telemetry agent did not remain running" >>"$BASE_TELEMETRY_LOG"
        return 1
    }
    echo "ordax-surface: persistent base telemetry agent is running" >>"$BASE_TELEMETRY_LOG"
    return 0
}

base_update_agent_running() {
    pid=""
    [ -s "$BASE_UPDATE_PID_FILE" ] && IFS= read -r pid <"$BASE_UPDATE_PID_FILE" || true
    persistent_agent_pid_matches "$pid" "$BASE_UPDATE_AGENT"
}

ensure_base_update_agent() {
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        if base_update_agent_running; then
            pid=""
            IFS= read -r pid <"$BASE_UPDATE_PID_FILE" || true
            terminate_child "$pid" "development base update owner"
            rm -f "$BASE_UPDATE_PID_FILE"
        fi
        echo "ordax-surface: Base update owner is disabled in Stable/MVP until signed update integration is connected" >>"$BASE_UPDATE_LOG"
        return 0
    fi

    [ -f "$BASE_UPDATE_SOURCE" ] || {
        echo "ordax-surface: base update owner source unavailable: $BASE_UPDATE_SOURCE" >>"$BASE_UPDATE_LOG"
        return 0
    }

    repo_root=${SYSTEM_ROOT%/system}
    if [ -z "$repo_root" ] || [ "$repo_root" = "$SYSTEM_ROOT" ] || [ ! -d "$repo_root" ]; then
        echo "ordax-surface: source root unavailable for base update owner" >>"$BASE_UPDATE_LOG"
        return 0
    fi
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] && [ ! -d "$repo_root/.git" ]; then
        echo "ordax-surface: Owner/Development Git root unavailable for base update owner" >>"$BASE_UPDATE_LOG"
        return 0
    fi
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] && ! is_source_sha "$SOURCE_SHA"; then
        echo "ordax-surface: Stable/MVP source identity unavailable for base update owner" >>"$BASE_UPDATE_LOG"
        return 0
    fi

    owner_changed=1
    if [ -f "$BASE_UPDATE_AGENT" ] && /bin/busybox cmp "$BASE_UPDATE_SOURCE" "$BASE_UPDATE_AGENT" >/dev/null 2>&1; then
        owner_changed=0
    fi

    temporary=$BASE_UPDATE_AGENT.tmp.$$
    cp "$BASE_UPDATE_SOURCE" "$temporary" >>"$BASE_UPDATE_LOG" 2>&1 || return 1
    chmod 700 "$temporary" >>"$BASE_UPDATE_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$BASE_UPDATE_AGENT" >>"$BASE_UPDATE_LOG" 2>&1 || return 1

    if [ "$owner_changed" -eq 1 ] && base_update_agent_running; then
        pid=""
        IFS= read -r pid <"$BASE_UPDATE_PID_FILE" || true
        terminate_child "$pid" "base update owner"
        rm -f "$BASE_UPDATE_PID_FILE"
        echo "ordax-surface: refreshed persistent base update owner" >>"$BASE_UPDATE_LOG"
    fi

    base_update_agent_running && return 0

    if [ -x /bin/setsid ]; then
        ORDAX_BASE_RUNTIME_ROOT="$RUNTIME_ROOT" \
        ORDAX_BASE_HOST_REPO_ROOT="$repo_root" \
        ORDAX_BASE_DISTRIBUTION_PROFILE="$DISTRIBUTION_PROFILE" \
        ORDAX_BASE_SOURCE_SHA="$SOURCE_SHA" \
            /bin/setsid "$BASE_UPDATE_AGENT" >>"$BASE_UPDATE_LOG" 2>&1 </dev/null &
    else
        ORDAX_BASE_RUNTIME_ROOT="$RUNTIME_ROOT" \
        ORDAX_BASE_HOST_REPO_ROOT="$repo_root" \
        ORDAX_BASE_DISTRIBUTION_PROFILE="$DISTRIBUTION_PROFILE" \
        ORDAX_BASE_SOURCE_SHA="$SOURCE_SHA" \
            "$BASE_UPDATE_AGENT" >>"$BASE_UPDATE_LOG" 2>&1 </dev/null &
    fi
    owner_pid=$!
    printf '%s\n' "$owner_pid" >"$BASE_UPDATE_PID_FILE"
    chmod 600 "$BASE_UPDATE_PID_FILE" >/dev/null 2>&1 || true
    /bin/busybox sleep 1
    base_update_agent_running || {
        echo "ordax-surface: base update owner did not remain running" >>"$BASE_UPDATE_LOG"
        rm -f "$BASE_UPDATE_PID_FILE"
        return 1
    }
    echo "ordax-surface: persistent base update owner is running" >>"$BASE_UPDATE_LOG"
    return 0
}

rescue_agent_running() {
    pid=""
    [ -s "$RESCUE_PID_FILE" ] && IFS= read -r pid <"$RESCUE_PID_FILE" || true
    persistent_agent_pid_matches "$pid" "$RESCUE_AGENT"
}

ensure_rescue_agent() {
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        if rescue_agent_running; then
            pid=""
            IFS= read -r pid <"$RESCUE_PID_FILE" || true
            terminate_child "$pid" "development rescue agent"
            rm -f "$RESCUE_PID_FILE"
        fi
        echo "ordax-surface: development Git rescue is disabled in Stable/MVP" >>"$RESCUE_LOG"
        return 0
    fi
    [ -f "$RESCUE_SOURCE" ] || {
        echo "ordax-surface: rescue agent source unavailable: $RESCUE_SOURCE" >>"$RESCUE_LOG"
        return 0
    }

    rescue_agent_changed=1
    if [ -f "$RESCUE_AGENT" ] && /bin/busybox cmp "$RESCUE_SOURCE" "$RESCUE_AGENT" >/dev/null 2>&1; then
        rescue_agent_changed=0
    fi

    temporary=$RESCUE_AGENT.tmp.$$
    cp "$RESCUE_SOURCE" "$temporary" >>"$RESCUE_LOG" 2>&1 || return 1
    chmod 700 "$temporary" >>"$RESCUE_LOG" 2>&1 || return 1
    /bin/busybox mv -f "$temporary" "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 || return 1

    if [ "$rescue_agent_changed" -eq 1 ] && rescue_agent_running; then
        pid=""
        IFS= read -r pid <"$RESCUE_PID_FILE" || true
        terminate_child "$pid" "rescue agent"
        rm -f "$RESCUE_PID_FILE"
        echo "ordax-surface: refreshed persistent rescue agent" >>"$RESCUE_LOG"
    fi

    rescue_agent_running && return 0

    if [ -x /bin/setsid ]; then
        /bin/setsid "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 </dev/null &
    else
        "$RESCUE_AGENT" >>"$RESCUE_LOG" 2>&1 </dev/null &
    fi
    /bin/busybox sleep 1
    rescue_agent_running || {
        echo "ordax-surface: rescue agent did not remain running" >>"$RESCUE_LOG"
        return 1
    }
    echo "ordax-surface: persistent rescue agent is running" >>"$RESCUE_LOG"
    return 0
}

terminate_child() {
    pid=${1:-}
    label=${2:-child}
    case "$pid" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 0
    kill -0 "$pid" >/dev/null 2>&1 || return 0

    kill "$pid" >/dev/null 2>&1 || true
    remaining=2
    while kill -0 "$pid" >/dev/null 2>&1 && [ "$remaining" -gt 0 ]; do
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
        echo "ordax-surface: forcing stale $label pid $pid" >>"$HOST_LOG"
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
}

# SIGTERM all the Surface-owned children before waiting for any of them.
# The previous serial two-second wait per broker could exceed the Supervisor's
# entire shutdown grace budget even when each child responded promptly.
# Only PIDs started by this launcher are eligible; never kill by process name.
quiesce_surface_children() {
    owned_pids=""
    for child_pid in "$NATIVE_INSTALL_BROKER_PID" "$NETWORK_BROKER_PID" "$TIME_SYNC_PID" \
                     "$POWER_BROKER_PID" "$KEYBOARD_SESSION_RESTART_BROKER_PID" \
                     "$GRAPHICS_PID" "$HTTP_PID"; do
        case "$child_pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$child_pid" -gt 1 ] 2>/dev/null || continue
        owned_pids="$owned_pids $child_pid"
        kill "$child_pid" >/dev/null 2>&1 || true
    done
    remaining=4
    while [ "$remaining" -gt 0 ]; do
        active=0
        for child_pid in $owned_pids; do
            kill -0 "$child_pid" >/dev/null 2>&1 || continue
            child_state=$(/bin/busybox awk '$1 == "State:" { print $2; exit }' "/proc/$child_pid/status" 2>/dev/null || true)
            [ "$child_state" = Z ] && continue
            active=1
            break
        done
        [ "$active" -eq 0 ] && break
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    for child_pid in $owned_pids; do
        if kill -0 "$child_pid" >/dev/null 2>&1; then
            child_state=$(/bin/busybox awk '$1 == "State:" { print $2; exit }' "/proc/$child_pid/status" 2>/dev/null || true)
            if [ "$child_state" != Z ]; then
                echo "ordax-surface: forcing unresponsive owned child pid $child_pid" >>"$HOST_LOG"
                kill -KILL "$child_pid" >/dev/null 2>&1 || true
            fi
        fi
        wait "$child_pid" 2>/dev/null || true
    done
}

runtime_root_processes() {
    [ -d "$RUNTIME_ROOT" ] || [ -d "$LEGACY_RUNTIME_ROOT" ] || return 0
    for root_link in /proc/[0-9]*/root; do
        [ -L "$root_link" ] || continue
        pid=${root_link#/proc/}
        pid=${pid%/root}
        root_target=$(/bin/busybox readlink "$root_link" 2>/dev/null || true)
        # Both directories may carry old bind mounts across a crashed boot.
        # Never select processes outside the two runtime-owned chroots.
        case "$root_target" in
            "$RUNTIME_ROOT"|"$LEGACY_RUNTIME_ROOT") printf '%s\n' "$pid" ;;
        esac
    done
}

reap_stale_runtime_processes() {
    stale_pids=$(runtime_root_processes) || return 1
    [ -n "$stale_pids" ] || return 0

    echo "ordax-surface: reaping stale processes rooted in graphical runtime" >>"$HOST_LOG"
    for pid in $stale_pids; do
        case "$pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$pid" -gt 1 ] 2>/dev/null || continue
        kill "$pid" >/dev/null 2>&1 || true
    done

    /bin/busybox sleep 1

    # Re-scan: children can exit or fork between TERM and KILL. Acting on
    # stale PIDs without rechecking their /proc/root can kill unrelated work.
    stale_pids=$(runtime_root_processes) || return 1
    for pid in $stale_pids; do
        case "$pid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$pid" -gt 1 ] 2>/dev/null || continue
        if kill -0 "$pid" >/dev/null 2>&1; then
            echo "ordax-surface: forcing stale runtime pid $pid" >>"$HOST_LOG"
            kill -KILL "$pid" >/dev/null 2>&1 || true
        fi
    done

    # SIGKILL delivery is not a release of mounts or App Data authority.
    # Prove the runtime has no remaining rooted processes before unmounting.
    remaining=5
    while [ "$remaining" -gt 0 ]; do
        stale_pids=$(runtime_root_processes) || return 1
        [ -z "$stale_pids" ] && return 0
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    stale_pids=$(runtime_root_processes) || return 1
    [ -z "$stale_pids" ] && return 0
    echo "ordax-surface: runtime processes remain after bounded SIGKILL; refusing mount teardown" >>"$HOST_LOG"
    return 1
}

clear_runtime_mounts_at() {
    runtime_root=$1
    [ -d "$runtime_root" ] || return 0
    for target in \
        "$runtime_root/srv/ordax-power-receipts" \
        "$runtime_root/var/lib/ordax-user" \
        "$runtime_root/var/lib/ordax" \
        "$runtime_root/ordax" \
        "$runtime_root/srv/ordax-repo" \
        "$runtime_root/srv/ordax-system" \
        "$runtime_root/run" \
        "$runtime_root/sys" \
        "$runtime_root/proc" \
        "$runtime_root/dev"
    do
        /bin/busybox umount "$target" >/dev/null 2>&1 || true
    done
}

clear_stale_runtime_mounts() {
    clear_runtime_mounts_at "$RUNTIME_ROOT"
    clear_runtime_mounts_at "$LEGACY_RUNTIME_ROOT"
}

seatd_process_running() {
    for comm in /proc/[0-9]*/comm; do
        [ -r "$comm" ] || continue
        process_name=""
        IFS= read -r process_name <"$comm" || true
        [ "$process_name" = "seatd" ] && return 0
    done
    return 1
}

remove_stale_seatd_socket() {
    [ -e "$SEATD_SOCKET" ] || return 0
    if [ ! -S "$SEATD_SOCKET" ]; then
        echo "ordax-surface: seatd path exists but is not a UNIX socket: $SEATD_SOCKET" >>"$HOST_LOG"
        return 1
    fi
    if seatd_process_running; then
        echo "ordax-surface: seatd socket is owned by a running seatd process; refusing to remove it" >>"$HOST_LOG"
        return 1
    fi
    echo "ordax-surface: removing stale seatd socket $SEATD_SOCKET" >>"$HOST_LOG"
    rm -f "$SEATD_SOCKET" >>"$HOST_LOG" 2>&1 || return 1
    return 0
}

cleanup() {
    rm -f "$RUNTIME_PROOF_CONTEXT" >/dev/null 2>&1 || true
    quiesce_surface_children
    NATIVE_INSTALL_BROKER_PID=""
    NETWORK_BROKER_PID=""
    TIME_SYNC_PID=""
    POWER_BROKER_PID=""
    KEYBOARD_SESSION_RESTART_BROKER_PID=""
    GRAPHICS_PID=""
    HTTP_PID=""
    rm -f "$NATIVE_INSTALL_CONTROL" "$NATIVE_INSTALL_REQUEST" "$NATIVE_INSTALL_RESPONSE" "$NATIVE_INSTALL_SNAPSHOT" >/dev/null 2>&1 || true
    rm -f "$NETWORK_CONTROL" "$NETWORK_REQUEST" "$NETWORK_RESPONSE" "$NETWORK_SCAN_RAW" "$NETWORK_LINK_RAW" "$NETWORK_SAVED_SSID" >/dev/null 2>&1 || true
    rm -f "$POWER_REQUEST" "$KEYBOARD_SESSION_RESTART_REQUEST" >/dev/null 2>&1 || true
    if ! reap_stale_runtime_processes; then
        # Preserve mounted state rather than unmount resources still used by
        # an unverified live process. The next owner must fail closed too.
        echo "ordax-surface: cleanup refused; runtime chroot remains active" >>"$HOST_LOG"
        exit 1
    fi
    if [ "$UDEV_ACTIVE" -eq 1 ] && [ -x "$RUNTIME_ROOT/bin/udevadm" ]; then
        /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm control --exit >/dev/null 2>&1 || true
        UDEV_ACTIVE=0
    fi
    if [ -S "$SEATD_SOCKET" ] && ! seatd_process_running; then
        rm -f "$SEATD_SOCKET" >/dev/null 2>&1 || true
    fi
    if [ "$POWER_RECEIPTS_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT$POWER_RECEIPTS_MOUNT_RELATIVE" >/dev/null 2>&1 || true
        POWER_RECEIPTS_BOUND=0
    fi
    if [ "$ORDAX_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/ordax" >/dev/null 2>&1 || true
        ORDAX_BOUND=0
    fi
    if [ "$REPO_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/srv/ordax-repo" >/dev/null 2>&1 || true
        REPO_BOUND=0
    fi
    if [ "$SYSTEM_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/srv/ordax-system" >/dev/null 2>&1 || true
        SYSTEM_BOUND=0
    fi
    if [ "$USER_HOME_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/var/lib/ordax-user" >/dev/null 2>&1 || true
        USER_HOME_BOUND=0
    fi
    if [ "$STATE_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/var/lib/ordax" >/dev/null 2>&1 || true
        STATE_BOUND=0
    fi
    if [ "$RUN_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/run" >/dev/null 2>&1 || true
        RUN_BOUND=0
    fi
    if [ "$SYS_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/sys" >/dev/null 2>&1 || true
        SYS_BOUND=0
    fi
    if [ "$PROC_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/proc" >/dev/null 2>&1 || true
        PROC_BOUND=0
    fi
    if [ "$DEV_BOUND" -eq 1 ]; then
        /bin/busybox umount "$RUNTIME_ROOT/dev" >/dev/null 2>&1 || true
        DEV_BOUND=0
    fi
    if [ -n "$STAGING_DIR" ] && [ -d "$STAGING_DIR" ]; then
        rm -rf "$STAGING_DIR"
        STAGING_DIR=""
    fi
    rm -f "$RUNTIME_PROVISIONING_FILE" >/dev/null 2>&1 || true
}

terminate() {
    trap - EXIT HUP INT TERM
    cleanup
    exit 0
}

trap cleanup EXIT
trap terminate HUP INT TERM

console_fallback() {
    cleanup
    printf '\033[2J\033[H'
    printf 'OrdaX\n'
    printf 'Surface native host fallback\n'
    printf 'Release root: %s\n' "${SYSTEM_ROOT:-unknown}"
    printf 'Mode: %s\n' "${ORDAX_SURFACE_MODE:-unknown}"
    printf '\nThe graphical host could not be started.\n'
    printf 'Host log: %s\n' "$HOST_LOG"
    printf 'HTTP log: %s\n' "$HTTP_LOG"
    if [ -s "$HOST_LOG" ]; then
        printf '\nDiagnostic:\n'
        /bin/busybox tail -n 28 "$HOST_LOG" 2>/dev/null || cat "$HOST_LOG" 2>/dev/null || true
    fi
    if [ -s "$HTTP_LOG" ]; then
        printf '\nHTTP diagnostic:\n'
        /bin/busybox tail -n 20 "$HTTP_LOG" 2>/dev/null || cat "$HTTP_LOG" 2>/dev/null || true
    fi
    printf '\nThe checked-out system remains available for maintenance.\n'
    trap 'exit 0' HUP INT TERM
    while :; do sleep 3600; done
}

fallback_with_reason() {
    printf 'ordax-surface: %s\n' "$*" >>"$HOST_LOG"
    console_fallback
}

runtime_base_is_ready() {
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ] ||
       [ "$VERIFIED_RUNTIME_MODE" = "verified-erofs-overlay" ]; then
        [ "$VERIFIED_RUNTIME_MODE" = "verified-erofs-overlay" ] || return 1
        [ "$RUNTIME_ROOT" = "$VERIFIED_RUNTIME_ROOT" ] || return 1
    else
        [ -f "$RUNTIME_READY" ] || return 1
    fi
    [ -x "$RUNTIME_ROOT/usr/bin/cage" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/python3" ] &&
        [ -f "$RUNTIME_ROOT/usr/lib/girepository-1.0/Gtk-3.0.typelib" ] &&
        [ -f "$RUNTIME_ROOT/usr/lib/girepository-1.0/WebKit2-4.1.typelib" ] &&
        [ -x "$RUNTIME_ROOT/usr/bin/seatd-launch" ] &&
        [ -x "$RUNTIME_ROOT/bin/busybox" ]
}

runtime_is_ready() {
    runtime_base_is_ready &&
        [ -x "$RUNTIME_ROOT/usr/bin/Xwayland" ] &&
        [ -x "$RUNTIME_ROOT/sbin/udevd" ] &&
        [ -x "$RUNTIME_ROOT/bin/udevadm" ] &&
        [ -f "$RUNTIME_ROOT/usr/lib/udev/rules.d/60-input-id.rules" ]
}

staged_runtime_is_ready() {
    staged_root=$1
    [ -x "$staged_root/usr/bin/cage" ] &&
        [ -x "$staged_root/usr/bin/python3" ] &&
        [ -f "$staged_root/usr/lib/girepository-1.0/Gtk-3.0.typelib" ] &&
        [ -f "$staged_root/usr/lib/girepository-1.0/WebKit2-4.1.typelib" ] &&
        [ -x "$staged_root/usr/bin/Xwayland" ] &&
        [ -x "$staged_root/sbin/udevd" ] &&
        [ -x "$staged_root/bin/udevadm" ] &&
        [ -f "$staged_root/usr/lib/udev/rules.d/60-input-id.rules" ] &&
        [ -x "$staged_root/usr/bin/seatd-launch" ] &&
        [ -x "$staged_root/bin/busybox" ]
}

commit_staged_runtime() {
    staged_root=$STAGING_DIR/rootfs
    staged_runtime_is_ready "$staged_root" || {
        echo "ordax-surface: staged graphical runtime failed readiness validation" >>"$HOST_LOG"
        return 1
    }
    for directory in dev proc sys run tmp root ordax srv/ordax-system srv/ordax-repo var/lib/ordax var/lib/ordax-user; do
        mkdir -p "$staged_root/$directory"
    done
    chmod 1777 "$staged_root/tmp" 2>/dev/null || true
    printf '%s\n' "$RUNTIME_ID" >"$STAGING_DIR/ready"
    rm -rf "$RUNTIME_STATE/$RUNTIME_ID"
    mv "$STAGING_DIR" "$RUNTIME_STATE/$RUNTIME_ID"
    STAGING_DIR=""
    return 0
}

legacy_runtime_can_seed() {
    [ -f "$LEGACY_RUNTIME_READY" ] &&
        [ -d "$LEGACY_RUNTIME_ROOT" ] &&
        [ -x "$LEGACY_RUNTIME_ROOT/usr/bin/cage" ] &&
        [ -x "$LEGACY_RUNTIME_ROOT/usr/bin/python3" ] &&
        [ -x "$LEGACY_RUNTIME_ROOT/usr/bin/seatd-launch" ] &&
        [ -x "$LEGACY_RUNTIME_ROOT/bin/busybox" ]
}

migrate_legacy_runtime() {
    legacy_runtime_can_seed || return 1
    [ -x /sbin/apk ] || return 1
    clear_runtime_mounts_at "$LEGACY_RUNTIME_ROOT"
    mkdir -p "$RUNTIME_STATE"
    STAGING_DIR=$RUNTIME_STATE/.staging-$$
    rm -rf "$STAGING_DIR"
    mkdir -p "$STAGING_DIR"
    printf 'OrdaX: migrando runtime grafico local...\n'
    echo "ordax-surface: seeding WebKit runtime from $LEGACY_RUNTIME_ID" >>"$HOST_LOG"

    if ! /bin/busybox cp -a "$LEGACY_RUNTIME_ROOT" "$STAGING_DIR/rootfs" >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: failed to copy legacy graphical runtime seed" >>"$HOST_LOG"
        rm -rf "$STAGING_DIR"
        STAGING_DIR=""
        return 1
    fi

    if ! run_bounded_apk "$RUNTIME_UPGRADE_TIMEOUT" \
        --root "$STAGING_DIR/rootfs" --keys-dir /etc/apk/keys --no-cache add \
        xwayland eudev libinput-udev python3 py3-gobject3 gtk+3.0 webkit2gtk-4.1 \
        >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: legacy runtime migration timed out or failed" >>"$HOST_LOG"
        rm -rf "$STAGING_DIR"
        STAGING_DIR=""
        return 1
    fi

    commit_staged_runtime
}

install_runtime() {
    [ -x /sbin/apk ] || { echo "ordax-surface: /sbin/apk is unavailable in the Git bootstrap base" >>"$HOST_LOG"; return 1; }
    [ -d /etc/apk/keys ] || { echo "ordax-surface: Alpine trusted keys are unavailable" >>"$HOST_LOG"; return 1; }
    set -- /etc/apk/keys/*.pub
    [ -f "$1" ] || { echo "ordax-surface: Alpine trusted public keys are unavailable" >>"$HOST_LOG"; return 1; }

    mkdir -p "$RUNTIME_STATE"
    STAGING_DIR=$RUNTIME_STATE/.staging-$$
    rm -rf "$STAGING_DIR"
    mkdir -p "$STAGING_DIR/rootfs/etc/apk/keys"
    for key in /etc/apk/keys/*.pub; do cp "$key" "$STAGING_DIR/rootfs/etc/apk/keys/"; done
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
        mkdir -p "$STAGING_DIR/rootfs/etc/ssl/certs"
        cp /etc/ssl/certs/ca-certificates.crt "$STAGING_DIR/rootfs/etc/ssl/certs/"
    fi
    cat >"$STAGING_DIR/rootfs/etc/apk/repositories" <<'REPOSITORIES'
https://dl-cdn.alpinelinux.org/alpine/v3.22/main
https://dl-cdn.alpinelinux.org/alpine/v3.22/community
REPOSITORIES

    printf 'OrdaX: preparando novo runtime grafico...\n'
    echo "ordax-surface: provisioning replaceable graphical runtime in $RUNTIME_STATE" >>"$HOST_LOG"
    if ! run_bounded_apk "$RUNTIME_INSTALL_TIMEOUT" \
        --root "$STAGING_DIR/rootfs" --keys-dir /etc/apk/keys --no-cache --initdb add \
        alpine-baselayout busybox ca-certificates cage xwayland \
        python3 py3-gobject3 gtk+3.0 webkit2gtk-4.1 \
        seatd-launch mesa-dri-gallium mesa-egl mesa-gbm font-dejavu \
        eudev libinput-udev >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: graphical runtime provisioning timed out or failed" >>"$HOST_LOG"
        rm -rf "$STAGING_DIR"
        STAGING_DIR=""
        return 1
    fi

    commit_staged_runtime
}

upgrade_existing_runtime() {
    printf 'OrdaX: atualizando runtime grafico existente...\n'
    echo "ordax-surface: extending existing graphical runtime with WebKit browser host support" >>"$HOST_LOG"
    if ! run_bounded_apk "$RUNTIME_UPGRADE_TIMEOUT" \
        --root "$RUNTIME_ROOT" --keys-dir /etc/apk/keys --no-cache add \
        xwayland eudev libinput-udev python3 py3-gobject3 gtk+3.0 webkit2gtk-4.1 >>"$HOST_LOG" 2>&1; then
        echo "ordax-surface: graphical runtime upgrade timed out or failed" >>"$HOST_LOG"
        return 1
    fi
    runtime_is_ready
}

ensure_runtime() {
    # Owner USB reuses the canonical verified EROFS/overlay handoff. A missing
    # or invalid preseed must fail closed: never fall through to APK downloads.
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] &&
       [ "$VERIFIED_RUNTIME_MODE" = "verified-erofs-overlay" ]; then
        runtime_is_ready || {
            echo "ordax-surface: Owner USB offline graphical runtime is invalid" >>"$HOST_LOG"
            return 1
        }
        echo "ordax-surface: using preverified Owner USB EROFS runtime" >>"$HOST_LOG"
        return 0
    fi
    if [ "$DISTRIBUTION_PROFILE" = "stable-mvp" ]; then
        runtime_is_ready || {
            echo "ordax-surface: Stable/MVP requires the preverified offline graphical runtime" >>"$HOST_LOG"
            return 1
        }
        echo "ordax-surface: using verified immutable Surface runtime with ephemeral overlay" >>"$HOST_LOG"
        return 0
    fi

    runtime_is_ready && return 0
    if runtime_base_is_ready; then
        upgrade_existing_runtime || return 1
        return 0
    fi
    if migrate_legacy_runtime; then
        runtime_is_ready
        return $?
    fi
    install_runtime || return 1
    runtime_is_ready
}

ensure_loopback() {
    [ -x /sbin/ip ] || { echo "ordax-surface: /sbin/ip is unavailable; cannot configure loopback" >>"$HOST_LOG"; return 1; }
    /sbin/ip link set dev lo up >>"$HOST_LOG" 2>&1 || return 1
    /sbin/ip address replace 127.0.0.1/8 dev lo >>"$HOST_LOG" 2>&1 || return 1
}

sync_runtime_resolver() {
    resolver_sync=$SYSTEM_ROOT/surface/runtime/resolver_sync.sh
    [ -f "$resolver_sync" ] && [ ! -L "$resolver_sync" ] || return 1
    /bin/sh "$resolver_sync" "$RUNTIME_ROOT" "$HOST_LOG"
}

ensure_shared_memory() {
    mkdir -p /dev/shm >>"$HOST_LOG" 2>&1 || return 1
    chmod 1777 /dev/shm >>"$HOST_LOG" 2>&1 || return 1
}

is_source_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    return 0
}

resolve_source_identity() {
    repo_root=${SYSTEM_ROOT%/system}
    case "$DISTRIBUTION_PROFILE" in
        stable-mvp)
            is_source_sha "$SOURCE_SHA_HINT" || {
                echo "ordax-surface: Stable/MVP source SHA is invalid" >>"$HOST_LOG"
                return 1
            }
            SOURCE_SHA=$SOURCE_SHA_HINT
            ;;
        owner-development)
            is_source_sha "$SOURCE_SHA_HINT" || {
                echo "ordax-surface: Owner/Development source SHA hint is invalid" >>"$HOST_LOG"
                return 1
            }
            [ "$repo_root" != "$SYSTEM_ROOT" ] && [ -x /usr/bin/git ] || {
                echo "ordax-surface: Owner/Development source repository is unavailable" >>"$HOST_LOG"
                return 1
            }
            candidate_sha=$(/usr/bin/git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown')
            is_source_sha "$candidate_sha" || {
                echo "ordax-surface: Owner/Development checkout SHA is invalid" >>"$HOST_LOG"
                return 1
            }
            [ "$candidate_sha" = "$SOURCE_SHA_HINT" ] || {
                echo "ordax-surface: Owner/Development checkout SHA does not match supervised source SHA" >>"$HOST_LOG"
                return 1
            }
            SOURCE_SHA=$candidate_sha
            ;;
        *)
            echo "ordax-surface: unknown distribution profile" >>"$HOST_LOG"
            return 1
            ;;
    esac
    return 0
}

configure_graphics_host() {
    is_source_sha "$SOURCE_SHA" || {
        echo "ordax-surface: exact source identity was not resolved before graphics setup" >>"$HOST_LOG"
        return 1
    }
    [ -f "$SYSTEM_ROOT/surface/runtime/ordax_browser_host.py" ] || return 1
    mkdir -p "$RUNTIME_ROOT/tmp/ordax-web-cache-$SOURCE_SHA" || return 1
}

bind_runtime_mounts() {
    repo_root=${SYSTEM_ROOT%/system}
    case "$DISTRIBUTION_PROFILE" in
        owner-development)
            [ -n "$repo_root" ] && [ "$repo_root" != "$SYSTEM_ROOT" ] && [ -d "$repo_root" ] || {
                echo "ordax-surface: Owner/Development source repository root is unavailable" >>"$HOST_LOG"
                return 1
            }
            ;;
        stable-mvp)
            # Stable/MVP owns a verified /system tree, not a Git checkout.
            # Do not require or fabricate a development repository bind in the final USB.
            repo_root=
            ;;
        *)
            echo "ordax-surface: unsupported distribution profile for runtime bindings" >>"$HOST_LOG"
            return 1
            ;;
    esac

    [ -d "$SYSTEM_ROOT" ] && [ -d /ordax ] || return 1
    mkdir -p \
        "$RUNTIME_ROOT/srv/ordax-system" \
        "$RUNTIME_ROOT/ordax" \
        "$RUNTIME_ROOT/var/lib/ordax" \
        "$RUNTIME_ROOT/var/lib/ordax-user" \
        "$PERSISTENT_NATIVE_STATE" \
        "$PERSISTENT_USER_HOME" || return 1
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
        mkdir -p "$RUNTIME_ROOT/srv/ordax-repo" || return 1
    fi
    chmod 700 "$PERSISTENT_NATIVE_STATE" "$PERSISTENT_USER_HOME" || return 1
    /bin/busybox mount -o bind "$SYSTEM_ROOT" "$RUNTIME_ROOT/srv/ordax-system" >>"$HOST_LOG" 2>&1 || return 1
    SYSTEM_BOUND=1
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
        /bin/busybox mount -o bind "$repo_root" "$RUNTIME_ROOT/srv/ordax-repo" >>"$HOST_LOG" 2>&1 || return 1
        REPO_BOUND=1
    fi
    /bin/busybox mount -o bind /ordax "$RUNTIME_ROOT/ordax" >>"$HOST_LOG" 2>&1 || return 1
    ORDAX_BOUND=1
    /bin/busybox mount -o bind "$PERSISTENT_NATIVE_STATE" "$RUNTIME_ROOT/var/lib/ordax" >>"$HOST_LOG" 2>&1 || return 1
    STATE_BOUND=1
    /bin/busybox mount -o bind "$PERSISTENT_USER_HOME" "$RUNTIME_ROOT/var/lib/ordax-user" >>"$HOST_LOG" 2>&1 || return 1
    USER_HOME_BOUND=1
    /bin/busybox mount -o bind /dev "$RUNTIME_ROOT/dev" >>"$HOST_LOG" 2>&1 || return 1
    DEV_BOUND=1
    /bin/busybox mount -o bind /proc "$RUNTIME_ROOT/proc" >>"$HOST_LOG" 2>&1 || return 1
    PROC_BOUND=1
    /bin/busybox mount -o bind /sys "$RUNTIME_ROOT/sys" >>"$HOST_LOG" 2>&1 || return 1
    SYS_BOUND=1
    /bin/busybox mount -o bind /run "$RUNTIME_ROOT/run" >>"$HOST_LOG" 2>&1 || return 1
    RUN_BOUND=1
    # Owner USB receipts are written by the Guardian in /state/ordax/power.
    # The graphical chroot's /ordax bind is NOT a contract for that host path.
    # Bind only the dedicated state directory, never the whole host state tree.
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ] && [ "$PRODUCT_MODE" = "usb" ]; then
        [ -d "$POWER_STATE_DIR" ] && [ ! -L "$POWER_STATE_DIR" ] || return 1
        receipts_target=$RUNTIME_ROOT$POWER_RECEIPTS_MOUNT_RELATIVE
        [ ! -L "$receipts_target" ] || return 1
        mkdir -p "$receipts_target" || return 1
        /bin/busybox mount -o bind "$POWER_STATE_DIR" "$receipts_target" >>"$HOST_LOG" 2>&1 || return 1
        POWER_RECEIPTS_BOUND=1
        /bin/busybox mount -o remount,bind,ro "$receipts_target" >>"$HOST_LOG" 2>&1 || return 1
        # Verify the mount flags, rather than guessing from the superblock.
        receipts_options=$(/bin/busybox awk -v path="$receipts_target" '$2 == path { print $4; exit }' /proc/mounts 2>/dev/null || true)
        case ",$receipts_options," in
            *,ro,*) ;;
            *) echo "ordax-surface: power receipts mount is not read-only" >>"$HOST_LOG"; return 1 ;;
        esac
    fi
}

bootstrap_verified_app_install_identities() {
    case "$DISTRIBUTION_PROFILE" in
        stable-mvp)
            /bin/busybox chroot "$RUNTIME_ROOT" \
                /usr/bin/python3 /srv/ordax-system/surface/runtime/native_app_install_identity_bootstrap.py \
                >>"$HOST_LOG" 2>&1 || return 1
            ;;
        owner-development)
            rm -f "$SESSION_DIR/app-install-identities.json" >/dev/null 2>&1 || return 1
            echo "ordax-surface: verified app install identity bootstrap is unavailable in Owner/Development without a verified system-release handoff; App Data binding remains disabled" >>"$HOST_LOG"
            return 0
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

publish_runtime_proof_context() {
    runtime_mode=
    evidence_scope=
    runtime_sha256=

    case "$DISTRIBUTION_PROFILE" in
        owner-development)
            evidence_scope=development
            if [ "$VERIFIED_RUNTIME_MODE" = "verified-erofs-overlay" ]; then
                [ "$RUNTIME_ROOT" = "/run/ordax/runtime/native-surface/rootfs" ] || return 1
                [ "${#VERIFIED_RUNTIME_SHA256}" -eq 64 ] || return 1
                case "$VERIFIED_RUNTIME_SHA256" in
                    *[!0-9a-f]*) return 1 ;;
                esac
                runtime_mode=verified-erofs-overlay
                runtime_sha256=$VERIFIED_RUNTIME_SHA256
            else
                [ -z "$VERIFIED_RUNTIME_MODE" ] || return 1
                runtime_mode=dynamic-native-runtime
            fi
            ;;
        stable-mvp)
            [ "$VERIFIED_RUNTIME_MODE" = "verified-erofs-overlay" ] || return 1
            [ "$RUNTIME_ROOT" = "/run/ordax/runtime/native-surface/rootfs" ] || return 1
            [ "${#VERIFIED_RUNTIME_SHA256}" -eq 64 ] || return 1
            case "$VERIFIED_RUNTIME_SHA256" in
                *[!0-9a-f]*) return 1 ;;
            esac
            runtime_mode=verified-erofs-overlay
            evidence_scope=canonical-stable-mvp
            runtime_sha256=$VERIFIED_RUNTIME_SHA256
            ;;
        *)
            return 1
            ;;
    esac

    temporary=$RUNTIME_PROOF_CONTEXT.tmp.$$
    {
        printf 'distribution_profile=%s\n' "$DISTRIBUTION_PROFILE"
        printf 'runtime_mode=%s\n' "$runtime_mode"
        printf 'evidence_scope=%s\n' "$evidence_scope"
        printf 'runtime_sha256=%s\n' "$runtime_sha256"
    } >"$temporary" || {
        rm -f "$temporary" >/dev/null 2>&1 || true
        return 1
    }
    chmod 600 "$temporary" || {
        rm -f "$temporary" >/dev/null 2>&1 || true
        return 1
    }
    /bin/busybox mv -f "$temporary" "$RUNTIME_PROOF_CONTEXT" || {
        rm -f "$temporary" >/dev/null 2>&1 || true
        return 1
    }
    return 0
}

supervise_network_broker() (
    # A failed broker must not strand network management for the rest of a
    # graphical session. Keep its lifecycle under the existing Surface owner.
    broker_pid=""
    stop_broker_supervisor() {
        trap - HUP INT TERM
        if [ -n "$broker_pid" ]; then
            kill -TERM "$broker_pid" >/dev/null 2>&1 || true
            wait "$broker_pid" >/dev/null 2>&1 || true
        fi
        exit 0
    }
    trap 'stop_broker_supervisor' HUP INT TERM
    while :; do
        ORDAX_NETWORK_STATE_DIR=${ORDAX_NETWORK_STATE_DIR:-/state/network} \
        ORDAX_NETWORK_SESSION_DIR="$SESSION_DIR" \
        ORDAX_RUNTIME_RESOLVER_SYNC_SCRIPT="$SYSTEM_ROOT/surface/runtime/resolver_sync.sh" \
        ORDAX_RUNTIME_RESOLVER_ROOT="$RUNTIME_ROOT" \
        ORDAX_RUNTIME_RESOLVER_LOG="$NETWORK_LOG" \
            /bin/sh "$NETWORK_BROKER_SOURCE" >>"$NETWORK_LOG" 2>&1 &
        broker_pid=$!
        broker_exit=0
        wait "$broker_pid" || broker_exit=$?
        broker_pid=""
        echo "ordax-surface: Wi-Fi broker exited (status=$broker_exit); restarting its IPC owner" >>"$NETWORK_LOG"
        /bin/busybox sleep 3
    done
)

start_network_broker() {
    [ -f "$NETWORK_BROKER_SOURCE" ] && [ ! -L "$NETWORK_BROKER_SOURCE" ] || return 1
    rm -f "$NETWORK_CONTROL" "$NETWORK_REQUEST" "$NETWORK_RESPONSE" "$NETWORK_SCAN_RAW" "$NETWORK_LINK_RAW" "$NETWORK_SAVED_SSID" >/dev/null 2>&1 || true
    supervise_network_broker &
    NETWORK_BROKER_PID=$!

    remaining=20
    while [ "$remaining" -gt 0 ]; do
        kill -0 "$NETWORK_BROKER_PID" >/dev/null 2>&1 || return 1
        [ -p "$NETWORK_CONTROL" ] && return 0
        /bin/busybox sleep 0.1
        remaining=$((remaining - 1))
    done
    # The supervisor continues bounded retries without blocking boot.
    return 1
}

start_native_install_broker() {
    [ "$NATIVE_INSTALL_CAPABILITY" = "post-mvp-preview" ] || return 0
    [ "$DISTRIBUTION_PROFILE" = "owner-development" ] || return 0
    [ "$PRODUCT_MODE" = "usb" ] || return 0
    [ -f "$NATIVE_INSTALL_BROKER_SOURCE" ] && [ ! -L "$NATIVE_INSTALL_BROKER_SOURCE" ] || return 1
    [ -x "$NATIVE_INSTALL_HELPER" ] && [ ! -L "$NATIVE_INSTALL_HELPER" ] || {
        echo "ordax-surface: signed Native install helper unavailable; installer remains disabled" >>"$NATIVE_INSTALL_LOG"
        return 0
    }

    rm -f "$NATIVE_INSTALL_CONTROL" "$NATIVE_INSTALL_REQUEST" "$NATIVE_INSTALL_RESPONSE" "$NATIVE_INSTALL_SNAPSHOT" >/dev/null 2>&1 || true
    ORDAX_NATIVE_INSTALL_SESSION_DIR="$SESSION_DIR" \
    ORDAX_NATIVE_INSTALL_HELPER="$NATIVE_INSTALL_HELPER" \
        /bin/sh "$NATIVE_INSTALL_BROKER_SOURCE" >>"$NATIVE_INSTALL_LOG" 2>&1 &
    NATIVE_INSTALL_BROKER_PID=$!

    remaining=20
    while [ "$remaining" -gt 0 ]; do
        kill -0 "$NATIVE_INSTALL_BROKER_PID" >/dev/null 2>&1 || return 1
        [ -p "$NATIVE_INSTALL_CONTROL" ] && return 0
        /bin/busybox sleep 0.1
        remaining=$((remaining - 1))
    done
    return 1
}

supervise_time_sync_agent() (
    # The clock must recover AFTER network readiness. Launching ntpd once
    # before a saved Wi-Fi connection exists could leave the 2015 RTC intact
    # for the entire graphical session after a transient DNS failure.
    ntp_pid=""
    stop_clock_supervisor() {
        trap - HUP INT TERM
        if [ -n "$ntp_pid" ]; then
            kill -TERM "$ntp_pid" >/dev/null 2>&1 || true
            wait "$ntp_pid" >/dev/null 2>&1 || true
        fi
        exit 0
    }
    trap 'stop_clock_supervisor' HUP INT TERM
    while :; do
        if ! /bin/busybox ip -4 addr show scope global 2>/dev/null |
            /bin/busybox grep -q ' inet '; then
            /bin/busybox sleep 5
            continue
        fi
        /bin/busybox ntpd -n \
            -p time.cloudflare.com \
            -p time.google.com \
            -p pool.ntp.org \
            >>"$TIME_SYNC_LOG" 2>&1 &
        ntp_pid=$!
        wait "$ntp_pid" >/dev/null 2>&1 || true
        ntp_pid=""
        echo "ordax-surface: clock synchronization exited; retrying after network recovery" >>"$TIME_SYNC_LOG"
        /bin/busybox sleep 15
    done
)

start_time_sync_agent() {
    supervise_time_sync_agent &
    TIME_SYNC_PID=$!
    kill -0 "$TIME_SYNC_PID" >/dev/null 2>&1
}

configure_keyboard_layout() {
    keyboard_layout_id=br-abnt2
    if [ -r "$KEYBOARD_LAYOUT_STATE" ] && [ ! -L "$KEYBOARD_LAYOUT_STATE" ]; then
        configured_layout=""
        IFS= read -r configured_layout <"$KEYBOARD_LAYOUT_STATE" || configured_layout=""
        case "$configured_layout" in
            br-abnt2|us)
                keyboard_layout_id=$configured_layout
                ;;
            "")
                ;;
            *)
                echo "ordax-surface: invalid persisted keyboard layout; using br-abnt2" >>"$HOST_LOG"
                ;;
        esac
    fi

    XKB_DEFAULT_RULES=evdev
    XKB_DEFAULT_VARIANT=
    XKB_DEFAULT_OPTIONS=
    case "$keyboard_layout_id" in
        us)
            XKB_DEFAULT_MODEL=pc105
            XKB_DEFAULT_LAYOUT=us
            ;;
        *)
            keyboard_layout_id=br-abnt2
            XKB_DEFAULT_MODEL=abnt2
            XKB_DEFAULT_LAYOUT=br
            ;;
    esac

    ORDAX_KEYBOARD_LAYOUT_ID=$keyboard_layout_id
    export XKB_DEFAULT_RULES XKB_DEFAULT_MODEL XKB_DEFAULT_LAYOUT
    export XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS ORDAX_KEYBOARD_LAYOUT_ID
    echo "ordax-surface: keyboard layout applied for Cage: $ORDAX_KEYBOARD_LAYOUT_ID" >>"$HOST_LOG"
    return 0
}

write_power_request_record() {
    action=${1:-}
    request_boot_id=${2:-}
    request_epoch=${3:-0}
    status=${4:-pending}
    case "$action" in
        restart|shutdown) ;;
        *) return 1 ;;
    esac
    case "$request_boot_id" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#request_boot_id}" -le 128 ] || return 1
    case "$request_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac
    case "$status" in
        pending|stopping|syncing|rebooting|powering-off|failed) ;;
        *) return 1 ;;
    esac

    temporary=$POWER_LAST_REQUEST.tmp.$$
    printf '%s|%s|%s|%s\n' "$action" "$request_boot_id" "$request_epoch" "$status" >"$temporary" || return 1
    chmod 600 "$temporary" || return 1
    /bin/busybox mv -f "$temporary" "$POWER_LAST_REQUEST" || return 1
    return 0
}

current_power_boot_id() {
    current_boot_id=""
    if [ -s /run/ordax-update/base-boot-id ]; then
        IFS= read -r current_boot_id </run/ordax-update/base-boot-id || true
    fi
    case "$current_boot_id" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#current_boot_id}" -le 128 ] || return 1
    printf '%s\n' "$current_boot_id"
}

record_power_request() {
    action=${1:-}
    status=${2:-pending}
    request_boot_id=$(current_power_boot_id 2>/dev/null || true)
    [ -n "$request_boot_id" ] || return 1
    request_epoch=$(/bin/busybox date +%s 2>/dev/null || true)
    case "$request_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac
    write_power_request_record "$action" "$request_boot_id" "$request_epoch" "$status"
}

reconcile_stale_power_request() {
    [ -s "$POWER_LAST_REQUEST" ] || return 0

    action=""
    request_boot_id=""
    request_epoch=""
    status=""
    IFS='|' read -r action request_boot_id request_epoch status <"$POWER_LAST_REQUEST" || return 0
    case "$status" in
        pending|stopping|syncing|rebooting|powering-off) ;;
        *) return 0 ;;
    esac
    case "$action" in restart|shutdown) ;; *) return 0 ;; esac
    case "$request_boot_id" in ''|*[!0-9a-f]*) return 0 ;; esac
    case "$request_epoch" in ''|*[!0-9]*) return 0 ;; esac

    current_boot_id=$(current_power_boot_id 2>/dev/null || true)
    [ -n "$current_boot_id" ] || return 0

    # A different boot id is positive cross-boot evidence. Do not rewrite it as
    # failure; the telemetry owner will report lastPowerRequestCrossedBoot=true.
    [ "$request_boot_id" = "$current_boot_id" ] || return 0

    now=$(/bin/busybox date +%s 2>/dev/null || true)
    case "$now" in ''|*[!0-9]*) return 0 ;; esac
    age=$((now - request_epoch))
    [ "$age" -ge "$POWER_PENDING_STALE_SECONDS" ] 2>/dev/null || return 0

    if write_power_request_record "$action" "$request_boot_id" "$request_epoch" failed; then
        echo "ordax-surface: stale $action request remained in the same boot for ${age}s; marked failed" >>"$HOST_LOG"
    fi
}

forward_host_power_request() {
    action=$1
    case "$action" in restart|shutdown) ;; *) return 1 ;; esac
    [ -p "$HOST_POWER_REQUEST" ] || {
        echo "ordax-surface: host power owner channel is unavailable" >>"$HOST_LOG"
        return 1
    }
    # A FIFO can survive its Guardian reader. Plain shell redirection would
    # block indefinitely if the host owner dies after the UI accepts a request.
    # Keep the destructive handoff bounded and report failure to the broker.
    if ! /bin/busybox timeout -k 1 3 /bin/sh -c \
        'printf "%s\\n" "$1" >"$2"' sh "$action" "$HOST_POWER_REQUEST"; then
        echo "ordax-surface: host power owner did not accept $action within timeout" >>"$HOST_LOG"
        return 1
    fi
    return 0
}

prepare_keyboard_session_restart_broker() {
    rm -f "$KEYBOARD_SESSION_RESTART_REQUEST" >/dev/null 2>&1 || true
    /bin/busybox mkfifo "$KEYBOARD_SESSION_RESTART_REQUEST" >>"$HOST_LOG" 2>&1 || return 1
    chmod 600 "$KEYBOARD_SESSION_RESTART_REQUEST" >>"$HOST_LOG" 2>&1 || return 1

    (
        exec 8<>"$KEYBOARD_SESSION_RESTART_REQUEST" || exit 1
        while :; do
            requested_layout=""
            if IFS= read -r requested_layout <&8; then
                case "$requested_layout" in
                    br-abnt2|us) ;;
                    *) continue ;;
                esac
                [ -r "$KEYBOARD_LAYOUT_STATE" ] && [ ! -L "$KEYBOARD_LAYOUT_STATE" ] || continue
                configured_layout=""
                IFS= read -r configured_layout <"$KEYBOARD_LAYOUT_STATE" || configured_layout=""
                [ "$configured_layout" = "$requested_layout" ] || continue
                [ "$configured_layout" != "$ORDAX_KEYBOARD_LAYOUT_ID" ] || continue
                echo "ordax-surface: applying configured keyboard at next graphical session" >>"$HOST_LOG"
                # Allow the HTTP response to drain, then revalidate: a later
                # configure() may have replaced the pending layout meanwhile.
                /bin/busybox sleep 2
                [ -r "$KEYBOARD_LAYOUT_STATE" ] && [ ! -L "$KEYBOARD_LAYOUT_STATE" ] || continue
                latest_layout=""
                IFS= read -r latest_layout <"$KEYBOARD_LAYOUT_STATE" || latest_layout=""
                [ "$latest_layout" = "$requested_layout" ] || continue
                /bin/busybox kill -TERM "$SURFACE_PID" >/dev/null 2>&1 || true
                exit 0
            else
                /bin/busybox sleep 1
            fi
        done
    ) &
    KEYBOARD_SESSION_RESTART_BROKER_PID=$!
    kill -0 "$KEYBOARD_SESSION_RESTART_BROKER_PID" >/dev/null 2>&1 || return 1
}

prepare_power_broker() {
    # Remove any stale local capability before checking the Guardian.
    # Otherwise a previous FIFO could still be visible to the Native server.
    rm -f "$POWER_REQUEST" >/dev/null 2>&1 || return 1
    # Never advertise a functioning power control when its actual root-owned
    # Guardian channel is missing. The graphical desktop must still boot.
    [ -p "$HOST_POWER_REQUEST" ] || {
        echo "ordax-surface: Guardian host power channel absent; controls disabled" >>"$HOST_LOG"
        return 1
    }
    /bin/busybox mkfifo "$POWER_REQUEST" >>"$HOST_LOG" 2>&1 || return 1
    chmod 600 "$POWER_REQUEST" >>"$HOST_LOG" 2>&1 || return 1

    (
        exec 9<>"$POWER_REQUEST" || exit 1
        while :; do
            action=""
            if IFS= read -r action <&9; then
                case "$action" in
                    restart)
                        echo "ordax-surface: host power broker accepted restart" >>"$HOST_LOG"
                        if ! record_power_request restart pending; then
                            echo "ordax-surface: refusing restart because pending power proof could not be persisted" >>"$HOST_LOG"
                            continue
                        fi
                        /bin/busybox sleep 1
                        if ! forward_host_power_request restart; then
                            record_power_request restart failed || true
                        fi
                        ;;
                    shutdown)
                        echo "ordax-surface: host power broker accepted shutdown" >>"$HOST_LOG"
                        if ! record_power_request shutdown pending; then
                            echo "ordax-surface: refusing shutdown because pending power proof could not be persisted" >>"$HOST_LOG"
                            continue
                        fi
                        /bin/busybox sleep 1
                        if ! forward_host_power_request shutdown; then
                            record_power_request shutdown failed || true
                        fi
                        ;;
                    *)
                        [ -n "$action" ] && echo "ordax-surface: rejected unknown host power request: $action" >>"$HOST_LOG"
                        ;;
                esac
            else
                /bin/busybox sleep 1
            fi
        done
    ) &
    POWER_BROKER_PID=$!
    kill -0 "$POWER_BROKER_PID" >/dev/null 2>&1 || return 1
}

# The native Python HTTP server is not a boot blocker until the bounded
# readiness window expires. Its former 10s bound caused false cold-boot
# failures under QEMU TCG despite the Guardian's 90s Surface health budget.
wait_for_native_server() {
    remaining=${1:-30}
    while [ "$remaining" -gt 0 ]; do
        [ -n "$HTTP_PID" ] && kill -0 "$HTTP_PID" >/dev/null 2>&1 || return 1
        if /bin/busybox chroot "$RUNTIME_ROOT" /usr/bin/python3 -c 'import socket; s=socket.create_connection(("127.0.0.1", 8765), 0.5); s.close()' >>"$HTTP_LOG" 2>&1; then
            return 0
        fi
        /bin/busybox sleep 1
        remaining=$((remaining - 1))
    done
    return 1
}

prepare_input_stack() {
    set -- /dev/input/event*
    if [ ! -e "$1" ]; then
        echo "ordax-surface: no /dev/input/event* devices are visible on the host" >>"$HOST_LOG"
        [ -d /dev/input ] && ls -la /dev/input >>"$HOST_LOG" 2>&1 || true
        return 1
    fi
    echo "ordax-surface: input event devices are present; starting eudev classification" >>"$HOST_LOG"
    mkdir -p "$RUNTIME_ROOT/run/udev" || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /sbin/udevd --daemon >>"$HOST_LOG" 2>&1 || return 1
    UDEV_ACTIVE=1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm control --reload-rules >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm trigger --subsystem-match=input --action=add >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm settle --timeout=5 >>"$HOST_LOG" 2>&1 || return 1
    /bin/busybox chroot "$RUNTIME_ROOT" /bin/udevadm info --query=property --name="$1" >>"$HOST_LOG" 2>&1 || true
    echo "ordax-surface: eudev input classification complete" >>"$HOST_LOG"
}

[ -n "$SYSTEM_ROOT" ] || fallback_with_reason "ORDAX_SYSTEM_ROOT is empty"
reconcile_stale_power_request || echo "ordax-surface: stale power request reconciliation failed safely" >>"$HOST_LOG"
ensure_base_telemetry_agent || echo "ordax-surface: base telemetry bootstrap failed; continuing Surface startup" >>"$HOST_LOG"
ensure_rescue_agent || echo "ordax-surface: rescue agent bootstrap failed; continuing Surface startup" >>"$HOST_LOG"
