start_network_broker || echo "ordax-surface: native Wi-Fi management broker unavailable; continuing without network management" >>"$HOST_LOG"
start_native_install_broker || echo "ordax-surface: Native install discovery broker unavailable; installer remains disabled" >>"$HOST_LOG"
[ -f "$SYSTEM_ROOT/composition/native/index.html" ] || fallback_with_reason "native Surface composition is missing: $SYSTEM_ROOT/composition/native/index.html"
[ -f "$SYSTEM_ROOT/surface/runtime/native_host_server.py" ] || fallback_with_reason "native Surface host server is missing: $SYSTEM_ROOT/surface/runtime/native_host_server.py"
[ -f "$SYSTEM_ROOT/surface/runtime/native_app_data_runtime.py" ] || fallback_with_reason "private App Data Native runtime is missing: $SYSTEM_ROOT/surface/runtime/native_app_data_runtime.py"
[ -f "$SYSTEM_ROOT/surface/runtime/native_app_install_identity_bootstrap.py" ] || fallback_with_reason "verified app install identity bootstrap is missing: $SYSTEM_ROOT/surface/runtime/native_app_install_identity_bootstrap.py"
[ -f "$SYSTEM_ROOT/surface/runtime/ordax_browser_host.py" ] || fallback_with_reason "native browser host is missing: $SYSTEM_ROOT/surface/runtime/ordax_browser_host.py"
[ -x /bin/busybox ] || fallback_with_reason "/bin/busybox is unavailable in the bootstrap base"
[ -e /dev/dri/card0 ] || fallback_with_reason "DRM device /dev/dri/card0 is unavailable"
reap_stale_runtime_processes || fallback_with_reason "stale runtime processes survived bounded termination; refusing mount reuse"
clear_stale_runtime_mounts
resolve_source_identity || fallback_with_reason "failed to resolve exact Surface source identity"
# Bind the existing signed Account gateway after the exact Surface source is
# resolved, even when the Supervisor starts this runtime without an exported
# optional environment override. Missing/invalid settings stay offline-first.
resolve_account_gateway_base_url
if ! runtime_is_ready; then
    printf 'OrdaX: preparando Surface grafica...\n'
    # Current-boot, exact-SHA marker. Stable/MVP never acquires APK packages.
    if [ "$DISTRIBUTION_PROFILE" = "owner-development" ]; then
        printf '%s\n' "$SOURCE_SHA" >"$RUNTIME_PROVISIONING_FILE"
    fi
fi
ensure_runtime || fallback_with_reason "graphical runtime is unavailable after bounded provisioning attempt"
rm -f "$RUNTIME_PROVISIONING_FILE"
ensure_loopback || fallback_with_reason "failed to configure IPv4 loopback for local Surface HTTP"
sync_runtime_resolver || echo "ordax-surface: external DNS unavailable inside graphical runtime; continuing local Surface" >>"$HOST_LOG"
ensure_shared_memory || fallback_with_reason "failed to prepare /dev/shm for wlroots/Xwayland"
configure_graphics_host || fallback_with_reason "failed to configure OrdaX WebKit graphics host"
bind_runtime_mounts || fallback_with_reason "failed to bind host resources into graphical runtime"
bootstrap_verified_app_install_identities || fallback_with_reason "failed to bootstrap verified app install identities"
prepare_input_stack || fallback_with_reason "failed to prepare physical keyboard/touchpad input devices"
configure_keyboard_layout
prepare_keyboard_session_restart_broker || echo "ordax-surface: keyboard session restart unavailable; next startup still applies configured layout" >>"$HOST_LOG"
publish_runtime_proof_context || fallback_with_reason "failed to publish active Surface runtime proof context"
remove_stale_seatd_socket || fallback_with_reason "failed to clear stale seatd socket before native host startup"
prepare_power_broker || echo "ordax-surface: host power broker unavailable; continuing without power actions" >>"$HOST_LOG"
ensure_base_update_agent || echo "ordax-surface: base update owner unavailable; continuing Surface startup" >>"$HOST_LOG"

export XDG_RUNTIME_DIR="$SESSION_DIR"
export HOME=/root
export GDK_BACKEND=wayland
export XDG_CACHE_HOME=/tmp/ordax-web-cache-$SOURCE_SHA
export ORDAX_SURFACE_MODE=native-graphical

/bin/busybox chroot "$RUNTIME_ROOT" \
    /usr/bin/python3 /srv/ordax-system/surface/runtime/native_app_data_runtime.py \
    --bind 127.0.0.1 --port 8765 --directory /srv/ordax-system \
    --user-root /var/lib/ordax-user --power-request /run/ordax-surface/power-request \
    --product-mode "$PRODUCT_MODE" \
    --distribution-profile "$DISTRIBUTION_PROFILE" \
    --native-install-capability "$NATIVE_INSTALL_CAPABILITY" \
    --component-channel-bin /srv/ordax-system/bin/ordax-runtime-component-channel \
    --component-trust /srv/ordax-system/trust/runtime-components-ed25519.json \
    --component-slot-root /var/lib/ordax/components \
    --account-gateway-origin "$ACCOUNT_GATEWAY_ORIGIN" \
    --telemetry-config /srv/ordax-system/services/telemetry/relay.json \
    >"$HTTP_LOG" 2>&1 &
HTTP_PID=$!
wait_for_native_server 30 || fallback_with_reason "native Surface HTTP/control server failed readiness check"

printf '\033[2J\033[H'
printf 'OrdaX: iniciando Surface grafica...\n'

# WebKitGTK 2.48 can negotiate DMA-BUF on a DRM device that cannot present
# those buffers. Restrict shared-memory transport to the *active* virtio DRM
# device in Owner Development; no global software-rendering switch, no
# change to real Intel/AMD/NVIDIA devices, and no Stable/MVP contract change.
# The driver identity comes from sysfs, not the QEMU proof's command line.
select_owner_virtio_webkit_transport() {
    [ "$DISTRIBUTION_PROFILE" = "owner-development" ] || return 0
    # A DRM card may be represented as a PCI or virtio child in sysfs.
    # Inspect the bound device and its kernel uevent, not the presence of a
    # loaded module or a test-only command-line parameter.
    drm_device=/sys/class/drm/card0/device
    active_driver=$(/bin/busybox readlink -f "$drm_device/driver" 2>/dev/null || true)
    active_device=$(/bin/busybox readlink -f "$drm_device" 2>/dev/null || true)
    detected=0
    case "$active_driver" in */virtio_gpu) detected=1 ;; esac
    if [ "$detected" -eq 0 ] && [ -r "$drm_device/uevent" ]; then
        /bin/busybox grep -qx 'DRIVER=virtio_gpu' "$drm_device/uevent" && detected=1
    fi
    case "$active_device" in
        */virtio[0-9]*)
            # Only a kernel-bound virtio child, not an arbitrary PCI alias.
            [ -e /sys/module/virtio_gpu ] && detected=1
            ;;
    esac
    # virtio-vga's DRM card0 may expose its *parent PCI device* as
    # /sys/class/drm/card0/device (driver=virtio-pci). Require the documented
    # exact modern VirtIO-GPU PCI vendor/device pair; never match the bus or
    # vendor alone, which would misclassify other VirtIO devices.
    if [ "$detected" -eq 0 ] && [ "$active_driver" = "/sys/bus/pci/drivers/virtio-pci" ] &&
       [ -r "$drm_device/vendor" ] && [ -r "$drm_device/device" ] &&
       /bin/busybox grep -qx '0x1af4' "$drm_device/vendor" &&
       /bin/busybox grep -qx '0x1050' "$drm_device/device"; then
        detected=1
    fi
    if [ "$detected" -eq 1 ]; then
        export WEBKIT_DISABLE_DMABUF_RENDERER=1
        printf 'ordax-surface: owner virtio_gpu selected WebKit non-DMA-BUF transport\n'
        return 0
    fi
    if [ -r /proc/cmdline ] &&
       /bin/busybox grep -qw 'ordax.owner_qemu_graphics_probe=1' /proc/cmdline; then
        # Bounded non-sensitive QEMU-only evidence to correct DRM classification.
        printf 'ORDAX_OWNER_DRM_DRIVER_PATH=%s\n' "${active_driver:-unavailable}"
        printf 'ORDAX_OWNER_DRM_DEVICE_PATH=%s\n' "${active_device:-unavailable}"
        if [ -r "$drm_device/uevent" ]; then
            /bin/busybox grep '^DRIVER=' "$drm_device/uevent" || true
        fi
        [ -r "$drm_device/vendor" ] && /bin/busybox sed -n '1s/^/ORDAX_OWNER_DRM_PCI_VENDOR=/p' "$drm_device/vendor" || true
        [ -r "$drm_device/device" ] && /bin/busybox sed -n '1s/^/ORDAX_OWNER_DRM_PCI_DEVICE=/p' "$drm_device/device" || true
    fi
}
select_owner_virtio_webkit_transport

START_URI="http://127.0.0.1:8765/composition/native/index.html?source=$SOURCE_SHA"
/bin/busybox chroot "$RUNTIME_ROOT" \
    /usr/bin/seatd-launch -- /usr/bin/cage -s -- \
    /usr/bin/python3 /srv/ordax-system/surface/runtime/ordax_browser_host.py \
    --start-uri "$START_URI" --profile-root /var/lib/ordax-user/browser \
    --component-channel-bin /srv/ordax-system/bin/ordax-runtime-component-channel \
    --component-slot-root /var/lib/ordax/components \
    --distribution-profile "$DISTRIBUTION_PROFILE" \
    >"$HOST_LOG" 2>&1 &
GRAPHICS_PID=$!
host_rc=0
while kill -0 "$GRAPHICS_PID" >/dev/null 2>&1; do
    if ! kill -0 "$HTTP_PID" >/dev/null 2>&1; then
        echo "ordax-surface: native HTTP/control server exited while graphics remained active" >>"$HOST_LOG"
        terminate_child "$GRAPHICS_PID" "graphics host"
        GRAPHICS_PID=""
        exit 1
    fi
    /bin/busybox sleep 1
done
wait "$GRAPHICS_PID" 2>/dev/null || host_rc=$?
GRAPHICS_PID=""

[ "$host_rc" -eq 0 ] && exit 0

fallback_with_reason "native Cage/OrdaX WebKit host exited with status $host_rc"
