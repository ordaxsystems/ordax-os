#!/bin/sh
set -eu

BIN_DIR=${0%/*}
RUNTIME_RESOLVER=$BIN_DIR/ordax-proof-runtime.sh
SCRIPT=/srv/ordax-system/diagnostics/physical_boot_storage.py

validate_arguments() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help) shift ;;
            --max-records)
                [ "$#" -ge 2 ] || { echo "ordax-physical-boot-storage: missing value for $1" >&2; return 2; }
                shift 2
                ;;
            --max-records=*) shift ;;
            *)
                echo "ordax-physical-boot-storage: unsupported physical entrypoint argument: $1" >&2
                return 2
                ;;
        esac
    done
}
validate_arguments "$@" || exit $?

[ -x /bin/busybox ] || { echo "ordax-physical-boot-storage: /bin/busybox unavailable" >&2; exit 2; }
[ -r "$RUNTIME_RESOLVER" ] || { echo "ordax-physical-boot-storage: runtime resolver unavailable: $RUNTIME_RESOLVER" >&2; exit 2; }
. "$RUNTIME_RESOLVER"
resolve_ordax_proof_runtime_root || exit 2
[ -x "$RUNTIME_ROOT/usr/bin/python3" ] || { echo "ordax-physical-boot-storage: active runtime Python unavailable" >&2; exit 2; }
[ -r "$RUNTIME_ROOT$SCRIPT" ] || { echo "ordax-physical-boot-storage: probe unavailable in active runtime" >&2; exit 2; }
[ -c "$RUNTIME_ROOT/dev/kmsg" ] || { echo "ordax-physical-boot-storage: active runtime /dev/kmsg binding unavailable" >&2; exit 2; }

exec /bin/busybox chroot "$RUNTIME_ROOT" /usr/bin/python3 "$SCRIPT" "$@"
