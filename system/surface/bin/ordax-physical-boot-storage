#!/bin/sh
set -eu

BIN_DIR=${0%/*}
RUNTIME_RESOLVER=$BIN_DIR/ordax-proof-runtime.sh
SCRIPT=/srv/ordax-system/diagnostics/physical_boot_storage.py

[ -x /bin/busybox ] || {
    echo "ordax-physical-boot-storage: /bin/busybox unavailable" >&2
    exit 2
}
[ -r "$RUNTIME_RESOLVER" ] || {
    echo "ordax-physical-boot-storage: runtime resolver unavailable: $RUNTIME_RESOLVER" >&2
    exit 2
}
. "$RUNTIME_RESOLVER"
resolve_ordax_proof_runtime_root || exit 2

[ -x "$RUNTIME_ROOT/usr/bin/python3" ] || {
    echo "ordax-physical-boot-storage: active runtime Python unavailable: $RUNTIME_ROOT/usr/bin/python3" >&2
    exit 2
}
[ -r "$RUNTIME_ROOT$SCRIPT" ] || {
    echo "ordax-physical-boot-storage: probe unavailable in active runtime" >&2
    exit 2
}
[ -c "$RUNTIME_ROOT/dev/kmsg" ] || {
    echo "ordax-physical-boot-storage: active runtime /dev/kmsg binding unavailable" >&2
    exit 2
}

exec /bin/busybox chroot "$RUNTIME_ROOT" /usr/bin/python3 "$SCRIPT" "$@"
