{
  "name": "ordax-os-desktop-dev",
  "private": true,
  "version": "0.1.0-alpha.20",
  "description": "Installable Windows development host for the canonical OrdaX Native Surface",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev:local": "node local-dev.cjs",
    "test": "node --test *.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.ordax.os.desktop",
    "productName": "OrdaX OS Desktop Dev",
    "artifactName": "OrdaX-OS-Desktop-Dev-${version}-${arch}.${ext}",
    "directories": {
      "output": "../../out/windows-desktop-installer"
    },
    "files": [
      "main.cjs",
      "package.json",
      "runtime.cjs",
      "checkout.cjs",
      "dev-update.cjs",
      "git-cleanup.cjs",
      "host.cjs",
      "browser-host.cjs",
      "browser-preload.cjs",
      "native-build.cjs",
      "surface-stage.cjs",
      "toolchain-cache.cjs"
    ],
    "extraResources": [
      {
        "from": "../../system",
        "to": "runtime-template/system",
        "filter": [
          "**/*",
          "!surface/runtime/packages.txt",
          "!entrypoint",
          "!supervisor",
          "!surface/entrypoint",
          "!surface/bin/ordax-surface",
          "!rescue/agent.sh",
          "!services/base-update/agent.sh",
          "!services/base-update/dev-helpers.sh",
          "!services/device-agent/native-product-lifecycle.sh",
          "!services/device-agent/product-presence-report.sh",
          "!services/intelligence-source/owner-stage.sh",
          "!services/local-ai/owner-dev-runtime.sh",
          "!services/local-ai/run-low-priority.sh",
          "!services/power/acpi-button-action.sh",
          "!services/surface-source/owner-stage.sh",
          "!services/telemetry/base-agent.sh",
          "!services/update/owner-signed-preview.sh",
          "!surface/bin/ordax-ata-evidence",
          "!surface/bin/ordax-internet-proof",
          "!surface/bin/ordax-kernel-log-evidence",
          "!surface/bin/ordax-mvp-smoke",
          "!surface/bin/ordax-performance-evidence",
          "!surface/bin/ordax-proof-runtime.sh",
          "!surface/runtime/native_install_broker.sh",
          "!surface/runtime/network_broker.sh",
          "!surface/runtime/resolver_sync.sh",
          "!surface/runtime/audio-session.sh",
          "!surface/runtime/media_runtime_probe.py",
          "!surface/runtime/physical_ata_probe.py",
          "!surface/runtime/physical_kernel_log_probe.py",
          "!surface/runtime/physical_performance_probe.py",
          "!surface/runtime/native_host_server.py",
          "!surface/runtime/ordax_browser_host.py",
          "!composition/web/**"
        ]
      },
      {
        "from": "../windows-emulator",
        "to": "runtime-template/tools/windows-emulator",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../package.json",
        "to": "runtime-template/package.json"
      },
      {
        "from": "../../docs/contracts/distribution-profiles.json",
        "to": "runtime-template/docs/contracts/distribution-profiles.json"
      },
      {
        "from": "../../out/windows-desktop-toolchain/node_modules.tar.gz",
        "to": "runtime-template/toolchain/node_modules.tar.gz"
      },
      {
        "from": "../../out/windows-desktop-toolchain/toolchain-receipt.json",
        "to": "runtime-template/toolchain/toolchain-receipt.json"
      },
      {
        "from": "../../out/windows-desktop-native",
        "to": "runtime-template/desktop-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../docs/contracts/surface-source.json",
        "to": "runtime-template/docs/contracts/surface-source.json"
      },
      {
        "from": "../../out/windows-local-ai-runtime",
        "to": "runtime-template/local-ai-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../out/windows-desktop-components/ordax-runtime-component-channel.exe",
        "to": "runtime-template/tools/runtime-component-channel/ordax-runtime-component-channel.exe"
      },
      {
        "from": "../../docs/contracts/runtime-component-trust-policy.json",
        "to": "runtime-template/docs/contracts/runtime-component-trust-policy.json"
      },
      {
        "from": "../../docs/evidence/desktop-runtime-windows-candidate-2026-10-31.json",
        "to": "runtime-template/docs/evidence/desktop-runtime-windows-candidate-2026-10-31.json"
      },
      {
        "from": "../../docs/contracts/runtime-component-package.json",
        "to": "runtime-template/docs/contracts/runtime-component-package.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false,
      "selectPerMachineByDefault": false
    },
    "publish": null
  }
}
