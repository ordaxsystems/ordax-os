#!/bin/sh
set -eu

NETBOX=/ordax/bootstrap/network/bin/netbox
DHCP_SCRIPT=/ordax/bootstrap/network/udhcpc.script
STATE_DIR=/run/ordax-network

log() {
    echo "ordax-network: $*" >&2
}

[ -x "$NETBOX" ] || {
    log "network userspace is missing"
    exit 1
}
[ -x "$DHCP_SCRIPT" ] || {
    log "DHCP script is missing"
    exit 1
}

mkdir -p "$STATE_DIR" /etc

for path in /sys/class/net/*; do
    [ -e "$path" ] || continue
    iface=${path##*/}
    [ "$iface" = lo ] && continue
    # Wi-Fi belongs to the first-use WPA owner. An unassociated radio must
    # never run DHCP in this early wired/USB-tether bootstrap.
    [ -d "$path/wireless" ] && continue
    # Match the Native broker: try only Ethernet-like interfaces, and check
    # carrier *after* raising them because a DOWN NIC may hide its link.
    net_type=""
    if [ -r "$path/type" ]; then
        IFS= read -r net_type <"$path/type" || true
    fi
    [ "$net_type" = 1 ] || continue
    "$NETBOX" ifconfig "$iface" up >/dev/null 2>&1 || continue
    if [ -r "$path/carrier" ]; then
        carrier=""
        IFS= read -r carrier <"$path/carrier" || true
        [ "$carrier" = 1 ] || continue
    fi
    log "trying DHCP on $iface"

    pidfile="$STATE_DIR/udhcpc-$iface.pid"
    rm -f "$pidfile"
    if "$NETBOX" udhcpc -n -q -t 4 -T 3 -i "$iface" -s "$DHCP_SCRIPT" -p "$pidfile"; then
        status="$("$NETBOX" ifconfig "$iface" 2>/dev/null || true)"
        case "$status" in
            *"inet addr:"*|*"inet "*)
                printf '%s\n' "$iface" > "$STATE_DIR/active-interface"
                log "network ready on $iface"
                exit 0
                ;;
        esac
    fi
done

log "no DHCP-capable Ethernet/USB-tether interface became ready"
exit 1
