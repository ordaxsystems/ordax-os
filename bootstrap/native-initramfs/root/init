#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

MAPPER_NAME=ordax-pool
MAPPER_DEVICE=/dev/mapper/$MAPPER_NAME
BOOTSTRAP_PATH=/ordax/bootstrap/entrypoint
RECOVERY_BOOTSTRAP_PATH=/ordax/bootstrap/recovery/entrypoint
PRODUCT_MODE_PATH=/ordax/bootstrap/config/product-mode
MAPPER_OPEN=0

log() {
    echo "ordax-native-initramfs: $*" >&2
}

# Fixed, non-secret boot stages for the existing serial diagnostic channel.
# The hardware-only tty0 unlock remains unchanged. A missing serial device
# cannot prevent a physical boot; no UUID, password, key or command is logged.
signal_boot_stage() {
    # This trace is opt-in only for the disposable QEMU proof entry.
    # A real laptop must never try to open a phantom ttyS0 during boot.
    [ "$(cmdline_value ordax.qemu_proof 2>/dev/null || true)" = "serial-stages" ] || return 0
    [ -c /dev/ttyS0 ] || return 0
    printf 'ORDAX_NATIVE_BOOT_STAGE=%s\n' "$1" > /dev/ttyS0 2>/dev/null || true
}

unmount_runtime() {
    for target in \
        /home \
        /.ordax-snapshots \
        /var/lib/containers \
        /var/lib/ordax/apps \
        /var/home \
        /var \
        /ordax
    do
        umount "$target" >/dev/null 2>&1 || true
    done
}

rescue() {
    reason=$1
    log "$reason; entering local recovery shell"
    signal_boot_stage rescue
    unmount_runtime
    if [ "$MAPPER_OPEN" -eq 1 ]; then
        cryptsetup close "$MAPPER_NAME" >/dev/null 2>&1 || true
        MAPPER_OPEN=0
    fi
    exec sh
}

cmdline_value() {
    key=$1
    found=""
    count=0
    for token in $(cat /proc/cmdline 2>/dev/null || true); do
        case "$token" in
            "$key="*)
                value=${token#*=}
                count=$((count + 1))
                found=$value
                ;;
        esac
    done
    [ "$count" -eq 1 ] || return 1
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

valid_uuid() {
    value=$1
    [ "${#value}" -eq 36 ] || return 1
    case "$value" in
        ????????-????-????-????-????????????) ;;
        *) return 1 ;;
    esac
    case "$value" in
        *[!0-9A-Fa-f-]*) return 1 ;;
    esac
    return 0
}

persistent_product_mode() {
    [ -f "$PRODUCT_MODE_PATH" ] && [ ! -L "$PRODUCT_MODE_PATH" ] || return 1
    value=$(cat "$PRODUCT_MODE_PATH" 2>/dev/null || true)
    [ "$value" = "native-disk" ] || return 1
    printf '%s' "$value"
}

require_subvolume() {
    name=$1
    [ -d "/ordax/$name" ] && [ ! -L "/ordax/$name" ] || return 1
    btrfs subvolume show "/ordax/$name" >/dev/null 2>&1
}

mount_persistent_subvolumes() {
    mkdir -p /var /home /.ordax-snapshots
    mount -t btrfs -o rw,compress=zstd:1,subvol=ordax-state "$MAPPER_DEVICE" /var \
        || return 1

    mkdir -p /var/home /var/lib/ordax/apps /var/lib/containers
    mount -t btrfs -o rw,compress=zstd:1,subvol=ordax-home "$MAPPER_DEVICE" /var/home \
        || return 1
    mount -t btrfs -o rw,compress=zstd:1,subvol=ordax-apps "$MAPPER_DEVICE" /var/lib/ordax/apps \
        || return 1
    mount -t btrfs -o rw,compress=zstd:1,subvol=ordax-containers "$MAPPER_DEVICE" /var/lib/containers \
        || return 1
    mount -t btrfs -o rw,compress=zstd:1,subvol=ordax-snapshots "$MAPPER_DEVICE" /.ordax-snapshots \
        || return 1
    mount --bind /var/home /home || return 1
    return 0
}

mkdir -p /proc /sys /dev /run /ordax /var /home
mount -t proc proc /proc || rescue "cannot mount /proc"
mount -t sysfs sysfs /sys || rescue "cannot mount /sys"
mount -t devtmpfs devtmpfs /dev || rescue "cannot mount /dev"
signal_boot_stage init-ready

BOOT_MODE=$(cmdline_value ordax.mode 2>/dev/null || true)
case "$BOOT_MODE" in
    normal|recovery) ;;
    *) rescue "missing, duplicate or invalid ordax.mode" ;;
esac

PRODUCT_MODE=$(cmdline_value ordax.product_mode 2>/dev/null || true)
[ "$PRODUCT_MODE" = "native-disk" ] \
    || rescue "missing, duplicate or invalid ordax.product_mode"

POOL_UUID=$(cmdline_value ordax.pool_uuid 2>/dev/null || true)
valid_uuid "$POOL_UUID" || rescue "missing, duplicate or invalid ordax.pool_uuid"
POOL_UUID=$(printf '%s' "$POOL_UUID" | tr 'A-F' 'a-f')

find_pool_device() {
    expected_uuid=$1
    matched=""
    matches=0
    for sys_path in /sys/class/block/*; do
        [ -e "$sys_path/partition" ] || continue
        name=${sys_path##*/}
        case "$name" in
            ''|*[!A-Za-z0-9._-]*) continue ;;
        esac
        candidate=/dev/$name
        [ -b "$candidate" ] || continue
        cryptsetup isLuks --type luks2 "$candidate" >/dev/null 2>&1 || continue
        observed=$(cryptsetup luksUUID "$candidate" 2>/dev/null | tr 'A-F' 'a-f' || true)
        [ "$observed" = "$expected_uuid" ] || continue
        matched=$candidate
        matches=$((matches + 1))
    done
    [ "$matches" -eq 1 ] || return 1
    printf '%s' "$matched"
}

POOL_DEVICE=$(find_pool_device "$POOL_UUID" 2>/dev/null || true)
case "$POOL_DEVICE" in
    /dev/*) ;;
    *) rescue "exact LUKS pool UUID was not found uniquely" ;;
esac

cryptsetup isLuks --type luks2 "$POOL_DEVICE" \
    || rescue "selected pool is not LUKS2"
OBSERVED_UUID=$(cryptsetup luksUUID "$POOL_DEVICE" 2>/dev/null | tr 'A-F' 'a-f' || true)
[ "$OBSERVED_UUID" = "$POOL_UUID" ] \
    || rescue "LUKS UUID changed after device selection"

log "unlocking Native pool; passphrase or recovery key is required"
# Guest has passed UEFI/kernel selection and validated the exact LUKS UUID.
# QEMU must never type a generated secret while firmware/boot menus own PS/2.
signal_boot_stage unlock-ready
if [ "$BOOT_MODE" = "recovery" ]; then
    cryptsetup open --readonly --type luks2 --tries 3 "$POOL_DEVICE" "$MAPPER_NAME" \
        || rescue "Native pool unlock failed"
else
    cryptsetup open --type luks2 --tries 3 "$POOL_DEVICE" "$MAPPER_NAME" \
        || rescue "Native pool unlock failed"
fi
MAPPER_OPEN=1
signal_boot_stage pool-unlocked
[ -b "$MAPPER_DEVICE" ] || rescue "Native pool mapper did not appear"

mount -t btrfs -o ro,subvolid=5 "$MAPPER_DEVICE" /ordax \
    || rescue "cannot mount Native Btrfs pool read-only"
persistent_product_mode >/dev/null \
    || rescue "persistent product mode is not native-disk"

for subvolume in \
    ordax-state \
    ordax-home \
    ordax-apps \
    ordax-containers \
    ordax-snapshots
do
    require_subvolume "$subvolume" \
        || rescue "required Btrfs subvolume is missing or invalid: $subvolume"
done

if [ "$BOOT_MODE" = "recovery" ]; then
    [ -x "$RECOVERY_BOOTSTRAP_PATH" ] \
        || rescue "Native recovery entrypoint is missing"
    log "starting Native recovery with ORDAX-POOL read-only"
    exec "$RECOVERY_BOOTSTRAP_PATH"
fi

[ -x "$BOOTSTRAP_PATH" ] || rescue "Native bootstrap entrypoint is missing"
umount /ordax || rescue "cannot transition Native pool from validation to writable boot"
mount -t btrfs -o rw,compress=zstd:1,subvolid=5 "$MAPPER_DEVICE" /ordax \
    || rescue "cannot mount Native Btrfs pool read-write"

persistent_product_mode >/dev/null \
    || rescue "persistent product mode changed during Native mount transition"
mount_persistent_subvolumes \
    || rescue "cannot mount required Native persistent subvolumes"

ORDAX_PRODUCT_MODE=native-disk
ORDAX_STATE_DIR=/var/lib/ordax
ORDAX_USER_HOME=/var/home
export ORDAX_PRODUCT_MODE ORDAX_STATE_DIR ORDAX_USER_HOME

log "Native LUKS2/Btrfs boundary validated; handing off to shared bootstrap"
exec "$BOOTSTRAP_PATH"
