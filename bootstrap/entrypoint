#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

CURRENT_ENTRYPOINT=/ordax/current/system/entrypoint
NETWORK_BRINGUP=/ordax/bootstrap/network/bring-up
RELEASE_AGENT=/ordax/bootstrap/release-acquisition/ordax-release-agent
RELEASE_TRUST=/ordax/bootstrap/trust/release-ed25519.json
RELEASE_CHANNEL=/ordax/bootstrap/config/release-envelope-url
PRODUCT_MODE_FILE=/ordax/bootstrap/config/product-mode
ACCOUNT_GATEWAY_FILE=/ordax/bootstrap/config/account-gateway-origin
RECOVERY_ENTRYPOINT=/ordax/bootstrap/recovery/entrypoint

log() {
    echo "ordax-bootstrap: $*" >&2
}

recovery() {
    log "$*"
    if [ -x "$RECOVERY_ENTRYPOINT" ]; then
        exec "$RECOVERY_ENTRYPOINT"
    fi
    log "recovery entrypoint unavailable; entering initramfs shell"
    exec sh
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    return 0
}

product_mode() {
    [ -f "$PRODUCT_MODE_FILE" ] && [ ! -L "$PRODUCT_MODE_FILE" ] || return 1
    value=$(/bin/busybox cat "$PRODUCT_MODE_FILE" 2>/dev/null || true)
    case "$value" in
        usb|native-disk)
            printf '%s' "$value"
            ;;
        *)
            return 1
            ;;
    esac
}

account_gateway_base_url() {
    [ -e "$ACCOUNT_GATEWAY_FILE" ] || return 1
    [ -f "$ACCOUNT_GATEWAY_FILE" ] && [ ! -L "$ACCOUNT_GATEWAY_FILE" ] || return 1
    value=$(/bin/busybox cat "$ACCOUNT_GATEWAY_FILE" 2>/dev/null || true)
    case "$value" in
        https://*) ;;
        *) return 1 ;;
    esac
    remainder=${value#https://}
    [ -n "$remainder" ] || return 1
    case "$remainder" in
        *\?*|*\#*|*@*|*[!A-Za-z0-9._:/-]*|*/) return 1 ;;
    esac
    authority=${remainder%%/*}
    [ -n "$authority" ] || return 1
    printf '%s' "$value"
}

current_release_sha() {
    [ -L /ordax/current ] || return 1
    target=$(/bin/busybox readlink /ordax/current 2>/dev/null || true)
    case "$target" in
        releases/*)
            value=${target#releases/}
            ;;
        *)
            return 1
            ;;
    esac
    case "$value" in
        */*) return 1 ;;
    esac
    is_sha "$value" || return 1
    [ -d "/ordax/releases/$value" ] || return 1
    printf '%s' "$value"
}

boot_current() {
    [ -x "$CURRENT_ENTRYPOINT" ] || return 1
    source_sha=$(current_release_sha) || recovery "current release identity is invalid"
    [ -x "$RELEASE_AGENT" ] || recovery "offline release verifier is missing"
    # Reuse the canonical exact verifier for the already selected release;
    # never execute a current tree based only on a valid symlink identity.
    "$RELEASE_AGENT" activate-exact --root /ordax --trust "$RELEASE_TRUST" \
        --expected-commit "$source_sha" >/dev/null \
        || recovery "current release failed exact offline verification"
    verified_sha=$(current_release_sha) || recovery "verified current identity is invalid"
    [ "$verified_sha" = "$source_sha" ] || recovery "current release changed during verification"
    mode=$(product_mode) || recovery "product mode identity is missing or invalid"
    gateway_origin=$(account_gateway_base_url || true)
    if [ -n "$gateway_origin" ]; then
        ORDAX_ACCOUNT_GATEWAY_ORIGIN=$gateway_origin
        export ORDAX_ACCOUNT_GATEWAY_ORIGIN
    else
        unset ORDAX_ACCOUNT_GATEWAY_ORIGIN
    fi
    log "booting current verified release without requiring network"
    ORDAX_DISTRIBUTION_PROFILE=stable-mvp \
    ORDAX_PRODUCT_MODE="$mode" \
    ORDAX_SOURCE_SHA="$source_sha" \
        exec "$CURRENT_ENTRYPOINT"
}

# A known-good current release is the primary boot path. Network is not a
# normal boot dependency once the device has activated its first release.
boot_current || true

[ -x "$NETWORK_BRINGUP" ] || recovery "network bootstrap is missing"
[ -x "$RELEASE_AGENT" ] || recovery "release acquisition agent is missing"
[ -f "$RELEASE_TRUST" ] || recovery "release trust anchor is missing"
[ -f "$RELEASE_CHANNEL" ] || recovery "release channel configuration is missing"
product_mode >/dev/null || recovery "product mode identity is missing or invalid"

log "no active release; bringing up minimum network for first acquisition"
"$NETWORK_BRINGUP" || recovery "minimum network bring-up failed"

IFS= read -r RELEASE_URL < "$RELEASE_CHANNEL" || recovery "cannot read release channel"
case "$RELEASE_URL" in
    https://*) ;;
    *) recovery "release channel must use HTTPS" ;;
esac

log "acquiring first verified release"
"$RELEASE_AGENT" install --envelope-url "$RELEASE_URL" --trust "$RELEASE_TRUST" --root /ordax \
    || recovery "release acquisition failed"

[ -x "$CURRENT_ENTRYPOINT" ] || recovery "release activation did not create a bootable current entrypoint"
log "first verified release activated"
boot_current || recovery "verified release handoff failed"
