#!/bin/sh
set -eu

WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
ENTRYPOINT=$WORKTREE/system/entrypoint
GIT_BIN=${ORDAX_GIT_BIN:-/usr/bin/git}
UPDATE_RUN_DIR=${ORDAX_UPDATE_RUN_DIR:-/run/ordax-update}
GUARDIAN_LOG=$UPDATE_RUN_DIR/guardian.log
SURFACE_RUNTIME_PROVISION_MARKER=${ORDAX_SURFACE_RUNTIME_PROVISION_MARKER:-/run/ordax-surface/runtime-provisioning-source-sha}
PRODUCT_CONTROL_PLANE_URL=${ORDAX_PRODUCT_CONTROL_PLANE_URL:-}
PRODUCT_CONTROL_PLANE_CONFIG=$WORKTREE/bootstrap/base-update/owner-development/product-control-plane-origin
STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}
CURRENT_FILE=$STATE_DIR/current-commit
OWNER_UPDATE_STAGE_TIMEOUT=${ORDAX_STAGE_TIMEOUT_SECONDS:-60}
ENTRY_PID=""
TAIL_PID=""
WATCH_PID=""

bb() {
    if [ -x /bin/busybox ]; then
        /bin/busybox "$@"
    else
        command "$@"
    fi
}

fail() {
    echo "ordax-run: $*" >&2
    exit 1
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    return 0
}

case "$OWNER_UPDATE_STAGE_TIMEOUT" in
    ''|*[!0-9]*) OWNER_UPDATE_STAGE_TIMEOUT=60 ;;
esac
[ "$OWNER_UPDATE_STAGE_TIMEOUT" -ge 15 ] 2>/dev/null || OWNER_UPDATE_STAGE_TIMEOUT=60
[ "$OWNER_UPDATE_STAGE_TIMEOUT" -le 300 ] 2>/dev/null || OWNER_UPDATE_STAGE_TIMEOUT=300

read_state_value() {
    path=$1
    value=""
    [ -f "$path" ] && [ ! -L "$path" ] || {
        printf '%s' ""
        return 0
    }
    IFS= read -r value <"$path" || true
    printf '%s' "$value"
}

valid_https_origin() {
    value=${1:-}
    case "$value" in
        https://*) ;;
        *) return 1 ;;
    esac
    remainder=${value#https://}
    [ -n "$remainder" ] || return 1
    case "$remainder" in
        *\?*|*\#*|*@*|*/*|*[!A-Za-z0-9._:-]*) return 1 ;;
    esac
    return 0
}

resolve_product_control_plane_url() {
    if [ -n "$PRODUCT_CONTROL_PLANE_URL" ]; then
        if ! valid_https_origin "$PRODUCT_CONTROL_PLANE_URL"; then
            echo "ordax-run: configured product control plane URL is invalid; optional device enrollment disabled" >>"$GUARDIAN_LOG"
            PRODUCT_CONTROL_PLANE_URL=
        fi
        return 0
    fi

    [ -f "$PRODUCT_CONTROL_PLANE_CONFIG" ] && [ ! -L "$PRODUCT_CONTROL_PLANE_CONFIG" ] || return 0
    configured=$(bb cat "$PRODUCT_CONTROL_PLANE_CONFIG" 2>/dev/null || true)
    if valid_https_origin "$configured"; then
        PRODUCT_CONTROL_PLANE_URL=$configured
    else
        echo "ordax-run: owner product control plane config is invalid; optional device enrollment disabled" >>"$GUARDIAN_LOG"
    fi
}

prepare_status_log() {
    if [ -e "$UPDATE_RUN_DIR" ] || [ -L "$UPDATE_RUN_DIR" ]; then
        [ -d "$UPDATE_RUN_DIR" ] && [ ! -L "$UPDATE_RUN_DIR" ] || \
            fail "runtime status directory is unsafe: $UPDATE_RUN_DIR"
    else
        bb mkdir -p "$UPDATE_RUN_DIR" || fail "cannot create runtime status directory"
    fi
    bb chmod 700 "$UPDATE_RUN_DIR" || fail "cannot protect runtime status directory"

    if [ -e "$GUARDIAN_LOG" ] || [ -L "$GUARDIAN_LOG" ]; then
        [ -f "$GUARDIAN_LOG" ] && [ ! -L "$GUARDIAN_LOG" ] || \
            fail "guardian log path is unsafe: $GUARDIAN_LOG"
    else
        bb touch "$GUARDIAN_LOG" || fail "cannot create guardian status log"
    fi
}

process_alive() {
    pid=${1:-}
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" >/dev/null 2>&1
}

stop_observer() {
    pid=${1:-}
    process_alive "$pid" || return 0
    kill "$pid" >/dev/null 2>&1 || true
    wait "$pid" 2>/dev/null || true
}

cleanup_observers() {
    stop_observer "$WATCH_PID"
    stop_observer "$TAIL_PID"
    WATCH_PID=""
    TAIL_PID=""
}

forward_signal() {
    signal=$1
    if process_alive "$ENTRY_PID"; then
        kill -"$signal" "$ENTRY_PID" >/dev/null 2>&1 || true
    fi
}

watch_owner_provisioning() {
    announced=no
    while process_alive "$ENTRY_PID"; do
        if [ "$announced" = no ] && [ -f "$SURFACE_RUNTIME_PROVISION_MARKER" ] && [ ! -L "$SURFACE_RUNTIME_PROVISION_MARKER" ]; then
            marker_source=""
            IFS= read -r marker_source <"$SURFACE_RUNTIME_PROVISION_MARKER" || true
            if [ "$marker_source" = "$source_sha" ]; then
                echo "ordax-run: first-boot Surface runtime provisioning is in progress; the runtime remains supervised"
                announced=yes
            fi
        fi
        bb sleep 1
    done
}

# Owner engineering Runtime is optional and separate from Surface. Only an
# explicitly paired device with a 0600 local opt-in starts it. The pinned
# recovery controller owns installation, identity and authenticated transport.
# Publish a bounded read-only diagnosis on each Owner boot, even when the
# network and Remote MCP pairing are unavailable. The result is a private
# cross-boot witness, not a substitute for live power or Base A/B proof.
publish_owner_maintenance_receipt() {
    helper=/usr/local/bin/ordax-maintain
    [ -f "$helper" ] && [ ! -L "$helper" ] || return 0
    destination=$STATE_DIR/maintenance
    bb mkdir -p "$destination" || return 0
    bb chmod 700 "$destination" || return 0
    temporary=$destination/.last-status.$$
    if /bin/sh "$helper" status >"$temporary" 2>&1; then
        printf 'boot_check=passed\n' >>"$temporary"
    else
        printf 'boot_check=attention-required\n' >>"$temporary"
    fi
    bb chmod 600 "$temporary" || { bb rm -f "$temporary"; return 0; }
    bb mv -f "$temporary" "$destination/last-status" || bb rm -f "$temporary"
    return 0
}

start_optional_owner_remote() {
    remote=/usr/local/bin/ordax-remote
    consent=$STATE_DIR/owner-remote/auto-start-enabled
    [ -f "$consent" ] && [ ! -L "$consent" ] || return 0
    [ "$(bb stat -c '%a' "$consent" 2>/dev/null || true)" = 600 ] || return 0
    first_line=$(bb sed -n '1p' "$consent" 2>/dev/null || true)
    [ "$first_line" = enabled ] || return 0
    [ -f "$STATE_DIR/owner-remote/device-token" ] || return 0
    [ -x "$remote" ] && [ ! -L "$remote" ] || return 0
    (
        umask 077
        /bin/sh "$remote" ensure >>"$STATE_DIR/owner-remote/auto-start.log" 2>&1 || true
    ) </dev/null &
}

start_guardian_tail() {
    if [ -x /bin/busybox ]; then
        /bin/busybox tail -n 0 -f "$GUARDIAN_LOG" &
    else
        tail -n 0 -f "$GUARDIAN_LOG" &
    fi
    TAIL_PID=$!
}

# The local checkout must boot without network, including on a pinned rollback.
# The running supervisor/main watcher already owns automatic recovery after
# the durable First Run receipt; ordax-run must never pull before the UI starts.
[ -x "$ENTRYPOINT" ] || fail "$ENTRYPOINT nao existe ou nao e executavel"

source_sha=$("$GIT_BIN" -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
is_sha "$source_sha" || fail "checkout Owner/Development sem SHA Git valida"
recorded_sha=$(read_state_value "$CURRENT_FILE")
is_sha "$recorded_sha" || fail "estado current-commit ausente ou invalido; execute ordax-pull antes de iniciar"
[ "$recorded_sha" = "$source_sha" ] || fail "checkout diverge do commit registrado; execute ordax-pull para reconciliar"
checkout_status=$("$GIT_BIN" -C "$WORKTREE" status --porcelain 2>/dev/null) || \
    fail "nao foi possivel validar limpeza do checkout"
[ -z "$checkout_status" ] || fail "checkout local possui alteracoes; execute ordax-pull para preservar diagnostico e restaurar uma versao limpa"

prepare_status_log
resolve_product_control_plane_url
if [ -n "$PRODUCT_CONTROL_PLANE_URL" ]; then
    ORDAX_PRODUCT_CONTROL_PLANE_URL=$PRODUCT_CONTROL_PLANE_URL
    export ORDAX_PRODUCT_CONTROL_PLANE_URL
else
    unset ORDAX_PRODUCT_CONTROL_PLANE_URL
fi

echo "ordax-run: starting Owner/Development runtime at $source_sha"
echo "ordax-run: live status follows; canonical log: $GUARDIAN_LOG"
echo "ordax-run: Ctrl+C stops this runtime session cleanly"

# Observe only the canonical guardian log. TAIL_PID is the actual external tail
# process, not a background shell-function wrapper, so cleanup can proveably reap it.
start_guardian_tail

ORDAX_DISTRIBUTION_PROFILE=owner-development \
ORDAX_PRODUCT_MODE=usb \
ORDAX_SOURCE_SHA="$source_sha" \
ORDAX_STAGE_TIMEOUT_SECONDS="$OWNER_UPDATE_STAGE_TIMEOUT" \
    "$ENTRYPOINT" &
ENTRY_PID=$!

# Health checks are observations, not boot prerequisites. Publish the private
# receipt asynchronously after the canonical Guardian is already running.
publish_owner_maintenance_receipt &

# Do not wait for remote login or downloads during boot. Remote failure must
# never hold the Guardian, network setup, First Run or Surface health gate.
start_optional_owner_remote

watch_owner_provisioning &
WATCH_PID=$!

trap 'forward_signal HUP' HUP
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM
trap cleanup_observers EXIT

entry_rc=0
wait "$ENTRY_PID" || entry_rc=$?
ENTRY_PID=""
cleanup_observers
trap - EXIT HUP INT TERM

if [ "$entry_rc" -ne 0 ]; then
    echo "ordax-run: runtime exited with status $entry_rc; final guardian log follows" >&2
    bb tail -n 20 "$GUARDIAN_LOG" >&2 || true
fi
exit "$entry_rc"
