#!/bin/sh
set -eu

REPO_URL=${ORDAX_REPO_URL:-https://github.com/ordaxsystems/ordax-os.git}
BRANCH=${ORDAX_REPO_BRANCH:-main}
WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}
RUN_DIR=${ORDAX_UPDATE_RUN_DIR:-/run/ordax-update}
PULL_LOCK_DIR=$RUN_DIR/pull.lock
PULL_LOCK_PID_FILE=$PULL_LOCK_DIR/pid
# A small bounded phase token consumed by the canonical Supervisor's lastError.
# Kept in its existing volatile update run directory; not a second history store.
PULL_RESULT_FILE=$RUN_DIR/pull-result
PULL_PHASE=preflight
LOCK_HELD=0
PREVIOUS_FILE=$STATE_DIR/previous-commit
CURRENT_FILE=$STATE_DIR/current-commit
PINNED_FILE=$STATE_DIR/pinned-commit
BOOT_REJECTED_FILE=$STATE_DIR/boot-rejected-commit
AUTOMATIC_ROLLBACK_RECOVERY=${ORDAX_AUTOMATIC_ROLLBACK_RECOVERY:-0}
EXPECTED_SHA=${ORDAX_EXPECTED_SHA:-}
DIRTY_CHECKOUT_DIR=$STATE_DIR/dirty-checkout
GIT_TIMEOUT_SECONDS=${ORDAX_BOOT_GIT_TIMEOUT_SECONDS:-45}
GIT_LOW_SPEED_TIME=${ORDAX_BOOT_GIT_LOW_SPEED_SECONDS:-15}
WORKSPACE_ROOT=${WORKTREE%/*}
STAGING_PREFIX=$WORKSPACE_ROOT/.ordax-staging
RETIRED_PREFIX=$WORKSPACE_ROOT/.ordax-retired
INTERRUPTED_PREFIX=$WORKSPACE_ROOT/.ordax-interrupted
TRANSACTION_FILE=$STATE_DIR/pull-transaction.tsv
NETWORK_STATUS_FILE=${ORDAX_NETWORK_STATUS_FILE:-/run/ordax-network-status}
SEED_MODE=0
SEED_SOURCE_REPO=
SEED_SOURCE_SHA=
case "${1:-}" in
    --seed-from-local)
        [ "$#" -eq 3 ] || { echo "usage: ordax-pull --seed-from-local SOURCE_REPO SOURCE_SHA" >&2; exit 2; }
        SEED_MODE=1
        SEED_SOURCE_REPO=$2
        SEED_SOURCE_SHA=$3
        ;;
    "") ;;
    *) echo "ordax-git: unsupported argument: $1" >&2; exit 2 ;;
esac

case "$GIT_TIMEOUT_SECONDS" in
    ''|*[!0-9]*) GIT_TIMEOUT_SECONDS=45 ;;
esac
[ "$GIT_TIMEOUT_SECONDS" -ge 10 ] 2>/dev/null || GIT_TIMEOUT_SECONDS=45

case "$GIT_LOW_SPEED_TIME" in
    ''|*[!0-9]*) GIT_LOW_SPEED_TIME=15 ;;
esac
[ "$GIT_LOW_SPEED_TIME" -ge 5 ] 2>/dev/null || GIT_LOW_SPEED_TIME=15

case "$AUTOMATIC_ROLLBACK_RECOVERY" in
    0|1) ;;
    *) AUTOMATIC_ROLLBACK_RECOVERY=0 ;;
esac

GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT

run_bounded_git() {
    timeout -k 5 "$GIT_TIMEOUT_SECONDS" \
        git \
        -c http.lowSpeedLimit=1 \
        -c "http.lowSpeedTime=$GIT_LOW_SPEED_TIME" \
        "$@"
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

is_pid() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 1 ] 2>/dev/null
}
if [ -n "$EXPECTED_SHA" ] && ! is_sha "$EXPECTED_SHA"; then
    echo "ordax-git: expected SHA is invalid" >&2
    exit 2
fi

read_state() {
    source=$1
    value=""
    [ -f "$source" ] && [ ! -L "$source" ] || {
        printf '%s' ""
        return 0
    }
    IFS= read -r value <"$source" || true
    printf '%s' "$value"
}

write_state() {
    destination=$1
    value=$2
    temporary=$destination.tmp.$$
    printf '%s\n' "$value" >"$temporary"
    mv -f "$temporary" "$destination"
}

acquire_pull_lock() {
    mkdir -p "$RUN_DIR"
    if mkdir "$PULL_LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"$PULL_LOCK_PID_FILE"
        LOCK_HELD=1
        return 0
    fi

    [ -d "$PULL_LOCK_DIR" ] && [ ! -L "$PULL_LOCK_DIR" ] || {
        echo "ordax-git: update lock path is unsafe; refusing transaction" >&2
        return 1
    }

    owner=$(read_state "$PULL_LOCK_PID_FILE")
    if ! is_pid "$owner"; then
        echo "ordax-git: update lock has no trustworthy owner; refusing concurrent transaction" >&2
        return 1
    fi
    if kill -0 "$owner" >/dev/null 2>&1; then
        echo "ordax-git: another update transaction is active (pid=$owner)" >&2
        return 1
    fi

    rm -f "$PULL_LOCK_PID_FILE"
    if ! rmdir "$PULL_LOCK_DIR" 2>/dev/null; then
        echo "ordax-git: stale update lock could not be reclaimed safely" >&2
        return 1
    fi
    if ! mkdir "$PULL_LOCK_DIR" 2>/dev/null; then
        echo "ordax-git: update lock was acquired by another transaction" >&2
        return 1
    fi
    printf '%s\n' "$$" >"$PULL_LOCK_PID_FILE"
    LOCK_HELD=1
    echo "ordax-git: stale update lock reclaimed" >&2
    return 0
}

release_pull_lock() {
    [ "$LOCK_HELD" -eq 1 ] || return 0
    owner=$(read_state "$PULL_LOCK_PID_FILE")
    if [ "$owner" = "$$" ]; then
        rm -f "$PULL_LOCK_PID_FILE"
        rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    fi
    LOCK_HELD=0
}

runtime_sparse_paths() {
    # Single allowlist for the sparse checkout and the exact-commit blob
    # acquisition gate. Git fetch of a commit does not necessarily contain
    # promised blobs when the source is a partial clone.
    printf '%s\n' \
        /system/ \
        /bootstrap/base-update/ \
        /bootstrap/dev-base/ \
        /bootstrap/recovery/entrypoint \
        /bootstrap/trust/ \
        /bootstrap/config/release-envelope-url \
        /docs/contracts/base-update.json \
        /docs/contracts/release-trust-policy.json \
        /docs/contracts/minimal-bootstrap.json \
        /docs/evidence/release-trust-ceremony.json \
        /docs/evidence/release-trust-proof-manifest.json \
        /docs/evidence/release-trust-recovery-envelope.json
}

configure_runtime_checkout_at() {
    checkout=$1
    set -- $(runtime_sparse_paths)
    git -C "$checkout" sparse-checkout set --no-cone "$@"
}

acquire_runtime_candidate_blobs() {
    candidate_sha=$1
    # A partial clone may have the commit/tree but not all referenced blobs.
    # Force only the shared sparse allowlist into the already validated local
    # object database; Git lazily acquires missing promisor blobs if required.
    # The tar stream is discarded; it does not touch the live checkout.
    candidate_paths=$(runtime_sparse_paths | sed 's@^/@@')
    set -- $candidate_paths
    if ! run_bounded_git -C "$WORKTREE" archive --format=tar "$candidate_sha" "$@" >/dev/null; then
        echo "ordax-git: blobs da entrega nao puderam ser obtidos; checkout local preservado" >&2
        return 1
    fi
    return 0
}

record_dirty_checkout() {
    mkdir -p "$DIRTY_CHECKOUT_DIR"
    chmod 700 "$DIRTY_CHECKOUT_DIR" 2>/dev/null || true

    head=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    status_file=$DIRTY_CHECKOUT_DIR/last-status.txt
    status_tmp=$status_file.tmp.$$
    {
        printf 'head=%s\n' "${head:-unknown}"
        git -C "$WORKTREE" status --porcelain=v1 2>/dev/null || true
    } >"$status_tmp"
    mv -f "$status_tmp" "$status_file"

    patch_file=$DIRTY_CHECKOUT_DIR/last-tracked-changes.patch
    patch_tmp=$patch_file.tmp.$$
    if run_bounded_git -C "$WORKTREE" diff --binary --no-ext-diff HEAD >"$patch_tmp" 2>/dev/null; then
        mv -f "$patch_tmp" "$patch_file"
    else
        rm -f "$patch_tmp"
    fi
}

checkout_metadata_valid() {
    checkout=$1
    # Preserve a precise *bounded* failure token for the caller. No paths,
    # remotes, credential material or command output are emitted to UI state.
    CHECKOUT_METADATA_FAILURE=gitdir
    [ -d "$checkout/.git" ] || return 1
    head=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
    CHECKOUT_METADATA_FAILURE=head
    is_sha "$head" || return 1
    origin=$(git -C "$checkout" remote get-url origin 2>/dev/null || true)
    CHECKOUT_METADATA_FAILURE=origin
    [ "$origin" = "$REPO_URL" ] || return 1
    branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    CHECKOUT_METADATA_FAILURE=branch
    [ "$branch" = "$BRANCH" ] || return 1
    CHECKOUT_METADATA_FAILURE=entrypoint
    [ -x "$checkout/system/entrypoint" ] || return 1
    CHECKOUT_METADATA_FAILURE=
    return 0
}

checkout_is_clean() {
    checkout=$1
    status=$(git -C "$checkout" status --porcelain 2>/dev/null) || return 1
    [ -z "$status" ]
}

write_pull_transaction() {
    transaction_id=$1
    phase=$2
    expected_sha=$3
    old_sha=$4
    reason=$5
    temporary=$TRANSACTION_FILE.tmp.$$
    printf '%s|%s|%s|%s|%s\n' \
        "$transaction_id" "$phase" "$expected_sha" "$old_sha" "$reason" >"$temporary"
    mv -f "$temporary" "$TRANSACTION_FILE"
}

clear_pull_transaction() {
    rm -f "$TRANSACTION_FILE"
}

transaction_record_valid() {
    case "$TX_ID" in ''|*[!0-9]*) return 1 ;; esac
    case "$TX_PHASE" in prepared|retired) ;; *) return 1 ;; esac
    is_sha "$TX_EXPECTED" || return 1
    if [ -n "$TX_OLD" ]; then
        is_sha "$TX_OLD" || return 1
    fi
    case "$TX_REASON" in invalid|dirty|update) ;; *) return 1 ;; esac
    return 0
}

read_pull_transaction() {
    TX_ID=
    TX_PHASE=
    TX_EXPECTED=
    TX_OLD=
    TX_REASON=
    [ -f "$TRANSACTION_FILE" ] && [ ! -L "$TRANSACTION_FILE" ] || return 1
    IFS='|' read -r TX_ID TX_PHASE TX_EXPECTED TX_OLD TX_REASON <"$TRANSACTION_FILE" || return 1
    transaction_record_valid
}

quarantine_interrupted_checkout() {
    source=$1
    transaction_id=$2
    [ -e "$source" ] || return 0
    destination=$INTERRUPTED_PREFIX.$transaction_id
    [ ! -e "$destination" ] || return 1
    mv "$source" "$destination"
    echo "ordax-git: checkout incompleto preservado para diagnostico em $destination" >&2
}

recover_interrupted_swap() {
    [ -e "$TRANSACTION_FILE" ] || return 0
    if ! read_pull_transaction; then
        echo "ordax-git: transacao de atualizacao invalida; preservando workspace e artefatos para diagnostico" >&2
        return 1
    fi

    stage=$STAGING_PREFIX.$TX_ID
    retired=$RETIRED_PREFIX.$TX_ID
    active_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)

    if checkout_metadata_valid "$WORKTREE" && checkout_is_clean "$WORKTREE" && [ "$active_sha" = "$TX_EXPECTED" ]; then
        rm -rf "$stage" 2>/dev/null || true
        if [ -e "$retired" ]; then
            retired_sha=$(git -C "$retired" rev-parse HEAD 2>/dev/null || true)
            if checkout_metadata_valid "$retired" && [ -n "$TX_OLD" ] && [ "$retired_sha" = "$TX_OLD" ]; then
                rm -rf "$retired"
            else
                echo "ordax-git: checkout aposentado ambiguo preservado em $retired" >&2
            fi
        fi
        write_state "$CURRENT_FILE" "$TX_EXPECTED"
        if is_sha "$TX_OLD" && [ "$TX_OLD" != "$TX_EXPECTED" ]; then
            write_state "$PREVIOUS_FILE" "$TX_OLD"
        fi
        clear_pull_transaction
        echo "ordax-git: transacao interrompida ja estava ativada em $TX_EXPECTED; estado reconciliado" >&2
        return 0
    fi

    if [ -n "$TX_OLD" ] && [ -e "$retired" ]; then
        retired_sha=$(git -C "$retired" rev-parse HEAD 2>/dev/null || true)
        if checkout_metadata_valid "$retired" && [ "$retired_sha" = "$TX_OLD" ]; then
            if [ -e "$WORKTREE" ]; then
                quarantine_interrupted_checkout "$WORKTREE" "$TX_ID" || {
                    echo "ordax-git: nao foi possivel preservar checkout incompleto; recuperacao abortada" >&2
                    return 1
                }
            fi
            mv "$retired" "$WORKTREE" || return 1
            write_state "$CURRENT_FILE" "$TX_OLD"
            rm -rf "$stage" 2>/dev/null || true
            clear_pull_transaction
            echo "ordax-git: atualizacao anterior foi interrompida; versao local $TX_OLD restaurada" >&2
            return 0
        fi
    fi

    if checkout_metadata_valid "$WORKTREE" && [ -n "$TX_OLD" ] && [ "$active_sha" = "$TX_OLD" ]; then
        rm -rf "$stage" 2>/dev/null || true
        if [ -e "$retired" ]; then
            retired_sha=$(git -C "$retired" rev-parse HEAD 2>/dev/null || true)
            if checkout_metadata_valid "$retired" && [ "$retired_sha" = "$TX_OLD" ]; then
                rm -rf "$retired"
            fi
        fi
        write_state "$CURRENT_FILE" "$TX_OLD"
        clear_pull_transaction
        echo "ordax-git: atualizacao anterior nao foi ativada; usando versao local $TX_OLD" >&2
        return 0
    fi

    echo "ordax-git: transacao interrompida sem rollback inequivoco; nenhum workspace sera apagado" >&2
    return 1
}

recover_legacy_retired_checkout() {
    [ -e "$WORKTREE" ] && return 0
    set -- "$RETIRED_PREFIX".*
    [ -e "$1" ] || return 0
    [ "$#" -eq 1 ] || {
        echo "ordax-git: multiplos checkouts aposentados antigos; recuperacao automatica bloqueada" >&2
        return 1
    }
    retired=$1
    retired_sha=$(git -C "$retired" rev-parse HEAD 2>/dev/null || true)
    expected_old=$(read_state "$CURRENT_FILE")
    checkout_metadata_valid "$retired" || return 1
    is_sha "$retired_sha" || return 1
    if is_sha "$expected_old" && [ "$retired_sha" != "$expected_old" ]; then
        echo "ordax-git: checkout aposentado nao corresponde ao ultimo commit registrado; preservado" >&2
        return 1
    fi
    mv "$retired" "$WORKTREE" || return 1
    write_state "$CURRENT_FILE" "$retired_sha"
    echo "ordax-git: recovered interrupted checkout transaction at $retired_sha; checkout conhecido como bom restaurado" >&2
    return 0
}

network_failure_hint() {
    [ -f "$NETWORK_STATUS_FILE" ] && [ ! -L "$NETWORK_STATUS_FILE" ] || return 0
    status_line=""
    IFS= read -r status_line <"$NETWORK_STATUS_FILE" || true
    status=${status_line%%|*}
    case "$status" in
        no-ip) echo "ordax-git: sem rede/IP disponivel; atualizacao adiada" >&2 ;;
        dns-failed) echo "ordax-git: rede local ativa, mas DNS indisponivel; atualizacao adiada" >&2 ;;
        https-failed) echo "ordax-git: DNS ativo, mas HTTPS indisponivel; atualizacao adiada" >&2 ;;
        github-git-failed) echo "ordax-git: internet/HTTPS ativos, mas GitHub/Git indisponivel; usando cache local" >&2 ;;
        ready) echo "ordax-git: Git remoto havia respondido, mas ficou indisponivel durante esta atualizacao" >&2 ;;
    esac
}

remote_main_sha() {
    output=$(run_bounded_git ls-remote --heads "$REPO_URL" "refs/heads/$BRANCH" 2>/dev/null || true)
    set -- $output
    value=${1:-}
    is_sha "$value" || return 1
    printf '%s' "$value"
}

clone_runtime_checkout() {
    destination=$1
    expected_sha=$2
    PULL_PHASE=candidate-objects

    # Supervisor already fetched and verified the exact target into this cache.
    # Re-cloning over HTTPS needlessly repeats acquisition and can fail even
    # when the required Git objects are available locally. Materialize a fully
    # independent staging checkout from those objects instead; --no-hardlinks
    # prevents the candidate from sharing mutable object files with live Git.
    if checkout_metadata_valid "$WORKTREE" && checkout_is_clean "$WORKTREE"; then
        if ! run_bounded_git -C "$WORKTREE" cat-file -e "$expected_sha^{commit}" >/dev/null 2>&1; then
            echo "ordax-git: commit esperado nao foi adquirido; checkout local preservado" >&2
            return 1
        fi
        acquire_runtime_candidate_blobs "$expected_sha" || return 1
        PULL_PHASE=isolated-checkout
        echo "ordax-git: preparando checkout isolado do commit ja validado em cache"
        seed_runtime_checkout_from_local "$WORKTREE" "$expected_sha" "$destination" fetched
        return $?
    fi

    # Cold recovery or invalid cache has no trusted local materialization
    # source; this is the only case that acquires a full clean remote clone.
    PULL_PHASE=remote-clone
    rm -rf "$destination"
    echo "ordax-git: preparando checkout novo e isolado de $REPO_URL ($BRANCH)"
    if ! run_bounded_git clone \
        --branch "$BRANCH" \
        --single-branch \
        --filter=blob:none \
        --sparse \
        "$REPO_URL" \
        "$destination"; then
        rm -rf "$destination"
        return 1
    fi
    if ! configure_runtime_checkout_at "$destination"; then
        rm -rf "$destination"
        return 1
    fi
    checkout_metadata_valid "$destination" || {
        rm -rf "$destination"
        return 1
    }
    checkout_is_clean "$destination" || {
        rm -rf "$destination"
        return 1
    }
    cloned_sha=$(git -C "$destination" rev-parse HEAD 2>/dev/null || true)
    [ "$cloned_sha" = "$expected_sha" ] || {
        echo "ordax-git: checkout preparado divergiu da main esperada" >&2
        rm -rf "$destination"
        return 1
    }
    return 0
}

seed_runtime_checkout_from_local() {
    source_repo=$1
    expected_sha=$2
    destination=$3
    source_mode=${4:-seed}

    [ -d "$source_repo/.git" ] || {
        echo "ordax-git: local seed source is not a Git checkout" >&2
        return 1
    }
    is_sha "$expected_sha" || {
        echo "ordax-git: local seed SHA is invalid" >&2
        return 1
    }
    source_sha=$(git -C "$source_repo" rev-parse HEAD 2>/dev/null || true)
    case "$source_mode" in
        seed)
            [ "$source_sha" = "$expected_sha" ] || {
                echo "ordax-git: local seed source does not match requested SHA" >&2
                return 1
            }
            ;;
        fetched)
            checkout_metadata_valid "$source_repo" && checkout_is_clean "$source_repo" || {
                echo "ordax-git: verified source checkout is unavailable or dirty" >&2
                return 1
            }
            git -C "$source_repo" merge-base --is-ancestor "$source_sha" "$expected_sha" >/dev/null 2>&1 || {
                echo "ordax-git: cached candidate is not a fast-forward from current" >&2
                return 1
            }
            ;;
        *)
            echo "ordax-git: unsupported local checkout mode" >&2
            return 1
            ;;
    esac

    rm -rf "$destination"
    mkdir -p "$(dirname "$destination")"
    echo "ordax-git: pre-carregando checkout limpo em $expected_sha"
    if ! git clone --no-checkout --no-hardlinks "$source_repo" "$destination" >/dev/null 2>&1; then
        rm -rf "$destination"
        return 1
    fi
    git -C "$destination" remote set-url origin "$REPO_URL" || {
        rm -rf "$destination"
        return 1
    }
    # A local clone only carries branch refs, not the source repository's
    # remote-tracking refs. A fetched candidate can therefore be present in
    # source's origin/main but absent from the isolated destination. Transfer
    # the verified candidate from the local cache before checking it out:
    # no second remote HTTPS fetch and no mutation of the running checkout.
    if [ "$source_mode" = fetched ]; then
        if ! run_bounded_git -C "$destination" fetch --no-tags \
            "$source_repo" "refs/remotes/origin/$BRANCH" >/dev/null 2>&1; then
            echo "ordax-git: isolated checkout could not import cached candidate" >&2
            rm -rf "$destination"
            return 1
        fi
        staged_candidate=$(git -C "$destination" rev-parse FETCH_HEAD 2>/dev/null || true)
        if [ "$staged_candidate" != "$expected_sha" ]; then
            echo "ordax-git: isolated checkout candidate does not match verified main" >&2
            rm -rf "$destination"
            return 1
        fi
    fi
    git -C "$destination" config remote.origin.fetch "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" || {
        rm -rf "$destination"
        return 1
    }
    git -C "$destination" sparse-checkout init --no-cone || {
        rm -rf "$destination"
        return 1
    }
    git -C "$destination" checkout -B "$BRANCH" "$expected_sha" >/dev/null 2>&1 || {
        rm -rf "$destination"
        return 1
    }
    configure_runtime_checkout_at "$destination" || {
        rm -rf "$destination"
        return 1
    }
    git -C "$destination" update-ref "refs/remotes/origin/$BRANCH" "$expected_sha" || {
        rm -rf "$destination"
        return 1
    }
    git -C "$destination" branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || {
        rm -rf "$destination"
        return 1
    }
    checkout_metadata_valid "$destination" || {
        rm -rf "$destination"
        return 1
    }
    checkout_is_clean "$destination" || {
        rm -rf "$destination"
        return 1
    }
    seeded_sha=$(git -C "$destination" rev-parse HEAD 2>/dev/null || true)
    [ "$seeded_sha" = "$expected_sha" ] || {
        rm -rf "$destination"
        return 1
    }
    return 0
}

replace_runtime_checkout() {
    expected_sha=$1
    reason=$2
    transaction_id=$$
    stage=$STAGING_PREFIX.$transaction_id
    retired=$RETIRED_PREFIX.$transaction_id
    old_sha=""

    if [ -d "$WORKTREE/.git" ]; then
        old_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    fi
    case "$reason" in
        dirty) record_dirty_checkout ;;
    esac

    clone_runtime_checkout "$stage" "$expected_sha" || {
        echo "ordax-git: atualizacao falhou ao preparar nova versao; usando versao local ${old_sha:-disponivel}" >&2
        return 1
    }

    PULL_PHASE=atomic-switch
    if [ -e "$retired" ] || [ -L "$retired" ]; then
        echo "ordax-git: transaction retirement path already exists; refusing unsafe overwrite" >&2
        rm -rf "$stage"
        return 1
    fi
    write_pull_transaction "$transaction_id" prepared "$expected_sha" "$old_sha" "$reason" || {
        rm -rf "$stage"
        return 1
    }
    if [ -e "$WORKTREE" ]; then
        if ! mv "$WORKTREE" "$retired"; then
            rm -rf "$stage"
            clear_pull_transaction
            echo "ordax-git: atualizacao falhou antes da troca; workspace local preservado" >&2
            return 1
        fi
        write_pull_transaction "$transaction_id" retired "$expected_sha" "$old_sha" "$reason" || return 1
    fi

    if ! mv "$stage" "$WORKTREE"; then
        if [ -e "$retired" ] && [ ! -e "$WORKTREE" ]; then
            mv "$retired" "$WORKTREE" || {
                echo "ordax-git: falha durante troca; transacao mantida para recuperacao no proximo boot" >&2
                return 1
            }
        fi
        clear_pull_transaction
        echo "ordax-git: atualizacao falhou durante ativacao; usando versao local ${old_sha:-anterior}" >&2
        return 1
    fi

    PULL_PHASE=candidate-validation
    if ! checkout_metadata_valid "$WORKTREE" || ! checkout_is_clean "$WORKTREE"; then
        quarantine_interrupted_checkout "$WORKTREE" "$transaction_id" || {
            echo "ordax-git: checkout novo invalido e nao pode ser isolado; transacao preservada" >&2
            return 1
        }
        if [ -e "$retired" ]; then
            mv "$retired" "$WORKTREE" || {
                echo "ordax-git: rollback da troca falhou; transacao preservada para recuperacao" >&2
                return 1
            }
        fi
        clear_pull_transaction
        echo "ordax-git: atualizacao falhou na validacao; usando versao local ${old_sha:-anterior}" >&2
        return 1
    fi

    PULL_PHASE=state-commit
    if is_sha "$old_sha" && [ "$old_sha" != "$expected_sha" ]; then
        write_state "$PREVIOUS_FILE" "$old_sha"
    fi
    write_state "$CURRENT_FILE" "$expected_sha"
    rm -rf "$retired"
    clear_pull_transaction
    echo "ordax-git: checkout atomico ativado em $expected_sha"
    return 0
}

refresh_dev_helpers() {
    source_sha=$1
    helper=$WORKTREE/system/services/base-update/dev-helpers.sh
    [ -f "$helper" ] || {
        echo "ordax-git: helper refresh owner not present; runtime checkout remains usable" >&2
        return 0
    }
    if ! ORDAX_SOURCE_SHA="$source_sha" \
            ORDAX_WORKTREE="$WORKTREE" \
            ORDAX_STATE_DIR="$STATE_DIR" \
            /bin/sh "$helper"; then
        echo "ordax-git: development Base helper refresh failed; checkout remains active but helper activation is incomplete" >&2
        return 1
    fi
    return 0
}

cleanup_transaction_artifacts() {
    for candidate in "$STAGING_PREFIX".*; do
        [ -e "$candidate" ] || [ -L "$candidate" ] || continue
        rm -rf "$candidate"
    done

    if checkout_metadata_valid "$WORKTREE" && checkout_is_clean "$WORKTREE"; then
        active_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
        for candidate in "$RETIRED_PREFIX".*; do
            [ -e "$candidate" ] || [ -L "$candidate" ] || continue
            retired_sha=$(git -C "$candidate" rev-parse HEAD 2>/dev/null || true)
            if checkout_metadata_valid "$candidate" && checkout_is_clean "$candidate" && \
               [ -n "$active_sha" ] && [ "$retired_sha" = "$active_sha" ]; then
                rm -rf "$candidate"
            fi
        done
    fi
}

mkdir -p "$WORKSPACE_ROOT" "$STATE_DIR" "$RUN_DIR"
if ! acquire_pull_lock; then
    exit 75
fi
# A failure after lock acquisition is classified at its last trusted phase.
# Atomic rename avoids torn receipts; only fixed phase tokens are persisted.
record_pull_exit() {
    code=$1
    if [ "$code" -eq 0 ]; then
        PULL_PHASE=completed
    fi
    write_state "$PULL_RESULT_FILE" "$PULL_PHASE" || true
    release_pull_lock
}
trap 'record_pull_exit "$?"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
recover_interrupted_swap || exit 1
recover_legacy_retired_checkout || exit 1
cleanup_transaction_artifacts

if [ "$SEED_MODE" -eq 1 ]; then
    is_sha "$SEED_SOURCE_SHA" || {
        echo "ordax-git: local seed SHA is invalid" >&2
        exit 2
    }
    seed_runtime_checkout_from_local "$SEED_SOURCE_REPO" "$SEED_SOURCE_SHA" "$WORKTREE" || exit 1
    write_state "$CURRENT_FILE" "$SEED_SOURCE_SHA"
    rm -f "$PREVIOUS_FILE" "$PINNED_FILE" "$BOOT_REJECTED_FILE"
    printf 'ORDAX_SOURCE_SHA=%s\n' "$SEED_SOURCE_SHA"
    exit 0
fi

# A Supervisor-owned transaction arrives with an exact candidate SHA whose
# tracking ref and Git objects were already fetched and checked by Supervisor.
# It MUST NOT perform a second remote discovery: that races a moving main and
# makes an otherwise complete delivery dependent on another HTTPS request.
# A broken local handoff is a specific failure, not permission to rediscover.
remote_sha=""
SUPERVISOR_VERIFIED_CACHE=0
if [ -n "$EXPECTED_SHA" ]; then
    PULL_PHASE=handoff-validation
    if ! checkout_metadata_valid "$WORKTREE"; then
        PULL_PHASE="handoff-metadata-${CHECKOUT_METADATA_FAILURE:-unknown}"
        echo "ordax-git: Supervisor handoff rejected: invalid checkout metadata ($PULL_PHASE)" >&2
        exit 1
    fi
    cached_main=$(git -C "$WORKTREE" rev-parse "refs/remotes/origin/$BRANCH" 2>/dev/null || true)
    if [ "$cached_main" != "$EXPECTED_SHA" ]; then
        PULL_PHASE=handoff-ref-mismatch
        echo "ordax-git: Supervisor handoff rejected: tracking ref differs from verified candidate" >&2
        exit 1
    fi
    if ! run_bounded_git -C "$WORKTREE" cat-file -e "$EXPECTED_SHA^{commit}" >/dev/null 2>&1; then
        PULL_PHASE=handoff-commit-unavailable
        echo "ordax-git: Supervisor handoff rejected: candidate Git object is unavailable" >&2
        exit 1
    fi
    remote_sha=$EXPECTED_SHA
    SUPERVISOR_VERIFIED_CACHE=1
    echo "ordax-git: usando candidato ja adquirido e fixado pelo Supervisor"
else
    # Standalone maintenance Pull has no Supervisor witness; in this mode
    # remote discovery is owned by ordax-pull itself.
    PULL_PHASE=remote-discovery
    remote_sha=$(remote_main_sha || true)
fi

if [ -z "$remote_sha" ]; then
    network_failure_hint
    echo "ordax-git: main remota indisponivel; checkout local sera preservado" >&2
    local_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    if is_sha "$local_sha" && [ -x "$WORKTREE/system/entrypoint" ]; then
        echo "ordax-git: atualizacao falhou; usando versao local $local_sha" >&2
        if ! checkout_is_clean "$WORKTREE"; then
            echo "ordax-git: checkout local possui alteracoes; ordax-run validara o estado antes de iniciar" >&2
        fi
    fi
    exit 1
fi
recovery_pinned=""
recovery_rejected=""
if [ "$AUTOMATIC_ROLLBACK_RECOVERY" -eq 1 ]; then
    recovery_pinned=$(read_state "$PINNED_FILE")
    recovery_rejected=$(read_state "$BOOT_REJECTED_FILE")
    recovery_current=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    if ! is_sha "$recovery_pinned" || ! is_sha "$recovery_rejected" || ! is_sha "$recovery_current" || \
       [ "$recovery_current" != "$recovery_pinned" ] || [ "$recovery_rejected" = "$recovery_pinned" ]; then
        echo "ordax-git: estado de rollback automatico invalido; known-good preservado" >&2
        exit 1
    fi
    if [ "$remote_sha" = "$recovery_pinned" ]; then
        echo "ordax-git: main ainda aponta para o known-good fixado; rollback preservado" >&2
        exit 1
    fi
    if [ "$remote_sha" = "$recovery_rejected" ]; then
        echo "ordax-git: main ainda aponta para a entrega rejeitada; rollback preservado" >&2
        exit 1
    fi
fi

if ! checkout_metadata_valid "$WORKTREE"; then
    echo "ordax-git: checkout ausente ou inconsistente; reconstruindo sem reutilizar estado Git local" >&2
    replace_runtime_checkout "$remote_sha" invalid || exit 1
else
    current=$(git -C "$WORKTREE" rev-parse HEAD)

    if ! checkout_is_clean "$WORKTREE"; then
        echo "ordax-git: checkout local alterado; substituindo cache por clone limpo validado" >&2
        replace_runtime_checkout "$remote_sha" dirty || exit 1
    elif [ "$current" != "$remote_sha" ]; then
        # Supervisor already fetched this exact tracking ref. A repeat fetch
        # here would reintroduce a remote dependency and race against main.
        if [ "$SUPERVISOR_VERIFIED_CACHE" -ne 1 ]; then
            PULL_PHASE=remote-fetch
            if ! run_bounded_git -C "$WORKTREE" fetch --no-tags origin \
                "refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" >/dev/null 2>&1; then
                echo "ordax-git: fetch de verificacao falhou; checkout local preservado" >&2
                exit 1
            fi
        fi
        run_bounded_git -C "$WORKTREE" merge-base --is-ancestor "$current" "$remote_sha" >/dev/null 2>&1 || {
            echo "ordax-git: main remota nao e fast-forward do checkout local; substituicao bloqueada" >&2
            exit 1
        }
        replace_runtime_checkout "$remote_sha" update || exit 1
    else
        configure_runtime_checkout_at "$WORKTREE" || {
            echo "ordax-git: sparse checkout local inconsistente; reconstruindo cache" >&2
            replace_runtime_checkout "$remote_sha" invalid || exit 1
        }
        write_state "$CURRENT_FILE" "$current"
    fi
fi

current=$(git -C "$WORKTREE" rev-parse HEAD)
if [ -n "$EXPECTED_SHA" ] && [ "$current" != "$EXPECTED_SHA" ]; then
    echo "ordax-git: checkout ativado divergiu do SHA esperado" >&2
    exit 1
fi
write_state "$CURRENT_FILE" "$current"
if [ "$AUTOMATIC_ROLLBACK_RECOVERY" -eq 1 ]; then
    if [ "$current" = "$recovery_pinned" ] || [ "$current" = "$recovery_rejected" ]; then
        echo "ordax-git: recuperacao nao produziu uma entrega nova segura; rollback preservado" >&2
        exit 1
    fi
    rm -f "$PINNED_FILE" "$BOOT_REJECTED_FILE"
else
    rm -f "$PINNED_FILE"
fi
# Helper installation is a separate required activation gate. A failure may
# happen after the Git swap and must report nonzero so the Supervisor does not
# promote an incompletely installed version. The Supervisor reads the exact
# active SHA and the bounded error phase instead of assuming checkout rollback.
PULL_PHASE=helper-refresh
refresh_dev_helpers "$current" || exit 1
printf 'ORDAX_SOURCE_SHA=%s\n' "$current"
