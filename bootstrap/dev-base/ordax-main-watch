#!/bin/sh
set -eu

BIN_DIR=${ORDAX_BIN_DIR:-/usr/local/bin}
STATE_DIR=${ORDAX_STATE_DIR:-/state/ordax}
RUN_DIR=${ORDAX_UPDATE_RUN_DIR:-/run/ordax-update}
WORKTREE=${ORDAX_WORKTREE:-/workspace/ordax}
INTERVAL=${ORDAX_UPDATE_INTERVAL_SECONDS:-5}
LOG_FILE=$STATE_DIR/main-watch.log
LOCK_FILE=$RUN_DIR/main-watch.lock
SUPERVISOR_HEARTBEAT_FILE=$RUN_DIR/supervisor-heartbeat
RUNTIME_SURFACE_SHA_FILE=$STATE_DIR/runtime-surface-sha
PINNED_FILE=$STATE_DIR/pinned-commit
BOOT_REJECTED_FILE=$STATE_DIR/boot-rejected-commit
OWNER_STATE=""
PIN_STATE=""
LAST_PULL_FAILURE=""

case "$INTERVAL" in
    ''|*[!0-9]*) INTERVAL=5 ;;
esac
[ "$INTERVAL" -ge 5 ] 2>/dev/null || INTERVAL=5

mkdir -p "$STATE_DIR" "$RUN_DIR"
chmod 700 "$RUN_DIR" 2>/dev/null || true

log() {
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown-time)" "$*" >>"$LOG_FILE"
}

acquire_single_instance_lock() {
    [ ! -L "$LOCK_FILE" ] || {
        log "watch recusado: lock inseguro em $LOCK_FILE"
        return 1
    }
    : >"$LOCK_FILE"
    chmod 600 "$LOCK_FILE" 2>/dev/null || true
    exec 9>"$LOCK_FILE"
    if [ -x /bin/busybox ] && /bin/busybox --list 2>/dev/null | grep -x flock >/dev/null 2>&1; then
        /bin/busybox flock -n 9
        return $?
    fi
    command -v flock >/dev/null 2>&1 || {
        log "watch recusado: flock indisponivel"
        return 1
    }
    flock -n 9
}

if ! acquire_single_instance_lock; then
    exit 0
fi

is_pid() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 1 ] 2>/dev/null
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

read_state_value() {
    source=$1
    value=""
    [ -f "$source" ] && [ ! -L "$source" ] || {
        printf '%s' ""
        return 0
    }
    IFS= read -r value <"$source" || true
    printf '%s' "$value"
}

active_supervisor_pid() {
    pid=$(read_state_value "$SUPERVISOR_HEARTBEAT_FILE")
    is_pid "$pid" || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    command_line=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in
        *"/system/supervisor"*) printf '%s' "$pid"; return 0 ;;
    esac
    return 1
}

handoff_runtime_drift_if_needed() {
    pid=$1
    checkout_sha=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    runtime_sha=$(read_state_value "$RUNTIME_SURFACE_SHA_FILE")
    is_sha "$checkout_sha" || return 0
    is_sha "$runtime_sha" || return 0
    [ "$checkout_sha" != "$runtime_sha" ] || return 0

    log "checkout $checkout_sha difere da Surface $runtime_sha; solicitando refresh do supervisor $pid"
    kill -TERM "$pid" >/dev/null 2>&1 || true
}

log "watch da main iniciado; intervalo=${INTERVAL}s"

while :; do
    supervisor_pid=$(active_supervisor_pid || true)
    if [ -n "$supervisor_pid" ]; then
        if [ "$OWNER_STATE" != supervisor ]; then
            log "supervisor ativo; sincronizacao da main delegada ao owner canonico"
            OWNER_STATE=supervisor
        fi
        handoff_runtime_drift_if_needed "$supervisor_pid"
        sleep "$INTERVAL"
        continue
    fi

    if [ "$OWNER_STATE" != watcher ]; then
        log "supervisor inativo; watch da main assumiu sincronizacao do checkout"
        OWNER_STATE=watcher
    fi

    pull_mode=normal
    if [ -s "$PINNED_FILE" ]; then
        if [ ! -s "$BOOT_REJECTED_FILE" ]; then
            if [ "$PIN_STATE" != manual ]; then
                log "rollback manual fixado; sincronizacao automatica da main pausada ate ordax-pull explicito"
                PIN_STATE=manual
                LAST_PULL_FAILURE=""
            fi
            sleep "$INTERVAL"
            continue
        fi
        pull_mode=automatic-recovery
        if [ "$PIN_STATE" != automatic ]; then
            log "rollback automatico fixado; main sera observada sem reabrir a entrega rejeitada"
            PIN_STATE=automatic
            LAST_PULL_FAILURE=""
        fi
    else
        PIN_STATE=""
    fi

    before=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
    status=0
    if [ "$pull_mode" = automatic-recovery ]; then
        ORDAX_AUTOMATIC_ROLLBACK_RECOVERY=1 "$BIN_DIR/ordax-pull" >/dev/null 2>&1 || status=$?
    else
        "$BIN_DIR/ordax-pull" >/dev/null 2>&1 || status=$?
    fi

    if [ "$status" -eq 0 ]; then
        after=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)
        if [ -n "$after" ] && [ "$after" != "$before" ]; then
            log "main aplicada: ${before:-unknown} -> $after"
        fi
        LAST_PULL_FAILURE=""
        PIN_STATE=""
    elif [ "$pull_mode" = automatic-recovery ]; then
        if [ "$LAST_PULL_FAILURE" != automatic-rollback-wait ]; then
            log "rollback automatico preservado; aguardando main avancar alem da entrega rejeitada"
            LAST_PULL_FAILURE=automatic-rollback-wait
        fi
    else
        failure="status=$status"
        if [ "$LAST_PULL_FAILURE" != "$failure" ]; then
            log "checagem da main indisponivel ($failure); mantendo checkout local"
            LAST_PULL_FAILURE=$failure
        fi
    fi
    sleep "$INTERVAL"
done
