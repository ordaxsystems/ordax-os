{
  "$schema": "prototype-ordax.independent-surface-runtime-source/1",
  "status": "experimental-not-promotable",
  "purpose": "replace the Alpine/APK Surface runtime with a Buildroot/musl runtime without changing Stable until parity is proven",
  "buildroot_source_contract": "bootstrap/independent-base/source.json",
  "architecture": "x86_64",
  "libc": "musl",
  "build_profile": "ordax_surface_defconfig",
  "first_boot_offline_required": true,
  "network_package_install_during_boot_allowed": false,
  "package_manager_in_runtime_allowed": false,
  "required_runtime_paths": [
    "usr/bin/cage",
    "usr/bin/python3",
    "usr/bin/Xwayland",
    "usr/bin/seatd-launch",
    "sbin/udevd",
    "bin/udevadm",
    "bin/busybox",
    "usr/lib/girepository-1.0/Gtk-3.0.typelib",
    "usr/lib/girepository-1.0/WebKit2-4.1.typelib"
  ],
  "forbidden_runtime_paths": [
    "sbin/apk",
    "usr/sbin/apk",
    "lib/apk",
    "etc/apk",
    "etc/alpine-release"
  ],
  "artifact": {
    "name": "native-surface-runtime-buildroot.erofs",
    "filesystem": "erofs",
    "compression": "lz4",
    "label": "ORDAX-SURFACE",
    "physical_artifact_authorized": false,
    "stable_promotion_authorized": false
  }
}
