# BusyBox applets required by bootstrap/stable-base/ordax-stable-init.
# Buildroot 2026.08 merges this fragment with its upstream BusyBox config.
# stat -c '%a' enforces the ephemeral local-AI secret's file mode;
# timeout -k bounds Wi-Fi coldplug before the verified product handoff.
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TIMEOUT=y
# Phase 3: applets exercised by the existing system/entrypoint guardian.
# These are BusyBox feature requirements, not a second service supervisor.
CONFIG_DATE=y
CONFIG_MV=y
CONFIG_READLINK=y
CONFIG_SHA256SUM=y
CONFIG_OD=y
CONFIG_TR=y
CONFIG_SLEEP=y
# Real system/supervisor and QEMU networking/probe paths.
CONFIG_SED=y
CONFIG_HEAD=y
CONFIG_CUT=y
CONFIG_RM=y
CONFIG_TOUCH=y
CONFIG_NSLOOKUP=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_TIMEOUT=y
