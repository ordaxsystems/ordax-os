# BusyBox applets required by bootstrap/stable-base/ordax-stable-init.
# Buildroot 2026.08 merges this fragment with its upstream BusyBox config.
# stat -c '%a' enforces the ephemeral local-AI secret's file mode;
# timeout -k bounds Wi-Fi coldplug before the verified product handoff.
CONFIG_ACPID=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TIMEOUT=y
CONFIG_FLOCK=y
# Required for recursive bind preservation during Owner Dev rootfs A/B pivot.
CONFIG_FEATURE_MOUNT_FLAGS=y
# iproute2 owns /sbin/ip: the BusyBox IP applet lacks address replace.
# CONFIG_IP is not set
