# BusyBox applets required only by the Owner/Development Dev USB helpers.
# The portable handoff fragment already owns stat/timeout/flock. Keep this
# fragment restricted to capabilities that must not widen the minimal profile.
# ordax-network uses one-shot client mode before Git/HTTPS bootstrap.
CONFIG_NTPD=y
CONFIG_NSLOOKUP=y
CONFIG_WGET=y
# Owner USB sibling DATA identity is read-only; Stable remains unchanged.
CONFIG_BLKID=y
CONFIG_FEATURE_VOLUMEID_EXFAT=y
