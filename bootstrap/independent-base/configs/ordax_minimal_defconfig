BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y
BR2_INIT_NONE=y
BR2_PACKAGE_BUSYBOX=y
# /sbin/ip must implement the Surface contract: ip address replace.
BR2_PACKAGE_IPROUTE2=y
# Buildroot installs the full iproute2 suite by default. Apply the version-scoped
# OrdaX patch so this slice builds and installs only the consumed /sbin/ip tool.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ORDAX_MINIMAL_PATH)/patches"
# Canonical Surface Wi-Fi broker runtime: scan/link through iw and associate
# through wpa_supplicant using the current Linux nl80211 API. Do not add a
# parallel network manager or unused control interfaces.
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
# BR2_PACKAGE_WPA_SUPPLICANT_WEXT is not set
# BR2_PACKAGE_WPA_SUPPLICANT_CLI is not set
# BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE is not set
# BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE is not set
# BR2_PACKAGE_WPA_SUPPLICANT_DBUS is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPA3 is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPS is not set
# BR2_PACKAGE_WPA_SUPPLICANT_EAP is not set
# HTTPS/update/runtime trust needs a real CA bundle in the immutable base.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ORDAX_MINIMAL_PATH)/configs/portable-handoff.busybox.fragment"
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ORDAX_MINIMAL_PATH)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ORDAX_MINIMAL_PATH)/post-build.sh"
# The kernel-headers release is generated from bootstrap/kernel/source.json.
# Never pin a second kernel identity in this defconfig.
