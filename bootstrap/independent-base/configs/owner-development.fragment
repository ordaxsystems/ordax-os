# OrdaX Owner/Development capability profile.
# This extends the canonical Independent Base; it is not a second distro/base.
# Keep package ownership in Buildroot and keep runtime package managers absent.
# /sbin/modprobe remains owned by the canonical BusyBox base; do not add kmod
# unless a proven runtime requirement exceeds that existing capability.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
