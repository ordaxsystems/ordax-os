# Shared hardware/network capabilities for OrdaX Buildroot Base profiles.
# Firmware families are declared here exactly once, while runtime selection
# remains tied to docs/contracts/hardware-support-matrix.json and verified
# kernel module firmware= declarations. No product package manager.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y

BR2_PACKAGE_LINUX_FIRMWARE=y
