#!/bin/sh
# Disposable QEMU probe PID1 only. Never used by official portable initramfs.
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
echo ORDAX_INDEPENDENT_PROBE=START
mkdir -p /proc /sys /dev /run /proof/base /proof/state
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
rescue() {
    echo "ORDAX_INDEPENDENT_RECOVERY=$1"
    echo "ORDAX_INDEPENDENT_PROMOTABLE=NO"
    sync
    poweroff -f
    sleep 3
    exit 1
}
mount -t erofs -o ro /dev/sda /proof/base || rescue erofs
test -r /proof/base/etc/ordax/independent-base || rescue base-identity
grep -q 'ORDAX_INDEPENDENT_BASE=EXPERIMENTAL' /proof/base/etc/ordax/independent-base || rescue base-identity
grep -q " /proof/base erofs ro," /proc/mounts || rescue erofs-not-readonly
if touch /proof/base/.ordax-unexpected-write 2>/dev/null; then
    rescue erofs-write-accepted
fi
echo ORDAX_INDEPENDENT_EROFS=READ_ONLY
mount -t ext4 -o rw /dev/sdb /proof/state || rescue state
if test -e /proof/state/ordax-independent-marker; then
    grep -q '^PERSISTENT$' /proof/state/ordax-independent-marker || rescue persistence
    echo ORDAX_INDEPENDENT_STATE=RETAINED
else
    echo PERSISTENT > /proof/state/ordax-independent-marker || rescue persistence-write
    sync
    echo ORDAX_INDEPENDENT_STATE=CREATED
fi
if /ordax/bootstrap/network/bin/netbox ifconfig eth0 up && /ordax/bootstrap/network/bring-up; then
    echo ORDAX_INDEPENDENT_NETWORK=DHCP
else
    rescue dhcp
fi
# Provisioning proof only: QEMU has no supported Wi-Fi adapter attached here.
# Execute the actual target binaries so a missing/broken userspace cannot be
# mistaken for hardware Wi-Fi proof.
iw_version=$(/usr/sbin/iw --version 2>&1) || rescue wifi-iw-version
case "$iw_version" in
    "iw version "*) ;;
    *) rescue wifi-iw-identity ;;
esac
wpa_version=$(/usr/sbin/wpa_supplicant -v 2>&1) || rescue wifi-wpa-supplicant-version
case "$wpa_version" in
    "wpa_supplicant v"*) ;;
    *) rescue wifi-wpa-supplicant-identity ;;
esac
test -s /etc/ssl/certs/ca-certificates.crt || rescue ca-bundle
grep -q -- '-----BEGIN CERTIFICATE-----' /etc/ssl/certs/ca-certificates.crt || rescue ca-bundle-format
echo ORDAX_INDEPENDENT_WIFI_USERSPACE=READY
echo ORDAX_INDEPENDENT_CA_BUNDLE=READY
# Functional Surface parity proof happens only inside this disposable guest.
# Never run this mutation on the CI host.
if /sbin/ip address replace 127.0.0.1/8 dev lo; then
    echo ORDAX_INDEPENDENT_SURFACE_IP_REPLACE_EXIT=0
else
    ip_replace_exit=$?
    echo "ORDAX_INDEPENDENT_SURFACE_IP_REPLACE_EXIT=$ip_replace_exit"
    rescue surface-loopback-ip-replace
fi
loopback_line=$(/sbin/ip -o -4 address show dev lo) || rescue surface-loopback-ip-show
case " $loopback_line " in
    *" inet 127.0.0.1/8 "*) ;;
    *) rescue surface-loopback-address ;;
esac
echo ORDAX_INDEPENDENT_SURFACE_LOOPBACK=127.0.0.1/8
echo ORDAX_INDEPENDENT_SURFACE_IP_REPLACE=PASS
# Probe-only diagnostics from kernel-owned /proc. No extra daemon or package.
# These are observed resource measurements, NOT release-health predicates.
measure_resources() {
    mem_total_kib=
    mem_available_kib=
    while read -r label value unit; do
        case "$label" in
            MemTotal:) mem_total_kib=$value ;;
            MemAvailable:) mem_available_kib=$value ;;
        esac
    done < /proc/meminfo
    case "$mem_total_kib:$mem_available_kib" in
        *[!0-9:]*|:*|*:) return 1 ;;
    esac
    [ "$mem_total_kib" -gt 0 ] || return 1
    [ "$mem_available_kib" -le "$mem_total_kib" ] || return 1
    read -r cpu user nice system idle iowait irq softirq steal remaining < /proc/stat || return 1
    [ "$cpu" = cpu ] || return 1
    case "$user:$nice:$system:$idle:$iowait:$irq:$softirq:$steal" in
        *[!0-9:]*|:*|*:) return 1 ;;
    esac
    total_ticks=$((user + nice + system + idle + iowait + irq + softirq + steal))
    [ "$total_ticks" -gt 0 ] || return 1
    busy_ticks=$((total_ticks - idle - iowait))
    process_count=0
    for process_dir in /proc/[0-9]*; do
        [ ! -d "$process_dir" ] || process_count=$((process_count + 1))
    done
    [ "$process_count" -gt 0 ] || return 1
    read -r boot_uptime_s remainder < /proc/uptime || return 1
    case "$boot_uptime_s" in
        ''|*[!0-9.]*) return 1 ;;
    esac
    printf 'ORDAX_INDEPENDENT_METRIC_MEM_TOTAL_KIB=%s\n' "$mem_total_kib"
    printf 'ORDAX_INDEPENDENT_METRIC_MEM_USED_KIB=%s\n' "$((mem_total_kib - mem_available_kib))"
    printf 'ORDAX_INDEPENDENT_METRIC_CPU_BUSY_PCT=%s\n' "$((busy_ticks * 100 / total_ticks))"
    printf 'ORDAX_INDEPENDENT_METRIC_PROCESSES=%s\n' "$process_count"
    printf 'ORDAX_INDEPENDENT_METRIC_UPTIME_S=%s\n' "$boot_uptime_s"
}
measure_resources || rescue resource-metrics
echo ORDAX_INDEPENDENT_BOOT=PASS
umount /proof/state || rescue state-unmount
umount /proof/base || rescue base-unmount
sync
poweroff -f
sleep 3
exit 1
