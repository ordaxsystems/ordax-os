{
  "$schema": "prototype-ordax.surface-runtime-source/1",
  "status": "candidate-not-promotable",
  "purpose": "One canonical Buildroot/musl Surface producer for all OrdaX channels; physical and Stable publication remain separately gated.",
  "buildroot_source_contract": "bootstrap/independent-base/source.json",
  "kernel_source_contract": "bootstrap/kernel/source.json",
  "architecture": "x86_64",
  "libc": "musl",
  "build_profile": "ordax_surface_defconfig",
  "first_boot_offline_required": true,
  "network_package_install_during_boot_allowed": false,
  "package_manager_in_runtime_allowed": false,
  "required_runtime_paths": [
    "usr/bin/cage",
    "usr/bin/python3",
    "usr/bin/Xwayland",
    "usr/bin/seatd-launch",
    "sbin/udevd",
    "bin/udevadm",
    "bin/busybox",
    "usr/lib/girepository-1.0/Gtk-3.0.typelib",
    "usr/lib/girepository-1.0/WebKit2-4.1.typelib",
    "usr/lib/libGL.so.1",
    "usr/lib/dri/swrast_dri.so",
    "usr/lib/udev/rules.d/60-input-id.rules",
    "usr/share/X11/xkb/rules/evdev",
    "usr/share/X11/xkb/keycodes/evdev",
    "usr/share/X11/xkb/symbols/us",
    "usr/share/X11/xkb/symbols/br",
    "usr/share/X11/xkb/types/complete",
    "usr/share/X11/xkb/compat/complete",
    "usr/bin/gst-inspect-1.0",
    "usr/bin/gst-launch-1.0",
