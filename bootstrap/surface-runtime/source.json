    "usr/lib/gstreamer-1.0/libgstpulseaudio.so",
    "usr/lib/gstreamer-1.0/libgstlibav.so"
  ],
  "forbidden_runtime_paths": [
    "sbin/apk",
    "usr/sbin/apk",
    "lib/apk",
    "etc/apk",
    "etc/alpine-release"
