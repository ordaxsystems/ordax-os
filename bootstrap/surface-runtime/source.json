  "artifact": {
    "name": "native-surface-runtime.erofs",
    "filesystem": "erofs",
    "compression": "lz4",
    "label": "ORDAX-SURFACE",
    "physical_artifact_authorized": false,
    "stable_promotion_authorized": false
