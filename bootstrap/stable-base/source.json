{
  "$schema": "prototype-ordax.stable-base-source/1",
  "status": "buildroot-candidate-not-promotable",
  "product_scope": "stable-mvp-usb-only",
  "base_producer": {
    "entrypoint": "bootstrap/independent-base/build.py",
    "source_contract": "bootstrap/independent-base/source.json",
    "profile": "stable-mvp",
    "requires_authenticated_kernel_archive": true,
    "package_manager_in_runtime_allowed": false,
    "physical_artifact_authorized": false,
    "signed_release_equivalence_proven": false
  },
  "kernel_modules": {
    "source": "bootstrap/kernel",
    "required_basenames": [
      "iwlwifi",
      "iwlmvm",
      "rtl8xxxu",
      "mt76x2u",
      "ath9k_htc"
    ],
    "selected_with_dependencies": true,
    "coldplug_entrypoints": [
      "iwlwifi",
      "rtl8xxxu",
      "mt76x2u",
      "ath9k_htc"
    ]
  },
  "rootfs": {
    "format": "erofs",
    "artifact_name": "stable-base.erofs",
    "target_path": ".ordax/base/stable-base.erofs",
    "read_only": true,
    "compression": "lz4",
    "volume_label": "ORDAX-BASE",
    "complete_minimal_os_userspace": true,
    "product_system_tree_embedded": false,
    "surface_runtime_embedded": false,
    "mutable_state_embedded": false,
    "maximum_unique_regular_bytes": 230686720,
    "runtime_directories": [
      "state",
      "system",
      "ordax",
      "ordax-data",
      "ordax-esp",
      "home",
      "run",
      "tmp",
      "proc",
      "sys",
      "dev",
      "root"
    ]
  },
  "entrypoint": {
    "source": "bootstrap/stable-base/ordax-stable-init",
    "path": "/sbin/ordax-stable-init",
    "requires_distribution_profile": "stable-mvp",
    "requires_product_mode": "usb",
    "requires_runtime_layout": "portable-v2"
  },
  "state_overlay": {
    "owner": "persistent-state.img",
    "upper": "/ordax/base/upper",
    "work": "/ordax/base/work",
    "base_root_immutable": true
  },
  "build": {
    "canonical_entrypoint": "bootstrap/independent-base/build.py",
    "shared_firmware_policy": "bootstrap/base/firmware_policy.py",
    "physical_artifact_authorized": false,
    "signed_update_integration_implemented": false,
    "qemu_boot_proven": false,
    "physical_boot_proven": false
  },
  "promotion_blockers": [
    "verified-signed-buildroot-delivery",
    "portable-uefi-ovmf-proof",
    "physical-usb-boot-proof"
  ]
}
