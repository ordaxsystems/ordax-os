#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

fail() {
    echo "ordax-stable-init: $*" >&2
    exit 1
}

is_sha() {
    value=${1:-}
    [ "${#value}" -eq 40 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

is_sha256() {
    value=${1:-}
    [ "${#value}" -eq 64 ] || return 1
    case "$value" in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
}

validate_surface_runtime() {
    [ "${ORDAX_SURFACE_RUNTIME_MODE:-}" = "verified-erofs-overlay" ] ||
        return 1
    [ "${ORDAX_SURFACE_RUNTIME_ROOT:-}" = "/run/ordax/runtime/native-surface/rootfs" ] ||
        return 1
    is_sha256 "${ORDAX_SURFACE_RUNTIME_SHA256:-}" ||
        return 1
    [ -x "$ORDAX_SURFACE_RUNTIME_ROOT/usr/bin/cage" ] ||
        return 1
    [ -x "$ORDAX_SURFACE_RUNTIME_ROOT/usr/bin/python3" ] ||
        return 1
}

validate_local_ai_runtime() {
    [ "${ORDAX_LOCAL_AI_RUNTIME_MODE:-}" = "verified-erofs-read-only" ] ||
        return 1
    [ "${ORDAX_LOCAL_AI_RUNTIME_ROOT:-}" = "/run/ordax/runtime/local-ai" ] ||
        return 1
    is_sha256 "${ORDAX_LOCAL_AI_RUNTIME_SHA256:-}" ||
        return 1
    [ -x "$ORDAX_LOCAL_AI_RUNTIME_ROOT/bin/llama-server" ] ||
        return 1
    [ -x "$ORDAX_LOCAL_AI_RUNTIME_ROOT/bin/ordax-local-ai" ] ||
        return 1
    [ -f "$ORDAX_LOCAL_AI_RUNTIME_ROOT/metadata/source-lock.json" ] ||
        return 1
    [ -f "$ORDAX_LOCAL_AI_RUNTIME_ROOT/metadata/runtime-policy.json" ] ||
        return 1
}

disable_local_ai() {
    reason=$1
    unset ORDAX_LOCAL_AI_RUNTIME_MODE ORDAX_LOCAL_AI_RUNTIME_ROOT ORDAX_LOCAL_AI_RUNTIME_SHA256
    echo "ordax-stable-init: local AI degraded: $reason" >&2
    echo "ORDAX_LOCAL_AI_BACKEND=DEGRADED"
}

# Stable Base owns physical kernel/firmware readiness before the product Surface
# starts. The kernel build intentionally keeps broad Wi-Fi families modular so
# firmware is requested only after the verified Stable Base has made its pinned
# /lib/firmware tree available. Coldplug every real PCI/USB modalias exactly as
# a normal init/udev stack would, without hard-coding a specific notebook NIC.
coldplug_kernel_modules() {
    [ -x /sbin/modprobe ] || {
        echo "ordax-stable-init: required modprobe is unavailable" >&2
        return 1
    }

    attempted=0
    loaded=0
    unresolved=0
    seen=" "

    for modalias_path in /sys/bus/pci/devices/*/modalias /sys/bus/usb/devices/*/modalias; do
        [ -r "$modalias_path" ] || continue
        modalias=$(cat "$modalias_path" 2>/dev/null || true)
        [ -n "$modalias" ] || continue
        case "$seen" in
            *" $modalias "*) continue ;;
        esac
        seen="$seen$modalias "
        attempted=$((attempted + 1))
        if /sbin/modprobe "$modalias" >/dev/null 2>&1; then
            loaded=$((loaded + 1))
        else
            # A device may already be handled by a built-in driver or may not
            # have a module in the deliberately minimal Stable Base. Keep boot
            # available and expose the count for diagnostics instead of hiding it.
            unresolved=$((unresolved + 1))
        fi
    done

    wifi_interface=""
    for netpath in /sys/class/net/*; do
        [ -d "$netpath/wireless" ] || continue
        wifi_interface=${netpath##*/}
        break
    done

    echo "ORDAX_KERNEL_COLDPLUG=COMPLETE"
    echo "ORDAX_KERNEL_COLDPLUG_ATTEMPTED=$attempted"
    echo "ORDAX_KERNEL_COLDPLUG_LOADED=$loaded"
    echo "ORDAX_KERNEL_COLDPLUG_UNRESOLVED=$unresolved"
    if [ -n "$wifi_interface" ]; then
        echo "ORDAX_WIFI_INTERFACE=$wifi_interface"
    else
        echo "ORDAX_WIFI_INTERFACE=UNAVAILABLE"
    fi
    return 0
}

probe_local_ai_hardware() {
    LOCAL_AI_PROBE_REASON=

    detected_machine=$(uname -m 2>/dev/null || true)
    case "$detected_machine" in
        x86_64|amd64)
            detected_arch=x86_64
            ;;
        '')
            LOCAL_AI_PROBE_REASON="hardware probe could not determine architecture"
            return 1
            ;;
        *)
            LOCAL_AI_PROBE_REASON="runtime-artifact-architecture-mismatch:$detected_machine"
            return 1
            ;;
    esac

    logical_cpus=unknown
    if [ -r /proc/cpuinfo ]; then
        cpu_count=0
        while IFS= read -r cpu_line; do
            case "$cpu_line" in
                processor*:*) cpu_count=$((cpu_count + 1)) ;;
            esac
        done </proc/cpuinfo
        if [ "$cpu_count" -gt 0 ]; then
            logical_cpus=$cpu_count
        fi
    fi

    mem_total_kib=unknown
    if [ -r /proc/meminfo ]; then
        while IFS=' ' read -r mem_key mem_value mem_unit mem_rest; do
            [ "$mem_key" = "MemTotal:" ] || continue
            case "$mem_value" in
                ''|*[!0-9]*) ;;
                *) mem_total_kib=$mem_value ;;
            esac
            break
        done </proc/meminfo
    fi

    echo "ORDAX_LOCAL_AI_HARDWARE_PROBE=PASS"
    echo "ORDAX_LOCAL_AI_HARDWARE_ARCH=$detected_arch"
    echo "ORDAX_LOCAL_AI_HARDWARE_LOGICAL_CPUS=$logical_cpus"
    echo "ORDAX_LOCAL_AI_HARDWARE_MEM_TOTAL_KIB=$mem_total_kib"
    return 0
}

start_local_ai() {
    [ "${LOCAL_AI_READY:-0}" -eq 1 ] || return 0

    if ! probe_local_ai_hardware; then
        LOCAL_AI_READY=0
        disable_local_ai "${LOCAL_AI_PROBE_REASON:-hardware probe failed}"
        return 0
    fi

    mkdir -p /run/ordax
    umask 077
    ORDAX_LOCAL_AI_RUNTIME_ROOT="$ORDAX_LOCAL_AI_RUNTIME_ROOT" \
        "$ORDAX_LOCAL_AI_RUNTIME_ROOT/bin/ordax-local-ai" \
        >/run/ordax/local-ai.log 2>&1 &
    local_ai_pid=$!
    case "$local_ai_pid" in
        ''|*[!0-9]*)
            LOCAL_AI_READY=0
            disable_local_ai "backend process did not return a valid pid"
            return 0
            ;;
    esac
    printf '%s\n' "$local_ai_pid" >/run/ordax/local-ai.pid ||
        echo "ordax-stable-init: local AI pid receipt could not be written" >&2
    echo "ORDAX_LOCAL_AI_BACKEND=STARTED"
}

[ "${ORDAX_DISTRIBUTION_PROFILE:-}" = "stable-mvp" ] ||
    fail "distribution profile must be stable-mvp"
[ "${ORDAX_PRODUCT_MODE:-}" = "usb" ] ||
    fail "product mode must be usb"
[ "${ORDAX_STABLE_LAYOUT:-}" = "portable-v2" ] ||
    fail "runtime layout must be portable-v2"
is_sha "${ORDAX_SOURCE_SHA:-}" ||
    fail "verified source identity is missing or invalid"
[ -x /system/entrypoint ] ||
    fail "verified product system entrypoint is missing"

LOCAL_AI_READY=0
case "${ORDAX_RELEASE_MANIFEST_SCHEMA:-}" in
    2)
        ;;
    3)
        validate_surface_runtime ||
            fail "portable v3 Surface runtime handoff is incomplete"
        ;;
    4)
        validate_surface_runtime ||
            fail "portable v4 Surface runtime handoff is incomplete"
        if validate_local_ai_runtime; then
            LOCAL_AI_READY=1
        else
            disable_local_ai "verified runtime mount is unavailable or incomplete"
        fi
        ;;
    *)
        fail "verified portable release manifest schema is missing or unsupported"
        ;;
esac

coldplug_kernel_modules ||
    fail "physical hardware coldplug could not be initialized"

echo "ORDAX_STABLE_INIT_HANDOFF=VERIFIED"
echo "ORDAX_STABLE_INIT_SOURCE_SHA=$ORDAX_SOURCE_SHA"
start_local_ai

exec /system/entrypoint
