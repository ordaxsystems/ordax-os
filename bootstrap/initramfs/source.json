{
  "$schema": "prototype-ordax.initramfs-source/1",
  "busybox": {
    "version": "1.38.0",
    "archive_url": "https://busybox.net/downloads/busybox-1.38.0.tar.bz2",
    "signature_url": "https://busybox.net/downloads/busybox-1.38.0.tar.bz2.sig",
    "archive_sha256": "34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2"
  },
  "root_init": "bootstrap/initramfs/root/init",
  "main_partition_label": "ORDAX",
  "bootstrap_entrypoint": "/ordax/bootstrap/entrypoint",
  "storage_growth": {
    "normal_boot": "online-ext4-grow-only",
    "helper_source": "bootstrap/initramfs/grow_ext4.c",
    "helper_runtime_path": "/sbin/ordax-grow-ext4",
    "target": "largest-valid-ext4-size-within-ORDAX-block-device",
    "exact_mounted_block_device_required": true,
    "read_write_mount_required": true,
    "bigalloc_supported": false,
    "failure_policy": "warn-and-continue",
    "runtime_proof": "bootstrap/initramfs/prove_ext4_growth.sh",
    "runtime_oracle": "upstream-resize2fs-on-disposable-twin-media",
    "physical_write_authorized": false
  },
  "recovery": {
    "cmdline_token": "ordax.mode=recovery",
    "main_partition_mount": "read-only",
    "filesystem_growth": false,
    "entrypoint": "/ordax/bootstrap/recovery/entrypoint",
    "network_started": false
  },
  "legacy_archive_imported": false,
  "network_inside_fixed_initramfs": false,
  "ssh_inside_fixed_initramfs": false,
  "control_plane_inside_fixed_initramfs": false,
  "build": {
    "canonical_entrypoint": "bootstrap/initramfs/build.py",
    "static_userspace": "busybox-musl",
    "deterministic_cpio": "newc",
    "compression": "gzip-mtime-zero",
    "physical_artifact_authorized": false
  },
  "storage_health": {
    "pre_mount_check": "ext4-superblock-error-flag",
    "normal_boot_error_policy": "read-only-recovery",
    "writable_mount_error_policy": "remount-ro",
    "helper_runtime_path": "/sbin/ordax-grow-ext4",
    "automatic_destructive_repair": false
  },
  "portable_v2_prerequisites": {
    "losetup_applet": true,
    "mount_loop_support": true,
    "exfat_volume_id": true,
    "kernel_exfat_required": true,
    "kernel_erofs_required": true,
    "kernel_overlayfs_required": true,
    "boot_path_enabled": false,
    "handoff_helper_installed": true,
    "main_partition_label_unchanged": "ORDAX",
    "physical_boot_promotion_allowed": false,
    "kernel_uapi_source_contract": "bootstrap/kernel/source.json",
    "kernel_uapi_version": "6.6.52",
    "kernel_uapi_headers_install": true,
    "host_linux_headers_required": false,
    "busybox_extra_cflags_policy": "pinned-kernel-uapi-include-only",
    "activation_state_reader": {
      "source": "bootstrap/initramfs/portable_state.c",
      "runtime_path": "/sbin/ordax-portable-state",
      "static": true,
      "read_only": false,
      "accepted_slots": [
        "current",
        "known-good",
        "candidate",
        "rejected"
      ],
      "identity": "lowercase-40-hex-source-commit",
      "nofollow_directory_walk": true,
      "activation_performed": true,
      "operations": [
        "read-slot",
        "resolve",
        "select",
        "prepare",
        "select-boot",
        "commit",
        "rollback"
      ],
      "selection_order": [
        "candidate-one-shot",
        "current",
        "known-good"
      ],
      "candidate_is_boot_authority": true,
      "requires_materialized_release_directory": true,
      "requires_system_erofs_magic": true,
      "requires_manifest_and_envelope_files": true,
      "selection_output": "slot-space-commit",
      "verifies_signature": false,
      "writes_activation_state": true,
      "pid1_connected": true,
      "resolve_boot_slots": [
        "current",
        "known-good"
      ],
      "resolve_candidate_allowed": false,
      "resolve_requires_materialized_release_shape": true,
      "resolve_verifies_signature": false,
      "resolve_is_for_exact_release_agent_handoff": true,
      "candidate_boot_authority": "armed-one-shot-transaction-only",
      "atomic_replace": true,
      "fsync_required": true,
      "directory_fsync_required": true,
      "rejected_identity_persisted": true,
      "runtime_copy_path": "/run/ordax/bootstrap-tools/ordax-portable-state",
      "runtime_copy_survives_switch_root": true,
      "outer_filesystem_sync_owner": "portable-pid1-after-selection"
    },
    "activation_state_reader_installed": true,
    "portable_mount_helper": {
      "source": "bootstrap/initramfs/portable_mount.c",
      "runtime_path": "/sbin/ordax-portable-mount",
      "static": true,
      "operations": [
        "mount-state",
        "mount-capsule",
        "mount-base",
        "mount-system",
        "mount-surface-runtime",
        "mount-ai-runtime"
      ],
      "state_filesystem": "ext4",
      "release_filesystem": "erofs",
      "runtime_system_view": "read-only-bind",
      "regular_file_backing_only": true,
      "physical_device_path_input_allowed": false,
      "release_read_only": true,
      "selects_release": false,
      "verifies_signature": false,
      "writes_activation_state": false,
      "pid1_connected": true,
      "base_filesystem": "erofs",
      "base_runtime_view": "overlayfs",
      "base_overlay_state_root": "/ordax/base",
      "system_persistent_overlay": false,
      "base_read_only_lower": true,
      "capsule_filesystem": "erofs",
      "capsule_read_only": true,
      "capsule_payload_shape_checked": true,
      "capsule_hash_verification_performed_by_mount_helper": false,
      "capsule_hash_verification_owner": "busybox-sha256sum-against-initramfs-pin",
      "surface_runtime_filesystem": "erofs",
      "surface_runtime_read_only_lower": true,
      "surface_runtime_view": "overlayfs-ephemeral-run",
      "surface_runtime_persistent_upper": false,
      "surface_runtime_required_shape_checked": true,
      "local_ai_runtime_filesystem": "erofs",
      "local_ai_runtime_read_only": true,
      "local_ai_runtime_mount_root": "/run/ordax/runtime/local-ai",
      "local_ai_runtime_required_shape_checked": true,
      "local_ai_runtime_failure_policy": "degrade-intelligence-without-blocking-boot"
    },
    "handoff_helper_pid1_connected": true,
    "bootstrap_capsule_pin": {
      "builder_support": true,
      "optional_build_input": "--portable-bootstrap-capsule",
      "pin_runtime_path": "/etc/ordax/portable-bootstrap-capsule.sha256",
      "expected_capsule_path": "/ordax-esp/ordax/bootstrap/bootstrap.erofs",
      "hash_algorithm": "sha256",
      "capsule_erofs_magic_checked": true,
      "pid1_enforced": true,
      "default_candidate_build_pinned": false,
      "physical_boot_authorized": false,
      "sha256sum_applet": true,
      "pin_format": "sha256sum-check-file",
      "sha256sum_check_mode": true,
      "busybox_feature": "CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y",
      "verification_helper": {
        "source": "bootstrap/initramfs/portable_capsule_verify.sh",
        "runtime_path": "/sbin/ordax-portable-capsule-verify",
        "installed": true,
        "operation": "verify",
        "fixed_pin_path": "/etc/ordax/portable-bootstrap-capsule.sha256",
        "fixed_capsule_path": "/ordax-esp/ordax/bootstrap/bootstrap.erofs",
        "user_supplied_path_allowed": false,
        "uses_busybox_sha256sum_check_mode": true,
        "mounts_capsule": false,
        "network_access": false,
        "pid1_connected": true
      }
    },
    "activation_selection_helper_implemented": true,
    "activation_selection_pid1_connected": true,
    "stable_base_pin": {
      "builder_support": true,
      "optional_build_input": "--portable-stable-base",
      "pin_runtime_path": "/etc/ordax/portable-stable-base.sha256",
      "expected_base_path": "/ordax-data/.ordax/base/stable-base.erofs",
      "artifact_name": "stable-base.erofs",
      "hash_algorithm": "sha256",
      "erofs_magic_checked": true,
      "pid1_enforced": true,
      "default_candidate_build_pinned": false,
      "physical_boot_authorized": false,
      "verification_helper": {
        "source": "bootstrap/initramfs/portable_base_verify.sh",
        "runtime_path": "/sbin/ordax-portable-base-verify",
        "installed": true,
        "operation": "verify",
        "fixed_pin_path": "/etc/ordax/portable-stable-base.sha256",
        "fixed_base_path": "/ordax-data/.ordax/base/stable-base.erofs",
        "user_supplied_path_allowed": false,
        "uses_busybox_sha256sum_check_mode": true,
        "mounts_base": false,
        "network_access": false,
        "pid1_connected": true
      }
    },
    "candidate_pid1": {
      "source": "bootstrap/initramfs/portable_init.sh",
      "runtime_path": "/sbin/ordax-portable-init",
      "installed": true,
      "default_init": false,
      "legacy_init_unchanged": true,
      "invocation_for_disposable_proof": "rdinit=/sbin/ordax-portable-init",
      "physical_boot_entry_implemented": false,
      "network_required": false,
      "recovery_network_started": false,
      "requires_capsule_hash_verification": true,
      "requires_stable_base_hash_verification": true,
      "requires_bootstrap_owned_release_trust": true,
      "release_selection": [
        "candidate-one-shot",
        "current",
        "known-good"
      ],
      "candidate_slot_boot_authority": true,
      "selected_release_exact_signature_verification": true,
      "switch_root_target": "stable-base-overlay",
      "product_system_mount": "read-only-bind",
      "pid1_promotion_allowed": false,
      "physical_boot_authorized": false,
      "exact_signed_release_verification": true,
      "release_manifest_v3_supported": true,
      "surface_runtime_verified_handoff": true,
      "surface_runtime_overlay": "ephemeral-run",
      "candidate_slot_boot_authority_policy": "armed-one-shot-transaction-only",
      "candidate_failure_rolls_back_before_handoff": true,
      "activation_helper_retained_after_switch_root": true,
      "release_manifest_v4_supported": true,
      "local_ai_runtime_verified_handoff": true,
      "local_ai_runtime_failure_boot_critical": false,
      "activation_state_outer_sync_required": true,
      "activation_state_durable_marker": "ORDAX_PORTABLE_ACTIVATION_STATE_DURABLE=YES",
      "activation_state_durable_marker_after_sync": true
    },
    "mount_security_flags": true,
    "mount_security_flags_busybox_selector": "CONFIG_FEATURE_MOUNT_FLAGS=y",
    "posix_test_applet": true,
    "posix_bracket_applet": true,
    "test_64_bit_comparisons": true,
    "posix_test_busybox_selectors": [
      "CONFIG_TEST=y",
      "CONFIG_TEST1=y",
      "CONFIG_FEATURE_TEST_64=y"
    ],
    "busybox_runtime_copy_applets": [
      "cp",
      "chmod"
    ],
    "partition_discovery": {
      "owner": "bootstrap/initramfs/portable_init.sh",
      "mechanism": "bounded-sysfs-partition-scan-with-busybox-blkid",
      "partitions": [
        "ORDAX-ESP",
        "ORDAX-DATA"
      ],
      "attempts": 12,
      "interval_seconds": 1,
      "requires_same_parent_disk": true,
      "rejects_duplicate_labels": true,
      "missing_or_ambiguous_policy": "local-offline-recovery",
      "uses_network": false,
      "mutates_media_during_discovery": false,
      "scope": "stable-mvp-usb; does not constitute boot-volume cryptographic attestation"
    }
  }
}
