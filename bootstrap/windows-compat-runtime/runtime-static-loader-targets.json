{
  "$schema": "prototype-ordax.windows-compat-runtime-static-loader-targets/1",
  "status": "static-loader-target-classification-only-not-linux-reachability-proof",
  "runtime_id": "wine-11.0-wow64-x86_64-candidate",
  "input": {
    "dynamic_source_proof_schema": "prototype-ordax.windows-compat-runtime-dynamic-load-source-proof/1"
  },
  "classification": {
    "all_static_string_callsites_must_match_exactly_one_rule": true,
    "all_rules_must_be_observed": true,
    "line_numbers_are_not_authority": true,
    "linux_build_reachability_verified": false,
    "static_target_runtime_resolution_complete": false
  },
  "rules": [
    {
      "id": "android-libhardware",
      "path": "dlls/wineandroid.drv/init.c",
      "expression": "\"libhardware.so\"",
      "category": "android-host-library",
      "host_platform": "android",
      "expected_callsites": 1
    },
    {
      "id": "android-libandroid",
      "path": "dlls/wineandroid.drv/init.c",
      "expression": "\"libandroid.so\"",
      "category": "android-host-library",
      "host_platform": "android",
      "expected_callsites": 2
    },
    {
      "id": "android-liblog",
      "path": "dlls/wineandroid.drv/init.c",
      "expression": "\"liblog.so\"",
      "category": "android-host-library",
      "host_platform": "android",
      "expected_callsites": 1
    },
    {
      "id": "android-ntdll-bootstrap",
      "path": "dlls/wineandroid.drv/init.c",
      "expression": "\"ntdll.so\"",
      "category": "ntdll-bootstrap-path",
      "host_platform": "android",
      "expected_callsites": 1
    },
    {
      "id": "macos-opengl-framework",
      "path": "dlls/winemac.drv/opengl.c",
      "expression": "\"/System/Library/Frameworks/OpenGL.framework/OpenGL\"",
      "category": "macos-framework",
      "host_platform": "macos",
      "expected_callsites": 1
    }
  ],
  "open_boundaries": {
    "linux_build_reachability_verified": false,
    "static_target_runtime_resolution_complete": false,
    "dynamic_load_inventory_complete": false,
    "external_transitive_closure_verified": false,
    "runtime_dependency_inventory_complete": false
  },
  "promotion": {
    "dynamic_load_inventory_complete": false,
    "external_transitive_closure_verified": false,
    "runtime_dependency_inventory_complete": false,
    "runtime_package_content_hashes_pinned": false,
    "binary_artifact_pinned": false,
    "activation_authorized": false,
    "execution_authorized": false,
    "wine_executed": false,
    "windows_payload_executed": false
  }
}
