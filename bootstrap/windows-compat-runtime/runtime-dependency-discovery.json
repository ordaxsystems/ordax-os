{
  "$schema": "prototype-ordax.windows-compat-runtime-dependency-discovery/1",
  "status": "discovery-only-not-promotable",
  "runtime_id": "wine-11.0-wow64-x86_64-candidate",
  "input": {
    "requires_full_build_proof": true,
    "requires_staged_install": true,
    "requires_locked_rootfs": true,
    "full_build_proof_schema": "prototype-ordax.windows-compat-full-build-proof/2"
  },
  "inspection": {
    "format": "elf-dt-needed",
    "supported_elf_classes": [32, 64],
    "supported_endianness": ["little", "big"],
    "stage_manifest_binding_required": true,
    "elf_identity_match_required": true,
    "rooted_symlink_resolution_required": true,
    "host_readelf_allowed": false,
    "network_allowed": false,
    "stage_mutation_allowed": false,
    "rootfs_mutation_allowed": false,
    "unresolved_dependency_allowed": false,
    "ambiguous_external_owner_allowed": false
  },
  "classification": {
    "stage_internal": "dependency resolves inside staged Wine tree with matching ELF class/machine/endianness",
    "rootfs_external": "dependency resolves only in the locked Alpine rootfs with matching ELF class/machine/endianness",
    "build_only_is_not_runtime_by_default": true,
    "external_package_owner_required": true,
    "external_package_version_required": true
  },
  "promotion": {
    "runtime_dependency_inventory_complete": false,
    "runtime_package_content_hashes_pinned": false,
    "binary_artifact_pinned": false,
    "activation_authorized": false,
    "execution_authorized": false,
    "wine_executed": false,
    "windows_payload_executed": false
  }
}
