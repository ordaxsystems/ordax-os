{
  "$schema": "prototype-ordax.windows-compat-runtime-computed-loader-targets/1",
  "status": "runtime-computed-target-classification-only-not-resolved",
  "runtime_id": "wine-11.0-wow64-x86_64-candidate",
  "input": {
    "dynamic_source_proof_schema": "prototype-ordax.windows-compat-runtime-dynamic-load-source-proof/1"
  },
  "classification": {
    "all_dynamic_expression_callsites_must_match_exactly_one_rule": true,
    "all_rules_must_be_observed": true,
    "line_numbers_are_not_authority": true,
    "runtime_computed_target_resolution_complete": false
  },
  "rules": [
    {
      "id": "ctapi-caller-library",
      "path": "dlls/ctapi32/unixlib.c",
      "expression": "libname",
      "category": "caller-provided-library",
      "control_source": "ctapi-attach-caller-argument",
      "expected_callsites": 1
    },
    {
      "id": "ntdll-so-name",
      "path": "dlls/ntdll/unix/loader.c",
      "expression": "so_name",
      "category": "ntdll-internal-module-path",
      "control_source": "ntdll-internal-dlopen-dll-callers",
      "expected_callsites": 1
    },
    {
      "id": "ntdll-builtin-unix-path",
      "path": "dlls/ntdll/unix/virtual.c",
      "expression": "builtin->unix_path",
      "category": "ntdll-internal-module-path",
      "control_source": "ntdll-builtin-module-mapping",
      "expected_callsites": 1
    },
    {
      "id": "odbc-driver-manager",
      "path": "dlls/odbc32/unixlib.c",
      "expression": "s",
      "category": "environment-override-or-configured-fallback",
      "control_source": "LIB_ODBC_DRIVER_MANAGER-or-SONAME_LIBODBC",
      "expected_callsites": 1
    },
    {
      "id": "xslt-extension-plugin",
      "path": "libs/xslt/libxslt/extensions.c",
      "expression": "module_filename",
      "category": "plugin-module-path",
      "control_source": "libxslt-extension-path-construction",
      "expected_callsites": 1
    },
    {
      "id": "loader-self-ntdll",
      "path": "loader/main.c",
      "expression": "path",
      "category": "ntdll-bootstrap-path",
      "control_source": "loader-self-path-layout",
      "expected_callsites": 1
    },
    {
      "id": "wine-build-tree-ntdll",
      "path": "tools/wine/wine.c",
      "expression": "strmake( \"%s/../../dlls/ntdll/ntdll.so\", bindir )",
      "category": "ntdll-bootstrap-path",
      "control_source": "wine-build-tree-layout",
      "expected_callsites": 1
    },
    {
      "id": "wine-installed-libdir-ntdll",
      "path": "tools/wine/wine.c",
      "expression": "strmake( \"%s/wine%s/ntdll.so\", libdir, arch_dir )",
      "category": "ntdll-bootstrap-path",
      "control_source": "wine-installed-libdir-layout",
      "expected_callsites": 1
    },
    {
      "id": "wine-winedllpath-arch-ntdll",
      "path": "tools/wine/wine.c",
      "expression": "strmake( \"%s%s/ntdll.so\", dir, arch_dir )",
      "category": "ntdll-bootstrap-path",
      "control_source": "WINEDLLPATH-with-arch-suffix",
      "expected_callsites": 1
    },
    {
      "id": "wine-winedllpath-flat-ntdll",
      "path": "tools/wine/wine.c",
      "expression": "strmake( \"%s/ntdll.so\", dir )",
      "category": "ntdll-bootstrap-path",
      "control_source": "WINEDLLPATH-flat",
      "expected_callsites": 1
    }
  ],
  "open_boundaries": {
    "caller_provided_library_policy_complete": false,
    "environment_override_resolution_complete": false,
    "plugin_module_resolution_complete": false,
    "ntdll_internal_path_resolution_complete": false,
    "ntdll_bootstrap_path_resolution_complete": false,
    "runtime_computed_target_resolution_complete": false,
    "wrapper_call_graph_complete": false,
    "generated_source_inventory_complete": false,
    "dynamic_load_inventory_complete": false
  },
  "promotion": {
    "dynamic_load_inventory_complete": false,
    "external_transitive_closure_verified": false,
    "runtime_dependency_inventory_complete": false,
    "runtime_package_content_hashes_pinned": false,
    "binary_artifact_pinned": false,
    "activation_authorized": false,
    "execution_authorized": false,
    "wine_executed": false,
    "windows_payload_executed": false
  }
}
