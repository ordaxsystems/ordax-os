#!/bin/sh
# Bounded handoff to compositor; never wait for a missing/stale splash.
set -eu
CONTROL_ROOT=${ORDAX_BOOT_CONTROL_ROOT:-/run/ordax-boot-splash}
FIFO=$CONTROL_ROOT/stop
[ -p "$FIFO" ] && [ ! -L "$FIFO" ] || exit 0
if /bin/busybox timeout -k 1 1 /bin/sh -c 'printf stop >"$1"' sh "$FIFO" 2>/dev/null; then
  # Wait for the renderer/audio parent to release the FIFO before Cage takes DRM.
  attempt=0
  while [ -p "$FIFO" ] && [ "$attempt" -lt 20 ]; do
    /bin/busybox sleep 0.05
    attempt=$((attempt + 1))
  done
fi
exit 0
