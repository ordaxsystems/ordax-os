{
  "$schema": "prototype-ordax.public-site-deployment/1",
  "status": "host-neutral-same-origin-adapter-source-ready-not-deployed",
  "site_artifact": "public-site",
  "adapter": {
    "kind": "nginx-loopback-behind-https-terminator",
    "source": "deploy/public-site/nginx.conf",
    "public_listener_in_adapter_allowed": false,
    "provider_specific_browser_api": false,
    "account_request_marker_header": "X-OrdaX-Public-Site",
    "account_request_marker_value": "1",
    "real_ip_source": "trusted-loopback-tls-terminator-x-forwarded-for",
    "real_ip_trusted_sources": [
      "127.0.0.1",
      "::1"
    ],
    "public_auth_rate_limit_source_ready": true,
    "public_auth_rate_limit_deployed": false
  },
  "routing": {
    "static_routes": [
      "/",
      "/download/",
      "/login/",
      "/cadastro/",
      "/recuperar/",
      "/recuperar/nova-senha/",
      "/conta/",
      "/releases/catalog.json",
      "/licencas/",
      "/privacidade/",
      "/termos/"
    ],
    "identity_prefix": "/auth/",
    "sync_prefix": "/sync/",
    "account_prefix": "/account/",
    "identity_gateway_entrypoint": "services/public-identity/gateway.py:application",
    "deployed_account_gateway": "ordax-control-plane:ordax-account-gateway",
    "same_origin_identity_required": true,
    "same_origin_sync_required": true,
    "same_origin_account_required": true,
    "unknown_static_route_behavior": 404,
    "gateway_public_activation_gate_required": true,
    "gateway_public_activation_currently_enabled": false,
    "recovery_request_path": "/auth/recover",
    "recovery_verify_path": "/auth/recover/verify",
    "recovery_complete_path": "/auth/recover/complete",
    "account_export_path": "/account/export",
    "account_close_path": "/account/close",
    "account_spaces_path": "/account/spaces"
  },
  "security_headers": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
  },
  "cache_policy": {
    "html": "no-cache",
    "config": "no-store",
    "release_catalog": "no-store",
    "assets": "public, max-age=300",
    "identity": "no-store",
    "sync": "no-store",
    "account": "no-store"
  },
  "production_requirements": {
    "https": true,
    "host_adapter_must_apply_security_headers": true,
    "host_adapter_must_preserve_auth_status_codes": true,
    "host_adapter_must_preserve_session_set_cookie": true,
    "host_adapter_must_not_expose_provider_cors_as_product_contract": true,
    "public_identity_provider_must_be_configured_before_enabling_login_links": true,
    "final_legal_documents_required_before_identity_activation": true,
    "leaked_password_protection_required_before_identity_activation": true,
    "host_adapter_must_mark_public_account_requests": true,
    "gateway_server_side_public_activation_gate_required": true,
    "recovery_completion_must_remain_server_owned": true,
    "recovery_tokens_must_not_enter_browser_javascript": true,
    "tls_terminator_must_append_real_client_ip": true,
    "adapter_must_trust_only_loopback_real_ip_source": true,
    "public_auth_rate_limits_required": true,
    "sensitive_account_mutation_rate_limit_required": true
  },
  "security_rate_limits": {
    "status_code": 429,
    "login_and_register": {
      "rate": "10r/m",
      "burst": 5,
      "key": "restored-real-client-ip"
    },
    "recovery_request": {
      "rate": "3r/m",
      "burst": 2,
      "key": "restored-real-client-ip"
    },
    "recovery_completion": {
      "rate": "10r/m",
      "burst": 5,
      "key": "restored-real-client-ip"
    },
    "account_close": {
      "rate": "5r/m",
      "burst": 2,
      "key": "restored-real-client-ip"
    }
  }
}
