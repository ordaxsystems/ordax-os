{
  "$schema": "prototype-ordax.public-site-deployment/1",
  "status": "host-neutral-and-vercel-same-origin-adapters-source-ready-not-deployed",
  "site_artifact": "public-site",
  "adapter": {
    "kind": "nginx-loopback-behind-https-terminator",
    "source": "deploy/public-site/nginx.conf",
    "public_listener_in_adapter_allowed": false,
    "provider_specific_browser_api": false,
    "account_request_marker_header": "X-OrdaX-Public-Site",
    "account_request_marker_value": "1",
    "real_ip_source": "trusted-loopback-tls-terminator-x-forwarded-for",
    "real_ip_trusted_sources": [
      "127.0.0.1",
      "::1"
    ],
    "public_auth_rate_limit_source_ready": true,
    "public_auth_rate_limit_deployed": false
  },
  "vercel_adapter": {
    "status": "source-ready-not-deployed",
    "project_config_source": "vercel.json",
    "function_source": "api/account-proxy.mjs",
    "static_output_directory": "sites/public",
    "identity_prefix": "/auth/",
    "sync_prefix": "/sync/",
    "provider_specific_browser_api": false,
    "account_request_marker_header": "X-OrdaX-Public-Site",
    "account_request_marker_value": "1",
    "trusted_real_ip_header": "x-forwarded-for",
    "trusted_real_ip_property": "vercel-edge-overwrites-client-supplied-value",
    "trusted_client_address_header": "x-ordax-client-address",
    "proxy_auth_secret_environment_variable": "ORDAX_PUBLIC_PROXY_SECRET",
    "proxy_auth_secret_browser_visible": false,
    "proxy_auth_secret_source_controlled": false,
    "authorization_header_forwarded": false,
    "maximum_request_body_bytes": 65536,
    "gateway_url_environment_variable": "ORDAX_ACCOUNT_GATEWAY_URL",
    "gateway_url_must_be_https": true,
    "gateway_url_path_suffix": "/functions/v1/ordax-public-account-gateway",
    "direct_inner_gateway_target_allowed": false,
    "upstream_timeout_milliseconds": 15000,
    "set_cookie_preserved": true,
    "provider_cors_forwarded": false,
    "public_auth_rate_limit_deployed": false
  },
  "public_edge_gateway": {
    "status": "source-ready-not-deployed",
    "function_name": "ordax-public-account-gateway",
    "function_source": "infra/supabase/functions/ordax-public-account-gateway/index.ts",
    "provenance_source": "infra/supabase/functions/ordax-public-account-gateway/public_auth_rate_limit.mjs",
    "inner_gateway": "ordax-account-gateway",
    "allowed_methods": [
      "GET",
      "POST"
    ],
    "allowed_prefixes": [
      "/auth/",
      "/sync/"
    ],
    "proxy_authentication_required": true,
    "proxy_secret_compared_as_sha256": true,
    "raw_proxy_secret_in_source": false,
    "trusted_client_address_requires_authenticated_proxy": true,
    "sensitive_proxy_headers_forwarded_to_inner_gateway": false,
    "browser_authorization_forwarded": false,
    "rate_limit_rpc": "ordax_consume_public_auth_rate_limit_v1",
    "rate_limit_rpc_service_role_only": true,
    "database_rate_limit_authority_deployed": true,
    "rate_limit_fail_closed": true,
    "maximum_request_body_bytes": 65536,
    "maximum_upstream_response_bytes": 2097152,
    "native_direct_path_covered_by_this_boundary": false
  },
  "routing": {
    "static_routes": [
      "/",
      "/download/",
      "/login/",
      "/cadastro/",
      "/recuperar/",
      "/recuperar/nova-senha/",
      "/conta/",
      "/releases/catalog.json",
      "/licencas/",
      "/privacidade/",
      "/termos/"
    ],
    "identity_prefix": "/auth/",
    "sync_prefix": "/sync/",
    "identity_gateway_entrypoint": "services/public-identity/gateway.py:application",
    "deployed_account_gateway": "ordax-control-plane:ordax-account-gateway",
    "public_edge_gateway_required_for_vercel": true,
    "public_edge_gateway_deployed": false,
    "same_origin_identity_required": true,
    "same_origin_sync_required": true,
    "unknown_static_route_behavior": 404,
    "gateway_public_activation_gate_required": true,
    "gateway_public_activation_currently_enabled": false,
    "recovery_request_path": "/auth/recover",
    "recovery_verify_path": "/auth/recover/verify",
    "recovery_complete_path": "/auth/recover/complete"
  },
  "security_headers": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
  },
  "cache_policy": {
    "html": "no-cache",
    "config": "no-store",
    "release_catalog": "no-store",
    "assets": "public, max-age=300",
    "identity": "no-store",
    "sync": "no-store"
  },
  "production_requirements": {
    "https": true,
    "host_adapter_must_apply_security_headers": true,
    "host_adapter_must_preserve_auth_status_codes": true,
    "host_adapter_must_preserve_session_set_cookie": true,
    "host_adapter_must_not_expose_provider_cors_as_product_contract": true,
    "public_identity_provider_must_be_configured_before_enabling_login_links": true,
    "final_legal_documents_required_before_identity_activation": true,
    "leaked_password_protection_required_before_identity_activation": true,
    "host_adapter_must_mark_public_account_requests": true,
    "gateway_server_side_public_activation_gate_required": true,
    "recovery_completion_must_remain_server_owned": true,
    "recovery_tokens_must_not_enter_browser_javascript": true,
    "tls_terminator_must_append_real_client_ip": true,
    "adapter_must_use_platform_trusted_real_ip_source": true,
    "public_proxy_must_be_authenticated_before_trusting_forwarded_client_ip": true,
    "public_auth_rate_limits_required": true,
    "native_auth_rate_limit_required_before_public_account_activation": true
  },
  "security_rate_limits": {
    "status_code": 429,
    "authoritative_backend": {
      "rpc": "ordax_consume_public_auth_rate_limit_v1",
      "window": "1 minute",
      "key_material_persisted": "sha256-of-canonical-client-ip-only",
      "raw_client_ip_persisted": false,
      "direct_table_access_allowed": false,
      "deployed": true
    },
    "login_and_register": {
      "rate": "10r/m",
      "burst": 5,
      "key": "restored-real-client-ip"
    },
    "recovery_request": {
      "rate": "3r/m",
      "burst": 2,
      "key": "restored-real-client-ip"
    },
    "recovery_completion": {
      "rate": "10r/m",
      "burst": 5,
      "key": "restored-real-client-ip"
    }
  }
}
