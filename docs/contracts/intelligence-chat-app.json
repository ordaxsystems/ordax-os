{
  "$schema": "prototype-ordax.intelligence-chat-app/1",
  "status": "native-integrated-beta",
  "product_name": "OrdaX Intelligence",
  "app_id": "intelligence",
  "version": "0.1.0",
  "owner": "system/apps/intelligence",
  "purpose": "first-party conversational and consultative planning client for ordax.intelligence/1",
  "integration": {
    "catalog_registered": true,
    "native_composition_mounted": true,
    "web_composition_mounted": false,
    "requires_capability": "intelligence.system"
  },
  "context": {
    "registry_schema": "ordax.intelligence-context-registry/1",
    "capsule_schema": "ordax.intelligence-context-capsule/1",
    "handoff_schema": "ordax.intelligence-handoff/1",
    "handoff_transport": "typed-app-activation-target",
    "automatic_sources": [
      "first-party-app-catalog"
    ],
    "persistent_memory_automatic": false,
    "private_app_state_automatic": false,
    "user_prompt_can_grant_context": false,
    "explicit_sources_require_caller_authorization": true,
    "handoff_carries_private_content": false,
    "handoff_can_activate_explicit_context": false
  },
  "capabilities": {
    "local_conversation": true,
    "consultative_planning": true,
    "typed_app_target_handoff": true,
    "planning_is_executable": false,
    "planning_can_grant_capabilities": false,
    "web_grounding": false,
    "external_provider_runtime": false,
    "voice": false,
    "tool_execution": false,
    "file_mutation": false,
    "system_mutation": false
  },
  "privacy": {
    "default_provider": "local",
    "implicit_cloud_fallback": false,
    "implicit_network_egress": false,
    "prompt_telemetry": false
  },
  "history": "session-only",
  "authority": "none",
  "next_gate": "add separately-authorized selected document, file, project and workspace context sources behind the typed handoff before Web grounding or action capabilities"
}
