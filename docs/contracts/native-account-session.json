{
  "$schema": "prototype-ordax.native-account-session/1",
  "status": "memory-only-until-encrypted-vault",
  "owner": "system/surface/runtime/native_account_gateway.py",
  "scope": "native-usb-account-session",
  "invariants": {
    "provider_tokens_exposed_to_surface_javascript": false,
    "provider_tokens_synchronized": false,
    "access_token_persisted_plaintext": false,
    "refresh_token_persisted_plaintext": false,
    "session_survives_native_host_restart": false,
    "session_survives_device_reboot": false,
    "legacy_plaintext_session_path_is_loaded": false,
    "legacy_plaintext_session_path_is_purged_on_start": true,
    "offline_local_os_use_requires_cloud_session": false,
    "explicit_logout_always_discards_native_in_memory_access_refresh": true,
    "offline_local_detach_must_not_claim_remote_token_revocation": true,
    "locally_detached_session_may_report_anonymous_without_network": true,
    "guest_oobe_must_require_local_detachment_proof": true
  },
  "legacy_cleanup": {
    "path": "/var/lib/ordax/account/session.json",
    "purpose": "cleanup-only-not-session-authority",
    "filesystem_links_followed": false,
    "purge_failure": "fail-closed"
  },
  "future_persistent_session_gate": {
    "enabled": false,
    "requires": [
      "encrypted-credential-vault",
      "device-local-unlock-binding",
      "authenticated-encryption",
      "anti-rollback-or-revocation-policy",
      "no-secret-surface-js-boundary",
      "physical-removable-media-threat-proof"
    ],
    "pin_role": "unlock-local-vault-never-cloud-account-password-substitute"
  },
  "non_goals": [
    "disk-encryption",
    "cloud-password-storage",
    "silent-offline-cloud-authentication"
  ]
}
