{
  "$schema": "prototype-ordax.intelligence/1",
  "status": "mvp-system-consultative-integration",
  "product_name": "Ordax Intelligence",
  "layer": "system-intelligence",
  "stable_port": "ordax.intelligence/1",
  "owner": "system/services/intelligence",
  "mvp": {
    "included_in_stable_mvp": true,
    "required_for_boot": false,
    "required_for_surface_start": false,
    "local_inference_backend_required_in_distribution": true,
    "failure_mode": "degrade-intelligence-without-blocking-os"
  },
  "architecture": {
    "surface_and_apps_are_clients": true,
    "assistant_ui_is_not_intelligence_owner": true,
    "runtime_policy_owner": "Ordax Intelligence",
    "inference_backend_contract": "ordax.local-ai/1",
    "inference_backend_owner": "system/services/local-ai",
    "memory_contract": "ordax.memory/1",
    "memory_context_authority_contract": "ordax.memory-context-auth/1",
    "authorized_memory_bridge": "ordax.intelligence-authorized-memory/1",
    "model_and_engine_replaceable": true,
    "cloud_provider_required": false,
    "production_native_composition": true,
    "first_party_consultative_consumers": [
      "system"
    ],
    "direct_provider_access_from_consumers": false,
    "stable_v4_backend_lifecycle": "source-handoff-implemented-signed-stable-materialization-pending"
  },
  "authority": {
    "mvp_authority": "none",
    "implicit_tool_execution": false,
    "implicit_file_write": false,
    "implicit_shell_execution": false,
    "implicit_network_egress": false,
    "implicit_package_install": false,
    "implicit_system_mutation": false,
    "implicit_raw_disk_access": false
  },
  "context": {
    "provenance_required": true,
    "bounded_context_required": true,
    "prompt_content_is_not_authority": true,
    "cross_scope_access_requires_explicit_future_policy": true,
    "ordinary_request_injects_memory": true,
    "memory_context_requires_composition_authorization": true,
    "memory_context_authorization_is_per_owner": true,
    "consumer_selected_context_has_priority_over_memory": true,
    "memory_query_is_local_and_bounded": true,
    "authenticated_account_memory_requires_real_identity": true,
    "ordinary_request_memory_injection_requires_composition_authorization": true,
    "ordinary_request_memory_injection_native_scopes": [
      "device",
      "account",
      "space"
    ],
    "project_or_session_memory_inferred": false,
    "restricted_memory_injected": false
  },
  "initial_capabilities": [
    "ask",
    "explain",
    "summarize",
    "diagnose"
  ],
  "deferred_capabilities": [
    "agent-manager",
    "shared-memory",
    "knowledge-manager",
    "tool-manager",
    "task-scheduler",
    "capability-bridge",
    "multi-agent-coordination"
  ],
  "migration": {
    "legacy_repository": "washingtonmsdj/novo-ordax-os",
    "reuse_mode": "architecture-invariants-reimplemented-clean-room",
    "source_ledger": "docs/SOURCE-MIGRATION.md",
    "bulk_legacy_import": false
  },
  "mvp_policy": {
    "first_party_consumer_source_proof": true,
    "system_explanation_is_read_only": true,
    "backend_absence_must_not_block_surface": true,
    "stable_v4_backend_lifecycle_required_pre_usb": true,
    "stable_v4_boot_handoff_source_complete": true,
    "signed_stable_v4_materialization_pending": true,
    "authorized_memory_bridge_source_complete": true,
    "automatic_memory_injection_enabled": true,
    "automatic_memory_injection_authority": "trusted-native-composition-only",
    "external_app_consumers_use_public_port": true
  },
  "memory_capture": {
    "schema": "ordax.memory-capture-result/1",
    "automatic_persistence": true,
    "per_item_confirmation_required": false,
    "composition_policy_required": true,
    "capture_can_be_disabled": true,
    "model_selects_owner_or_scope": false,
    "user_review_edit_delete_required": true,
    "preference_id": "memory.auto-capture",
    "preference_default": "on",
    "preference_device_local_in_mvp": true,
    "preference_account_sync": false,
    "exact_duplicate_coalescing": true,
    "exact_duplicate_mints_new_id": false,
    "semantic_supersession_enabled": false
  },
  "local_streaming": {
    "port": "ordax.intelligence/1",
    "option": "respond(request, { signal, onDelta })",
    "mode": "opt-in-provisional-local-only",
    "on_delta_type": "string",
    "final_response_contract": "ordax.intelligence-response/1",
    "callback_error_aborts_inference": true,
    "owner_space_profile_checks_each_delta": true,
    "default_without_callback": "buffered-unchanged",
    "assistant_ui_streaming_enabled": false,
    "external_providers_enabled": false,
    "engine_hardware_proof": false
  }
}
