{
  "$schema": "prototype-ordax.profile-activation-state/1",
  "runtime_schema": "ordax.profile-activation-state/1",
  "port_schema": "ordax.profile-activation-state-port/1",
  "status": "mvp-source-internal-proof",
  "ownership": {
    "owner": "profile-runtime",
    "persistence": "device",
    "native_path": "/var/lib/ordax/profile-activation-state.json",
    "surface_access": "read-only",
    "cloud_space_mutation_applied": false,
    "profile_owns_space_data": false
  },
  "state": {
    "per_space": true,
    "max_spaces": 64,
    "slots": [
      "current",
      "previous"
    ],
    "activation_reference_fields": [
      "profile",
      "components",
      "activatedAt"
    ],
    "profile_identity_fields": [
      "slug",
      "version"
    ],
    "component_identity_fields": [
      "id",
      "kind",
      "version",
      "sha256",
      "receiptSha256",
      "installedAt"
    ],
    "component_order_canonical": true,
    "same_current_previous_allowed": false,
    "space_identity_fields": [
      "spaceId",
      "spaceKind"
    ],
    "space_kind_values": [
      "personal",
      "work",
      "professional"
    ],
    "space_kind_persisted_for_offline_restore": true
  },
  "safety": {
    "activation_requires_exact_installed_component_receipts": true,
    "rollback_revalidates_previous_components_against_inventory": true,
    "missing_previous_component_fails_closed": true,
    "state_write_atomic": true,
    "state_file_mode": "0600",
    "state_directory_mode": "0700",
    "exclusive_mutation_lock": true,
    "http_mutation_exposed": true,
    "boot_critical": false,
    "space_kind_change_without_explicit_reconciliation_allowed": false,
    "http_mutation_scope": "token-bound-explicit-profile-command-only"
  },
  "data_separation": {
    "documents_allowed": false,
    "memory_content_allowed": false,
    "prompts_allowed": false,
    "credentials_allowed": false,
    "professional_payload_allowed": false,
    "rollback_rewinds_space_data": false,
    "profile_removal_deletes_space_data": false
  },
  "mvp": {
    "native_persistence_source": true,
    "surface_read_source": true,
    "public_activation_enabled": false,
    "profile_stack_enabled": false,
    "space_cloud_write_enabled": false,
    "offline_restore_compatibility_metadata": true,
    "native_restore_metadata_resolution": true,
    "native_restore_capability_application": false,
    "native_restore_drift_result": "disabled-safe",
    "trusted_user_intent_command_boundary": true
  },
  "next_gates": [
    "single-source-profile-component-composition",
    "published-trusted-profile-content-for-real-component-activation",
    "profile-health-after-activation",
    "physical-native-gtk-consent-proof",
    "public-profile-trust-and-permission-review-before-public-activation",
    "trusted-capability-application-from-resolved-profile-state"
  ],
  "command_boundary": {
    "schema": "ordax.profile-activation-command/1",
    "endpoint": "/__ordax/native/profile-activation-command",
    "token_header": "X-OrdaX-Profile-Activation-Token",
    "loopback_only": true,
    "same_origin_trust_required": true,
    "distribution_scope": [
      "owner-development"
    ],
    "stable_mvp_enabled": false,
    "expected_revision_required": true,
    "revision_check_atomic_with_file_lock": true,
    "canonical_bundled_manifest_revalidation": true,
    "arbitrary_profile_manifest_accepted": false,
    "component_bearing_activation_enabled": false,
    "public_activation_enabled": false,
    "preview_action": "preview-activate",
    "permission_diff_schema": "ordax.profile-permission-diff/1",
    "permission_review_schema": "ordax.profile-permission-review/1",
    "permission_review_digest": "sha256",
    "permission_review_bound_fields": [
      "expectedRevision",
      "spaceId",
      "spaceKind",
      "profile",
      "components",
      "permissionDiff"
    ],
    "permission_review_digest_is_human_intent_proof": false,
    "component_activation_requires_trusted_human_confirmation_surface": true,
    "component_activation_enabled": false,
    "internal_component_activation_path_implemented": true,
    "human_confirmation_presenter": "native-gtk",
    "human_confirmation_transport": "private-unix-socket",
    "human_confirmation_socket": "/run/ordax-surface/profile-consent.sock",
    "human_confirmation_socket_mode": "0600",
    "human_confirmation_owner_distribution_only": true,
    "human_consent_receipt_schema": "ordax.profile-human-consent/1",
    "human_consent_receipt_surface_visible": false,
    "human_consent_receipt_surface_writable": false,
    "human_consent_receipt_native_only": true,
    "human_consent_receipt_one_shot": true,
    "human_consent_receipt_ttl_bounded": true,
    "human_consent_presenter_unavailable_result": "503-safe-unavailable"
  }
}
