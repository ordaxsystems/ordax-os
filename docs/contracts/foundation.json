{
  "$schema": "prototype-ordax.foundation/7",
  "status": "prototype-not-promoted",
  "source_authority": {
    "kind": "git",
    "branch": "main",
    "physical_media_is_source_authority": false,
    "notebook_is_source_authority": false
  },
  "storage_architecture": {
    "contract": "docs/contracts/storage-architecture.json",
    "documentation": "docs/STORAGE-ARCHITECTURE.md",
    "single_physical_layout_for_all_media": false,
    "native_disk_profile": "native-disk",
    "portable_usb_profile": "portable-usb",
    "rigid_system_home_app_partition_sizing_required": false,
    "user_data_preserved_by_default_during_system_repair": true,
    "transactional_update_and_rollback_required": true
  },
  "physical_media": {
    "scope": "transitional-bootstrap-seed-proof-only",
    "final_product_storage_layout": false,
    "contract": "docs/contracts/physical-media.json",
    "partition_count": 2,
    "partitions": [
      {
        "index": 1,
        "name": "ORDAX-ESP",
        "role": "uefi-boot",
        "filesystem": "fat32"
      },
      {
        "index": 2,
        "name": "ORDAX",
        "role": "main",
        "filesystem": "linux"
      }
    ],
    "forbidden_required_partitions": [
      "ORDAX-HOME",
      "ORDAX-PLATFORM"
    ],
    "separate_home_partition": false
  },
  "initial_media": {
    "policy": "minimum-release-acquisition-first",
    "full_system_preseeded": false,
    "surface_preseeded": false,
    "normal_apps_preseeded": false,
    "remote_core_preseeded": false,
    "control_plane_preseeded": false,
    "stable_device_identity_preseeded": false,
    "full_git_client_preseeded": false,
    "legacy_repository_dump_allowed": false,
    "build_toolchain_preseeded": false,
    "complete_source_checkout_preseeded": false,
    "first_full_release_acquired_after_boot": true,
    "bootstrap_manifest_required_before_physical_write": true,
    "known_good_release_persisted_after_first_activation": true,
    "known_good_offline_boot_required": true,
    "normal_system_changes_require_usb_reflash": false,
    "allowed_initial_payload_classes": [
      "uefi-boot",
      "kernel",
      "initramfs",
      "minimal-network",
      "https-release-acquisition",
      "public-release-trust",
      "recovery-maintenance",
      "empty-runtime-roots"
    ]
  },
  "logical_main_layout": {
    "root": "/ordax",
    "bootstrap": "/ordax/bootstrap",
    "releases": "/ordax/releases",
    "current": "/ordax/current",
    "state": "/ordax/state",
    "home": "/ordax/home"
  },
  "release_model": {
    "addressing": "source-commit",
    "path_template": "/ordax/releases/<commit>",
    "immutable_after_verification": true,
    "activation": "atomic-current-pointer",
    "rollback_required": true,
    "normal_update_source": "git-driven-published-release",
    "device_full_git_client_required": false,
    "device_source_checkout_required": false,
    "device_compiler_required": false,
    "remote_shell_required": false
  },
  "pre_release_capabilities": [
    "uefi-boot",
    "kernel",
    "initramfs",
    "minimal-network",
    "release-acquisition",
    "recovery-maintenance"
  ],
  "post_release_optional_capabilities": [
    "stable-device-identity",
    "ordax-remote-core",
    "control-plane"
  ],
  "product_modes": {
    "single_product": true,
    "modes": [
      "web",
      "mobile",
      "desktop",
      "usb",
      "native-disk"
    ],
    "same_account_model": true,
    "same_surface_source": true,
    "same_application_source": true,
    "web_is_first_class_mode": true,
    "mobile_is_first_class_mode": true,
    "desktop_is_first_class_mode": true,
    "capability_progression": [
      "web",
      "mobile",
      "desktop",
      "usb",
      "native-disk"
    ]
  },
  "mobile": {
    "platforms": [
      "android",
      "ios"
    ],
    "normal_user_install": true,
    "is_ordax_operating_system": false,
    "shared_surface_required": true,
    "platform_differences_via_adapter_only": true,
    "secure_device_storage_required": true,
    "offline_capability_allowed": true,
    "native_notifications_allowed": true,
    "camera_and_media_capabilities_allowed": true,
    "biometric_gate_allowed": true,
    "raw_disk_access_allowed": false,
    "usb_creator_capability": false,
    "arbitrary_privileged_command_api_allowed": false,
    "store_or_signed_platform_updates_required": true
  },
  "desktop": {
    "first_host": "windows",
    "normal_user_install": true,
    "is_ordax_operating_system": false,
    "shared_surface_required": true,
    "signed_updates_required": true,
    "usb_creator_capability": true,
    "raw_host_disk_access_by_default": false,
    "privileged_helper_only_when_required": true,
    "arbitrary_privileged_command_api_allowed": false,
    "desktop_update_and_os_release_channels_separate": true
  },
  "account_sync": {
    "single_identity_across_all_modes": true,
    "core_cross_device_sync_available_to_all_accounts": false,
    "account_access_may_be_blocked_by_plan": false,
    "plan_entitlements_may_expand_sync": false,
    "offline_first_clients_allowed": true,
    "encrypted_transport_required": true,
    "server_side_authorization_required": true,
    "conflict_resolution_required": true,
    "device_local_secrets_never_sync": true,
    "syncable_categories": [
      "appearance",
      "preferences",
      "workspace-metadata",
      "app-state-metadata",
      "user-selected-cloud-content"
    ],
    "never_sync_categories": [
      "device-private-keys",
      "machine-identity-secrets",
      "hardware-drivers",
      "raw-disk-state",
      "ephemeral-cache"
    ],
    "cross_device_sync_implemented_in_mvp": false,
    "cross_device_sync_architecture_prepared": true,
    "future_entitlements_may_expand_service_capacity": true
  },
  "plans": {
    "billing_implemented": false,
    "pricing_defined": false,
    "commercial_tiers_defined": false,
    "commercial_device_limit_defined": false,
    "second_device_fee_policy_defined": false,
    "identity_is_plan_gated": false,
    "entitlement_architecture_prepared": true,
    "future_entitlements_are_server_authoritative": true,
    "future_value_categories": [
      "synchronization",
      "cloud-storage",
      "backup-restore",
      "cross-device-continuity",
      "collaboration",
      "premium-compute",
      "recovery-support",
      "additional-space-capacity",
      "shared-spaces",
      "cloud-memory",
      "external-ai-compute",
      "connectors",
      "automations"
    ],
    "provisional_private_space_limit": 2,
    "profile_pack_categories_are_plan_locked": false
  },
  "surface": {
    "single_source_tree_required": true,
    "device_and_web_ui_forks_allowed": false,
    "shared_components_required": true,
    "shared_design_tokens_required": true,
    "shared_application_source_required": true,
    "platform_differences_via_adapters_only": true,
    "targets": [
      "ordax-device",
      "desktop-host",
      "android-host",
      "ios-host",
      "local-web",
      "hosted-web"
    ],
    "same_source_commit_for_equivalent_surface": true,
    "manual_web_to_device_port_required": false
  },
  "host_independence": {
    "wsl_required": false,
    "qemu_required": false,
    "powershell_required": false,
    "bash_required": false,
    "specific_linux_distribution_required": false,
    "specific_desktop_os_required": false,
    "shared_creator_core_required": true,
    "creator_is_desktop_capability": true,
    "thin_platform_adapters_allowed": true,
    "platform_policy_forks_allowed": false,
    "end_user_kernel_toolchain_required": false
  },
  "remote_control": {
    "required_for_bootstrap": false,
    "required_for_product": false,
    "required_for_daily_development": false,
    "ssh_required": false,
    "product_owned_remote_core_may_be_added_later": true,
    "custom_cryptographic_primitives_allowed": false
  },
  "security": {
    "private_keys_in_repository_allowed": false,
    "fail_closed_identity_and_integrity": true,
    "custom_crypto_allowed": false
  },
  "development": {
    "normal_change_path": "git-push-to-ci-release-update",
    "full_image_rebuild_per_edit": false,
    "usb_reflash_per_edit": false,
    "routine_reboot_per_edit": false,
    "delta_or_release_update_preferred": true,
    "browser_hmr_for_surface_allowed": true,
    "surface_change_should_reach_web_mobile_desktop_and_device": true,
    "remote_shell_required": false,
    "remote_control_service_required": false,
    "emulator_mandatory": false,
    "real_hardware_validation_required_before_final_promotion": true
  },
  "ecosystem_foundation": {
    "status": "pre-mvp-source-foundation",
    "contracts": {
      "entitlements": "docs/contracts/entitlements.json",
      "spaces_and_profile_packs": "docs/contracts/spaces-and-profile-packs.json",
      "memory": "docs/contracts/memory.json",
      "model_router": "docs/contracts/model-router.json",
      "app_distribution": "docs/contracts/app-distribution.json",
      "external_ai_bridge": "docs/contracts/external-ai-bridge.json",
      "profile_provisioning": "docs/contracts/profile-provisioning.json",
      "profile_content_trust": "docs/contracts/profile-content-trust-policy.json",
      "profile_activation_state": "docs/contracts/profile-activation-state.json"
    },
    "account_profile_is_professional_profile": false,
    "memory_owned_by_ordax": true,
    "inference_provider_owns_memory": false,
    "product_mcp_reuses_development_owner_credentials": false,
    "github_project_access_prefers_github_app": true,
    "billing_enabled": false,
    "public_store_enabled": false,
    "profile_catalog_bundled_payloads_on_demand": true,
    "public_profile_install_enabled": false,
    "profile_content_trust_domain": "profile-content",
    "profile_content_reuses_runtime_component_key": false,
    "profile_content_publication_enabled": false,
    "profile_activation_state_device_persistent": true,
    "profile_activation_rolls_back_space_data": false,
    "profile_activation_http_mutation_enabled": false
  }
}
