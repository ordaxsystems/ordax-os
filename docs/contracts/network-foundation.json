{
  "$schema": "prototype-ordax.network-foundation/1",
  "status": "mvp-source-implementation-in-progress-live-backend-gated",
  "product_boundary": {
    "identity_subject": "account",
    "public_professional_actor": "space",
    "profile_pack_is_authority": false,
    "profile_pack_may_recommend_communities": true,
    "automatic_directory_publication": false,
    "automatic_membership": false,
    "anonymous_local_ordax_remains_supported": true
  },
  "domains": [
    "directory",
    "communities",
    "memberships",
    "groups",
    "conversations",
    "messages",
    "moderation"
  ],
  "mvp": {
    "directory_opt_in": true,
    "communities": true,
    "groups": true,
    "direct_messages": true,
    "group_messages": true,
    "block": true,
    "report": true,
    "rate_limits": true,
    "binary_attachments_required": false,
    "algorithmic_feed_required": false,
    "voice_video_required": false
  },
  "authorization": {
    "server_authoritative": true,
    "default_deny": true,
    "client_claimed_role_trusted": false,
    "membership_checked_for_each_protected_operation": true,
    "role_change_requires_authorized_actor": true,
    "space_switch_must_not_retarget_pending_message": true,
    "cross_tenant_direct_table_access": false
  },
  "data_security": {
    "opaque_public_ids": true,
    "exact_location_in_default_directory": false,
    "personal_email_public_by_default": false,
    "structured_or_plain_text_only": true,
    "raw_html_from_client_trusted": false,
    "bounded_payloads": true,
    "bounded_pagination": true,
    "idempotency_for_critical_mutations": true,
    "database_integrity_constraints_required": true,
    "retention_and_tombstone_policy_required": true,
    "message_bodies_in_default_operational_logs": false,
    "message_content_contract": "prototype-ordax.network-message-content/1",
    "message_plain_text": true,
    "message_html_interpretation": false,
    "message_unsafe_control_characters_rejected": true,
    "message_auto_link_schemes": [
      "http",
      "https"
    ]
  },
  "abuse_resistance": {
    "rate_limit_by_actor": true,
    "rate_limit_by_space": true,
    "anti_enumeration": true,
    "anti_scraping_controls": true,
    "block_enforced_server_side": true,
    "moderation_audit": true
  },
  "isolation_proof": {
    "two_accounts_required": true,
    "multiple_spaces_required": true,
    "negative_read_tests": true,
    "negative_write_tests": true,
    "role_escalation_tests": true,
    "blocked_actor_tests": true
  },
  "availability": {
    "network_failure_must_not_block_boot": true,
    "network_failure_must_not_block_local_apps": true,
    "offline_state_must_be_honest": true
  },
  "ai": {
    "messages_auto_ingested_into_memory": false,
    "summarization_requires_explicit_scope": true,
    "model_output_grants_authority": false
  },
  "external_integrations": {
    "direct_database_coupling": false,
    "authenticated_api_or_capability_required": true,
    "least_privilege_scopes": true
  },
  "implementation_state": {
    "surface_app_source": true,
    "explicit_sender_space": true,
    "pending_draft_space_pin": true,
    "mutation_outcome_v2_contract": true,
    "ephemeral_postgresql_message_send_v2_proof": true,
    "client_transport_v2_source": true,
    "provider_neutral_gateway_v2_source": true,
    "supabase_gateway_adapter": false,
    "generated_v2_migration": false,
    "live_network_endpoint": false,
    "production_rollout": false
  }
}
