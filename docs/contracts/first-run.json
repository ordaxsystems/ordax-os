{
  "$schema": "prototype-ordax.first-run/1",
  "status": "launch-baseline-native-functional",
  "scope": "launch-baseline-usb-first-use",
  "owners": {
    "state_semantics": "system/services/state/first-run.mjs",
    "state_port": "system/contracts/first-run-state-store.mjs",
    "native_adapter": "system/adapters/native/first-run-state.mjs",
    "native_host": "system/surface/runtime/native_host_server.py",
    "surface_ui": "system/surface/ui/first-run.mjs",
    "local_session_contract": "system/contracts/local-session.mjs",
    "local_session_adapter": "system/adapters/native/local-session.mjs",
    "local_session_ui": "system/surface/ui/local-session-lock.mjs",
    "preference_runtime": "system/contracts/preference-runtime.mjs",
    "keyboard_layout": "system/contracts/keyboard-layout.mjs",
    "device_profile": "system/contracts/device-profile.mjs",
    "identity_credentials": "system/contracts/identity-credentials.mjs"
  },
  "persistence": {
    "native_path": "/var/lib/ordax/first-run.json",
    "persistent_usb_state": true,
    "completion_must_be_durable_before_dismiss": true,
    "state_is_separate_from_user_preferences": true,
    "state_is_separate_from_identity_session": true,
    "state_is_separate_from_local_session_secret": true,
    "completed_receipt_monotonic": true,
    "identical_completed_retry_idempotent": true,
    "corrupt_existing_receipt_must_not_be_overwritten": true,
    "concurrent_completion_posts_serialized": true,
    "directory_entry_fsync_required_before_acknowledgement": true,
    "post_completion_regional_edits_owner": "settings",
    "preferences_confirmed_before_receipt": true,
    "rollback_attempted_when_pre_receipt_configuration_fails": true
  },
  "flow": [
    "welcome",
    "language",
    "keyboard",
    "region",
    "network",
    "account",
    "security",
    "privacy",
    "name",
    "review",
    "complete"
  ],
  "regional": {
    "complete_locales": [
      "pt-BR",
      "en-US"
    ],
    "completeness_scope": "first-run-oobe-only",
    "surface_complete_locales": [
      "pt-BR",
      "en-US"
    ],
    "surface_translation_status": {
      "pt-BR": "source-language",
      "en-US": "complete",
      "es-ES": "migration-in-progress",
      "de-DE": "migration-in-progress",
      "fr-FR": "migration-in-progress"
    },
    "default_locale": "pt-BR",
    "launch_locale_policy": "launch-baseline-public-pt-br-en-us-retain-hidden-oobe-translations",
    "default_time_zone": "America/Bahia",
    "time_zone_preference": "regional.time-zone",
    "missing_preference_recovery": "seed-from-completed-first-run",
    "existing_preference_overwrite_allowed": false,
    "editable_after_first_run_in_settings": true,
    "keyboard_layout_contract": "docs/contracts/keyboard-layout.json",
    "keyboard_layout_selector_exposed": true,
    "keyboard_layout_selector_gate": "durable-native-config-plus-explicit-next-surface-apply",
    "retained_compatible_locales": [
      "es-ES",
      "de-DE",
      "fr-FR"
    ],
    "public_selector_must_only_offer_surface_ready_locales": true,
    "public_launch_locales": [
      "pt-BR",
      "en-US"
    ]
  },
  "network": {
    "skippable": true,
    "uses_existing_network_management_port": true,
    "password_is_transient_only": true,
    "password_must_not_enter_first_run_state": true,
    "first_online_update_policy": "docs/contracts/mvp-app-delivery.json",
    "successful_connection_makes_official_update_discovery_reachable": true,
    "update_discovery_owner": "system/supervisor",
    "update_discovery_transport": "official-signed-release-channel",
    "update_discovery_mode": "periodic-signed-channel-polling",
    "update_discovery_default_interval_seconds": 60,
    "direct_oobe_update_executor_allowed": false,
    "direct_oobe_wake_required_for_launch": false,
    "update_discovery_failure_must_not_block_completion": true,
    "offline_skip_defers_successful_discovery": true,
    "retry_after_first_run_owned_by_supervisor": true,
    "runtime_update_polling_status": "source-connected-physical-proof-pending"
  },
  "account": {
    "optional": true,
    "local_only_always_available": true,
    "sign_in_capability_driven": true,
    "register_capability_driven": true,
    "provider_unavailable_must_not_block_completion": true,
    "identity_subject_must_not_enter_first_run_state": true,
    "identity_selection_requires_current_subject_at_completion": true,
    "identity_selection_requires_fresh_session_read": true,
    "identity_subject_in_first_run_receipt": false,
    "expired_or_changed_identity_returns_to_account_step": true,
    "recovery_capability_driven": true,
    "recovery_response_must_not_enumerate_accounts": true,
    "password_must_not_be_reused_as_local_secret": true,
    "cloud_sync_required_for_launch": false
  },
  "security": {
    "local_session_optional": true,
    "minimum_secret_characters": 6,
    "maximum_secret_characters": 128,
    "secret_is_transient_in_surface": true,
    "secret_must_not_enter_first_run_state": true,
    "secret_must_not_enter_telemetry": true,
    "credential_owner": "native-host",
    "credential_path": "/var/lib/ordax/local-session-credential.json",
    "credential_format": "scrypt-verifier-with-random-salt",
    "starts_locked_on_next_surface_start_when_configured": true,
    "bad_or_unreadable_credential_fails_closed": true,
    "account_identity_independent": true,
    "network_independent": true,
    "protection_scope": "surface-session-not-storage-encryption",
    "configurable_after_first_run_in_settings": true
  },
  "privacy": {
    "owner": "preferences",
    "memory_auto_capture_preference": "memory.auto-capture",
    "confirmed_persistence_required": true,
    "false_success_forbidden": true
  },
  "device_profile": {
    "optional_when_capability_unavailable": true,
    "owner": "system/contracts/device-profile.mjs",
    "display_name_persisted_by_native_owner": true,
    "false_success_forbidden": true
  },
  "review": {
    "second_authoritative_store_allowed": false,
    "reads_same_draft_and_live_owners": true
  },
  "completion": {
    "receipt_owner": "first-run-state-store",
    "receipt_written_after_required_owner_writes": true,
    "persistence_failure_blocks_completion": true,
    "surface_transition_only_after_durable_receipt": true
  },
  "launch_baseline": {
    "runs_from_usb": true,
    "permanent_internal_disk_install_exposed": false,
    "web_mode_uses_this_device_oobe": false
  }
}
