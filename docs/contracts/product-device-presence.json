{
  "$schema": "prototype-ordax.product-device-presence/1",
  "status": "owner-development-usb-native-presence-source-candidate",
  "authority": "ordax-control-plane-postgresql",
  "transport": {
    "direction": "outbound-https-only",
    "method": "POST",
    "path": "/v3/product/device/presence",
    "controlPlaneBaseUrl": "runtime-configured",
    "runtimeKind": "ordax-os",
    "runtimeOwner": "system/surface/runtime/product_device_presence.py",
    "canonicalIngress": "https://ordax-mcp.ordaxsystems.workers.dev",
    "separateMcpServer": false,
    "capabilityDigest": null
  },
  "credential": {
    "path": "/state/ordax/native-state/device-agent/product-device.json",
    "nativeRuntimePath": "/var/lib/ordax/device-agent/product-device.json",
    "mode": "0600",
    "fields": [
      "device_id",
      "device_token"
    ],
    "deviceId": "canonical-uuid",
    "deviceToken": "256-bit-lowercase-hex",
    "surfaceReadable": false,
    "synchronized": false,
    "singlePersistentCopy": true
  },
  "lifecycle": {
    "reportMode": "managed-native-worker",
    "ownsHeartbeatLoop": true,
    "schedulingOwner": "NativeHost/ProductDevicePresenceWorker",
    "enrollmentRequired": true,
    "enrollmentImplemented": true,
    "withoutCredential": "inactive-fail-soft",
    "withoutNetwork": "offline-fail-soft",
    "bootDependency": false,
    "surfaceHealthDependency": false,
    "grantsRemoteActions": false,
    "opensInboundPort": false,
    "dualWritesLegacyAndCanonical": false,
    "enrollmentSource": "system/surface/runtime/product_device_runtime.py",
    "enrollmentCondition": "authenticated-native-account-owner-development-usb-only",
    "legacyShellReporterMounted": false,
    "requiresAuthenticatedLogin": true,
    "stopsOnAccountLogout": true,
    "stopsOnNativeHostShutdown": true
  },
  "production": {
    "enabled": false,
    "reason": "control-plane-v3-production-gates-remain-closed"
  },
  "ownerDevelopment": {
    "canaryAllowedAfterAuthenticatedEnrollment": true,
    "automaticEnrollment": true,
    "enrollmentTrigger": "after-successful-authenticated-native-account-login",
    "requiresConfiguredHttpsControlPlane": true,
    "presenceAvailableAfterEnrollment": true,
    "manualPowerShellRequired": false
  },
  "externalMcp": {
    "accountLoginAutomaticallyConnectsExternalClient": false,
    "oauthClientConsentRequired": true,
    "deviceScopedCapabilityGrantRequired": true,
    "devicePresenceRuntimeMounted": true,
    "attestedMcpSessionImplementedInOs": false,
    "remoteActionRuntimePackagedInOs": false,
    "remoteActionDispatchEnabled": false,
    "chatGptAccountDistinctFromOrdaxAccount": true,
    "devicePresenceDoesNotGrantActions": true,
    "runtimeProvenance": "ordax-os",
    "actionGatewayOwner": "ordax-platform",
    "intelligenceOwner": "ordax-os:ordax.intelligence/1",
    "modelRouterSeparateFromMcp": true
  }
}
