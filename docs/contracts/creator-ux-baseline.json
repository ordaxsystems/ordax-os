{
  "$schema": "prototype-ordax.creator-ux-baseline/2",
  "status": "minimum-rufus-class-baseline",
  "primary_flow": [
    "detect_usb",
    "select_usb",
    "create_ordax",
    "confirm_destructive_action",
    "windows_uac",
    "write",
    "readback_verify",
    "complete"
  ],
  "user_required_inputs": [
    "usb_target"
  ],
  "user_optional_preferences": [
    "locale"
  ],
  "forbidden_required_inputs": [
    "iso_path",
    "image_path",
    "partition_scheme",
    "filesystem",
    "bootloader",
    "release_channel",
    "terminal_command",
    "publisher_key"
  ],
  "localization": {
    "owner": "creator",
    "source_locale": "pt-BR",
    "bundled_locales": [
      "pt-BR",
      "en-US"
    ],
    "initial_locale_source": "windows-user-locale",
    "fallback_locale": "pt-BR",
    "user_selection_persisted": true,
    "catalog_parity_required": true,
    "placeholder_parity_required": true,
    "raw_diagnostic_hidden_from_user_copy": true,
    "additional_locales_component_scoped": true
  },
  "owner_distribution": {
    "format": "split-zip-bundle",
    "artifact": "OrdaX-Creator-Owner-Prototype.zip",
    "gui_raw_backend_separate": true,
    "standalone_gui_published": false,
    "bundle_extraction_required": true
  },
  "owner_update": {
    "manifest_schema": "prototype-ordax.creator-owner-bundle-update/1",
    "artifact": "OrdaX-Creator-Owner-Prototype.zip",
    "automatic_in_app_update": false,
    "anti_downgrade_check": true,
    "unsupported_automatic_update_fails_closed": true
  },
  "requirements": {
    "automatic_update_check_on_launch": true,
    "visible_update_control": true,
    "separate_usb_refresh_control": true,
    "post_uac_status_transition": true,
    "visible_progress_indicator": true,
    "progress_completes_on_success": true,
    "explicit_success_completion_notice": true,
    "single_usb_auto_selection": true,
    "multiple_usb_explicit_selection": true,
    "system_disk_exclusion": true,
    "destructive_confirmation": true,
    "readback_verification": true,
    "guided_step_experience": true,
    "destructive_review_explains_usb_erasure": true,
    "internal_disk_safety_explained": true,
    "write_state_warns_keep_usb_connected": true,
    "completion_explains_boot_from_usb": true,
    "interactive_boot_guidance": true,
    "boot_guidance_stays_inside_creator": true,
    "illustration_slots_are_presentation_only": true,
    "native_visual_step_rail": true,
    "native_state_illustration": true,
    "visuals_follow_guided_state_machine": true,
    "visuals_add_no_network_or_web_runtime_dependency": true,
    "owner_write_package_independent_from_creator_dev": true,
    "owner_gui_and_raw_writer_are_separate": true,
    "physical_write_has_single_uac_elevation_boundary": true,
    "owner_update_detects_published_bundle": true,
    "owner_update_manifest_validates_sha256_and_size_binding": true,
    "owner_update_blocks_downgrade": true,
    "owner_update_does_not_run_unsupported_bundle_installer": true,
    "creator_copy_uses_localization_owner": true,
    "creator_locale_selection_is_persistent": true
  }
}
