{
  "$schema": "prototype-ordax.native-release-assembly/2",
  "status": "canonical-build-recipe",
  "recipe": "tools/native-release-assembly/build.py",
  "source_inputs": [
    "system/",
    "docs/contracts/native-release-assembly.json#creator_source",
    "tools/runtime-component-channel/go.mod",
    "tools/runtime-component-channel/*.go"
  ],
  "target": {
    "os": "linux",
    "arch": "amd64",
    "cgo_enabled": false
  },
  "output": {
    "staged_system_root": "<out>/system",
    "helper_paths": [
      "system/bin/ordax-native-install-targets",
      "system/bin/ordax-runtime-component-channel"
    ],
    "provenance_path": "system/.ordax/native-release-tools.json",
    "final_artifact_owner": "tools/release-bundle",
    "final_artifact": "system.tar"
  },
  "helpers": [
    {
      "path": "system/bin/ordax-native-install-targets",
      "role": "native-install-read-only-target-discovery",
      "physical_apply_implemented": false,
      "physical_apply_authorized": false,
      "component_publish_authorized": false,
      "sha256_required": true,
      "size_required": true,
      "mode": "0755"
    },
    {
      "path": "system/bin/ordax-runtime-component-channel",
      "role": "runtime-component-verifier-and-activation-state-owner",
      "private_signing_key_access": false,
      "component_publish_authorized": false,
      "runtime_slot_serving_authorized": false,
      "sha256_required": true,
      "size_required": true,
      "mode": "0755"
    }
  ],
  "release_policy": {
    "separate_download_channel": false,
    "runtime_compilation_allowed": false,
    "end_user_toolchain_required": false,
    "covered_by_system_tar_signature": true,
    "canonical_release_protocol_unchanged": true,
    "component_trust_domain_remains_separate": true
  },
  "creator_source": {
    "repository": "ordaxsystems/ordax-creator",
    "commit": "8adf641fb2cd9a3ac8351f23f912ce29ee2b70c9",
    "tree": "312d18bb8e5cb97a216a54697724bbc8893d33d0",
    "module": "github.com/ordaxsystems/ordax-creator",
    "helper_package": "./cmd/ordax-creator-native-targets",
    "physical_apply_authorized": false,
    "publisher_authority": "ordaxsystems/ordax-os"
  }
}
