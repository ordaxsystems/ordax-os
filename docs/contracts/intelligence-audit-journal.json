{
  "$schema": "prototype-ordax.intelligence-audit-journal/1",
  "status": "bounded-runtime-audit-foundation",
  "journal_contract": "ordax.intelligence-audit-journal/1",
  "entry_contract": "ordax.intelligence-audit-entry/1",
  "owner": "system/services/intelligence",
  "purpose": "Correlate governed Intelligence tool authorization and execution receipts without turning receipts into authority.",
  "sources": {
    "authorization_receipt_contract": "ordax.intelligence-tool-authorization-receipt/1",
    "execution_receipt_contract": "ordax.intelligence-tool-execution-receipt/1",
    "correlation_field": "auditRef"
  },
  "events": {
    "authorization": [
      "issued",
      "claimed",
      "revoked",
      "expired"
    ],
    "execution": [
      "succeeded",
      "failed"
    ]
  },
  "privacy": {
    "contains_grant_id": false,
    "contains_target_id": false,
    "contains_prompt": false,
    "contains_model_response": false,
    "contains_tool_result_context": false,
    "contains_adapter_error_detail": false,
    "audit_ref_is_authority": false
  },
  "safety": {
    "read_only": true,
    "network_egress": false,
    "mutated_state": false,
    "authority": "none",
    "raw_append_api": false,
    "delete_entry_api": false,
    "runtime_registration_api": false
  },
  "retention": {
    "default_entries": 256,
    "maximum_entries": 1024,
    "rotation": "oldest-first",
    "sequence_monotonic_within_runtime": true,
    "durable_native_persistence": false
  },
  "deferred": [
    "durable-native-audit-store",
    "integrity-protected-persistence",
    "user-facing-audit-history",
    "export-with-explicit-user-action",
    "cross-device-audit-sync"
  ]
}
