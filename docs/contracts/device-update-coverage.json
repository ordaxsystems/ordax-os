{
  "$schema": "prototype-ordax.device-update-coverage/1",
  "status": "canonical-prototype-contract",
  "source_authority": {
    "repository": "ordaxsystems/ordax-os",
    "branch": "main",
    "git_is_source_authority_for_all_product_layers": true,
    "runtime_sparse_checkout_is_not_source_authority": true,
    "physical_media_is_not_source_authority": true
  },
  "boot_policy": {
    "known_good_local_boot_precedes_network": true,
    "normal_boot_waits_for_git": false,
    "background_update_after_healthy_local_boot": true,
    "emergency_fix_may_originate_from_git_for_any_layer": true,
    "network_module_loading_on_known_good_local_boot": false,
    "network_initialization_owner": "bootstrap/dev-base/ordax-network",
    "network_initialization_runs_outside_local_boot_critical_path": true,
    "surface_health_default_timeout_seconds": 30,
    "surface_health_minimum_override_seconds": 15,
    "recovery_must_not_wait_minutes_for_surface_health": true
  },
  "layers": [
    {
      "id": "apps-and-surface",
      "source_roots": [
        "system/apps",
        "system/surface",
        "system/composition"
      ],
      "development_delivery": "runtime-git-checkout",
      "activation": "reload-or-surface-restart",
      "usb_rewrite_required": false,
      "reboot_required": false
    },
    {
      "id": "development-boot-helpers",
      "source_roots": [
        "bootstrap/dev-base",
        "bootstrap/recovery"
      ],
      "development_delivery": "runtime-git-checkout-plus-dev-helper-refresh",
      "activation": "atomic-helper-replace",
      "usb_rewrite_required": false,
      "reboot_required": false
    },
    {
      "id": "development-rootfs",
      "source_roots": [
        "bootstrap/dev-base",
        "bootstrap/recovery"
      ],
      "development_delivery": "exact-commit-development-base-rootfs-candidate",
      "activation": "versioned-selector-plus-automatic-inactive-slot-staging-health-gated-promotion",
      "candidate_delivery_implemented": true,
      "activation_implemented": false,
      "usb_rewrite_required": false,
      "reboot_required": true,
      "health_gate": "candidate boot is promoted only after matching base heartbeat + Surface health + Surface heartbeat + boot id",
      "selector_implemented": true,
      "physical_staging_implemented": true,
      "activation_readiness_implemented": true,
      "postboot_promotion_implemented": true,
      "runtime_one_shot_activation_wiring_implemented": false,
      "current_activation_gap": "runtime LoaderEntryOneShot arming/reboot handoff remains disabled pending boot-counting/fallback gates"
    },
    {
      "id": "kernel-and-initramfs",
      "source_roots": [
        "bootstrap/kernel",
        "bootstrap/initramfs"
      ],
      "development_delivery": "exact-commit-development-base-candidate",
      "activation": "inactive-base-slot-next-boot",
      "usb_rewrite_required": false,
      "reboot_required": true,
      "physical_staging_implemented": true,
      "activation_readiness_implemented": true,
      "runtime_one_shot_activation_wiring_implemented": false,
      "postboot_promotion_implemented": true
    },
    {
      "id": "boot-selection-metadata",
      "source_roots": [
        "bootstrap/base-update",
        "boot/esp/loader"
      ],
      "development_delivery": "staged-candidate-plus-health-gated-postboot-promotion",
      "activation": "one-shot-selection-proofed-runtime-arming-pending",
      "usb_rewrite_required": false,
      "reboot_required": true,
      "staging_implemented": true,
      "postboot_promotion_implemented": true,
      "runtime_one_shot_activation_wiring_implemented": false
    },
    {
      "id": "uefi-fallback-loader",
      "source_roots": [
        "boot/esp/EFI/BOOT"
      ],
      "development_delivery": "creator-or-recovery-maintenance",
      "activation": "physical-esp-loader-replacement",
      "usb_rewrite_required": "currently-yes-for-loader-byte-change",
      "reboot_required": true,
      "self_update_gap": true
    },
    {
      "id": "creator",
      "source_roots": [
        "tools/creator"
      ],
      "development_delivery": "repository-ci-desktop-tooling",
      "activation": "host-tool-update",
      "usb_rewrite_required": false,
      "reboot_required": false
    }
  ],
  "branding": {
    "current_pre_surface_boot_ui": "console-text",
    "current_text_owner": "bootstrap/dev-base/ordax-dev-init",
    "graphical_boot_splash_implemented": false,
    "future_early_splash_owner": "initramfs-or-base",
    "future_surface_loading_owner": "system/apps-or-system/surface",
    "branding_source_must_remain_repository_owned": true,
    "surface_loading_implemented": true,
    "surface_loading_owner": "system/surface/ui/boot-screen.*",
    "surface_loading_delivery": "runtime-git-checkout",
    "surface_loading_usb_rewrite_required": false
  },
  "runtime_checkout": {
    "sparse_by_design": true,
    "reason": "keep-first-acquisition-and-update-lightweight; source authority remains remote Git plus published exact-commit artifacts",
    "must_not_expand_to_full_repository_on_boot": true
  },
  "known_gap": {
    "id": "uefi-fallback-loader-self-update",
    "description": "BOOTX64.EFI is repository-owned but is not yet autonomously replaced by the running development system.",
    "normal_system_update_blocked_by_gap": false,
    "kernel_update_blocked_by_gap": false,
    "app_update_blocked_by_gap": false
  },
  "development_rootfs_activation": {
    "status": "selector-materialization-staging-readiness-and-postboot-promotion-implemented-runtime-one-shot-arming-pending",
    "artifact": "rootfs.tar",
    "candidate_owner": "system/services/base-update/agent.sh + system/services/base-update/dev_channel.py",
    "selector_owner": "bootstrap/dev-base/ordax-dev-init",
    "current_boot_root": "/ordax/dev-base",
    "target_versioned_layout": "/ordax/dev-base/versions/<commit>",
    "candidate_identity": "ordax.base_candidate=<commit> + ordax.base_slot=a|b",
    "slot_mapping": "/state/ordax/base-update/rootfs/slot-{a,b}",
    "shared_mounts": [
      "/state",
      "/workspace",
      "/home",
      "/proc",
      "/sys",
      "/dev"
    ],
    "selection_policy": "versioned rootfs is selected only when a candidate boot supplies the matching exact commit and A/B slot",
    "promotion_policy": "the candidate becomes current only when cmdline, base heartbeat, checkout SHA, Surface health, Surface heartbeat and boot id all agree",
    "fallback_policy": "an unpromoted/failed candidate never replaces the known-good current entry; exact systemd-boot one-try fallback and physical-notebook behavior remain separate gates",
    "next_gate": "merge the pinned systemd boot-counting proof, then wire LoaderEntryOneShot/reboot to the runtime owner and prove failed-candidate fallback before physical notebook activation",
    "request_owner": "system/supervisor writes exact SHA request only",
    "python_runtime": "replaceable native Surface runtime; Python is not required in the development bootstrap Base",
    "seed_root_resolution": "strip terminal /versions/<commit> from the live root mount subpath before resolving shared state/version storage",
    "current_limit": "staging/readiness/promotion are live in the owner, but runtime one-shot activation and reboot handoff remain intentionally disabled",
    "staging_owner": "system/services/base-update/agent.sh + system/services/base-update/dev_physical_stage.py",
    "readiness_owner": "system/services/base-update/agent.sh + system/services/base-update/dev_activation_readiness.py",
    "promotion_owner": "system/services/base-update/agent.sh + system/services/base-update/dev_postboot_promote.py + bootstrap/base-update/promote.py",
    "automatic_inactive_slot_staging": true,
    "activation_readiness_implemented": true,
    "postboot_health_promotion_implemented": true,
    "runtime_one_shot_activation_wiring_implemented": false,
    "staging_state": "/state/ordax/base-update/dev-base-staged-sha",
    "readiness_state": "/state/ordax/base-update/dev-base-activation-readiness-sha",
    "promotion_state": "/state/ordax/base-update/dev-base-promoted-sha",
    "disposable_physical_staging_proven": true,
    "disposable_postboot_promotion_proven": true,
    "physical_notebook_activation_proven": false
  }
}
