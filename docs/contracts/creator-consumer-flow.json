{
  "$schema": "prototype-ordax.creator-consumer-flow/2",
  "status": "implemented-gated-authorized-physical-candidate-publisher-release-pending",
  "audience": "end-user",
  "principle": "the consumer Creator behaves like a Rufus-class USB creation utility with OrdaX defaults fully owned by the product; the removable USB target is the only configurable user input",
  "user_configurable_inputs": [
    "usb_target"
  ],
  "automatic_inputs": [
    "ordax_version",
    "signed_physical_candidate",
    "portable_application_plan",
    "exact_17_artifact_sources",
    "partition_layout",
    "filesystem_layout",
    "bootloader",
    "kernel",
    "initramfs",
    "release_channel",
    "verification_policy"
  ],
  "normal_flow": [
    "launch_creator",
    "automatic_component_update",
    "automatic_usb_detection",
    "automatic_signed_physical_candidate_check",
    "automatic_canonical_portable_plan_resolution",
    "automatic_exact_17_artifact_resolution_and_verification",
    "select_usb",
    "click_create_ordax_usb",
    "revalidate_exact_removable_target",
    "confirm_destructive_target",
    "approve_windows_uac",
    "create_portable_two_partition_gpt",
    "format_ordax_esp_fat32_and_ordax_data_exfat",
    "materialize_exact_17_artifacts",
    "per_artifact_sha256_and_size_readback",
    "verify_final_geometry_labels_and_capacity",
    "success"
  ],
  "forbidden_user_steps": [
    "select_iso",
    "select_image_file",
    "select_ordax_version",
    "select_partition_scheme",
    "select_filesystem",
    "select_bootloader",
    "configure_release_channel",
    "generate_release_signing_key",
    "backup_release_signing_key",
    "provide_private_key",
    "provide_public_trust_file",
    "select_bootstrap_image_manually",
    "select_internal_system_disk",
    "use_terminal",
    "use_powershell",
    "run_cmd_scripts"
  ],
  "publisher_boundary": {
    "private_signing_key_is_consumer_input": false,
    "private_signing_key_may_ship_in_creator": false,
    "private_signing_key_may_ship_in_creator_payload": false,
    "public_verification_material_is_automatic": true,
    "public_verification_material_is_compile_time_pinned": true,
    "release_signature_verification_is_automatic": true,
    "physical_release_tag": "creator-physical",
    "physical_release_envelope": "creator-physical-envelope.json",
    "physical_release_purpose": "creator-portable-physical-windows-amd64",
    "physical_release_recipe": "creator/physical/portable-windows/2",
    "development_channel_may_promote_writer": false,
    "offline_canonical_signing_required_before_publication": true,
    "existing_release_rotation_requires_explicit_confirmation": true,
    "existing_release_rotation_must_archive_previous_signed_bytes": true,
    "active_alias_may_move_only_after_archive_readback": true,
    "rotation_failure_requires_byte_exact_rollback": true
  },
  "physical_candidate_integrity": {
    "signed_envelope_required": true,
    "ed25519_signature_required": true,
    "canonical_trust_file_sha256_must_match_creator_pin": true,
    "bundle_sha256_and_size_required": true,
    "critical_files_bound_by_sha256_and_size": [
      "ordax-creator-physical-test.exe",
      "release-ed25519.json",
      "minimal-bootstrap.json",
      "portable-usb-v2.json",
      "creator-portable-media-plan.json",
      "physical-write-authorization.json",
      "provenance.json",
      "SHA256SUMS"
    ],
    "unexpected_archive_files_allowed": false,
    "archive_symlinks_allowed": false,
    "archive_path_traversal_allowed": false,
    "critical_files_rehashed_before_offline_reuse": true,
    "offline_pointer_is_signed_envelope": true,
    "whole_disk_raw_image_required": false,
    "portable_artifact_count": 17,
    "portable_application_operation_count": 39,
    "portable_source_preflight_implemented": true,
    "portable_source_preflight_owner": "tools/creator/core/portable_sources.go#VerifyPortableSources",
    "portable_source_preflight_requires_exact_17_flat_files": true,
    "portable_source_preflight_is_destructive_authorization": false
  },
  "physical_write_gate": {
    "development_channel_can_write": false,
    "requires_raw_backend_for_windows_device_access": true,
    "requires_canonical_public_trust_binding": true,
    "requires_signed_physical_manifest": true,
    "requires_authorized_manifest_binding": true,
    "requires_canonical_portable_application_plan": true,
    "requires_exact_17_artifact_sources": true,
    "requires_live_usb_confirmation_token": true,
    "requires_user_destructive_confirmation": true,
    "requires_windows_elevation": true,
    "requires_post_write_readback": true,
    "internal_disk_write_allowed_in_mvp": false
  },
  "native_installation": {
    "foundation_may_exist_in_source": true,
    "public_mvp_visible": false,
    "public_mvp_enabled": false,
    "internal_disk_destructive_apply_enabled": false,
    "policy": "keep implemented foundations hidden and fail-closed until a separately reviewed post-MVP promotion explicitly enables native installation"
  },
  "failure_policy": {
    "network_update_failure": "use_last_signed_and_reverified_physical_candidate_when_available_otherwise_stay_read_only",
    "signed_envelope_failure": "stay_read_only",
    "critical_file_hash_failure": "stay_read_only",
    "portable_plan_or_artifact_mismatch": "abort_before_write",
    "target_changes_during_prepare": "abort",
    "uac_denied": "abort_without_write",
    "write_or_readback_failure": "report_failure_and_never_claim_success"
  }
}
