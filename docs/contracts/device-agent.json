{
  "$schema": "prototype-ordax.device-agent/1",
  "status": "pre-mvp-projects-integration-source",
  "product_name": "OrdaX Device Agent",
  "historical_incubation_repository": "washingtonmsdj/mcp-blender",
  "purpose": "provide one typed local capability runtime for Projects, Web control and external MCP clients",
  "source_and_update": {
    "github_remains_first_class": true,
    "main_is_active_integration_line": true,
    "fast_forward_update": true,
    "fail_closed_update": true,
    "external_bootstrap_recovery": true,
    "legacy_entrypoints_preserved_during_migration": true
  },
  "project_model": {
    "git_required": false,
    "github_required": false,
    "local_projects_supported": true,
    "github_projects_supported": true,
    "hybrid_projects_supported": true,
    "project_registration_is_authorization_boundary": true
  },
  "interfaces": {
    "ordax_projects_app": true,
    "ordax_web": true,
    "product_mcp": true,
    "same_action_gateway_required": true,
    "parallel_web_control_backend_forbidden": true,
    "ordax_mobile": true,
    "ordax_desktop": true,
    "ordax_native": true,
    "operational_realtime_contract": "docs/contracts/operational-realtime.json"
  },
  "projects_integration": {
    "component_port_optional": true,
    "capability_discovery_schema": "ordax.device-agent-capabilities/1",
    "capability_reader_schema": "ordax.device-agent-capability-reader/1",
    "projects_status_schema": "ordax.projects-device-agent-status/1",
    "capability_probe_timeout_ms": 1500,
    "surface_presentation_read_only": true,
    "surface_execute_action_exposed": false,
    "full_device_agent_port_passed_to_projects": false,
    "capability_reader_exposes_execute": false,
    "authority_narrowing_owner": "system/services/device-agent/capability-reader.mjs",
    "missing_port_hidden": true,
    "probe_failure_degrades_projects": false,
    "probe_failure_degrades_boot": false,
    "mutation_authority_from_status": "none"
  },
  "adapters": {
    "initial": [
      "files",
      "git",
      "blender",
      "unity"
    ],
    "versioned_independently": true,
    "capability_discovery_required": true,
    "compiled_does_not_imply_available": true
  },
  "github": {
    "direct_external_ai_connector_supported": true,
    "direct_connector_is_separate_from_ordax_mcp": true,
    "direct_connector_does_not_grant_ordax_memory": true,
    "direct_connector_does_not_grant_local_device_control": true,
    "ordax_account_connection_preferred_for_product_integration": "github-app",
    "selected_repository_scope_required": true
  },
  "remote_authorization": {
    "account_scope": true,
    "space_scope": true,
    "project_scope": true,
    "device_scope": true,
    "capability_scope": true,
    "read_write_separated": true,
    "write_requires_explicit_approval": true,
    "audit_required": true
  },
  "forbidden": [
    "generic-remote-shell-by-default",
    "raw-disk",
    "release-signing-key",
    "cross-space-memory",
    "unscoped-github-account",
    "implicit-admin",
    "client-side-entitlement-authority"
  ],
  "mvp_boundary": {
    "boot_dependency": false,
    "local_ai_dependency": false,
    "physical_usb_gate_changed": false,
    "ci_or_qemu_counts_as_physical_proof": false
  },
  "control_plane": {
    "backend_project": "ordax-control-plane",
    "shared_backend_project_allowed": true,
    "development_authority_separate_from_product_authority": true,
    "development_device_agent_transport_allowed": true,
    "development_credentials_may_authenticate_product_users": false,
    "product_credentials_may_authenticate_engineering_jobs": false,
    "product_action_gateway_may_reuse_development_operator_credentials": false,
    "historical_development_tables_are_product_authority": false,
    "bootstrap_dependency": false,
    "existing_device_token_identity_recovery": true,
    "github_runner_required_for_existing_device_recovery": false
  },
  "operational_actions": {
    "contract_status": "source-foundation-runtime-disabled",
    "request_schema": "ordax.device-action-request/1",
    "receipt_schema": "ordax.device-action-receipt/1",
    "same_action_gateway_required": true,
    "request_is_authority": false,
    "write_grant_required": true,
    "idempotency_required": true,
    "expiry_required": true,
    "audit_required": true
  }
}
