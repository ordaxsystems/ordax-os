{
  "$schema": "prototype-ordax.update-nomenclature/1",
  "status": "canonical-prototype-contract",
  "mode_version_policy": {
    "canonical_presentation": "system/contracts/product-family.mjs",
    "client_versions_require_verified_own_deployment_or_package": true,
    "unpublished_client_version": null,
    "os_usb_and_native_share_product_version": true,
    "one_global_version_number_for_all_clients": false,
    "mode_id_is_not_release_version": true,
    "github_sha_remains_exact_source_identity": true,
    "release_availability_remains_external_to_branding": true
  },
  "development": {
    "pull_request": {
      "user_facing_update_identity": false,
      "product_version": false,
      "purpose": "code-review-and-integration"
    },
    "source_commit": {
      "exact_technical_identity": true,
      "format": "lowercase-40-hex-git-sha"
    }
  },
  "delivery": {
    "user_label": "Entrega",
    "independent_from_pull_request_number": true,
    "human_sequence_only": true,
    "exact_identity_remains_source_commit": true,
    "prototype_sequence": {
      "method": "anchored-first-parent-device-impact-count",
      "epoch": {
        "source_commit": "2361b9e74c02d97c4d907417d7e1b2836062e5e7",
        "delivery_number": 220,
        "reason": "preserve already-observed prototype sequence while tightening device-impact scope"
      },
      "included_paths": [
        "system/**",
        "boot/**",
        "bootstrap/**"
      ],
      "excluded_paths": [
        "system/**/*.md",
        "boot/**/*.md",
        "bootstrap/**/*.md",
        "boot/**/prove_*",
        "bootstrap/**/prove_*"
      ],
      "proof_and_documentation_only_changes_increment_delivery": false,
      "proof_and_documentation_only_changes_require_boot_refresh": false
    }
  },
  "update": {
    "meaning": "device-application-event-or-state",
    "is_pull_request": false,
    "local_application_history_required": true
  },
  "product_version": {
    "currently_assigned": true,
    "scheme": "semantic-versioning",
    "current": "0.1.0",
    "display": "v0.1.0",
    "maturity": "prototype",
    "stable_release": false,
    "independent_from_delivery": true,
    "may_not_be_inferred_from_delivery": true,
    "may_not_be_inferred_from_pull_request": true,
    "v1_reserved_for_stable_product": true
  },
  "component_version": {
    "declared": true,
    "scheme": "semantic-versioning",
    "independence_is_per_component": true,
    "identity_independent_from_release_mode": true,
    "version_source": "component-manifests-and-app-owned-version-modules",
    "first_party_pre_1_0_maturity": "beta",
    "development_app_release_mode": "git-app",
    "independent_update_release_mode": "component-slot",
    "bundled_release_mode": "bundled",
    "base_release_mode": "base-ab",
    "independent_components_currently_enabled": [],
    "independent_components_currently_enabled_scope": "production-component-slot-only",
    "version_identity_requires_independent_packaging": false,
    "invented_component_versions_allowed": false,
    "independent_update_requires_independent_packaging": true,
    "bundled_version_does_not_imply_independent_update": true,
    "git_app_version_does_not_imply_production_independent_update": true
  },
  "compatibility": {
    "legacy_field": "versionNumber",
    "canonical_field": "deliveryNumber",
    "legacy_field_is_delivery_alias_only": true
  }
}
