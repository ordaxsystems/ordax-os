{
  "$schema": "prototype-ordax.native-app-data-binding/1",
  "status": "trusted-first-party-port-injection-active",
  "public_app_contract": "ordax.app-data/1",
  "verified_identity_contract": "ordax.verified-app-install-identity/1",
  "scope": "device-local-private-app-data",
  "binding": {
    "mint_input": "trusted-exact-receipt-sha256-only",
    "raw_identity_mint_allowed": false,
    "request_identity_fields_allowed": false,
    "capability_kind": "ephemeral-opaque-path-segment",
    "capability_entropy_bits": 256,
    "capability_published_in_global_native_session": false,
    "max_active_bindings_default": 64,
    "same_receipt_is_idempotent": true,
    "new_receipt_same_durable_identity_rotates_capability": true,
    "old_capability_revoked_on_rotation": true,
    "publisher_principal_partitions_same_app_id": true,
    "batch_mint_transactional": true,
    "batch_capacity_preflight_before_mutation": true,
    "batch_capability_allocation_before_mutation": true,
    "duplicate_durable_identity_in_batch_rejected": true
  },
  "current_boot_receipt_index": {
    "schema": "ordax.verified-app-install-session/1",
    "path": "/run/ordax-surface/app-install-identities.json",
    "mode": "0600",
    "nofollow": true,
    "single_hardlink_required": true,
    "source_commit_must_match_verified_handoff": true,
    "system_digest_must_match_verified_handoff": true,
    "all_receipts_validated_before_first_mint": true,
    "all_current_boot_receipts_minted_as_one_transactional_batch": true,
    "receipt_app_id_must_match_index": true,
    "receipt_identity_must_match_authenticated_first_party_inventory": true,
    "receipt_source_digest_must_match_current_system": true,
    "consumer_core": "system/surface/runtime/native_app_data_session_binding.py",
    "consumer_core_implemented": true,
    "runtime_wiring_enabled": true,
    "runtime_entrypoint": "system/surface/runtime/native_app_data_runtime.py",
    "stable_runtime_state_uid": 0,
    "owner_development_mints_bindings": false
  },
  "trusted_composition_handoff": {
    "schema": "ordax.native-app-data-port-bootstrap/1",
    "path": "/run/ordax-surface/app-data-port-bindings.json",
    "mode": "0600",
    "directory_mode": "0700",
    "root_owned_stable": true,
    "nofollow": true,
    "single_hardlink_required": true,
    "atomic_replace": true,
    "one_shot_consume": true,
    "receipt_sha256_included": false,
    "publisher_and_app_identity_derived_from_verified_binding": true,
    "producer": "system/surface/runtime/native_app_data_runtime.py",
    "consumer": "system/surface/runtime/ordax_browser_host.py",
    "browser_bridge_request": "app-data.bootstrap.request",
    "browser_bridge_response_event": "ordax-native-app-data-bootstrap",
    "global_native_session_exposure": false,
    "dom_exposure": false,
    "catalog_or_store_exposure": false
  },
  "app_facing_surface": {
    "receives_typed_port_only": true,
    "receives_endpoint_property": false,
    "receives_receipt_sha256": false,
    "port_injection_enabled": true,
    "opaque_endpoint_visible_only_during_trusted_composition_bootstrap": true,
    "opaque_endpoint_exposed_to_app_context": false,
    "trusted_component_context_provider_installed_before_first_app": true,
    "transport_identity_closed_by_trusted_composition": true,
    "first_party_only": true,
    "same_realm_third_party_isolation_claimed": false,
    "third_party_enablement_requires_separate_realm_or_origin": true
  },
  "transport": {
    "endpoint_prefix": "/__ordax/native/app-data/",
    "http_method": "POST",
    "identity_from_request_body": false,
    "typed_request_owner": "system/surface/runtime/native_app_data_endpoint.py",
    "durable_store_owner": "system/surface/runtime/native_app_data.py",
    "host_route_connected": true,
    "route_activation_scope": "trusted-native-process-only"
  },
  "non_goals": [
    "package-signature-verification",
    "receipt-production",
    "third-party-sandboxing",
    "account-sync",
    "credentials-storage",
    "notes-cutover"
  ]
}
