{
  "$schema": "prototype-ordax.repository-ownership/1",
  "status": "canonical",
  "repositories": {
    "platform": {
      "repo": "ordaxsystems/ordax-os",
      "owns": [
        "base",
        "boot",
        "surface-shell",
        "identity",
        "global-memory",
        "intelligence",
        "platform-permissions",
        "trust",
        "package-lifecycle",
        "store-structural",
        "settings-account-system",
        "app-sdk",
        "public-contracts"
      ],
      "must_not_own": [
        "studio-portable-source",
        "windows-runtime",
        "product-mcp-remote",
        "provider-connectors"
      ]
    },
    "apps": {
      "repo": "ordaxsystems/ordax-apps",
      "owns": [
        "first-party-app-source",
        "studio-portable-source",
        "app-ui-core",
        "app-assets-i18n-tests"
      ],
      "must_not_own": [
        "identity",
        "global-memory-authority",
        "platform-grants",
        "windows-device-host",
        "computer-control-authority",
        "oauth-remote",
        "control-plane"
      ]
    },
    "runtime": {
      "repo": "ordaxsystems/ordax-runtime",
      "owns": [
        "windows-ordax-runtime",
        "device-host",
        "computer-control",
        "filesystem-process-input-screenshot-app-launch",
        "windows-host-lifecycle",
        "local-policy-enforcement",
        "runtime-owned-adapters"
      ],
      "must_not_own": [
        "studio-portable-source",
        "product-mcp-remote",
        "oauth-remote",
        "platform-structural-services"
      ]
    },
    "control_plane": {
      "repo": "ordaxsystems/ordax-platform",
      "owns": [
        "product-mcp",
        "cloudflare-control-plane",
        "remote-oauth",
        "product-grants",
        "remote-queue-request-receipt-audit",
        "ordax-for-chatgpt",
        "provider-connectors"
      ],
      "must_not_own": [
        "studio-portable-source",
        "local-computer-control",
        "windows-device-host",
        "ordax-os-structural-services"
      ]
    }
  },
  "legacy": {
    "repo": "washingtonmsdj/mcp-blender",
    "role": "incubation-legacy-retirement-only",
    "new_features_allowed": false,
    "delete_only_after": [
      "studio-canonical-in-ordax-apps",
      "runtime-canonical-in-ordax-runtime",
      "control-plane-canonical-in-ordax-control-plane",
      "production-and-windows-packaging-repointed",
      "chatgpt-control-plane-runtime-e2e-green",
      "no-functional-build-deploy-launch-reference"
    ]
  },
  "invariants": {
    "single_canonical_owner_per_responsibility": true,
    "provider_identity_is_not_authority": true,
    "context_does_not_expand_authority": true,
    "raw_generic_shell_is_not_product_api": true,
    "typed_auditable_capabilities": true,
    "public_versioned_cross_repo_contracts": true,
    "migration_residue_may_not_become_second_ssot": true
  },
  "namespace_migration": {
    "status": "complete",
    "current_namespace": "ordaxsystems",
    "target_namespace": "ordaxsystems",
    "repository_name_changes_during_transfer": false,
    "redirect_dependency_allowed": false,
    "mirror_repository_allowed": false,
    "dual_authority_allowed": false,
    "provenance_rewrite_allowed": false,
    "canonical_targets": {
      "platform": "ordaxsystems/ordax-os",
      "apps": "ordaxsystems/ordax-apps",
      "runtime": "ordaxsystems/ordax-runtime",
      "control_plane": "ordaxsystems/ordax-platform"
    },
    "cutover_order": [
      "runtime",
      "apps",
      "control_plane",
      "platform"
    ],
    "completed_transfers": [
      "runtime",
      "apps",
      "control_plane",
      "platform"
    ],
    "transfer_policy": "transfer-one-repository-then-repoint-and-verify-before-next"
  }
}
