{
  "$schema": "prototype-ordax.repository-ownership/1",
  "status": "canonical",
  "repositories": {
    "platform": {
      "repo": "ordaxsystems/ordax-os",
      "owns": [
        "base",
        "boot",
        "surface-native-host",
        "surface-composition",
        "identity",
        "global-memory",
        "intelligence",
        "platform-permissions",
        "trust",
        "package-lifecycle",
        "store-structural",
        "settings-account-system",
        "app-sdk",
        "public-contracts",
        "native-capability-preflight"
      ],
      "must_not_own": [
        "studio-portable-source",
        "windows-runtime",
        "product-mcp-remote",
        "provider-connectors"
      ]
    },
    "surface": {
      "repo": "ordaxsystems/ordax-surface",
      "owns": [
        "surface-visual-shell",
        "surface-workspace-ui",
        "surface-presentation-assets"
      ],
      "must_not_own": [
        "native-os-host",
        "kernel-boot-base",
        "system-capability-authority",
        "product-grants",
        "native-composition",
        "physical-release-activation"
      ]
    },
    "apps": {
      "repo": "ordaxsystems/ordax-apps",
      "owns": [
        "first-party-app-source",
        "studio-portable-source",
        "app-ui-core",
        "app-assets-i18n-tests"
      ],
      "must_not_own": [
        "identity",
        "global-memory-authority",
        "platform-grants",
        "windows-device-host",
        "computer-control-authority",
        "oauth-remote",
        "control-plane",
        "mcp-system-authority",
        "windows-mcp-installer"
      ]
    },
    "runtime": {
      "repo": "ordaxsystems/ordax-runtime",
      "owns": [
        "windows-ordax-runtime",
        "windows-ordax-mcp-distribution",
        "device-host",
        "computer-control",
        "filesystem-process-input-screenshot-app-launch",
        "windows-host-lifecycle",
        "local-policy-enforcement",
        "runtime-owned-adapters"
      ],
      "must_not_own": [
        "studio-portable-source",
        "product-mcp-remote",
        "oauth-remote",
        "platform-structural-services"
      ]
    },
    "control_plane": {
      "repo": "ordaxsystems/ordax-platform",
      "owns": [
        "product-mcp",
        "cloudflare-control-plane",
        "remote-oauth",
        "product-grants",
        "remote-queue-request-receipt-audit",
        "ordax-for-chatgpt",
        "provider-connectors"
      ],
      "must_not_own": [
        "studio-portable-source",
        "local-computer-control",
        "windows-device-host",
        "ordax-os-structural-services"
      ]
    },
    "public_site": {
      "repo": "ordaxsystems/ordax-site",
      "owns": [
        "public-marketing-presentation",
        "public-legal-pages-presentation",
        "public-identity-account-presentation",
        "public-download-catalog-presentation",
        "public-site-static-build-and-i18n"
      ],
      "must_not_own": [
        "identity-backend",
        "account-authorization",
        "release-publisher-authority",
        "payments-and-billing",
        "surface-shared-source",
        "os-host",
        "dns-and-domain-routing"
      ]
    },
    "creator": {
      "repo": "ordaxsystems/ordax-creator",
      "owns": [
        "creator-standalone-application-source",
        "creator-media-verification-core",
        "creator-windows-ui-and-host-adapters",
        "creator-signed-channel-consumer"
      ],
      "must_not_own": [
        "kernel-boot-base",
        "os-media-proof-producers",
        "os-release-and-signing-authority",
        "physical-write-authorization",
        "native-os-host",
        "desktop-windows-shell"
      ]
    }
  },
  "legacy": {
    "repo": "washingtonmsdj/mcp-blender",
    "role": "incubation-legacy-retirement-only",
    "new_features_allowed": false,
    "delete_only_after": [
      "studio-canonical-in-ordax-apps",
      "runtime-canonical-in-ordax-runtime",
      "control-plane-canonical-in-ordax-control-plane",
      "production-and-windows-packaging-repointed",
      "chatgpt-control-plane-runtime-e2e-green",
      "no-functional-build-deploy-launch-reference"
    ]
  },
  "invariants": {
    "single_canonical_owner_per_responsibility": true,
    "provider_identity_is_not_authority": true,
    "context_does_not_expand_authority": true,
    "raw_generic_shell_is_not_product_api": true,
    "typed_auditable_capabilities": true,
    "public_versioned_cross_repo_contracts": true,
    "migration_residue_may_not_become_second_ssot": true,
    "mcp_is_system_wide_capability_not_an_app": true,
    "native_os_permissions_owned_by_platform_not_studio": true,
    "apps_consume_capability_ports_without_grant_minting": true,
    "remote_mcp_grants_remain_control_plane_owned": true,
    "windows_studio_is_optional_runtime_consumer": true,
    "windows_mcp_distribution_independent_of_studio": true
  },
  "namespace_migration": {
    "status": "complete",
    "current_namespace": "ordaxsystems",
    "target_namespace": "ordaxsystems",
    "repository_name_changes_during_transfer": false,
    "redirect_dependency_allowed": false,
    "mirror_repository_allowed": false,
    "dual_authority_allowed": false,
    "provenance_rewrite_allowed": false,
    "canonical_targets": {
      "platform": "ordaxsystems/ordax-os",
      "apps": "ordaxsystems/ordax-apps",
      "runtime": "ordaxsystems/ordax-runtime",
      "control_plane": "ordaxsystems/ordax-platform"
    },
    "cutover_order": [
      "runtime",
      "apps",
      "control_plane",
      "platform"
    ],
    "completed_transfers": [
      "runtime",
      "apps",
      "control_plane",
      "platform"
    ],
    "transfer_policy": "transfer-one-repository-then-repoint-and-verify-before-next"
  }
}
