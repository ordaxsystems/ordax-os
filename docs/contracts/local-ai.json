{
  "$schema": "prototype-ordax.local-ai/1",
  "status": "mvp-required-local-inference-foundation",
  "product_scope": "stable-mvp-usb",
  "required_for_boot": false,
  "required_for_offline_use": false,
  "required_for_stable_mvp_distribution": true,
  "default_creator_selection": "included-by-product-policy",
  "creator_toggle": {
    "label_pt_BR": "Incluir IA local",
    "label_en_US": "Include local AI",
    "label_es_ES": "Incluir IA local",
    "user_may_disable": false,
    "exposed_as_install_omission_toggle": false,
    "model_or_engine_may_change_after_install": true,
    "must_not_change_core_os_layout": true,
    "reason": "local inference is part of the Stable/MVP product; model and engine evolution are separate from omitting system Intelligence"
  },
  "runtime": {
    "engine_boundary": "OpenAI-compatible loopback HTTP",
    "listen_scope": "127.0.0.1-only",
    "client_endpoint_policy": "literal-http-127.0.0.1-or-exact-native-same-origin-bridge",
    "native_same_origin_endpoint": "/__ordax/native/local-ai",
    "native_bridge_paths": [
      "GET /health",
      "GET /v1/models",
      "POST /v1/chat/completions"
    ],
    "native_bridge_host_origin_restriction": true,
    "native_bridge_not_a_local_process_authentication_boundary": true,
    "stable_ephemeral_inference_key_required": true,
    "stable_inference_key_file": "/run/ordax/local-ai-auth/key",
    "stable_inference_key_file_mode": "0600",
    "stable_inference_key_source": "kernel-urandom-during-stable-base-boot",
    "stable_inference_auth_backend": "pinned-llama.cpp-LLAMA_ARG_API_KEY_FILE",
    "stable_inference_key_exposed_to_surface": false,
    "stable_inference_key_persisted": false,
    "stable_inference_key_fails_soft_on_unavailability": true,
    "internet_required_for_inference": false,
    "engine_migratable": true,
    "model_migratable": true,
    "engine_default": "llama.cpp",
    "engine_owner_upstream": "ggml-org/llama.cpp",
    "model_format": "GGUF",
    "model_default_candidate": "Qwen3.5-0.8B-Q4_0",
    "model_license_candidate": "Apache-2.0",
    "exact_model_artifact_pinned": true,
    "exact_engine_artifact_pinned": true,
    "source_lock": "system/services/local-ai/source-lock.json",
    "artifact_activation_gate": "signed-release-manifest-v4-with-sha256-size-license-source-and-model-binding",
    "engine_id_max_chars": 80,
    "model_discovery_id_max_chars": 160,
    "configured_identity_validated_before_network": true,
    "available_states_require_complete_identity": true,
    "configured_model_id_remains_fixed": true,
    "dynamic_model_is_rediscovered_on_each_probe": true,
    "dynamic_model_discovery_requires_exactly_one_model": true,
    "dynamic_model_is_rediscovered_after_inference_failure": true,
    "failed_generation_is_not_silently_retried_after_rediscovery": true,
    "malformed_model_discovery_fails_closed": true,
    "max_system_prompt_chars": 8192,
    "max_user_prompt_chars": 32768,
    "max_output_tokens": 2048,
    "max_model_discovery_response_bytes": 262144,
    "max_completion_response_bytes": 1048576,
    "production_json_response_requires_bounded_stream": true,
    "response_body_timeout_covers_stream_consumption": true,
    "unused_health_response_body_is_cancelled": true,
    "non_ok_json_response_body_is_cancelled": true,
    "max_completion_chars": 131072,
    "completion_nul_allowed": false,
    "completion_reported_model_id_must_match_when_present": true,
    "stale_probe_may_override_newer_activity": false,
    "newest_concurrent_probe_owns_probe_state": true,
    "hardware_probe_runtime_owner": "bootstrap/stable-base/ordax-stable-init",
    "hardware_probe_runtime_language": "posix-shell-busybox-compatible",
    "hardware_probe_before_backend_exec": true,
    "hardware_probe_current_start_blocker": "runtime-artifact-architecture-mismatch",
    "hardware_probe_required_architecture": "x86_64",
    "hardware_probe_cpu_and_memory_are_observational_only": true,
    "hardware_probe_adds_runtime_dependency": false,
    "hardware_probe_failure_degrades_local_ai_only": true
  },
  "storage": {
    "release_artifact_name": "local-ai-runtime.erofs",
    "content_addressed_media_root": "/.ordax/ai-runtimes/sha256",
    "verified_mount_root": "/run/ordax/runtime/local-ai",
    "user_data_root": "/var/lib/ordax/local-ai",
    "model_must_not_live_in_system_erofs": true,
    "mutable_user_state_must_not_live_in_ai_erofs": true,
    "removal_preserves_user_files": true
  },
  "migration": {
    "stable_service_contract": "ordax.local-ai/1",
    "system_intelligence_contract": "ordax.intelligence/1",
    "provider_specific_ui_allowed": false,
    "model_id_persisted_separately_from_engine_id": true,
    "engine_swap_requires_surface_changes": false,
    "model_swap_requires_surface_changes": false,
    "future_backends": [
      "llama.cpp",
      "OpenVINO",
      "other-local-provider"
    ],
    "mvp_delivery": "whole-os-signed-release-artifact",
    "future_independent_delivery": "component-slot-after-canonical-component-trust-and-health-rollback-are-proven"
  },
  "privacy": {
    "prompts_local_by_default": true,
    "cloud_fallback_implicit": false,
    "file_access_implicit": false,
    "tool_execution_implicit": false,
    "telemetry_prompt_content_allowed": false
  },
  "mvp_policy": {
    "recommended": true,
    "mandatory": true,
    "mandatory_scope": "stable-mvp-distribution-not-boot",
    "small_model_first": true,
    "hardware_probe_before_start": true,
    "failure_must_not_block_surface": true
  },
  "inference_transport_cancel": {
    "source": "system/services/local-ai/runtime.mjs",
    "optional_abort_signal": "generate(request, { signal })",
    "scope": "active-inference-http-only",
    "cancel_other_operations": false,
    "server_engine_abort_proven": false,
    "late_completions_discarded": true
  },
  "streaming_transport": {
    "implementation": "system/services/local-ai/completion-stream.mjs",
    "api": "generate(request, { onDelta, signal })",
    "backend_protocol": "OpenAI-compatible text/event-stream",
    "enabled_only_if_on_delta_requested": true,
    "default_inference_remains_buffered": true,
    "max_sse_response_bytes": 1048576,
    "max_sse_events": 16384,
    "max_accumulated_text_chars": 131072,
    "requires_final_finish_reason_and_done": true,
    "validates_reported_model_identity": true,
    "callback_deltas_are_provisional": true,
    "conversation_streaming_exposed": false,
    "engine_streaming_hardware_proven": false
  }
}
