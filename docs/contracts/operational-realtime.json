{
  "$schema": "prototype-ordax.operational-realtime/1",
  "status": "pre-mvp-contract-foundation-runtime-post-mvp",
  "purpose": "separate live business/device operations from account synchronization while preserving one OrdaX identity and authorization model",
  "owners": {
    "operational_domain": "future system/services/operations",
    "account_and_spaces": "system/services/account + system/services/spaces",
    "sync": "system/services/sync",
    "notifications": "system/services/notifications",
    "device_actions": "OrdaX Action Gateway + system/services/device-agent",
    "platform_delivery": "system/adapters"
  },
  "separation": {
    "account_sync_is_operational_event_stream": false,
    "operational_event_stream_is_source_of_truth": false,
    "notifications_are_authority": false,
    "push_notification_is_command_transport": false,
    "device_action_request_is_authorization": false,
    "device_action_grant_is_separate": true
  },
  "schemas": {
    "event": "ordax.operational-event/1",
    "subscription": "ordax.operational-subscription/1",
    "device_action_request": "ordax.device-action-request/1",
    "device_action_receipt": "ordax.device-action-receipt/1",
    "device_capability_grant": "ordax.device-agent/1",
    "notification": "ordax.notifications/3"
  },
  "event_model": {
    "server_authoritative_sequence": true,
    "stable_aggregate_identity": true,
    "aggregate_revision_required": true,
    "client_wall_clock_is_ordering_authority": false,
    "space_scope_required": true,
    "project_scope_optional_for_events": true,
    "credential_fields_forbidden_in_payload": true,
    "resume_after_sequence_supported": true,
    "full_state_reconciliation_required_after_gap": true
  },
  "device_actions": {
    "same_action_gateway_for_web_mobile_desktop_native_and_mcp": true,
    "generic_shell": false,
    "raw_disk": false,
    "release_signing_keys": false,
    "write_requires_explicit_grant": true,
    "idempotency_key_required": true,
    "request_expiry_required": true,
    "audit_required": true,
    "receipt_required": true,
    "device_offline_is_not_success": true,
    "current_v1_project_scope_required": true,
    "future_space_only_device_grants_require_versioned_contract": true
  },
  "notifications": {
    "derived_from_domain_or_device_state": true,
    "does_not_replace_canonical_state": true,
    "does_not_grant_action_authority": true,
    "mobile_push_is_future_adapter_delivery": true,
    "web_delivery_is_future_adapter_delivery": true
  },
  "examples": {
    "pizzaria": {
      "domains": [
        "business.orders",
        "business.production"
      ],
      "examples": [
        "order.created",
        "order.state-changed",
        "production.queue-changed"
      ],
      "independence": {
        "orders_live_in_cloud_not_merchant_notebook": true,
        "merchant_phone_web_tablet_can_operate_independently": true,
        "local_edge_optional_for_pos_kitchen_printer_and_other_equipment": true
      }
    },
    "impressao_3d": {
      "domains": [
        "fabrication.jobs",
        "device.telemetry"
      ],
      "examples": [
        "print.started",
        "print.progress",
        "print.failed",
        "print.completed"
      ],
      "future_actions": [
        "printer.job.pause",
        "printer.job.cancel"
      ],
      "independence": {
        "prefer_device_durable_job_storage_when_supported": true,
        "dedicated_edge_for_host_dependent_printers": true,
        "user_notebook_required_to_remain_on": false,
        "power_loss_recovery_depends_on_device_or_power_hardware": true
      }
    }
  },
  "mvp_boundary": {
    "blocks_first_usb": false,
    "runtime_backend_required_before_first_usb": false,
    "apk_required_before_first_usb": false,
    "web_public_rollout_required_before_first_usb": false,
    "source_contract_foundation_allowed": true
  },
  "promotion_gates": [
    "real public account and Space authorization",
    "server-authoritative operational persistence per domain",
    "realtime transport with reconnect and gap recovery",
    "audited Action Gateway",
    "product Device Agent credentials separate from engineering",
    "mobile/web notification adapters",
    "two-client realtime proof",
    "offline/reconnect proof",
    "device-action idempotency and stale-state proof",
    "user-visible action audit"
  ],
  "availability_model": {
    "user_notebook_required_for_service_continuity": false,
    "desktop_app_required_for_service_continuity": false,
    "canonical_cloud_state_survives_client_shutdown": true,
    "supported_topologies": [
      "cloud-authoritative",
      "device-native",
      "dedicated-edge",
      "client-hosted-development-or-convenience"
    ],
    "professional_continuity_may_depend_on_client_hosted_topology": false,
    "edge_outbound_authenticated_connection_preferred": true,
    "power_loss_is_solved_by_software": false,
    "ups_or_device_power_recovery_is_optional_hardware_capability": true,
    "stale_dangerous_actions_replayed_blindly_after_reconnect": false
  },
  "edge_runtime": {
    "status": "source-architecture-only-runtime-disabled",
    "user_facing_product_mode": false,
    "reuses_device_agent_capability_model": true,
    "may_run_on_device_when_supported": true,
    "may_run_on_dedicated_low_power_host": true,
    "may_run_on_compatible_nas_or_server": true,
    "desktop_usb_native_host_allowed_for_development_or_convenience": true,
    "desktop_usb_native_host_required_for_production": false,
    "responsibilities": [
      "device-capability-discovery",
      "bounded-local-state",
      "reconnect-reconciliation",
      "telemetry-publication",
      "typed-action-execution",
      "action-receipts-and-audit",
      "narrow-local-device-adapters"
    ],
    "forbidden_authority": [
      "account-authority",
      "space-membership-authority",
      "billing-authority",
      "global-business-policy",
      "generic-remote-shell",
      "raw-disk",
      "release-signing-key"
    ]
  }
}
