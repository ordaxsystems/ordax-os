{
  "$schema": "prototype-ordax.personal-ordax/1",
  "status": "native-foreground-runtime-bounded-action-enabled-public-autonomy-disabled",
  "product_role": "identity-bound personal orchestration above Intelligence and shared services",
  "principles": {
    "one_primary_personal_ordax_per_owner_context": true,
    "personal_ordax_is_not_a_new_privilege_authority": true,
    "personal_ordax_is_not_an_inference_provider": true,
    "personal_ordax_is_not_a_platform_adapter": true,
    "personal_ordax_is_not_a_second_workspace": true,
    "memory_remains_owned_by_ordax": true,
    "spaces_and_projects_remain_context_owners": true,
    "prompt_model_profile_and_memory_content_create_authority": false,
    "activity_is_user_visible": true,
    "sensitive_actions_require_existing_grants": true,
    "fail_closed_on_missing_authority": true,
    "single_codebase_across_product_modes": true
  },
  "composition": {
    "inputs": [
      "identity-session",
      "workspace/projects",
      "space-selection",
      "ordax.memory-context-auth/1",
      "ordax.intelligence/1",
      "ordax.intelligence-tool-grant/1",
      "device-capability-grant",
      "action-gateway",
      "ordax.action-gateway/1",
      "ordax.intelligence-tool-grant-registry/1",
      "ordax.intelligence-tool-grant-issuer/1",
      "ordax.action-executor/1"
    ],
    "outputs": [
      "ordax.personal-work-item/1",
      "ordax.personal-activity/1",
      "ordax.personal-action-decision/1",
      "ordax.personal-work-result/1",
      "ordax.personal-approval/1",
      "ordax.personal-approval-consent/1",
      "ordax.personal-action-proposal/1"
    ],
    "direct_platform_adapter_imports_allowed": false,
    "direct_provider_sdk_imports_allowed": false,
    "direct_database_row_contracts_allowed": false
  },
  "work_model": {
    "states": [
      "queued",
      "running",
      "waiting-approval",
      "paused",
      "completed",
      "failed",
      "cancelled"
    ],
    "work_is_bound_to_explicit_owner": true,
    "space_and_project_are_optional_explicit_scopes": true,
    "implicit_current_space_allowed": false,
    "implicit_current_project_allowed": false,
    "background_execution_enabled": false,
    "multi_agent_coordination_enabled": false,
    "cloud_computer_enabled": false,
    "owner_partitioned_persistence": true,
    "completed_reasoning_result_persisted_atomically": true,
    "result_carries_action_authority": false,
    "owner_partition_max_serialized_bytes": 4194304,
    "byte_ceiling_applies_after_semantic_validation": true,
    "native_device_store_source_enabled": true,
    "native_device_store_backend": "privileged-surface-local-storage",
    "native_device_store_mounted_in_composition": true,
    "corrupt_owner_partition_may_be_silently_overwritten": false,
    "corrupt_owner_partition_blocks_only_that_owner": true,
    "account_sync_of_personal_work_enabled": false,
    "explicit_work_entry_enabled": true,
    "assistant_messages_auto_create_work": false,
    "durable_pause_resume_enabled": true,
    "interrupted_action_restore_pauses_without_replay": true,
    "activity_retention_bounded_by_owner_partition": true,
    "activity_terminal_delete_supported": true,
    "activity_history_export_source_enabled": true,
    "activity_history_export_native_enabled": true,
    "activity_history_export_web_enabled": false,
    "activity_history_export_requires_explicit_user_action": true,
    "activity_history_export_reimportable_as_authority": false,
    "activity_history_export_strips_grant_refs": true
  },
  "authority": {
    "effects": [
      "read",
      "write",
      "external-egress",
      "device-control"
    ],
    "decisions": [
      "allow",
      "approval-required",
      "deny"
    ],
    "sensitive_effects": [
      "write",
      "external-egress",
      "device-control"
    ],
    "sensitive_allow_requires_explicit_grant_reference": true,
    "system_policy_may_default_allow_sensitive_effects": false,
    "forbidden_authority_sources": [
      "prompt",
      "model",
      "profile",
      "profile-pack",
      "memory",
      "project-content"
    ],
    "existing_grant_contracts_are_reused": true,
    "generic_shell_allowed": false,
    "raw_disk_allowed": false,
    "release_key_access_allowed": false,
    "physical_write_authorization_allowed": false,
    "action_gateway_source_enabled": true,
    "action_gateway_executes_side_effects": false,
    "exact_owner_space_project_tool_action_scope_required": true,
    "expired_or_invalid_grant": "deny",
    "device_and_account_owner_semantics_are_canonical": true,
    "intelligence_tool_grant_authorizes_effects": [
      "read",
      "write"
    ],
    "intelligence_tool_grant_authorizes_external_egress": false,
    "intelligence_tool_grant_authorizes_device_control": false,
    "intelligence_tool_grant_registry_source_enabled": true,
    "intelligence_tool_grant_registry_scope": "session",
    "intelligence_tool_grant_issuer_source_enabled": true,
    "intelligence_tool_grant_issuer_exposed_to_personal_runtime": false,
    "intelligence_tool_grant_issuer_requires_explicit_user_approval": true,
    "intelligence_tool_grant_initial_max_ttl_ms": 300000,
    "native_action_gateway_uses_canonical_grant_registry": true,
    "action_executor_contract_source_enabled": true,
    "action_executor_implementation_enabled": true,
    "trusted_human_consent_controller_source_enabled": true,
    "trusted_human_consent_controller_exposes_grant_issuer": false,
    "activity_explicit_approval_controls_enabled": true,
    "user_denial_audited_through_action_gateway": true,
    "grant_revoked_if_approval_resolution_fails": true,
    "consent_tool_grant_effects": [
      "read",
      "write"
    ],
    "consent_tool_grant_default_ttl_ms": 120000,
    "approve_control_requires_resolvable_typed_action": true,
    "native_registered_tool_actions_enabled": true,
    "sensitive_approval_requires_resource_ref": true,
    "tool_grant_binds_approval_id": true,
    "tool_grant_binds_resource_ref": true,
    "action_gateway_revalidates_approval_resource_scope": true,
    "action_executor_revalidates_authority_immediately_before_adapter": true,
    "action_receipt_contract_enabled": true,
    "runtime_reconstructs_execution_from_retained_approval": true,
    "caller_supplied_execution_resource_authoritative": false,
    "sensitive_approval_binds_tool_artifact_sha256": true,
    "tool_grant_binds_tool_artifact_sha256": true,
    "action_gateway_revalidates_tool_artifact_sha256": true,
    "action_executor_revalidates_adapter_artifact_sha256": true,
    "native_tool_artifact_identity_from_same_origin_bytes": true,
    "native_file_ensure_directory_tool_registered_for_approval": true,
    "native_file_ensure_directory_idempotent": true,
    "foreground_action_lifecycle_enabled": true,
    "approval_executed_state_persisted": true,
    "approval_replay_blocked_after_succeeded_receipt": true,
    "failed_receipt_consumes_approval": false,
    "failed_action_keeps_approval_for_explicit_idempotent_retry": true,
    "tool_grant_binds_work_item_id": true,
    "action_gateway_revalidates_work_item_id": true,
    "approved_actions_serialized_per_work": true,
    "work_cancel_revokes_live_approved_grant": true,
    "revoked_approval_retained_for_audit": true,
    "first_native_foreground_action_enabled": true,
    "canonical_action_catalog_enabled": true,
    "activity_owns_action_registry": false,
    "action_catalog_creates_authority": false,
    "action_catalog_requests_explicit_approval": true,
    "action_decision_binds_approval_id": true,
    "repeated_action_types_require_distinct_approval_ids": true,
    "action_gateway_requires_grant_revoker": true,
    "owner_switch_revokes_approved_grants": true,
    "space_invalidation_revokes_approved_grants": true,
    "project_invalidation_revokes_approved_grants": true,
    "paused_work_context_invalidation_revokes_approved_grants": true,
    "work_cancel_revocation_owned_by_runtime": true,
    "native_restore_revokes_missing_session_grants": true,
    "approved_action_ui_requires_live_grant_when_grant_ref_exists": true,
    "action_proposal_contract_enabled": true,
    "action_proposal_authority": "none",
    "action_proposal_catalog_entry_required": true,
    "action_proposal_validates_resource_without_exposing_canonical_ref": true,
    "action_proposal_may_carry_tool_id": false,
    "action_proposal_may_carry_action_id": false,
    "action_proposal_may_carry_grant_ref": false,
    "action_proposal_may_carry_approval_id": false,
    "action_proposal_may_request_approval": false,
    "action_proposal_may_authorize_execution": false,
    "model_proposal_creates_authority": false,
    "model_proposal_catalog_revalidation_required": true,
    "model_proposal_owner_revalidated_after_inference": true,
    "model_proposal_conversion_recanonicalizes_resource": true,
    "model_proposal_runtime_local_binding_required": true,
    "model_proposal_clone_or_serialized_reuse_allowed": false,
    "model_proposal_exact_work_revision_required": true,
    "model_proposal_cross_owner_reuse_allowed": false
  },
  "activity": {
    "ordered_sequence_required": true,
    "approval_events_reference_approval_ids": true,
    "action_events_reference_action_ids": true,
    "artifact_references_preferred_over_raw_payloads": true,
    "activity_view_runtime_enabled": true,
    "completed_result_reference_required_for_new_runtime_results": true,
    "result_payload_stored_outside_activity_summary": true,
    "activity_view_owns_persistence": false,
    "approval_state_persisted": true,
    "pending_approval_requires_waiting_work": true,
    "resolved_approval_requires_audit_activity": true,
    "approved_action_requires_matching_allow_decision": true,
    "denied_action_requires_matching_deny_decision": true,
    "native_activity_surface_enabled": true,
    "explicit_pause_resume_controls_enabled": true,
    "explicit_cancel_remove_controls_enabled": true
  },
  "mvp": {
    "public_mvp_enabled": false,
    "foundation_contract_enabled": true,
    "existing_consultative_intelligence_unchanged": true,
    "existing_memory_spaces_profiles_projects_reused": true,
    "background_agent_runtime_enabled": false,
    "proactive_research_enabled": false,
    "external_app_connectors_enabled": false,
    "specialist_agents_enabled": false,
    "personal_foreground_runtime_source_enabled": true,
    "personal_foreground_runtime_mounted_in_surface": true,
    "approval_lifecycle_source_enabled": true,
    "action_execution_enabled": true,
    "approval_consent_surface_enabled": true,
    "authorized_side_effects_enabled": true,
    "authorized_side_effects_scope": [
      "ordax-native-file-space/files.directory.ensure"
    ],
    "background_execution_enabled": false,
    "action_catalog_entries": [
      "native-file.ensure-directory"
    ],
    "model_generated_action_proposals_enabled": true,
    "automatic_side_effect_retry": false,
    "non_idempotent_file_mutations_enabled": false,
    "foreground_action_execution_enabled": true,
    "generic_action_execution_enabled": false,
    "autonomous_action_execution_enabled": false,
    "public_stable_personal_autonomy_enabled": false,
    "action_proposal_source_enabled": true,
    "action_proposal_native_composition_port_enabled": true,
    "automatic_proposal_to_approval_enabled": false,
    "automatic_proposal_execution_enabled": false,
    "model_proposal_generation_requires_explicit_user_action": true,
    "model_proposal_catalog_projection": "entryId+inputKind+resourceScheme-only",
    "model_proposal_exposes_tool_identity": false,
    "model_proposal_exposes_grants": false,
    "model_proposal_to_approval_requires_explicit_user_action": true,
    "model_proposal_rationale_becomes_approval_reason": false
  },
  "evolution": {
    "phase_1": "identity-bound work + visible activity + approval decisions",
    "phase_2": "bounded background execution + resumable work + selected connectors",
    "phase_3": "specialist workers coordinated by the same personal authority boundary",
    "phase_4": "hybrid local/cloud execution selected by capability, privacy, cost and availability",
    "new_execution_modes_must_reuse_same_contracts": true,
    "new_agents_must_not_create_parallel_memory_or_permission_systems": true,
    "phase_1_status": "implemented-native-foreground",
    "phase_2_status": "partial-durable-resume-complete-background-connectors-pending",
    "phase_3_status": "not-started",
    "phase_4_status": "not-started",
    "next_foreground_gate": "semantic Work recovery from explicit user requests without implicit owner/Space/project rebinding"
  },
  "action_execution": {
    "attempt_schema": "ordax.personal-action-attempt/1",
    "durable_attempt_journal": true,
    "attempt_persisted_before_adapter_entry": true,
    "exact_decision_approval_binding": true,
    "pre_side_effect_failure_retryable_with_same_approval": true,
    "adapter_entered_failure_outcome": "uncertain",
    "interrupted_started_attempt_restore_outcome": "uncertain",
    "uncertain_attempt_revokes_grant": true,
    "uncertain_attempt_pauses_work": true,
    "automatic_uncertain_replay": false,
    "max_attempts_per_owner": 128
  },
  "activity_export": {
    "schema": "ordax.personal-activity-export/1",
    "port_schema": "ordax.personal-activity-export-port/1",
    "native_directory": "/Downloads",
    "media_type": "application/json",
    "owner_partition_only": true,
    "includes": [
      "work-items",
      "activity-events",
      "results",
      "approvals",
      "decisions",
      "attempts"
    ],
    "excludes": [
      "next-ordinal",
      "grant-ref-replay-authority"
    ],
    "authority_replayable": false,
    "account_sync": false,
    "automatic_export": false
  }
}
