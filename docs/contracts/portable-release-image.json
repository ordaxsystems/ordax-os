{
  "$schema": "prototype-ordax.portable-release-image/1",
  "status": "candidate-proof-only",
  "product_scope": "mvp-portable-usb-v2",
  "source_policy_owner": "tools/release-bundle",
  "source_artifact": {
    "name": "system.tar",
    "role": "normalized-system-tree-staging",
    "must_be_deterministic": true,
    "release_protocol_v1_signed_artifact_unchanged": true
  },
  "output": {
    "name": "system.erofs",
    "filesystem": "erofs",
    "volume_label": "ORDAX-SYSTEM",
    "compression": "lz4",
    "timestamp": 0,
    "all_files_owned_by_root": true,
    "read_only": true,
    "byte_reproducible_required": true,
    "filesystem_uuid_policy": "uuidv5-fixed-namespace-over-system-tar-sha256",
    "filesystem_uuid_namespace": "7a471b52-6f72-5d61-9f58-2fb58012e6d1",
    "filesystem_uuid_release_unique": true
  },
  "builder": {
    "path": "tools/portable-release-image/build.py",
    "mkfs_tool": "mkfs.erofs",
    "fsck_tool": "fsck.erofs",
    "source_mode": "--tar=f",
    "fixed_timestamp": "-T 0",
    "fixed_uuid": false,
    "all_root": "--all-root",
    "deterministic_uuid_from_source_hash": true
  },
  "integration": {
    "release_protocol_v1_changed": false,
    "manifest_v2_implemented": true,
    "acquisition_agent_v2_implemented": true,
    "portable_boot_handoff_connected": false,
    "public_signed_publication_enabled": false,
    "physical_write_authorized": false,
    "signer_v2_implemented": true,
    "portable_materialization_implemented": true,
    "portable_activation_implemented": false,
    "offline_exact_verification_implemented": true
  },
  "fail_closed": [
    "reject-non-regular-or-symlink-system-tar",
    "reject-non-normalized-tar-metadata",
    "reject-links-devices-and-special-tar-members",
    "reject-missing-or-non-executable-system-entrypoint",
    "reject-existing-output",
    "reject-output-inside-source-directory",
    "verify-erofs-integrity-after-build",
    "never-treat-candidate-image-as-release-protocol-v1-artifact",
    "never-authorize-physical-write",
    "portable-v2-materialization-must-not-create-current-activation-pointer",
    "legacy-materialize-and-activate-exact-must-reject-portable-v2"
  ],
  "external_intelligence_candidate": {
    "owner": "ordaxsystems/ordax-intelligence",
    "lock": "docs/contracts/intelligence-source.json",
    "source_action": ".github/actions/assemble-intelligence",
    "preceded_by": "verified-pinned-surface",
    "required_in_portable_v2_ci": true,
    "legacy_engine_source_in_image_allowed": false,
    "model_included_in_source": false,
    "device_activation_authorized": false
  }
}
