{
  "$schema": "prototype-ordax.build-autonomy/2",
  "status": "canonical-prototype-contract",
  "source_authority": {
    "repository": "ordaxsystems/ordax-os",
    "branch": "main"
  },
  "required_independence": {
    "codex_required": false,
    "developer_local_toolchain_required": false,
    "wsl_required": false,
    "qemu_required": false,
    "manual_kernel_build_required": false,
    "specific_developer_host_os_required": false
  },
  "canonical_build": {
    "repository_recipe_required": true,
    "ci_build_required": true,
    "pinned_build_environment_required": true,
    "immutable_environment_identity_required": true,
    "upstream_source_hash_verification_required": true,
    "artifact_sha256_required": true,
    "artifact_provenance_required": true,
    "github_actions_is_current_executor_not_source_authority": true,
    "portable_build_entrypoint_required": true
  },
  "kernel": {
    "source_contract": "bootstrap/kernel/source.json",
    "canonical_config_required": true,
    "pinned_toolchain_required": true,
    "ci_compilation_required": true,
    "developer_machine_compilation_required": false,
    "provenance_manifest_required": true
  },
  "artifact_graph": {
    "independent_artifact_classes": [
      "kernel",
      "initramfs",
      "minimal-bootstrap",
      "shared-system-bundle",
      "public-site",
      "web-client",
      "mobile-client",
      "desktop-client",
      "native-system-release",
      "creator",
      "manifests"
    ],
    "surface_change_rebuilds_kernel": false,
    "kernel_change_rebuilds_unrelated_surface": false,
    "kernel_change_rebuilds_client_modes": false,
    "mode_adapter_change_rebuilds_unrelated_modes": false,
    "creator_change_rebuilds_kernel": false,
    "bootstrap_change_rebuilds_client_modes": false,
    "shared_surface_change_may_rebuild_all_applicable_product_modes": true,
    "shared_contract_change_runs_cross_mode_validation": true,
    "affected_build_selection_must_be_dependency_driven": true,
    "ci_path_filters_are_optimization_not_dependency_authority": true,
    "public_site_change_rebuilds_kernel": false,
    "public_site_change_rebuilds_system": false,
    "public_site_change_rebuilds_client_modes": false
  },
  "target_relationships": {
    "web-client": [
      "shared-system-bundle"
    ],
    "mobile-client": [
      "shared-system-bundle"
    ],
    "desktop-client": [
      "shared-system-bundle"
    ],
    "native-system-release": [
      "shared-system-bundle"
    ],
    "minimal-bootstrap": [
      "kernel",
      "initramfs"
    ],
    "creator": [
      "minimal-bootstrap",
      "manifests"
    ]
  },
  "graph_rules": {
    "dependency_cycle_allowed": false,
    "unrelated_rebuild_is_architectural_regression": true,
    "missing_required_dependency_build_is_architectural_regression": true,
    "new_product_mode_requires_explicit_artifact_class_or_documented_shared_target": true,
    "new_artifact_class_requires_provenance_owner": true,
    "build_cache_may_accelerate_but_may_not_replace_verification": true
  },
  "physical_boundary": {
    "creator_consumes_prebuilt_verified_artifacts": true,
    "end_user_compiles_kernel": false,
    "physical_action_requires_authorized_local_execution": true
  },
  "ai_operating_model": {
    "any_repository_agent_may_edit_source": true,
    "any_repository_agent_may_fix_ci": true,
    "codex_is_optional_partner": true,
    "codex_is_release_authority": false,
    "codex_is_build_authority": false
  },
  "native_system_release": {
    "assembly_recipe": "tools/native-release-assembly/build.py",
    "assembly_contract": "docs/contracts/native-release-assembly.json",
    "shared_system_source": "system/",
    "native_helper_source": [
      "docs/contracts/native-release-assembly.json#creator_source",
      "tools/runtime-component-channel/"
    ],
    "helper_built_by_ci": true,
    "helper_compiled_on_end_user_device": false,
    "helper_covered_by_signed_system_tar": true,
    "final_bundle_owner": "tools/release-bundle",
    "separate_helper_release_channel": false,
    "helper_outputs": [
      "system/bin/ordax-native-install-targets",
      "system/bin/ordax-runtime-component-channel"
    ],
    "component_helper_publish_authorized": false,
    "creator_source_owner": "ordaxsystems/ordax-creator"
  },
  "client_build_independence": {
    "desktop-client": {
      "requires_creator": false,
      "requires_usb_producer": false,
      "producer": "tools/windows-desktop/",
      "validation_owner": "Windows Desktop Dev (SSOT)"
    },
    "web-client": {
      "requires_creator": false,
      "requires_usb_producer": false,
      "producer": "system/composition/web/",
      "validation_owner": "Surface Web Candidate"
    },
    "client_only_source_prefixes": [
      "system/adapters/desktop/",
      "system/composition/web/",
      "tools/windows-desktop/",
      "tools/windows-emulator/"
    ],
    "shared_native_changes_require_usb_proof": true,
    "unknown_owner_changes_fail_closed": true,
    "identity_and_shared_contracts_remain_cross_mode": true,
    "ci_path_filters_not_authority": true,
    "separation_roadmap": "REMOVER-DEPENDENCIA.md",
    "client_validation_workflows": {
      "desktop-client": ".github/workflows/windows-desktop-dev.yml",
      "web-client": ".github/workflows/surface-web-candidate.yml"
    },
    "windows_package_forbidden_linux_boot_paths": [
      "entrypoint",
      "supervisor",
      "surface/entrypoint",
      "surface/bin/ordax-surface"
    ],
    "client_delivery_gate_decoupling_fully_proven": false,
    "windows_physical_and_web_live_independence_proven": false,
    "windows_package_forbidden_linux_shell_paths": [
      "rescue/agent.sh",
      "services/base-update/agent.sh",
      "services/base-update/dev-helpers.sh",
      "services/device-agent/native-product-lifecycle.sh",
      "services/device-agent/product-presence-report.sh",
      "services/intelligence-source/owner-stage.sh",
      "services/local-ai/owner-dev-runtime.sh",
      "services/local-ai/run-low-priority.sh",
      "services/power/acpi-button-action.sh",
      "services/surface-source/owner-stage.sh",
      "services/telemetry/base-agent.sh",
      "services/update/owner-signed-preview.sh",
      "surface/bin/ordax-ata-evidence",
      "surface/bin/ordax-internet-proof",
      "surface/bin/ordax-kernel-log-evidence",
      "surface/bin/ordax-mvp-smoke",
      "surface/bin/ordax-performance-evidence",
      "surface/bin/ordax-proof-runtime.sh",
      "surface/runtime/native_install_broker.sh",
      "surface/runtime/network_broker.sh",
      "surface/runtime/resolver_sync.sh",
      "surface/runtime/audio-session.sh"
    ],
    "linux_only_client_package_manifest": "surface/runtime/packages.txt",
    "linux_only_client_probe_paths": [
      "surface/runtime/media_runtime_probe.py",
      "surface/runtime/physical_ata_probe.py",
      "surface/runtime/physical_kernel_log_probe.py",
      "surface/runtime/physical_performance_probe.py"
    ],
    "linux_only_client_host_entrypoints": [
      "surface/runtime/native_host_server.py",
      "surface/runtime/ordax_browser_host.py"
    ]
  }
}
