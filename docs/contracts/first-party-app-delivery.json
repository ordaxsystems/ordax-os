{
  "$schema": "prototype-ordax.first-party-app-delivery/1",
  "status": "foundation-only-stable-payload-unchanged",
  "owner": "system/services/apps",
  "policy_schema": "ordax.first-party-app-delivery-policy/1",
  "projection_schema": "ordax.first-party-app-delivery-projection/1",
  "issue": 1016,
  "principles": {
    "catalogued_is_installed": false,
    "launcher_entry_implies_launchable": false,
    "store_ui_is_install_authority": false,
    "delivery_policy_grants_authority": false,
    "app_manifest_grants_authority": false,
    "remove_app_removes_user_data": false,
    "staged_means_activated": false,
    "failed_update_may_retain_last_known_good": true,
    "localization_policy": "component-scoped"
  },
  "delivery_classes": {
    "structural": {
      "meaning": "Surface/application shell is currently coupled to the System Platform and has no proven independent uninstall/recovery boundary.",
      "store_installable": false,
      "removable": false
    },
    "bootstrap": {
      "meaning": "Shipped in the initial Stable experience but intended to become independently removable/updateable after lifecycle proof.",
      "store_installable": true,
      "removable": true
    },
    "on-demand": {
      "meaning": "Known first-party product app that may be absent from the initial payload and installed later through the canonical component lifecycle.",
      "store_installable": true,
      "removable": true
    }
  },
  "current_target_policy": {
    "structural": [
      "settings",
      "account",
      "system",
      "store"
    ],
    "bootstrap": [
      "files",
      "internet"
    ],
    "on_demand": [
      "assistant",
      "studio",
      "projects",
      "activity",
      "notes",
      "network"
    ]
  },
  "surface_projection": {
    "states": [
      "installed",
      "available",
      "installing",
      "updating",
      "removing",
      "staged",
      "blocked",
      "failed-retained",
      "not-catalogued"
    ],
    "missing_recommended_app_action": "show-install",
    "missing_store_only_app_visible_in_launcher": false,
    "installed_payload_required_for_launch": true
  },
  "inventory_boundary": {
    "production_inventory_owner": "ordax-runtime-component-channel",
    "installed_truth": "verified-current-activation",
    "activation_state_owner_role": "runtime-component-verifier-and-activation-state-owner",
    "slot_cache_is_inventory": false,
    "policy_is_inventory": false,
    "catalog_is_inventory": false,
    "store_projection_is_inventory": false,
    "surface_may_claim_installation": false
  },
  "store_boundary": {
    "public_store_ui_enabled": false,
    "store_ui_implemented": true,
    "store_service_implemented": true,
    "native_lifecycle_executor_mounted": false,
    "must_reuse_component_manager": true,
    "must_reuse_runtime_component_release_v2_when_component_slot": true,
    "may_create_parallel_updater": false,
    "catalog_without_verified_artifact_may_offer_install": false,
    "lifecycle_request_must_delegate_to_platform_lifecycle": true,
    "request_contract": "ordax.app-lifecycle-request/1",
    "request_result_contract": "ordax.app-lifecycle-request-result/1",
    "request_port": "ordax.app-lifecycle-request-port/1",
    "request_authority": "none",
    "request_operations": [
      "install",
      "update",
      "remove"
    ],
    "launcher_request_operations": [
      "install"
    ],
    "request_may_select_artifact": false,
    "request_may_select_version": false,
    "request_may_select_trust_anchor": false,
    "request_may_grant_permissions": false,
    "request_may_bypass_verification": false,
    "remove_request_may_delete_user_data": false,
    "rollback_is_platform_owned": true,
    "verified_catalog_contract": "ordax.verified-app-store-catalog/1",
    "verified_catalog_port": "ordax.verified-app-store-catalog-port/1",
    "verified_catalog_source_repository": "washingtonmsdj/ordax-apps",
    "verified_catalog_trust_domain": "runtime-components",
    "verified_catalog_key_id": "ordax-runtime-components-v1",
    "catalog_signature_verifier_mounted": false,
    "catalog_sequence_watermark_required": true,
    "catalog_sequence_watermark_persistent": true,
    "catalog_lower_sequence_rejected": true,
    "catalog_equal_sequence_different_hash_rejected": true,
    "catalog_watermark_failure_is_fail_closed": true,
    "catalog_schema_grants_verification": false,
    "store_projection_service": "system/services/apps/verified-store-projection.mjs",
    "store_projection_contract": "ordax.app-store-catalog/2",
    "store_projection_port": "ordax.app-store-catalog-port/2",
    "store_projection_persists_inventory": false,
    "store_projection_reads_verified_current_activation": true,
    "catalog_replay_owner": "native-catalog-verifier",
    "catalog_signature_verification_owner": "native-catalog-verifier",
    "surface_may_write_catalog_watermark": false,
    "surface_receives_verified_catalog_read_only": true
  },
  "mvp": {
    "stable_payload_changed_by_this_foundation": false,
    "existing_mvp_app_requirements_unchanged": true,
    "public_store_is_mvp_blocker": false,
    "promotion_to_on_demand_requires_install_reinstall_offline_rollback_uninstall_proof": true
  }
}
