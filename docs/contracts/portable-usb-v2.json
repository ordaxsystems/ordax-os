{
  "$schema": "prototype-ordax.portable-usb-v2/1",
  "status": "disposable-proof-only",
  "product_scope": "mvp-usb-durable-storage-target",
  "storage_architecture_contract": "docs/contracts/storage-architecture.json",
  "creator_planner": "github.com/ordaxsystems/ordax-creator/core/storage_profiles.go#PlanPortableTargetStorage",
  "physical_write_authorized": false,
  "physical_device_paths_allowed": false,
  "host_loop_devices_allowed": true,
  "bootable_proven": false,
  "mvp_boot_handoff_connected": true,
  "logical_sector_bytes": 512,
  "alignment_bytes": 1048576,
  "target_bytes": 3221225472,
  "partitions": [
    {
      "index": 1,
      "name": "ORDAX-ESP",
      "role": "uefi-boot-current-fallback-and-recovery",
      "filesystem": "fat32",
      "filesystem_label": "ORDAX-ESP",
      "gpt_type_guid": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b",
      "start_lba": 2048,
      "size_bytes": 536870912
    },
    {
      "index": 2,
      "name": "ORDAX-DATA",
      "role": "portable-shared-capacity",
      "filesystem": "exfat",
      "filesystem_label": "ORDAX-DATA",
      "gpt_type_guid": "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7",
      "size_policy": "fill-all-remaining-usable-capacity",
      "windows_visible": true,
      "direct_overlayfs_upper": false
    }
  ],
  "ordax_internal_layout": {
    "root": "ORDAX-DATA/.ordax",
    "release_directory": ".ordax/releases",
    "release_image": {
      "path": ".ordax/releases/proof-system.erofs",
      "filesystem": "erofs",
      "read_only": true,
      "compressed": true
    },
    "state_directory": ".ordax/state",
    "persistent_state_image": {
      "path": ".ordax/state/persistent-state.img",
      "filesystem": "ext4",
      "filesystem_label": "ORDAX-STATE",
      "size_bytes": 268435456,
      "mounted_through_loop_device_in_runtime": true,
      "overlayfs_upper_owner": true,
      "overlayfs_scope": "stable-base-only",
      "layout": {
        "base_overlay": {
          "upper": "/ordax/base/upper",
          "work": "/ordax/base/work",
          "persistent": true
        },
        "product_system": {
          "persistent_overlay": false,
          "mount_policy": "verified-erofs-system-subtree-read-only"
        },
        "activation_state_root": "/ordax/portable-release",
        "runtime_state_root": "/ordax/runtime",
        "user_home_root": "/home"
      }
    },
    "activation_state": {
      "filesystem_owner": "persistent-state.img",
      "not_stored_directly_on_exfat": true,
      "root_inside_ext4": "/ordax/portable-release",
      "current": "/ordax/portable-release/current",
      "known_good": "/ordax/portable-release/known-good",
      "candidate": "/ordax/portable-release/candidate",
      "transaction": "/ordax/portable-release/activation-transaction.json",
      "rejected": "/ordax/portable-release/rejected",
      "candidate_policy": "armed-one-shot-boot-only",
      "transaction_commit_owner": "system/supervisor-after-cold-health",
      "rollback_owner": "pid1-or-supervisor"
    }
  },
  "user_data": {
    "shares_ordax_data_capacity": true,
    "outside_internal_directory_allowed": true,
    "preserved_by_system_image_reset": true
  },
  "proof_requirements": [
    "regular-sparse-raw-file-only",
    "gpt-valid",
    "exactly-two-partitions",
    "portable-planner-geometry-matches-contract",
    "ordax-esp-is-fat32",
    "ordax-data-is-exfat",
    "no-fixed-physical-ordax-system-partition",
    "real-erofs-release-image-inside-ordax-data",
    "real-ext4-persistent-state-image-inside-ordax-data",
    "persistent-state-image-is-not-exfat-overlay-upper",
    "user-file-coexists-with-ordax-internal-data",
    "read-only-remount-reverifies-contained-image-hashes",
    "physical-write-remains-unauthorized"
  ],
  "forbidden": [
    "physical-ORDAX-system-partition",
    "physical-ORDAX-HOME-partition",
    "physical-ORDAX-PLATFORM-partition",
    "direct-exfat-overlayfs-upper",
    "physical-device-path-input",
    "claiming-bootable-proof-from-storage-only-proof",
    "enabling-public-physical-write",
    "activation-current-pointer-directly-on-exfat",
    "persistent-overlay-over-system-erofs",
    "cross-release-system-upperdir"
  ],
  "kernel_prerequisites": {
    "source": "bootstrap/kernel/config/ordax.fragment",
    "built_in_before_release_handoff": true,
    "selectors": [
      "CONFIG_BLK_DEV_LOOP=y",
      "CONFIG_EXFAT_FS=y",
      "CONFIG_EROFS_FS=y",
      "CONFIG_EROFS_FS_ZIP=y",
      "CONFIG_OVERLAY_FS=y",
      "CONFIG_EXT4_FS=y"
    ],
    "purpose": {
      "CONFIG_BLK_DEV_LOOP": "mount EROFS release and ext4 persistent-state files as loop-backed block devices",
      "CONFIG_EXFAT_FS": "mount ORDAX-DATA before the full release is available",
      "CONFIG_EROFS_FS": "mount immutable release images",
      "CONFIG_EROFS_FS_ZIP": "read compressed EROFS release images",
      "CONFIG_OVERLAY_FS": "compose immutable lower system with Linux-native writable persistent state",
      "CONFIG_EXT4_FS": "mount the persistent-state image"
    }
  },
  "ci_proof_environment": {
    "exfat_population_backend": "exfat-fuse-userspace-ci-only",
    "reason": "GitHub-hosted runner kernel does not guarantee exFAT mount support",
    "product_runtime_backend": "linux-kernel-CONFIG_EXFAT_FS=y",
    "proof_still_formats_real_exfat": true,
    "proof_still_reverifies_real_exfat": true
  },
  "mount_handoff_proof_contract": "docs/contracts/portable-boot-handoff.json",
  "disposable_mount_handoff_proof_implemented": true,
  "portable_bootstrap_contract": "docs/contracts/portable-bootstrap-v2.json",
  "first_boot_target": {
    "offline_capable": true,
    "creator_preseeded_signed_release": true,
    "current_equals_known_good": true,
    "network_required": false,
    "pid1_integration_implemented": true
  }
}
