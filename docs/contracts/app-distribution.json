{
  "$schema": "prototype-ordax.app-distribution/1",
  "status": "mvp-minimal-payload-policy-defined",
  "catalog_owner": "future-store-service",
  "runtime_catalog": "system/apps/catalog.mjs",
  "first_party_delivery_policy_owner": "system/services/apps",
  "first_party_delivery_contract": "ordax.first-party-app-delivery-policy/1",
  "first_party_delivery_projection": "ordax.first-party-app-delivery-projection/1",
  "mvp_delivery_contract": "docs/contracts/mvp-app-delivery.json",
  "mvp_delivery_policy_owner": "system/services/apps/mvp-delivery-policy.mjs",
  "package_manifest_required": true,
  "package_fields": [
    "app_id",
    "version",
    "publisher",
    "entrypoint",
    "supported_modes",
    "required_contracts",
    "requested_capabilities",
    "content_hash",
    "signature",
    "update_policy"
  ],
  "security": {
    "unsigned_third_party_install_allowed": false,
    "profile_pack_may_bypass_package_verification": false,
    "profile_pack_may_auto_grant_permissions": false,
    "permission_change_on_update_must_be_visible": true,
    "failed_update_preserves_working_version": true,
    "removing_app_and_removing_user_data_are_separate_actions": true,
    "store_is_not_a_second_updater": true,
    "catalogued_app_may_be_treated_as_installed": false,
    "store_ui_may_claim_install_authority": false,
    "missing_payload_may_launch_from_residual_path": false,
    "first_online_catalog_refresh_may_mint_install_authority": false
  },
  "mvp": {
    "third_party_installation_enabled": false,
    "store_ui_enabled": false,
    "foundation_prepared": true,
    "minimal_initial_payload_target": true,
    "structural_app_ids": [
      "account",
      "settings",
      "system"
    ],
    "bootstrap_app_ids": [
      "files",
      "internet"
    ],
    "on_demand_app_ids": [
      "activity",
      "assistant",
      "network",
      "notes",
      "projects",
      "studio"
    ],
    "optional_apps_block_public_launch": false,
    "successful_network_makes_official_update_polling_reachable": true,
    "official_update_discovery_owner": "system/supervisor",
    "official_update_discovery_default_interval_seconds": 60,
    "first_run_is_not_a_second_updater": true,
    "network_skip_must_not_block_first_run": true,
    "stable_payload_may_drop_on_demand_apps_only_after_delivery_proofs": true,
    "stable_payload_changed_by_this_policy_only": false
  }
}
