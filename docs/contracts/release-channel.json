{
  "$schema": "prototype-ordax.release-channel/1",
  "status": "canonical-prototype-contract",
  "source_authority": {
    "kind": "git",
    "repository": "ordaxsystems/ordax-os",
    "branch": "main"
  },
  "device_pre_release": {
    "full_git_client_required": false,
    "source_checkout_required": false,
    "compiler_required": false,
    "codex_required": false,
    "https_release_resolver_required": true,
    "public_trust_anchor_required": true
  },
  "release": {
    "exact_source_commit_required": true,
    "immutable_after_verification": true,
    "artifact_sha256_required": true,
    "artifact_size_required": true,
    "manifest_authenticity_required_before_production": true,
    "custom_crypto_allowed": false,
    "atomic_activation_required": true,
    "known_good_preservation_required": true,
    "offline_known_good_boot_required": true
  },
  "publication": {
    "ci_owned": true,
    "github_is_current_artifact_host": true,
    "github_is_only_allowed_future_host": false,
    "codex_required": false,
    "release_envelope_asset_name": "release-envelope.json",
    "latest_envelope_url": "https://github.com/ordaxsystems/ordax-os/releases/latest/download/release-envelope.json",
    "latest_pointer_is_delivery_selector_not_authenticity": true
  },
  "kernel": {
    "compiled_on_device": false,
    "compiled_in_repository_ci": true,
    "delivered_as_verified_artifact": true
  },
  "runtime_polling": {
    "profile": "stable-mvp",
    "owner": "system/supervisor",
    "default_interval_seconds": 60,
    "discovery_command": "ordax-release-agent inspect",
    "materialization_command": "ordax-release-agent materialize",
    "exact_expected_commit_required": true,
    "staged_root": "/ordax/releases/<source_commit>",
    "staged_state": "/state/ordax/staged-release-sha",
    "current_pointer_changed": false,
    "activation_performed": false,
    "reboot_requested": false,
    "git_required": false
  },
  "runtime_health_gate": {
    "profile": "stable-mvp",
    "owner": "system/supervisor",
    "candidate_source": "/ordax/releases/<source_commit>/system",
    "candidate_entrypoint": "surface/entrypoint",
    "system_entrypoint_invoked": false,
    "source_sha_must_match_candidate": true,
    "process_survival_required": true,
    "surface_health_required": true,
    "known_good_surface_restored_after_probe": true,
    "known_good_health_required_after_restore": true,
    "health_ready_state": "/state/ordax/stable-release-health-ready-sha",
    "health_rejected_state": "/state/ordax/stable-release-health-rejected-sha",
    "repeat_failed_candidate": false,
    "current_pointer_changed": false,
    "activation_performed": false,
    "reboot_requested": false,
    "candidate_update_state_source_sha": "candidate-source-commit",
    "known_good_restore_update_state_source_sha": "current-source-commit",
    "health_ready_written_only_after_known_good_restore": true
  },
  "runtime_activation_primitive": {
    "profile": "stable-mvp",
    "owner": "bootstrap/release-acquisition",
    "command": "ordax-release-agent activate-exact",
    "exact_expected_commit_required": true,
    "network_required": false,
    "latest_pointer_re_resolved": false,
    "materialized_release_reverified": true,
    "previous_current_commit_reported": true,
    "atomic_current_pointer_replace": true,
    "supervisor_health_ready_gate_connected": true,
    "cold_health_rollback_connected": true,
    "reboot_requested": false
  },
  "runtime_activation_transaction": {
    "profile": "stable-mvp",
    "owner": "system/supervisor",
    "staged_state": "/state/ordax/staged-release-sha",
    "health_ready_state": "/state/ordax/stable-release-health-ready-sha",
    "activation_guard_state": "/state/ordax/stable-release-activation-guard",
    "staged_and_health_ready_sha_must_match": true,
    "guard_persisted_before_current_swap": true,
    "activation_command": "ordax-release-agent activate-exact",
    "activation_network_required": false,
    "activation_git_required": false,
    "guardian_refresh_after_swap": true,
    "cold_health_required": true,
    "cold_health_source_sha_must_match_activated_release": true,
    "rollback_command": "ordax-release-agent activate-exact",
    "rollback_target": "exact-previous-commit-from-transaction",
    "rollback_revalidates_signed_release": true,
    "rollback_network_required": false,
    "rollback_git_required": false,
    "failed_release_rejected": true,
    "known_good_preserved": true,
    "reboot_requested": false
  },
  "portable_runtime_activation": {
    "profile": "stable-mvp",
    "runtime_layout": "portable-v2",
    "discovery_command": "ordax-release-agent inspect",
    "materialization_command": "ordax-release-agent materialize-portable-v4",
    "exact_verification_command": "ordax-release-agent verify-portable-v4-exact",
    "activation_state_helper": "ordax-portable-state",
    "activation_state_root": "/state/ordax/portable-release",
    "portable_root": "/ordax-data/.ordax",
    "candidate_policy": "armed-one-shot-boot",
    "candidate_reboot_required": true,
    "candidate_cold_health_required": true,
    "commit_after_cold_health": true,
    "failed_candidate_persisted": true,
    "same_failed_candidate_retried": false,
    "rollback_network_required": false,
    "rollback_git_required": false,
    "physical_boot_proven": false,
    "manifest_schema": "prototype-ordax.release-manifest/4",
    "local_ai_runtime_required": true,
    "inspect_manifest_schema_drives_materializer": true,
    "pre_v4_current_may_accept_v3": true,
    "pre_v4_current_may_upgrade_to_v4": true,
    "v4_to_v3_downgrade_allowed": false,
    "v3_compatibility_materialization_command": "ordax-release-agent materialize-portable-v3",
    "v3_compatibility_exact_verification_command": "ordax-release-agent verify-portable-v3-exact"
  }
}
