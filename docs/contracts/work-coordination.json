{
  "$schema": "prototype-ordax.work-coordination-foundation/1",
  "status": "foundation-store-runtime-native-state-boundary-public-disabled",
  "issue": 1154,
  "owner": "platform",
  "contracts": [
    "ordax.work-coordination-policy/1",
    "ordax.work-plan/1",
    "ordax.work-task/1",
    "ordax.work-claim/1",
    "ordax.work-checkpoint/1",
    "ordax.work-evidence/1",
    "ordax.work-coordination-store/1",
    "ordax.work-coordination-store-state/1",
    "ordax.work-coordination-runtime/1"
  ],
  "authority": "none",
  "policy": {
    "modes": [
      "off",
      "manual",
      "assisted",
      "automatic"
    ],
    "absence_enables_coordination": false,
    "automatic_requires_explicit_confirmation": true,
    "background_execution_enabled": false,
    "project_override_supported_by_contract": true
  },
  "notifications": {
    "owns_notification_service": false,
    "intent_categories": [
      "approvalRequired",
      "taskBlocked",
      "workCompleted",
      "staleClaim",
      "conflictAvoided",
      "routineProgress"
    ]
  },
  "claims": {
    "finite_lease_required": true,
    "max_lease_ms": 900000,
    "cas_store_required": true,
    "permanent_lock_allowed": false
  },
  "store": {
    "contract_defined": true,
    "native_durable_adapter_defined": true,
    "native_typed_endpoint_defined": true,
    "native_durable_adapter_mounted": false,
    "partition": "owner+project",
    "scope_values": [
      "device",
      "session"
    ],
    "format_version": 1,
    "unknown_format_behavior": "reject-fail-closed",
    "migration_owner": "native-storage-adapter",
    "migration_must_preserve_owner_project_partition": true,
    "migration_may_create_authority": false,
    "max_serialized_bytes": 4194304,
    "full_dependency_graph_validation": true,
    "claim_revision_binding": true,
    "active_claim_requires_active_plan": true,
    "evidence_backed_completion_validation": true,
    "cas_only_mutation_surface": true,
    "last_write_wins_alias_allowed": false,
    "retention": {
      "automatic_delete": false,
      "archive_is_plan_state": true,
      "archive_requires_terminal_tasks": true,
      "delete_requires_partition_cas": true,
      "delete_is_separate_from_disable": true,
      "memory_cascade": false,
      "project_cascade": false
    }
  },
  "native_state": {
    "contract": "docs/contracts/work-coordination-native-state.json",
    "client_adapter": "system/adapters/native/work-coordination-state.mjs",
    "host_state_owner": "system/surface/runtime/native_work_coordination_state.py",
    "typed_endpoint": "system/surface/runtime/native_work_coordination_endpoint.py",
    "shared_transport": "system/adapters/native/bounded-json-transport.mjs",
    "shared_private_state_primitive": "system/surface/runtime/native_partitioned_json_state.py",
    "host_route_mounted": false,
    "authoritative_project_context_required": true,
    "project_browser_assertion_is_authority": false
  },
  "runtime": {
    "contract_defined": true,
    "mounted_in_native": false,
    "mounted_in_web": false,
    "create_plan_enabled_in_contract": true,
    "versioned_plan_update_enabled_in_contract": true,
    "dependency_state_derivation": "canonical-runtime",
    "claim_conflict_behavior": "surface-conflict-never-steal",
    "stale_claim_behavior": "block-for-reconciliation-never-auto-replay",
    "recovery_mutation_requires_policy": true,
    "system_mutation_requires_confirmed_automatic": true,
    "claim_revision_match_required": true,
    "evidence_verifier_injected": true,
    "provider_self_verification_allowed": false,
    "plan_revision_increments_on_runtime_state_change": true
  },
  "mvp": {
    "new_usb_mvp_blocker": false,
    "public_enabled": false,
    "background_autonomy_enabled": false,
    "provider_connector_mutations_enabled": false,
    "studio_is_authority_owner": false
  },
  "dependencies": {
    "project_authority_cutover_required_before_project_scoped_host_mount": true,
    "project_authority_owner": "ordax.project-catalog-reader/1",
    "project_cutover_tracking_pr": 1237,
    "no_parallel_project_registry_allowed": true
  },
  "next": [
    "project-authority-cutover",
    "native-host-route-composition",
    "native-composition-store-mount",
    "activity-settings",
    "provider-connectors",
    "studio-consumer"
  ]
}
