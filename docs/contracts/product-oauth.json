{
  "$schema": "prototype-ordax.product-oauth/1",
  "status": "persistent-authority-and-http-boundary-source-ready-runtime-disabled",
  "purpose": "first-party and end-user product authorization without reusing owner/development MCP credentials",
  "activation": {
    "public_enabled": false,
    "listener_deployed": false,
    "default_authority": "disabled",
    "account_public_gate_required": true
  },
  "protocol": {
    "oauth_2_1_direction": true,
    "authorization_code": true,
    "pkce_s256_required": true,
    "implicit_grant_forbidden": true,
    "password_grant_forbidden": true,
    "exact_redirect_uri_match": true,
    "authorization_code_single_use_authority_required": true,
    "short_lived_access_token_required": true,
    "refresh_rotation_authority_required_when_enabled": true,
    "refresh_tokens_enabled": false
  },
  "identity": {
    "account_authenticates_person": true,
    "space_is_product_actor": true,
    "space_selection_explicit": true,
    "space_membership_revalidated_on_exchange": true,
    "space_membership_revalidated_on_token_use": true,
    "client_asserted_role_authoritative": false
  },
  "security": {
    "same_origin_consent": true,
    "csrf_required_for_consent": true,
    "state_round_trip_required": true,
    "token_hashing_owned_by_server_adapter": true,
    "raw_tokens_in_logs": false,
    "supabase_service_role_in_core": false,
    "development_mcp_credentials_reused": false,
    "sec_fetch_site_same_origin_required": true
  },
  "initial_client": "acheguese",
  "known_scopes": [
    "network.space.read",
    "network.directory.read",
    "network.communities.read",
    "network.messages.read",
    "network.messages.write",
    "network.groups.join",
    "product.acheguese.publish"
  ],
  "persistence": {
    "provider": "supabase-postgres",
    "migration": "infra/supabase/product/migrations/20261002140612_product_oauth_authority_v1.sql",
    "server_adapter": "services/product-oauth/supabase_authority.py",
    "private_tables": true,
    "browser_table_grants": false,
    "raw_authorization_codes_persisted": false,
    "raw_access_tokens_persisted": false,
    "code_hash": "sha256",
    "access_token_hash": "sha256",
    "authorization_code_max_age_seconds": 300,
    "access_token_default_age_seconds": 900,
    "access_token_max_age_seconds": 3600,
    "refresh_tokens_enabled": false,
    "dedicated_server_secret_key_required": true,
    "secret_key_sent_as_bearer": false,
    "service_role_direct_table_grants": false
  },
  "http_boundary": {
    "source": "services/product-oauth/gateway.py",
    "default_application_enabled": false,
    "status_route": "/oauth/status",
    "authorize_route": "/oauth/authorize",
    "token_route": "/oauth/token",
    "revoke_route": "/oauth/revoke",
    "authorization_success": "303-exact-registered-https-redirect",
    "authorization_requires_same_origin": true,
    "authorization_requires_ordax_session": true,
    "authorization_requires_csrf": true,
    "token_grant_types": [
      "authorization_code"
    ],
    "token_content_type": "application/x-www-form-urlencoded",
    "refresh_token_returned": false,
    "revocation_hides_token_existence": true,
    "maximum_request_body_bytes": 16384
  }
}
