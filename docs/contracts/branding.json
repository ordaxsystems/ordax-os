{
  "$schema": "prototype-ordax.branding/1",
  "status": "prototype",
  "product_name": "OrdaX",
  "source_authority": "repository",
  "visual_identity": {
    "implemented": true,
    "owner": "system/surface/ui/tokens.css",
    "composition_owner": "system/surface/ui/identity.css",
    "symbol": "system/surface/ui/brand/ordax-symbol.png",
    "symbol_stylesheet": "system/surface/ui/brand/symbol.css",
    "themes": {
      "light": "Gelo",
      "dark": "Meia-noite"
    },
    "preference_id": "appearance.theme",
    "preference_owner": "system/services/preferences/appearance.mjs",
    "default_theme": "light",
    "external_visual_dependencies": false,
    "production_activation": false,
    "wallpaper": "system/surface/ui/brand/midnight-landscape.png",
    "wallpaper_provenance": "system/surface/ui/brand/ARTWORK-SOURCE.md"
  },
  "surface_loading": {
    "implemented": true,
    "owner": "system/surface/ui/boot-screen.*",
    "delivery": "runtime-git-checkout",
    "usb_rewrite_required": false,
    "default_status": "Preparando OrdaX…"
  },
  "first_run": {
    "implemented": true,
    "owner": "system/surface/ui/first-run.*",
    "native_usb_only": true,
    "account_optional": true,
    "identity_actions_capability_driven": true,
    "completion_is_persistent": true
  },
  "early_boot": {
    "graphical_splash_implemented": false,
    "current_mode": "console-text",
    "owner": "bootstrap/dev-base/ordax-dev-init",
    "future_graphical_owner": "bootstrap/initramfs-or-development-base",
    "kernel_framebuffer_support": true,
    "branding_change_requires_usb_rewrite": false,
    "future_delivery": "development-base-candidate",
    "developer_cinematic_candidate": {
      "status": "source-implemented-media-upload-and-physical-validation-pending",
      "owner": "bootstrap/boot-splash/",
      "source_video_sha256": "bcab385c001833529cd40b9bb8685e5eb33b7fec12b308d4a3a047965f500769",
      "video_frames_sha256": "82103c596add28d2945b172c418e4e9d03c1e4b6e3600a4f1b1a76be931bdb38",
      "original_audio_pcm_sha256": "78c35e843facdf25033d207acd82f6ba4354cdd75763bca48494a86c36e9b1f0",
      "native_player": "bootstrap/boot-splash/fb_splash.c",
      "audio_handoff": "ALSA aplay only after kernel sound device availability",
      "launch_owner": "bootstrap/dev-base/ordax-dev-init",
      "stop_owner": "system/surface/bin/ordax-surface",
      "media_format": "zstd-RGB565 640x360 12 fps + PCM WAV 48k stereo",
      "audio_required_in_intended_experience": true,
      "audio_supported_on_all_hardware": false,
      "only_dev_profile_initially": true,
      "kernel_boot_graphics_proven": false,
      "audio_on_notebook_proven": false,
      "does_not_block_boot": true,
      "does_not_wait_for_animation": true,
      "does_not_repeat_in_surface": true
    }
  },
  "failure_policy": {
    "surface_loading_error_stays_visible": true,
    "first_run_persistence_failure_stays_visible": true,
    "early_boot_graphics_must_have_text_fallback": true,
    "branding_must_not_block_boot": true
  }
}
