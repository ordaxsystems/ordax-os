{
  "$schema": "prototype-ordax.studio-runtime-integration/1",
  "status": "source-authorization-runtime-dispatch-disabled",
  "product": {
    "app_id": "studio",
    "product_name": "ORDAX Studio",
    "single_product": true,
    "duplicate_studio_forbidden": true,
    "blender_is_capability_not_product": true,
    "unity_is_capability_not_product": true
  },
  "runtime_source": {
    "historical_incubation_repository": "washingtonmsdj/mcp-blender",
    "device_agent_schema": "ordax.device-agent/1",
    "capability_reader_schema": "ordax.device-agent-capability-reader/1",
    "same_action_gateway_required": true,
    "parallel_runtime_forbidden": true
  },
  "platform_authority": {
    "identity_owner": "ordax-os",
    "spaces_owner": "ordax-os",
    "permissions_owner": "ordax-os",
    "intelligence_schema": "ordax.intelligence/1",
    "memory_schema": "ordax.memory/1",
    "model_router_schema": "ordax.model-router/1",
    "studio_must_not_create_parallel_identity": true,
    "studio_must_not_create_parallel_memory": true,
    "studio_must_not_create_parallel_model_router": true
  },
  "capability_discovery": {
    "surface_receives_capability_reader_only": true,
    "surface_receives_raw_execute": false,
    "missing_runtime_is_non_boot_critical": true,
    "probe_failure_is_component_scoped": true
  },
  "mutations": {
    "runtime_enabled": false,
    "authorization_runtime_enabled": true,
    "dispatch_runtime_enabled": false,
    "authorization_schema": "ordax.studio-device-action-authorization/1",
    "request_schema": "ordax.device-action-request/1",
    "receipt_schema": "ordax.device-action-receipt/1",
    "write_grant_schema": "ordax.device-agent/1",
    "explicit_write_approval_required": true,
    "live_capability_write_mode_required": true,
    "request_expiry_revalidated_at_authorization": true,
    "authorization_dispatch_authority": "none",
    "direct_device_agent_execute_from_surface_forbidden": true,
    "request_is_not_authority": true,
    "same_action_gateway_required": true,
    "idempotency_required": true,
    "expiry_required": true,
    "audit_required": true
  },
  "ai_modes": {
    "local_24h": {
      "owner": "ordax-os",
      "provider": "ordax.local-ai/1",
      "default_external_usage": false
    },
    "chatgpt_mcp": {
      "conversation_owner": "chatgpt",
      "user_initiated": true,
      "ordax_role": "authorized-tools-and-context"
    },
    "external_chatgpt_plan": {
      "runtime_enabled": false,
      "explicit_opt_in_required": true,
      "usage_notice_required": true,
      "usage_notice": "Uses ChatGPT Work/Codex allowance, not normal chat quota",
      "silent_fallback_forbidden": true
    },
    "provider_api": {
      "runtime_enabled": false,
      "separate_billing_notice_required": true,
      "silent_fallback_forbidden": true
    }
  },
  "handoff": {
    "memory_owner": "ordax-os",
    "structured_checkpoint_required": true,
    "browser_ui_automation_is_integration_foundation": false,
    "provider_may_receive_only_authorized_context": true
  },
  "activation_gate": {
    "source_contract_only": false,
    "authorization_only": true,
    "does_not_enable_surface_mutations": true,
    "does_not_change_usb_release_gate": true,
    "does_not_make_studio_boot_critical": true
  }
}
