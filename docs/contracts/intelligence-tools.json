{
  "$schema": "prototype-ordax.intelligence-tools/1",
  "status": "governed-local-observability-with-native-system-analysis",
  "tool_contract": "ordax.intelligence-tool/1",
  "registry_contract": "ordax.intelligence-tool-registry/1",
  "capability_bridge_contract": "ordax.intelligence-capability-bridge/1",
  "authorization_broker_contract": "ordax.intelligence-tool-authorization-broker/1",
  "authorization_receipt_contract": "ordax.intelligence-tool-authorization-receipt/1",
  "execution_contract": "ordax.intelligence-readonly-tool-executor/1",
  "execution_result_contract": "ordax.intelligence-tool-execution-result/1",
  "execution_receipt_contract": "ordax.intelligence-tool-execution-receipt/1",
  "audit_journal_contract": "ordax.intelligence-audit-journal/1",
  "audit_entry_contract": "ordax.intelligence-audit-entry/1",
  "owner": "system/services/intelligence",
  "approved_read_only_capabilities": [
    "system.metrics",
    "network.status",
    "power.status"
  ],
  "tools": [
    {
      "id": "observe-system-metrics",
      "capability_id": "system.metrics",
      "invocation_enabled": true
    },
    {
      "id": "observe-network-status",
      "capability_id": "network.status",
      "invocation_enabled": true
    },
    {
      "id": "observe-power-status",
      "capability_id": "power.status",
      "invocation_enabled": true
    }
  ],
  "authority": {
    "read_only": true,
    "network_egress": false,
    "mutates_state": false,
    "invocation_enabled": true,
    "automatic_model_invocation": false,
    "authority": "none",
    "generic_shell": false,
    "arbitrary_path": false,
    "arbitrary_url": false
  },
  "bridge": {
    "purpose": "Inspect whether an approved read-only product capability is present and whether its governed invocation path is enabled.",
    "adapter_calls": false,
    "model_can_invoke": false,
    "agent_identity_grants_tool": false,
    "prompt_grants_tool": false,
    "unknown_capability_fails_closed": true
  },
  "authorization": {
    "explicit_agent_tool_binding_required": true,
    "one_shot": true,
    "max_ttl_ms": 300000,
    "target_bound": true,
    "trusted_capability_inventory_required": true,
    "authorization_receipts": [
      "issued",
      "claimed",
      "revoked",
      "expired"
    ],
    "receipt_contains_bearer_token": false,
    "receipt_contains_target_id": false,
    "receipt_is_execution_proof": false,
    "grant_itself_executes": false
  },
  "execution": {
    "enabled_tools": [
      "observe-system-metrics",
      "observe-network-status",
      "observe-power-status"
    ],
    "claim_required_before_adapter_read": true,
    "result_context_bounded": true,
    "result_provenance_required": true,
    "network_interface_names_exposed_to_model": false,
    "network_ip_addresses_exposed_to_model": false,
    "network_ssids_exposed_to_model": false,
    "execution_receipts": [
      "succeeded",
      "failed"
    ],
    "receipt_contains_bearer_token": false,
    "receipt_contains_target_id": false,
    "adapter_error_details_exposed": false,
    "model_direct_access": false,
    "network_egress": false,
    "mutates_state": false
  },
  "native_system_analysis": {
    "composed": true,
    "trigger": "explicit-system-diagnose-action",
    "agent_id": "system",
    "observation_tools": [
      "observe-system-metrics",
      "observe-network-status",
      "observe-power-status"
    ],
    "model_selects_tools": false,
    "consumer_imports_tool_runtime": false,
    "partial_observation_is_reported_as_limitation_context": true,
    "all_observations_unavailable_fails_closed": true,
    "authority": "none"
  },
  "audit": {
    "authorization_and_execution_correlated": true,
    "correlation_field": "auditRef",
    "audit_ref_is_authority": false,
    "bounded_runtime_journal": true,
    "default_entries": 256,
    "maximum_entries": 1024,
    "contains_bearer_grant_id": false,
    "contains_target_id": false,
    "contains_prompt_or_model_response": false,
    "contains_tool_result_context": false,
    "durable_native_persistence": false
  },
  "deferred": [
    "durable-native-audit-store",
    "user-facing-tool-approval-flow",
    "model-mediated-tool-selection",
    "web-grounding",
    "mutating-tools",
    "leases",
    "rollback"
  ]
}
