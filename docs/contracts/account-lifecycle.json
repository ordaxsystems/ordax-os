{
  "$schema": "prototype-ordax.account-lifecycle/1",
  "status": "account-export-and-close-implemented-deployed-disabled",
  "identity_owner": "ordax-account-gateway",
  "provider": "supabase",
  "principles": {
    "account_optional_for_product_use": true,
    "browser_direct_provider_admin_calls_allowed": false,
    "service_role_key_in_browser_allowed": false,
    "provider_tokens_in_surface_javascript_allowed": false,
    "destructive_account_action_requires_recent_authenticated_session": true,
